// ui: TextArea

from typing.primitives.string use { String }
from typing.collections.list use { List }
use window
from .util use { mix, _clamp, _max, _min }
from .theme use { Theme }
from .widget use { _clip_pop, _clip_push, _ink, _sel_color }
from .text_edit use { TextEdit }

---
Multi-line text. Enter starts a new line; Up / Down / Page Up / Page Down
move between lines, Home / End to the start / end of the line (with Ctrl:
of the text). Editing, selection and copy / paste as for `TextEdit`.
`rows` / `columns` set the size it asks for; it scrolls (wheel, or by
following the cursor) when the text is bigger. With `wrap=true` long
lines break at spaces to fit the width (and the keys move along the
wrapped lines) instead of scrolling sideways. `on_change(text)` runs on
every edit.
---
struct TextArea : TextEdit {
    rows: Int
    columns: Int
    wrap: Bool
    _top: Int
    _left: Int
    _goal: Int

    define __init(self, text: String = "", rows: Int = 6, columns: Int = 40, on_change: Callable = null, expand: Bool = false, wrap: Bool = false) -> void {
        super().__init(text, on_change)
        self.rows = rows
        self.columns = columns
        self.wrap = wrap
        self.expand = expand
        self._top = 0
        self._left = 0
        self._goal = -1
    }

    --- The text split into lines (at "\n"; wrapping doesn't count). ---
    define lines(self) -> List {
        return self.text.split("\n")
    }

    define measure(self, t: Theme) -> void {
        self._t = t
        self._cw = t.char_w()
        self._lh = t.line()
        self.min_w = self.columns * t.char_w() + 16
        self.min_h = self.rows * t.line() + 12
    }

    // A right-to-left row is drawn against the right edge.
    define _row_off(self, seg: String) -> Int {
        if not window.is_rtl(seg) { return 0 }
        return _max(0, self.width - 16 - self._t.font.width(seg))
    }

    define _shown_rows(self) -> Int {
        return _max(1, (self.height - 12) / self._lh)
    }

    define _shown_cols(self) -> Int {
        if self.width <= 0 { return self.columns }
        return _max(1, (self.width - 16) / self._cw)
    }

    --- The rows on screen as [start, end] text ranges ("\n" not included). ---
    define layout(self) -> List {
        out := []
        n := self.text.length()
        cols := self._shown_cols()
        avail := _max(1, self.width - 16)
        if self.width <= 0 { avail = cols * self._cw }
        s := 0
        while true {
            e := self._line_end(s)
            if self.wrap {
                pos := s
                while self._span_w(pos, e) > avail {
                    // The most that fits (at least one character).
                    brk := self._index_near(pos, e, avail)
                    while brk > pos + 1 and self._span_w(pos, brk) > avail { brk = brk - 1 }
                    if brk <= pos { brk = pos + 1 }
                    j := brk
                    while j > pos and self.text.substring(j - 1, j) != " " { j = j - 1 }
                    if j > pos { brk = j }
                    out.append([pos, brk])
                    pos = brk
                }
                out.append([pos, e])
            } else {
                out.append([s, e])
            }
            if e >= n { break }
            s = e + 1
        }
        return out
    }

    // The row holding index i. At a wrap point the index starts the next row.
    define _row_of(self, rows: List, i: Int) -> Int {
        r := 0
        while r < rows.length() {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            if i >= ra and i < rb { return r }
            if i == rb {
                if r + 1 >= rows.length() { return r }
                nxt: List = rows[r + 1]
                na: Int = nxt[0]
                if na != rb { return r }
            }
            r = r + 1
        }
        return _max(0, rows.length() - 1)
    }

    // Index at column `col` of row `r` (clamped to the row; a wrapped row
    // stops before its wrap point, which belongs to the next row).
    define _at_row(self, rows: List, r: Int, col: Int) -> Int {
        if r < 0 { return 0 }
        if r >= rows.length() { return self.text.length() }
        row: List = rows[r]
        ra: Int = row[0]
        rb: Int = row[1]
        last := rb - ra
        if r + 1 < rows.length() {
            nxt: List = rows[r + 1]
            na: Int = nxt[0]
            if na == rb and last > 0 { last = last - 1 }
        }
        return ra + _clamp(col, 0, last)
    }

    define index_at(self, px: Int, py: Int) -> Int {
        rows := self.layout()
        r := self._top + (py - self.y - 6) / self._lh
        if py < self.y + 6 { r = self._top }
        left := self._left
        if self.wrap { left = 0 }
        if r < 0 or r >= rows.length() { return self._at_row(rows, r, 0) }
        row: List = rows[r]
        ra: Int = row[0]
        rb: Int = row[1]
        if rb > ra and self._bidi(self.text.substring(ra, rb)) {
            seg := self.text.substring(ra, rb)
            return self._at_row(rows, r, self._t.font.index_at(seg, px - self.x - 8 - self._row_off(seg)))
        }
        idx := self._index_near(_min(ra + left, rb), rb, px - self.x - 8)
        return self._at_row(rows, r, idx - ra)
    }

    define _vertical(self, by: Int, grow: Bool) -> void {
        rows := self.layout()
        r := self._row_of(rows, self.cursor)
        row: List = rows[r]
        ra: Int = row[0]
        // The goal is a pixel offset, so the cursor stays above itself with
        // a proportional font.
        if self._goal < 0 { self._goal = self._span_w(ra, self.cursor) }
        target := r + by
        if target < 0 {
            self._move(0, grow)
        } elif target >= rows.length() {
            self._move(self.text.length(), grow)
        } else {
            trow: List = rows[target]
            tra: Int = trow[0]
            trb: Int = trow[1]
            self._move(self._at_row(rows, target, self._index_near(tra, trb, self._goal) - tra), grow)
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "wheel" {
            most := _max(0, self.layout().length() - self._shown_rows())
            self._top = _clamp(self._top - e.dy * 3, 0, most)
            return true
        }
        if e.kind == "key_down" and (e.key == "up" or e.key == "down" or e.key == "pageup" or e.key == "pagedown") {
            by := 1
            if e.key == "up" { by = -1 }
            if e.key == "pageup" { by = -self._shown_rows() }
            if e.key == "pagedown" { by = self._shown_rows() }
            self._vertical(by, e.shift)
            return true
        }
        self._goal = -1
        if self._edit(e) { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        mod := e.ctrl or e.meta
        if k == "home" or k == "end" {
            if mod {
                if k == "home" { self._move(0, e.shift) } else { self._move(self.text.length(), e.shift) }
            } else {
                rows := self.layout()
                r := self._row_of(rows, self.cursor)
                if k == "home" { self._move(self._at_row(rows, r, 0), e.shift) }
                else { self._move(self._at_row(rows, r, 1000000), e.shift) }
            }
        } elif k == "return" or k == "keypad_enter" {
            self.insert("\n")
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        self._fix()
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        self._t = t
        lh := t.line()
        shown := self._shown_rows()
        rows := self.layout()
        if self.wrap { self._left = 0 }
        // Follow the cursor.
        cr := self._row_of(rows, self.cursor)
        crow: List = rows[cr]
        cra: Int = crow[0]
        cc := self.cursor - cra
        if self._dragging or self.focused {
            if cr < self._top { self._top = cr }
            if cr >= self._top + shown { self._top = cr - shown + 1 }
            if not self.wrap {
                if cc < self._left { self._left = cc }
                while self._left < cc and self._span_w(cra + self._left, self.cursor) > self.width - 16 { self._left = self._left + 1 }
            }
        }
        self._top = _clamp(self._top, 0, _max(0, rows.length() - 1))
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        sa := self.selection_start()
        sb := self.selection_end()
        r := self._top
        while r < rows.length() and r < self._top + shown {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            ly := self.y + 6 + (r - self._top) * lh
            bseg := ""
            if rb > ra { bseg = self.text.substring(ra, rb) }
            if rb > ra and self._bidi(bseg) {
                // Right-to-left / mixed row: laid out by the font.
                bx := self.x + 8 + self._row_off(bseg)
                if sb > sa and _max(sa, ra) < _min(sb, rb) {
                    for piece in t.font.selection(bseg, _max(sa, ra) - ra, _min(sb, rb) - ra) {
                        pc: List = piece
                        px: Int = pc[0]
                        pw: Int = pc[1]
                        win.rect(bx + px, ly, pw, lh, _sel_color(self, t))
                    }
                }
                win.text(bseg, bx, ly, _ink(self, t.text, t), scale=t.scale, font=t.font)
                r = r + 1
                continue
            }
            if sb > sa {
                a := _max(sa, ra)
                b := _min(sb, rb)
                // A selected line break shows as one extra cell.
                extra := 0
                hard := r + 1 >= rows.length()
                if not hard {
                    nxt: List = rows[r + 1]
                    na: Int = nxt[0]
                    hard = na != rb
                }
                if hard and sb > rb and sa <= rb and rb < self.text.length() { extra = 1 }
                start := ra + self._left
                sa2 := _max(a, start)
                if b > sa2 or (extra == 1 and b >= sa2) {
                    x1 := self.x + 8 + self._span_w(start, sa2)
                    x2 := self.x + 8 + self._span_w(start, _max(b, sa2)) + extra * self._cw
                    if x2 > x1 { win.rect(x1, ly, x2 - x1, lh, _sel_color(self, t)) }
                }
            }
            if rb - ra > self._left {
                win.text(self.text.substring(ra + self._left, rb), self.x + 8, ly,
                         _ink(self, t.text, t), scale=t.scale, font=t.font)
            }
            r = r + 1
        }
        if not self.focused { self._compose = "" }
        if self.focused and cr >= self._top and cr < self._top + shown {
            cx := self.x + 8 + self._span_w(cra + self._left, self.cursor)
            crb0: Int = crow[1]
            if crb0 > cra and self._bidi(self.text.substring(cra, crb0)) {
                cseg := self.text.substring(cra, crb0)
                cx = self.x + 8 + self._row_off(cseg) + t.font.caret_x(cseg, self.cursor - cra)
            }
            cy := self.y + 6 + (cr - self._top) * lh
            if self._compose != "" {
                // Inline: the composition at the cursor, the rest of the row after it.
                win.rect(cx, cy, _max(0, self.x + self.width - 1 - cx), lh, t.input)
                cw := self._draw_compose(win, t, cx, cy)
                crb: Int = crow[1]
                if crb > self.cursor {
                    win.text(self.text.substring(self.cursor, crb), cx + cw, cy, _ink(self, t.text, t), scale=t.scale, font=t.font)
                }
            } else {
                win.text_input_area(cx, cy, 1, lh)
                if (window.ticks() / 530) % 2 == 0 { win.rect(cx, cy, _max(1, t.scale), lh, t.text) }
            }
        }
        _clip_pop(win)
        // Scroll indicator when there are more rows than fit.
        if rows.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / rows.length())
            most := _max(1, rows.length() - shown)
            by := self.y + 2 + (track - bar) * _min(self._top, most) / most
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}
