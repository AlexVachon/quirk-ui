// ui: Label, Button, Checkbox, Slider, RadioGroup, ProgressBar

from typing.primitives.string use { String }
from typing.collections.list use { List }
use window
from .util use { mix, _clamp, _max }
from .theme use { Theme }
from .widget use { Widget, _focus_ring, _ink }
from .access use { AccessNode }

---
Text. "\n" starts a new line. `color` -1 uses the theme's text colour;
`align` is "left", "center" or "right".
---
struct Label : Widget {
    text: String
    color: Int
    align: String
    weight: String           // "regular", "medium", "semibold", "bold" (see Theme.set_weight)
    define access_role(self) -> String {
        return "text"
    }

    define _a11y_name(self) -> String {
        return self.text
    }


    define __init(self, text: String, color: Int = -1, align: String = "left", weight: String = "") -> void {
        super().__init()
        self.text = text
        self.color = color
        self.align = align
        self.weight = weight
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.text_w(self.text, self.weight)
        lines := self.text.split("\n").length()
        self.min_h = _max(1, lines) * t.line()
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        c := self.color
        if c == -1 { c = t.text }
        tw := t.text_w(self.text, self.weight)
        tx := self.x
        if self.align == "center" { tx = self.x + (self.width - tw) / 2 }
        if self.align == "right" { tx = self.x + self.width - tw }
        ty := self.y + (self.height - self.min_h) / 2
        t.draw_text(win, self.text, tx, ty, _ink(self, c, t), weight=self.weight)
    }
}

---
A push button. `on_click` (no arguments) runs when it's clicked, or
when it has the focus and Enter / Space is pressed. `color`: its
background (-1: the theme's accent); `text_color` (-1: accent_text);
`weight` of its text ("medium", "semibold", "bold").
---
struct Button : Widget {
    text: String
    on_click: Callable
    color: Int
    text_color: Int
    weight: String
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "invoke" or not self.enabled { return false }
        self.click()
        return true
    }

    define access_role(self) -> String {
        return "button"
    }

    define _a11y_name(self) -> String {
        return self.text
    }


    define __init(self, text: String, on_click: Callable = null, expand: Bool = false, color: Int = -1, text_color: Int = -1, weight: String = "") -> void {
        super().__init()
        self.text = text
        self.on_click = on_click
        self.focusable = true
        self.expand = expand
        self.color = color
        self.text_color = text_color
        self.weight = weight
    }

    --- Press the button from code. ---
    define click(self) -> void {
        if self.enabled and self.on_click != null { self.on_click() }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.text_w(self.text, self.weight) + 4 * t.char_w()
        self.min_h = t.line() + 12
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        base := self.color != -1 ? self.color : t.accent
        bg := base
        if not self.enabled {
            bg = mix(base, t.background, 60)
        } elif self.pressed {
            bg = mix(base, window.black(), 25)
        } elif self.hovered {
            bg = mix(base, window.white(), 15)
        }
        win.rect(self.x, self.y, self.width, self.height, bg)
        tw := t.text_w(self.text, self.weight)
        ink := self.text_color != -1 ? self.text_color : t.accent_text
        t.draw_text(win, self.text, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2,
                    _ink(self, ink, t), weight=self.weight)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.click() }
            return true
        }
        if e.kind == "key_down" and (e.key == "return" or e.key == "space" or e.key == "keypad_enter") {
            self.click()
            return true
        }
        return false
    }
}

---
A box that's ticked or not, with a label. `on_change(checked)` runs when
the user toggles it.
---
struct Checkbox : Widget {
    text: String
    checked: Bool
    on_change: Callable
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if (action != "toggle" and action != "invoke") or not self.enabled { return false }
        self.toggle()
        return true
    }

    define access_role(self) -> String {
        return "checkbox"
    }

    define _a11y_name(self) -> String {
        return self.text
    }

    define _a11y_states(self, out: List) -> void {
        if self.checked { out.append("checked") }
    }


    define __init(self, text: String, checked: Bool = false, on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.checked = checked
        self.on_change = on_change
        self.focusable = true
    }

    --- Flip it, as a click would (runs `on_change`). ---
    define toggle(self) -> void {
        if not self.enabled { return }
        self.checked = not self.checked
        if self.on_change != null { self.on_change(self.checked) }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.line() + t.char_w() + t.text_w(self.text)
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        bx := self.x
        by := self.y + (self.height - s) / 2
        win.rect(bx, by, s, s, t.input)
        border := t.border
        if self.hovered { border = t.accent }
        win.rect(bx, by, s, s, border, fill=false)
        if self.checked {
            m := _max(2, s / 4)
            win.rect(bx + m, by + m, s - 2 * m, s - 2 * m, _ink(self, t.accent, t))
        }
        win.text(self.text, bx + s + t.char_w(), self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.toggle() }
            return true
        }
        if e.kind == "key_down" and (e.key == "space" or e.key == "return") {
            self.toggle()
            return true
        }
        return false
    }
}

---
Pick a number between `min` and `max` by dragging (or with the arrow
keys, by `step`). `on_change(value)` runs when it moves.
---
struct Slider : Widget {
    min: Int
    max: Int
    value: Int
    step: Int
    on_change: Callable
    define _a11y_range(self) -> List {
        return [self.min, self.max, self.value]
    }

    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if (action != "set_range" and action != "set_value") or not self.enabled { return false }
        self.set(Int(value))
        return true
    }

    define access_role(self) -> String {
        return "slider"
    }

    define access_value(self) -> String {
        return String(self.value)
    }

    define _a11y_description(self) -> String {
        return String(self.min) + " to " + String(self.max)
    }


    define __init(self, min: Int = 0, max: Int = 100, value: Int = 50, on_change: Callable = null, step: Int = 1) -> void {
        super().__init()
        self.min = min
        self.max = max
        self.value = _clamp(value, min, max)
        self.step = step
        self.on_change = on_change
        self.focusable = true
    }

    --- Set the value (clamped to min..max); runs `on_change` if it changed. ---
    define set(self, v: Int) -> void {
        nv := _clamp(v, self.min, self.max)
        if nv != self.value {
            self.value = nv
            if self.on_change != null { self.on_change(nv) }
        }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 8
    }

    define _from_x(self, px: Int) -> void {
        span := _max(1, self.width - 16)
        rel := _clamp(px - self.x - 8, 0, span)
        self.set(self.min + (rel * (self.max - self.min) + span / 2) / span)
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_move" and self.pressed {
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_up" {
            self.pressed = false
            return true
        }
        if e.kind == "key_down" {
            if e.key == "left" or e.key == "down" {
                self.set(self.value - self.step)
                return true
            }
            if e.key == "right" or e.key == "up" {
                self.set(self.value + self.step)
                return true
            }
            if e.key == "home" {
                self.set(self.min)
                return true
            }
            if e.key == "end" {
                self.set(self.max)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        cy := self.y + self.height / 2
        span := _max(1, self.width - 16)
        range := _max(1, self.max - self.min)
        kx := self.x + 8 + (self.value - self.min) * span / range
        win.rect(self.x + 8, cy - 2, span, 4, t.border)
        win.rect(self.x + 8, cy - 2, kx - self.x - 8, 4, _ink(self, t.accent, t))
        knob := t.text
        if self.pressed or self.hovered { knob = t.accent }
        win.circle(kx, cy, _max(6, self.height / 3), _ink(self, knob, t))
        if self.focused { _focus_ring(win, self, t) }
    }
}

---
One choice out of `options` (anything with `.str()`), shown as a column
of round buttons. Click one, or Up / Down (Left / Right) when it has the
focus. `selected` is the index (-1 = none); `on_change(index, item)` runs
when it changes.
---
struct RadioGroup : Widget {
    options: List
    selected: Int
    on_change: Callable
    _row_h: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "select" or node.index < 0 or not self.enabled { return false }
        self.select(node.index)
        return true
    }

    define access_role(self) -> String {
        return "radiogroup"
    }

    define access_value(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return String(self.options[self.selected])
    }

    define _a11y_children(self) -> List {
        out := []
        n := self.options.length()
        i := 0
        while i < n {
            h := n > 0 ? self.height / n : 0
            item := AccessNode("radio", String(self.options[i]), "", self.x, self.y + i * h, self.width, h)._item(self, i)
            if i == self.selected { item.states.append("checked") }
            out.append(item)
            i = i + 1
        }
        return out
    }


    define __init(self, options: List, selected: Int = 0, on_change: Callable = null) -> void {
        super().__init()
        self.options = options
        self.selected = _clamp(selected, -1, options.length() - 1)
        self.on_change = on_change
        self._row_h = 24
        self.focusable = true
    }

    --- The chosen option as text ("" when none). ---
    define text(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return self.options[self.selected].str()
    }

    --- Choose option `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.options.length() == 0 or not self.enabled { return }
        ni := _clamp(i, 0, self.options.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.options[ni]) }
        }
    }

    define measure(self, t: Theme) -> void {
        self._row_h = t.line() + 8
        widest := 0
        for o in self.options { widest = _max(widest, t.text_w(o.str())) }
        self.min_w = t.line() + t.char_w() + widest
        self.min_h = _max(1, self.options.length()) * self._row_h
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y) / self._row_h
            if row >= 0 and row < self.options.length() { self.select(row) }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" {
            if e.key == "down" or e.key == "right" {
                self.select(self.selected + 1)
                return true
            }
            if e.key == "up" or e.key == "left" {
                self.select(_max(0, self.selected - 1))
                return true
            }
            if e.key == "home" {
                self.select(0)
                return true
            }
            if e.key == "end" {
                self.select(self.options.length() - 1)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        r := s / 2
        i := 0
        while i < self.options.length() {
            ry := self.y + i * self._row_h
            cx := self.x + r
            cy := ry + self._row_h / 2
            ring := t.border
            if self.hovered { ring = t.accent }
            win.circle(cx, cy, r, t.input)
            win.circle(cx, cy, r, ring, fill=false)
            if i == self.selected { win.circle(cx, cy, _max(2, r / 2), _ink(self, t.accent, t)) }
            win.text(self.options[i].str(), self.x + s + t.char_w(), cy - t.line() / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
            i = i + 1
        }
        if self.focused { _focus_ring(win, self, t) }
    }
}

---
How far along something is: `value` out of `max` (clamped), drawn as a
filled bar. `show_text` adds the percentage. Set `value` as work
progresses.
---
struct ProgressBar : Widget {
    value: Int
    max: Int
    show_text: Bool
    define _a11y_range(self) -> List {
        return [0, self.max, self.value]
    }

    define access_role(self) -> String {
        return "progressbar"
    }

    define access_value(self) -> String {
        if self.max <= 0 { return String(self.value) }
        return String(self.value * 100 / self.max) + "%"
    }


    define __init(self, value: Int = 0, max: Int = 100, show_text: Bool = false, expand: Bool = false) -> void {
        super().__init()
        self.value = value
        self.max = max
        self.show_text = show_text
        self.expand = expand
    }

    --- Progress from 0 to 100. ---
    define percent(self) -> Int {
        if self.max <= 0 { return 0 }
        return _clamp(self.value * 100 / self.max, 0, 100)
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        fill := (self.width - 2) * self.percent() / 100
        if fill > 0 { win.rect(self.x + 1, self.y + 1, fill, self.height - 2, _ink(self, t.accent, t)) }
        win.rect(self.x, self.y, self.width, self.height, t.border, fill=false)
        if self.show_text {
            label := self.percent().str() + "%"
            tw := t.text_w(label)
            win.text(label, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2, t.text, scale=t.scale, font=t.font)
        }
    }
}
