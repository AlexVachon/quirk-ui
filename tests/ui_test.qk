// ui v1.7.0, headless: layout, events routed by App.dispatch, widget
// state and drawing. Every test is skipped (passes) without SDL2.
use window
use ui
use test

define new_app() -> ui.App {
    return ui.App("ui test", 400, 300, headless=true)
}

define ev(kind: String) -> window.Event {
    return window.Event(kind)
}

define click(app: ui.App, x: Int, y: Int) -> void {
    d := ev("mouse_down")
    d.x = x
    d.y = y
    d.button = 1
    app.dispatch(d)
    u := ev("mouse_up")
    u.x = x
    u.y = y
    u.button = 1
    app.dispatch(u)
}

define click_on(app: ui.App, w: ui.Widget) -> void {
    click(app, w.x + w.width / 2, w.y + w.height / 2)
}

define key(app: ui.App, k: String) -> void {
    e := ev("key_down")
    e.key = k
    app.dispatch(e)
}

define typed(app: ui.App, s: String) -> void {
    e := ev("text")
    e.text = s
    app.dispatch(e)
}

// ───── layout ─────
define test_column_stacks_and_stretches() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.Label("one")
    b := ui.Button("two")
    app.root = ui.Column([a, b], padding=10, spacing=6)
    app.layout()
    test.assert_eq(a.x, 10)
    test.assert_eq(a.y, 10)
    test.assert_eq(a.width, 380)
    test.assert_eq(a.height, 16)
    test.assert_eq(b.y, 32)
    test.assert_eq(b.height, 28)
    app.close()
}

define test_expand_takes_free_space() -> void {
    if not window.available() { return }
    app := new_app()
    top := ui.Label("top")
    filler := ui.Spacer()
    bottom := ui.Button("bottom")
    app.root = ui.Column([top, filler, bottom])
    app.layout()
    test.assert_eq(bottom.y + bottom.height, 300)
    row_a := ui.Button("a")
    row_b := ui.TextInput()
    row_b.expand = true
    app.root = ui.Row([row_a, row_b], padding=0, spacing=4)
    app.layout()
    test.assert_eq(row_b.x + row_b.width, 400)
    app.close()
}

define test_hidden_widgets_take_no_space() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.Label("a")
    b := ui.Label("b")
    c := ui.Label("c")
    b.visible = false
    app.root = ui.Column([a, b, c], spacing=4)
    app.layout()
    test.assert_eq(c.y, 20)
    app.close()
}

// ───── widgets ─────
define test_button_click_and_keyboard() -> void {
    if not window.available() { return }
    app := new_app()
    count := 0
    btn := ui.Button("Go", on_click=fn() { count = count + 1 })
    app.root = ui.Column([btn], padding=8)
    app.layout()
    click_on(app, btn)
    test.assert_eq(count, 1)
    test.assert_true(btn.focused)
    key(app, "return")
    key(app, "space")
    test.assert_eq(count, 3)
    btn.enabled = false
    click_on(app, btn)
    test.assert_eq(count, 3)
    app.close()
}

define test_release_outside_does_not_click() -> void {
    if not window.available() { return }
    app := new_app()
    count := 0
    btn := ui.Button("Go", on_click=fn() { count = count + 1 })
    app.root = ui.Column([btn], padding=8)
    app.layout()
    d := ev("mouse_down")
    d.x = btn.x + 2
    d.y = btn.y + 2
    d.button = 1
    app.dispatch(d)
    test.assert_true(btn.pressed)
    u := ev("mouse_up")
    u.x = 390
    u.y = 290
    u.button = 1
    app.dispatch(u)
    test.assert_false(btn.pressed)
    test.assert_eq(count, 0)
    app.close()
}

define test_checkbox_toggles() -> void {
    if not window.available() { return }
    app := new_app()
    seen := []
    box := ui.Checkbox("Agree", on_change=fn(on) { seen.append(on) })
    app.root = ui.Column([box], padding=8)
    app.layout()
    click_on(app, box)
    test.assert_true(box.checked)
    key(app, "space")
    test.assert_false(box.checked)
    test.assert_eq(seen.length(), 2)
    app.close()
}

define test_text_input_editing() -> void {
    if not window.available() { return }
    app := new_app()
    changes := 0
    submitted := ""
    input := ui.TextInput(placeholder="name", on_change=fn(s) { changes = changes + 1 },
                          on_submit=fn(s) { submitted = s })
    app.root = ui.Column([input], padding=8)
    app.layout()
    click_on(app, input)
    test.assert_true(input.focused)
    typed(app, "Héllo")
    test.assert_eq(input.text, "Héllo")
    test.assert_eq(input.cursor, 5)
    key(app, "home")
    typed(app, ">")
    key(app, "end")
    key(app, "backspace")
    key(app, "left")
    key(app, "delete")
    test.assert_eq(input.text, ">Hél")
    key(app, "return")
    test.assert_eq(submitted, ">Hél")
    test.assert_eq(changes, 4)
    app.close()
}

define test_slider_mouse_and_keys() -> void {
    if not window.available() { return }
    app := new_app()
    s := ui.Slider(min=0, max=10, value=5)
    app.root = ui.Column([s], padding=8)
    app.layout()
    click(app, s.x + 8, s.y + s.height / 2)
    test.assert_eq(s.value, 0)
    click(app, s.x + s.width - 8, s.y + s.height / 2)
    test.assert_eq(s.value, 10)
    key(app, "left")
    key(app, "left")
    test.assert_eq(s.value, 8)
    key(app, "home")
    test.assert_eq(s.value, 0)
    s.set(99)
    test.assert_eq(s.value, 10)
    app.close()
}

define test_list_view_select_and_scroll() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    items := ["a", "b", "c", "d", "e", "f", "g", "h"]
    lv := ui.ListView(items, on_select=fn(i, item) { picked = item }, rows=3)
    app.root = ui.Column([lv], padding=8)
    app.layout()
    click(app, lv.x + 10, lv.y + 2 + 24 + 5)
    test.assert_eq(lv.selected, 1)
    test.assert_eq(picked, "b")
    key(app, "end")
    test.assert_eq(lv.selected, 7)
    test.assert_eq(picked, "h")
    key(app, "up")
    test.assert_eq(lv.selected, 6)
    app.close()
}

// ───── focus ─────
define test_tab_cycles_focus() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.TextInput()
    lbl := ui.Label("not focusable")
    b := ui.Button("b")
    c := ui.Checkbox("c")
    app.root = ui.Column([a, lbl, ui.Row([b, c])])
    app.layout()
    key(app, "tab")
    test.assert_true(a.focused)
    key(app, "tab")
    test.assert_true(b.focused)
    test.assert_false(a.focused)
    key(app, "tab")
    test.assert_true(c.focused)
    key(app, "tab")
    test.assert_true(a.focused)
    shift_tab := ev("key_down")
    shift_tab.key = "tab"
    shift_tab.shift = true
    app.dispatch(shift_tab)
    test.assert_true(c.focused)
    app.close()
}

define test_keys_go_to_the_focused_widget() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.TextInput()
    b := ui.TextInput()
    app.root = ui.Column([a, b])
    app.layout()
    click_on(app, b)
    typed(app, "x")
    test.assert_eq(a.text, "")
    test.assert_eq(b.text, "x")
    click(app, 399, 299)
    test.assert_true(app.focus == null)
    typed(app, "y")
    test.assert_eq(b.text, "x")
    app.close()
}

// ───── drawing / frames ─────
define test_step_draws_theme_and_widgets() -> void {
    if not window.available() { return }
    app := ui.App("draw", 200, 100, theme=ui.light(), headless=true)
    btn := ui.Button("OK")
    app.root = ui.Column([btn], padding=10)
    test.assert_true(app.step())
    test.assert_eq(app.win.pixel(2, 2), window.hex("#f4f5f7") % 16777216)
    test.assert_eq(app.win.pixel(btn.x + 2, btn.y + 2), window.hex("#2f6fde") % 16777216)
    app.close()
    test.assert_false(app.step())
}

define test_on_frame_runs_each_step() -> void {
    if not window.available() { return }
    app := new_app()
    frames := 0
    app.on_frame = fn() { frames = frames + 1 }
    app.step()
    app.step()
    test.assert_eq(frames, 2)
    app.close()
}

define test_mix() -> void {
    test.assert_eq(ui.mix(window.rgb(0, 0, 0), window.rgb(200, 100, 50), 50), window.rgb(100, 50, 25))
    test.assert_eq(ui.mix(window.red(), window.blue(), 0), window.red())
}

// ───── v1.1.0: selection, clipboard, TextArea, ScrollView, Dropdown, tooltips ─────
define keym(app: ui.App, k: String, shift: Bool = false, ctrl: Bool = false) -> void {
    e := ev("key_down")
    e.key = k
    e.shift = shift
    e.ctrl = ctrl
    app.dispatch(e)
}

define mouse(app: ui.App, kind: String, x: Int, y: Int, clicks: Int = 1) -> void {
    e := ev(kind)
    e.x = x
    e.y = y
    e.button = 1
    e.clicks = clicks
    e.left = kind == "mouse_move"
    app.dispatch(e)
}

define wheel(app: ui.App, x: Int, y: Int, dy: Int) -> void {
    mouse(app, "mouse_move", x, y)
    e := ev("wheel")
    e.dy = dy
    app.dispatch(e)
}

define test_text_input_select_type_over_and_clipboard() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("hello world")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    keym(app, "home")
    i := 0
    while i < 5 {
        keym(app, "right", shift=true)
        i = i + 1
    }
    test.assert_true(field.has_selection())
    test.assert_eq(field.selected_text(), "hello")
    typed(app, "HEY")
    test.assert_eq(field.text, "HEY world")
    test.assert_false(field.has_selection())
    keym(app, "a", ctrl=true)
    test.assert_eq(field.selected_text(), "HEY world")
    keym(app, "c", ctrl=true)
    test.assert_eq(window.clipboard(), "HEY world")
    keym(app, "delete")
    test.assert_eq(field.text, "")
    keym(app, "v", ctrl=true)
    keym(app, "v", ctrl=true)
    test.assert_eq(field.text, "HEY worldHEY world")
    field.select(3, 9)
    keym(app, "x", ctrl=true)
    test.assert_eq(window.clipboard(), " world")
    test.assert_eq(field.text, "HEYHEY world")
    // Left / Right with a selection collapse it to that end.
    field.select(1, 4)
    keym(app, "left")
    test.assert_eq(field.cursor, 1)
    test.assert_false(field.has_selection())
    app.close()
}

define test_text_input_word_moves() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("one two  three")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    keym(app, "end")
    keym(app, "left", ctrl=true)
    test.assert_eq(field.cursor, 9)
    keym(app, "left", ctrl=true)
    test.assert_eq(field.cursor, 4)
    keym(app, "right", ctrl=true)
    test.assert_eq(field.cursor, 7)
    keym(app, "backspace", ctrl=true)
    test.assert_eq(field.text, "one   three")
    keym(app, "home")
    keym(app, "delete", ctrl=true)
    test.assert_eq(field.text, "   three")
    app.close()
}

define test_text_input_mouse_selection_and_one_line_paste() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("alpha beta gamma", columns=30)
    app.root = ui.Column([field], padding=8)
    app.layout()
    cx := field.x + 8 + 8 * 7          // inside "beta"
    cy := field.y + field.height / 2
    mouse(app, "mouse_down", cx, cy, 2)
    mouse(app, "mouse_up", cx, cy, 2)
    test.assert_eq(field.selected_text(), "beta")
    // Drag from the start of "alpha" to the end of it.
    mouse(app, "mouse_down", field.x + 8, cy)
    mouse(app, "mouse_move", field.x + 8 + 8 * 5, cy)
    mouse(app, "mouse_up", field.x + 8 + 8 * 5, cy)
    test.assert_eq(field.selected_text(), "alpha")
    window.set_clipboard("one\ntwo")
    field.paste()
    test.assert_eq(field.text, "one two beta gamma")
    app.close()
}

define test_text_area_lines_and_selection() -> void {
    if not window.available() { return }
    app := new_app()
    changes := 0
    area := ui.TextArea("first\nsecond line\nx", rows=4, on_change=fn(s) { changes = changes + 1 })
    app.root = ui.Column([area], padding=8)
    app.layout()
    click_on(app, area)
    keym(app, "home", ctrl=true)
    test.assert_eq(area.cursor, 0)
    keym(app, "end")
    test.assert_eq(area.cursor, 5)                 // end of "first"
    keym(app, "down")
    test.assert_eq(area.cursor, 11)                // column 5 of "second line"
    keym(app, "down")
    test.assert_eq(area.cursor, 19)                // "x" is short: end of it
    keym(app, "up")
    test.assert_eq(area.cursor, 11)                // back to column 5
    keym(app, "home")
    keym(app, "up", shift=true)
    test.assert_eq(area.selected_text(), "first\n")
    keym(app, "return")
    test.assert_eq(area.text, "\nsecond line\nx")
    test.assert_eq(area.lines().length(), 3)
    typed(app, "top")
    test.assert_eq(area.text, "\ntopsecond line\nx")
    test.assert_true(changes >= 2)
    // Triple-click selects a whole line.
    lx := area.x + 10
    ly := area.y + 6 + 16 + 4                      // second visible line
    mouse(app, "mouse_down", lx, ly, 3)
    mouse(app, "mouse_up", lx, ly, 3)
    test.assert_eq(area.selected_text(), "topsecond line")
    app.close()
}

define test_scroll_view_wheel_clip_and_follow_focus() -> void {
    if not window.available() { return }
    app := new_app()
    buttons := []
    i := 0
    while i < 20 {
        buttons.append(ui.Button("Item " + i.str()))
        i = i + 1
    }
    content := ui.Column(buttons, spacing=4)
    view := ui.ScrollView(content, height=100)
    below := ui.Label("below")
    app.root = ui.Column([view, below], padding=10)
    app.layout()
    test.assert_eq(view.height, 100)
    test.assert_eq(below.y, 10 + 100 + 8)
    first: ui.Button = buttons[0]
    test.assert_eq(first.y, 10)
    wheel(app, view.x + 20, view.y + 20, -2)          // towards you: scroll down
    app.layout()
    test.assert_eq(view.offset, 80)
    test.assert_eq(first.y, 10 - 80)
    // The content doesn't draw outside the view.
    app.theme = ui.light()
    app.draw()
    test.assert_eq(app.win.pixel(view.x + 20, below.y + 30), app.win.pixel(395, 295))
    // Tab to the last button: the view scrolls to show it.
    last: ui.Button = buttons[19]
    app.focus_on(buttons[18])
    keym(app, "tab")
    app.layout()
    test.assert_true(last.focused)
    test.assert_eq(last.y + last.height, view.y + view.height)
    // Wheel up past the top stops at 0.
    wheel(app, view.x + 20, view.y + 20, 50)
    app.layout()
    test.assert_eq(view.offset, 0)
    app.close()
}

define test_scroll_view_bar_drag_and_nested_list() -> void {
    if not window.available() { return }
    app := new_app()
    items := []
    i := 0
    while i < 30 {
        items.append("row " + i.str())
        i = i + 1
    }
    lv := ui.ListView(items, rows=3)
    filler := ui.Spacer(400)
    view := ui.ScrollView(ui.Column([lv, filler]), height=150)
    app.root = ui.Column([view], padding=10)
    app.layout()
    // Wheel over the list scrolls the list, not the view.
    wheel(app, lv.x + 10, lv.y + 10, -2)
    app.layout()
    test.assert_eq(view.offset, 0)
    test.assert_eq(lv._top, 2)
    // Drag the scroll bar to the bottom.
    bx := view.x + view.width - 4
    focused_before := app.focus
    mouse(app, "mouse_down", bx, view.y + 5)
    mouse(app, "mouse_move", bx, view.y + 400)
    mouse(app, "mouse_up", bx, view.y + 400)
    app.layout()
    test.assert_eq(view.offset, content_most(view))
    test.assert_true(app.focus == focused_before)   // the bar doesn't take the focus
    app.close()
}

define content_most(v: ui.ScrollView) -> Int {
    return v.content.min_h - v.height
}

define test_dropdown_mouse_and_keyboard() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    dd := ui.Dropdown(["Small", "Medium", "Large"], on_change=fn(i, item) { picked = item.str() })
    other := ui.Button("other")
    app.root = ui.Column([dd, ui.Spacer(120), other], padding=10)      // clear of the open list
    app.layout()
    test.assert_eq(dd.text(), "Small")
    click_on(app, dd)
    test.assert_true(dd.is_open)
    app.draw()                                   // places the list
    row_y := dd.y + dd.height + 2 + 2 + 24 + 12  // middle of the second row
    mouse(app, "mouse_move", dd.x + 10, row_y)
    mouse(app, "mouse_down", dd.x + 10, row_y)
    mouse(app, "mouse_up", dd.x + 10, row_y)
    test.assert_false(dd.is_open)
    test.assert_eq(dd.selected, 1)
    test.assert_eq(picked, "Medium")
    // Keyboard: Space opens, Down, Enter picks.
    keym(app, "space")
    test.assert_true(dd.is_open)
    keym(app, "down")
    keym(app, "return")
    test.assert_false(dd.is_open)
    test.assert_eq(dd.text(), "Large")
    // Closed: Up changes the choice directly; Escape closes an open list.
    keym(app, "up")
    test.assert_eq(dd.selected, 1)
    keym(app, "space")
    keym(app, "escape")
    test.assert_false(dd.is_open)
    // A click elsewhere closes it (and still reaches what was clicked).
    count := 0
    other.on_click = fn() { count = count + 1 }
    click_on(app, dd)
    test.assert_true(dd.is_open)
    app.draw()
    click_on(app, other)
    test.assert_false(dd.is_open)
    test.assert_eq(count, 1)
    // A second click on the field closes it.
    click_on(app, dd)
    click_on(app, dd)
    test.assert_false(dd.is_open)
    app.close()
}

define test_tooltip_after_delay() -> void {
    if not window.available() { return }
    app := new_app()
    app.theme = ui.light()
    label := ui.tooltip(ui.Label("hover me"), "A helpful hint")
    app.root = ui.Column([label, ui.Spacer()], padding=10)
    app.layout()
    mx := label.x + 4
    my := label.y + 4
    tip_px := mx + 12 + 2                        // inside the tooltip box
    tip_py := my + 20 + 2
    app.tooltip_delay = 100000
    mouse(app, "mouse_move", mx, my)
    app.draw()
    bg := app.win.pixel(395, 295)
    test.assert_eq(app.win.pixel(tip_px, tip_py), bg)
    app.tooltip_delay = 0
    app.draw()
    test.assert_true(app.win.pixel(tip_px, tip_py) != bg)
    // A click hides it.
    mouse(app, "mouse_down", mx, my)
    app.draw()
    test.assert_eq(app.win.pixel(tip_px, tip_py), bg)
    app.close()
}

// ───── v1.2.0: undo / redo, RadioGroup, ProgressBar, Tabs ─────
define test_undo_redo_groups_typing() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    typed(app, "h")
    typed(app, "i")
    typed(app, " ")
    typed(app, "y")
    typed(app, "o")
    test.assert_eq(field.text, "hi yo")
    keym(app, "z", ctrl=true)                  // the word "yo"
    test.assert_eq(field.text, "hi ")
    keym(app, "z", ctrl=true)                  // the space
    test.assert_eq(field.text, "hi")
    keym(app, "z", ctrl=true)                  // "hi"
    test.assert_eq(field.text, "")
    test.assert_false(field.undo())            // nothing left
    keym(app, "y", ctrl=true)
    test.assert_eq(field.text, "hi")
    keym(app, "z", ctrl=true, shift=true)      // Ctrl+Shift+Z redoes too
    test.assert_eq(field.text, "hi ")
    // A new edit drops what could be redone.
    typed(app, "!")
    test.assert_false(field.redo())
    keym(app, "backspace")
    keym(app, "z", ctrl=true)
    test.assert_eq(field.text, "hi !")
    // Paste and cut are their own steps.
    window.set_clipboard("XY")
    keym(app, "v", ctrl=true)
    test.assert_eq(field.text, "hi !XY")
    keym(app, "z", ctrl=true)
    test.assert_eq(field.text, "hi !")
    app.close()
}

define test_radio_group() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    rg := ui.RadioGroup(["Red", "Green", "Blue"], selected=0, on_change=fn(i, item) { picked = item.str() })
    app.root = ui.Column([rg], padding=10)
    app.layout()
    test.assert_eq(rg.height, 3 * 24)
    mouse(app, "mouse_down", rg.x + 5, rg.y + 24 * 2 + 10)
    mouse(app, "mouse_up", rg.x + 5, rg.y + 24 * 2 + 10)
    test.assert_eq(rg.selected, 2)
    test.assert_eq(picked, "Blue")
    test.assert_true(rg.focused)
    keym(app, "up")
    test.assert_eq(rg.text(), "Green")
    keym(app, "home")
    test.assert_eq(rg.selected, 0)
    keym(app, "end")
    keym(app, "down")                           // stays on the last
    test.assert_eq(rg.selected, 2)
    app.close()
}

define test_progress_bar() -> void {
    if not window.available() { return }
    app := new_app()
    app.theme = ui.light()
    bar := ui.ProgressBar(value=25, max=200, show_text=true)
    app.root = ui.Column([bar], padding=10)
    app.layout()
    test.assert_eq(bar.percent(), 12)
    bar.value = 500
    test.assert_eq(bar.percent(), 100)
    bar.value = 50
    bar.max = 100
    app.draw()
    // Left half filled with the accent, right half not.
    test.assert_eq(app.win.pixel(bar.x + bar.width / 4, bar.y + 3), window.hex("#2f6fde") % 0x1000000)
    test.assert_eq(app.win.pixel(bar.x + bar.width * 3 / 4 + 20, bar.y + 3), window.hex("#ffffff") % 0x1000000)
    app.close()
}

define test_tabs_switch_pages() -> void {
    if not window.available() { return }
    app := new_app()
    changes := []
    first := ui.Button("on page one")
    second := ui.Label("page two")
    tabs := ui.Tabs(["One", "Two"], [first, second], on_change=fn(i, title) { changes.append(title) })
    app.root = ui.Column([tabs], padding=10, expand=true)
    app.layout()
    app.draw()                                   // places the tab row
    test.assert_true(tabs.page() == first)
    test.assert_true(first.y > tabs.y + 20)
    // Click the second tab (right after the first).
    one_w := window.text_width("One") + 24
    mouse(app, "mouse_down", tabs.x + one_w + 10, tabs.y + 10)
    mouse(app, "mouse_up", tabs.x + one_w + 10, tabs.y + 10)
    test.assert_eq(tabs.selected, 1)
    test.assert_eq(changes, ["Two"])
    // Only the shown page is in the tree (hit-testing, Tab order).
    test.assert_eq(tabs.children().length(), 1)
    keym(app, "left")
    test.assert_eq(tabs.selected, 0)
    keym(app, "tab", ctrl=true)                  // Ctrl+Tab: next tab, not next widget
    test.assert_eq(tabs.selected, 1)
    tabs.add("Three", ui.Label("page three"))
    keym(app, "right")
    test.assert_eq(tabs.selected, 2)
    keym(app, "right")                           // wraps
    test.assert_eq(tabs.selected, 0)
    app.close()
}

// v1.11.0: a × on each tab (closable), close(i); takes_tab.
define test_tabs_close_buttons() -> void {
    if not window.available() { return }
    app := new_app()
    tabs := ui.Tabs(["A", "B", "C"], [ui.Label("a"), ui.Label("b"), ui.Label("c")], closable=true, expand=true)
    app.root = ui.Column([tabs], padding=10, expand=true)
    app.layout()
    app.draw()
    // The × of tab B: at the right end of its tab.
    b_end: Int = tabs._xs[2]
    mouse(app, "mouse_down", b_end - 12, tabs.y + 10)
    mouse(app, "mouse_up", b_end - 12, tabs.y + 10)
    test.assert_eq(", ".join(tabs.titles), "A, C")             // closed, without an on_close
    test.assert_eq(tabs.selected, 0)
    // Clicking the title (not the ×) selects, as before.
    app.draw()
    c_start: Int = tabs._xs[1]
    mouse(app, "mouse_down", c_start + 6, tabs.y + 10)
    mouse(app, "mouse_up", c_start + 6, tabs.y + 10)
    test.assert_eq(tabs.selected, 1)
    // close(i) before the shown page: the same page stays shown.
    tabs.add("D", ui.Label("d"))
    tabs.select(2)
    tabs.close(0)
    test.assert_eq(", ".join(tabs.titles), "C, D")
    test.assert_eq(tabs.selected, 1)
    // With on_close, the app decides (and a middle click counts).
    asked := []
    tabs.on_close = fn(i) { asked.append(i) }
    app.draw()
    first_mid: Int = tabs._xs[1]
    m := ev("mouse_down")
    m.x = first_mid / 2 + tabs.x / 2
    m.y = tabs.y + 10
    m.button = 2
    app.dispatch(m)
    test.assert_eq(asked.length(), 1)
    test.assert_eq(Int(asked[0]), 0)
    test.assert_eq(tabs.titles.length(), 2)                    // still there: on_close didn't close it
    app.close()
}

define test_takes_tab_keeps_the_tab_key() -> void {
    if not window.available() { return }
    app := new_app()
    area := ui.TextArea()
    other := ui.Button("other")
    area.takes_tab = true
    app.root = ui.Column([area, other], padding=10)
    app.layout()
    app.focus_on(area)
    keym(app, "tab")
    test.assert_true(app.focus == area)                        // not moved to the next widget
    area.takes_tab = false
    keym(app, "tab")
    test.assert_true(app.focus == other)
}

// ───── v1.3.0: menus, context menus, TreeView, Table ─────
define right_click(app: ui.App, x: Int, y: Int) -> void {
    e := ev("mouse_down")
    e.x = x
    e.y = y
    e.button = 3
    app.dispatch(e)
}

define test_menu_bar_and_menus() -> void {
    if not window.available() { return }
    app := new_app()
    log := []
    file := ui.Menu([
        ui.MenuItem("New", on_click=fn() { log.append("new") }, shortcut="Ctrl+N"),
        ui.MenuItem("-"),
        ui.MenuItem("Save", on_click=fn() { log.append("save") }, enabled=false),
        ui.MenuItem("Quit", on_click=fn() { log.append("quit") }),
    ])
    edit := ui.Menu([ui.MenuItem("Copy", on_click=fn() { log.append("copy") })])
    bar := ui.MenuBar(["File", "Edit"], [file, edit])
    app.root = ui.Column([bar, ui.Spacer()])
    app.layout()
    app.draw()                                    // places the titles
    click(app, bar.x + 10, bar.y + 5)             // open File
    test.assert_true(file.is_open)
    app.draw()                                    // places the menu
    // Click "New" (first row).
    row_y := bar.y + bar.height + 2 + 12
    mouse(app, "mouse_down", bar.x + 20, row_y)
    mouse(app, "mouse_up", bar.x + 20, row_y)
    test.assert_eq(log, ["new"])
    test.assert_false(file.is_open)
    // Keyboard: open, Down skips the separator and the disabled Save.
    click(app, bar.x + 10, bar.y + 5)
    app.draw()
    keym(app, "down")                             // New
    keym(app, "down")                             // Quit (separator + Save skipped)
    keym(app, "return")
    test.assert_eq(log, ["new", "quit"])
    // Right switches to the next menu; Escape closes.
    click(app, bar.x + 10, bar.y + 5)
    keym(app, "right")
    test.assert_false(file.is_open)
    test.assert_true(edit.is_open)
    keym(app, "escape")
    test.assert_false(edit.is_open)
    // Hovering another title while a menu is open switches to it.
    click(app, bar.x + 10, bar.y + 5)
    file_w := window.text_width("File") + 16
    mouse(app, "mouse_move", bar.x + file_w + 10, bar.y + 5)
    test.assert_true(edit.is_open)
    test.assert_false(file.is_open)
    // Clicking the open title again closes it.
    click(app, bar.x + file_w + 10, bar.y + 5)
    test.assert_false(edit.is_open)
    app.close()
}

define test_context_menu() -> void {
    if not window.available() { return }
    app := new_app()
    hit := ""
    label := ui.Label("right-click me")
    label.context_menu = ui.Menu([ui.MenuItem("Rename", on_click=fn() { hit = "rename" })])
    other := ui.Label("no menu")
    app.root = ui.Column([label, other], padding=10)
    app.layout()
    right_click(app, other.x + 4, other.y + 4)
    test.assert_false(label.context_menu.is_open)
    right_click(app, label.x + 4, label.y + 4)
    test.assert_true(label.context_menu.is_open)
    app.draw()
    keym(app, "down")
    keym(app, "return")
    test.assert_eq(hit, "rename")
    // A click elsewhere closes an open context menu without running anything.
    right_click(app, label.x + 4, label.y + 4)
    click(app, 390, 290)
    test.assert_false(label.context_menu.is_open)
    app.close()
}

define test_tree_view() -> void {
    if not window.available() { return }
    app := new_app()
    src := ui.TreeNode("src", [ui.TreeNode("main.qk"), ui.TreeNode("util.qk")])
    docs := ui.TreeNode("docs", [ui.TreeNode("guide.md")])
    picked := ""
    tree := ui.TreeView([src, docs], on_select=fn(n) { picked = n.text })
    app.root = ui.Column([tree], padding=10)
    app.layout()
    test.assert_eq(tree.visible_nodes().length(), 2)
    // Click the arrow of "src": expands it (and selects it).
    mouse(app, "mouse_down", tree.x + 8, tree.y + 2 + 12)
    mouse(app, "mouse_up", tree.x + 8, tree.y + 2 + 12)
    test.assert_true(src.expanded)
    test.assert_eq(tree.visible_nodes().length(), 4)
    test.assert_eq(picked, "src")
    keym(app, "down")
    test.assert_eq(picked, "main.qk")
    test.assert_eq(tree.selected.depth(), 1)
    keym(app, "left")                             // a leaf: up to its parent
    test.assert_eq(picked, "src")
    keym(app, "left")                             // collapses
    test.assert_false(src.expanded)
    keym(app, "down")
    keym(app, "right")                            // expands docs
    test.assert_true(docs.expanded)
    keym(app, "right")                            // into its first child
    test.assert_eq(picked, "guide.md")
    // Collapsing a node whose child is selected selects the node.
    tree.toggle(docs)
    test.assert_eq(picked, "docs")
    // Double-click a row toggles it.
    mouse(app, "mouse_down", tree.x + 60, tree.y + 2 + 12, 2)
    mouse(app, "mouse_up", tree.x + 60, tree.y + 2 + 12, 2)
    test.assert_true(src.expanded)
    app.close()
}

define test_table_select_and_sort() -> void {
    if not window.available() { return }
    app := new_app()
    rows := [["banana", 12], ["apple", 3], ["cherry", 120]]
    picked := ""
    table := ui.Table(["Fruit", "Count"], rows, on_select=fn(i, row) { picked = row[0].str() })
    app.root = ui.Column([table], padding=10)
    app.layout()
    app.draw()
    rh := 24
    // Click the second row (apple).
    mouse(app, "mouse_down", table.x + 10, table.y + 2 + rh + rh + 12)
    mouse(app, "mouse_up", table.x + 10, table.y + 2 + rh + rh + 12)
    test.assert_eq(table.selected, 1)
    test.assert_eq(picked, "apple")
    // Sort by Count (numbers by value: 3, 12, 120), Down goes in sorted order.
    count_x := table.x + 2 + table._last_w[0] + 5
    mouse(app, "mouse_down", count_x, table.y + 10)
    mouse(app, "mouse_up", count_x, table.y + 10)
    test.assert_eq(table.sort_column, 1)
    test.assert_false(table.sort_descending)
    keym(app, "down")                             // after apple (3) comes banana (12)
    test.assert_eq(picked, "banana")
    keym(app, "down")
    test.assert_eq(picked, "cherry")
    // Click the header again: descending.
    mouse(app, "mouse_down", count_x, table.y + 10)
    test.assert_true(table.sort_descending)
    keym(app, "home")
    test.assert_eq(picked, "cherry")
    // Sort by name.
    table.sort_by(0)
    keym(app, "home")
    test.assert_eq(picked, "apple")
    keym(app, "end")
    test.assert_eq(picked, "cherry")
    test.assert_eq(table.selected, 2)            // index into rows, whatever the sort
    app.close()
}

define test_on_key_runs_first() -> void {
    if not window.available() { return }
    app := new_app()
    saves := 0
    field := ui.TextInput("x")
    app.root = ui.Column([field], padding=8)
    app.on_key = fn(e) {
        if e.ctrl and e.key == "s" { saves = saves + 1 }
    }
    app.layout()
    click_on(app, field)
    keym(app, "s", ctrl=true)
    test.assert_eq(saves, 1)
    test.assert_eq(field.text, "x")
    app.close()
}

// ───── v1.4.0: word wrap, editable cells, ColorPicker, FileDialog, drag and drop ─────
define test_text_area_word_wrap() -> void {
    if not window.available() { return }
    app := new_app()
    // 10 columns: 10 * 8 + 16 = 96 px wide.
    area := ui.TextArea("the quick brown fox jumps\nend", rows=6, columns=10, wrap=true)
    app.root = ui.Row([area, ui.Spacer()], padding=8)
    app.layout()
    test.assert_eq(area.width, 96)
    rows := area.layout()
    // "the quick " | "brown fox " | "jumps" | "end"
    test.assert_eq(rows.length(), 4)
    test.assert_eq(rows[1], [10, 20])
    test.assert_eq(rows[2], [20, 25])
    click_on(app, area)
    keym(app, "home", ctrl=true)
    keym(app, "end")                              // end of the first visual row
    test.assert_eq(area.cursor, 9)                // before the space at the wrap
    keym(app, "down")                             // same column on "brown fox "
    test.assert_eq(area.cursor, 19)
    keym(app, "home")
    test.assert_eq(area.cursor, 10)
    keym(app, "down")
    keym(app, "end")
    test.assert_eq(area.cursor, 25)               // a hard line end: the "\n" itself
    keym(app, "down")
    test.assert_eq(area.cursor, 29)               // last row, clamped
    // A click on the second visual row lands there.
    mouse(app, "mouse_down", area.x + 8 + 8 * 2, area.y + 6 + 16 + 4)
    mouse(app, "mouse_up", area.x + 8 + 8 * 2, area.y + 6 + 16 + 4)
    test.assert_eq(area.cursor, 12)
    // A word longer than the width is broken at the width.
    area.text = "abcdefghijklmnop"
    test.assert_eq(area.layout(), [[0, 10], [10, 16]])
    // Without wrap: one row per line.
    area.wrap = false
    test.assert_eq(area.layout().length(), 1)
    app.close()
}

define test_table_edit_cells() -> void {
    if not window.available() { return }
    app := new_app()
    rows := [["banana", 12], ["apple", 3]]
    edits := []
    table := ui.Table(["Fruit", "Count"], rows, editable=true, on_edit=fn(i, c, v) { edits.append(v) })
    app.root = ui.Column([table], padding=10)
    app.layout()
    app.draw()
    rh := 24
    // Double-click the Count cell of "apple".
    cx := table.x + 2 + table._last_w[0] + 10
    cy := table.y + 2 + rh + rh + 12
    mouse(app, "mouse_down", cx, cy, 2)
    mouse(app, "mouse_up", cx, cy, 2)
    test.assert_true(table.editing())
    test.assert_eq(table.column, 1)
    app.draw()
    typed(app, "42")                              // replaces the selected "3"
    keym(app, "return")
    test.assert_false(table.editing())
    test.assert_eq(rows[1][1], 42)
    test.assert_eq(type(rows[1][1]), "Int")       // an Int column stays an Int
    test.assert_eq(edits, [42])
    // Keyboard: Left to the name column, F2, Escape cancels.
    keym(app, "left")
    test.assert_eq(table.column, 0)
    keym(app, "f2")
    test.assert_true(table.editing())
    typed(app, "zzz")
    keym(app, "escape")
    test.assert_eq(rows[1][0], "apple")
    // Enter edits; a word in an Int column is kept as text.
    keym(app, "right")
    keym(app, "return")
    typed(app, "many")
    keym(app, "return")
    test.assert_eq(rows[1][1], "many")
    // Not editable: Enter does nothing.
    table.editable = false
    keym(app, "return")
    test.assert_false(table.editing())
    app.close()
}

define test_color_picker() -> void {
    if not window.available() { return }
    // HSV conversions.
    test.assert_eq(ui.hsv_to_color(0, 100, 100), window.rgb(255, 0, 0))
    test.assert_eq(ui.hsv_to_color(120, 100, 100), window.rgb(0, 255, 0))
    test.assert_eq(ui.hsv_to_color(240, 100, 50), window.rgb(0, 0, 127))
    test.assert_eq(ui.hsv_to_color(0, 0, 100), window.rgb(255, 255, 255))
    test.assert_eq(ui.color_to_hsv(window.rgb(255, 0, 0)), [0, 100, 100])
    test.assert_eq(ui.color_to_hsv(window.rgb(0, 0, 255)), [240, 100, 100])
    app := new_app()
    got := []
    picker := ui.ColorPicker(color=window.rgb(255, 0, 0), on_change=fn(c) { got.append(c) })
    app.root = ui.Column([picker], padding=10)
    app.layout()
    test.assert_eq(picker.hex(), "#ff0000")
    // Top-left of the square: no saturation, full brightness = white.
    click(app, picker.x, picker.y)
    test.assert_eq(picker.hex(), "#ffffff")
    // Bottom: black.
    click(app, picker.x + 64, picker.y + 128)
    test.assert_eq(picker.hex(), "#000000")
    // Back to full colour, then the hue strip a third of the way: green.
    click(app, picker.x + 128, picker.y)
    test.assert_eq(picker.hex(), "#ff0000")
    click(app, picker.x + 128 + 8 + 5, picker.y + 43)        // 43 / 128 of 360 = hue 120
    test.assert_eq(picker.hue, 120)
    test.assert_eq(picker.hex(), "#00ff00")
    test.assert_eq(got.length(), 4)
    // Keys: Down darkens.
    keym(app, "down")
    test.assert_eq(picker.value, 95)
    picker.set_color(window.hex("#336699"))
    test.assert_eq(picker.hex(), "#336699")
    app.close()
}

use fs

define test_file_dialog() -> void {
    if not window.available() { return }
    root := fs.temp_dir()
    fs.mkdir(fs.join(root, "sub"))
    fs.write_text(fs.join(root, "b.qk"), "x")
    fs.write_text(fs.join(root, "A.qk"), "x")
    fs.write_text(fs.join(root, "notes.txt"), "x")
    fs.write_text(fs.join(root, ".hidden"), "x")
    fs.write_text(fs.join(fs.join(root, "sub"), "inner.qk"), "x")
    app := new_app()
    picked := ""
    cancelled := false
    dlg := ui.FileDialog(dir=root, filter="*.qk", on_pick=fn(p) { picked = p }, on_cancel=fn() { cancelled = true })
    app.root = ui.Column([ui.Label("behind")], padding=8)
    app.layout()
    dlg.show()
    test.assert_true(dlg.is_open)
    // "..", folders first, then filtered files sorted ignoring case; no hidden.
    test.assert_eq(dlg._list.items, ["..", "sub/", "A.qk", "b.qk"])
    app.draw()
    // Keyboard: Down to sub/, Enter opens it.
    keym(app, "down")
    keym(app, "return")
    test.assert_eq(fs.basename(dlg.dir), "sub")
    test.assert_eq(dlg._list.items, ["..", "inner.qk"])
    keym(app, "backspace")                        // back up
    test.assert_eq(dlg._list.items, ["..", "sub/", "A.qk", "b.qk"])
    // Double-click a file picks it.
    app.draw()
    rows_y := dlg._list.y + 2 + 24 * 3 + 12        // fourth row: b.qk
    mouse(app, "mouse_down", dlg._list.x + 20, rows_y, 2)
    mouse(app, "mouse_up", dlg._list.x + 20, rows_y, 2)
    test.assert_false(dlg.is_open)
    test.assert_eq(fs.basename(picked), "b.qk")
    // Modal while open: a click "behind" doesn't reach the app.
    dlg.show()
    app.draw()
    click(app, 10, 10)
    test.assert_true(dlg.is_open)
    keym(app, "escape")
    test.assert_true(cancelled)
    // Save mode: type a name, Enter.
    saver := ui.FileDialog(mode="save", dir=root, on_pick=fn(p) { picked = p })
    saver.show()
    app.draw()
    typed(app, "out.txt")
    keym(app, "return")
    test.assert_eq(picked, fs.join(fs.absolute(root), "out.txt"))
    // Folder mode lists folders only.
    chooser := ui.FileDialog(mode="folder", dir=root, on_pick=fn(p) { picked = p })
    chooser.show()
    test.assert_eq(chooser._list.items, ["..", "sub/"])
    app.draw()
    click(app, chooser._ok.x + 5, chooser._ok.y + 5)      // "Choose" with ".." selected: this folder
    test.assert_eq(picked, fs.absolute(root))
    fs.remove_tree(root)
    app.close()
}

define test_drag_and_drop() -> void {
    if not window.available() { return }
    app := new_app()
    dropped := []
    clicks := 0
    card := ui.Button("card", on_click=fn() { clicks = clicks + 1 })
    card.on_drag = fn() => "payload"
    bin := ui.Panel([ui.Label("drop here")])
    bin.on_drop = fn(data) { dropped.append(data) }
    app.root = ui.Column([card, ui.Spacer(40), bin], padding=10)
    app.layout()
    // A plain click is still a click (moved less than 4 px).
    click_on(app, card)
    test.assert_eq(clicks, 1)
    test.assert_false(app.dragging())
    // Press on the card, move to the bin, release: dropped, and no click.
    mouse(app, "mouse_down", card.x + 5, card.y + 5)
    mouse(app, "mouse_move", card.x + 5, card.y + 30)
    test.assert_true(app.dragging())
    app.draw()
    mouse(app, "mouse_move", bin.x + 10, bin.y + 10)
    mouse(app, "mouse_up", bin.x + 10, bin.y + 10)
    test.assert_false(app.dragging())
    test.assert_eq(dropped, ["payload"])
    test.assert_eq(clicks, 1)
    // Dropped where nothing takes it: nothing happens.
    mouse(app, "mouse_down", card.x + 5, card.y + 5)
    mouse(app, "mouse_move", 390, 290)
    mouse(app, "mouse_up", 390, 290)
    test.assert_eq(dropped.length(), 1)
    // on_drag returning null cancels the drag.
    card.on_drag = fn() => null
    mouse(app, "mouse_down", card.x + 5, card.y + 5)
    mouse(app, "mouse_move", card.x + 5, card.y + 40)
    test.assert_false(app.dragging())
    mouse(app, "mouse_up", card.x + 5, card.y + 40)
    app.close()
}

define test_list_view_reorder() -> void {
    if not window.available() { return }
    app := new_app()
    moves := []
    lv := ui.ListView(["a", "b", "c", "d"], rows=4, reorderable=true, on_reorder=fn(f, t) { moves.append([f, t]) })
    app.root = ui.Column([lv], padding=10)
    app.layout()
    rh := 24
    // Drag "a" (row 0) onto row 2.
    mouse(app, "mouse_down", lv.x + 10, lv.y + 2 + 10)
    mouse(app, "mouse_move", lv.x + 10, lv.y + 2 + rh * 2 + 10)
    app.draw()
    mouse(app, "mouse_up", lv.x + 10, lv.y + 2 + rh * 2 + 10)
    test.assert_eq(lv.items, ["b", "c", "a", "d"])
    test.assert_eq(lv.selected, 2)
    test.assert_eq(moves, [[0, 2]])
    // Drag "d" to the top.
    mouse(app, "mouse_down", lv.x + 10, lv.y + 2 + rh * 3 + 10)
    mouse(app, "mouse_move", lv.x + 10, lv.y + 2)
    mouse(app, "mouse_up", lv.x + 10, lv.y + 2)
    test.assert_eq(lv.items, ["d", "b", "c", "a"])
    // Not reorderable: dragging only selects.
    lv.reorderable = false
    mouse(app, "mouse_down", lv.x + 10, lv.y + 2 + 10)
    mouse(app, "mouse_move", lv.x + 10, lv.y + 2 + rh * 3 + 10)
    mouse(app, "mouse_up", lv.x + 10, lv.y + 2 + rh * 3 + 10)
    test.assert_eq(lv.items, ["d", "b", "c", "a"])
    app.close()
}

// ───── v1.5.0: shortcuts, SplitView, Toolbar, StatusBar, DatePicker ─────
define test_menu_shortcuts_work() -> void {
    if not window.available() { return }
    app := new_app()
    log := []
    file := ui.Menu([
        ui.MenuItem("Save", on_click=fn() { log.append("save") }, shortcut="Ctrl+S"),
        ui.MenuItem("Save as", on_click=fn() { log.append("save-as") }, shortcut="Ctrl+Shift+S"),
        ui.MenuItem("Off", on_click=fn() { log.append("off") }, shortcut="F5", enabled=false),
    ])
    field := ui.TextInput("text")
    field.context_menu = ui.Menu([ui.MenuItem("Clear", on_click=fn() { log.append("clear") }, shortcut="Del")])
    other := ui.Button("other")
    app.root = ui.Column([ui.MenuBar(["File"], [file]), field, other], padding=4)
    app.layout()
    keym(app, "s", ctrl=true)
    keym(app, "s", ctrl=true, shift=true)
    test.assert_eq(log, ["save", "save-as"])
    e := ev("key_down")
    e.key = "s"
    e.meta = true                                  // Cmd+S on macOS
    app.dispatch(e)
    test.assert_eq(log.length(), 3)
    keym(app, "f5")                                // disabled: nothing
    test.assert_eq(log.length(), 3)
    // A context menu's shortcut only while its widget has the focus.
    click_on(app, other)
    keym(app, "delete")
    test.assert_eq(log.length(), 3)
    click_on(app, field)
    keym(app, "delete")
    test.assert_eq(log[3], "clear")
    test.assert_eq(field.text, "text")            // the shortcut took the key
    test.assert_true(ui.MenuItem("x", shortcut="Ctrl+Shift+N").matches(keyev("n", true, true)))
    test.assert_false(ui.MenuItem("x", shortcut="Ctrl+N").matches(keyev("n", true, true)))
    app.close()
}

define keyev(k: String, ctrl: Bool, shift: Bool) -> window.Event {
    e := ev("key_down")
    e.key = k
    e.ctrl = ctrl
    e.shift = shift
    return e
}

define test_split_view() -> void {
    if not window.available() { return }
    app := new_app()
    left := ui.Label("left")
    right := ui.Label("right")
    split := ui.SplitView(left, right, ratio=25)
    app.root = ui.Column([split])
    app.layout()
    test.assert_eq(split.width, 400)
    test.assert_eq(left.width, (400 - 6) * 25 / 100)
    test.assert_eq(right.x, left.width + 6)
    // Drag the divider to the middle.
    bx := left.width + 3
    mouse(app, "mouse_down", bx, 100)
    mouse(app, "mouse_move", 200, 100)
    mouse(app, "mouse_up", 200, 100)
    app.layout()
    test.assert_true(split.ratio >= 49 and split.ratio <= 51)
    // It never gets smaller than min_size.
    mouse(app, "mouse_down", left.width + 3, 100)
    mouse(app, "mouse_move", 2, 100)
    mouse(app, "mouse_up", 2, 100)
    app.layout()
    test.assert_eq(left.width, 40)
    // Stacked.
    top := ui.Label("top")
    bottom := ui.Label("bottom")
    app.root = ui.Column([ui.SplitView(top, bottom, vertical=true, ratio=50)])
    app.layout()
    test.assert_eq(top.height, (300 - 6) / 2)
    test.assert_eq(bottom.y, top.height + 6)
    app.close()
}

define test_toolbar_and_status_bar() -> void {
    if not window.available() { return }
    app := new_app()
    saves := 0
    save := ui.ToolButton("Save", on_click=fn() { saves = saves + 1 }, tooltip="Save the file")
    icon_only := ui.ToolButton(icon="no/such/icon.png", tooltip="missing icon")
    tools := ui.Toolbar([save, ui.ToolButton("-"), icon_only])
    status := ui.StatusBar(["Ready", "Ln 1"])
    app.root = ui.Column([tools, ui.Spacer(), status], spacing=0)
    app.layout()
    test.assert_eq(status.y + status.height, 300)
    click_on(app, save)
    test.assert_eq(saves, 1)
    test.assert_eq(save.tooltip, "Save the file")
    app.draw()                                     // a missing icon draws a box, no error
    test.assert_true(icon_only._img_failed)
    status.set(1, "Ln 7")
    status.set(3, "UTF-8")
    test.assert_eq(status.get(1), "Ln 7")
    test.assert_eq(status.sections.length(), 4)
    app.draw()
    app.close()
}

define test_date_picker() -> void {
    if not window.available() { return }
    test.assert_eq(ui.days_in_month(2024, 2), 29)
    test.assert_eq(ui.days_in_month(2026, 2), 28)
    test.assert_eq(ui.days_in_month(2026, 11), 30)
    test.assert_eq(ui.weekday(2026, 11, 13), 4)    // a Friday
    test.assert_eq(ui.weekday(2000, 1, 1), 5)      // a Saturday
    app := new_app()
    got := []
    dp := ui.DatePicker(2026, 1, 31, on_change=fn(y, m, d) { got.append(d) })
    app.root = ui.Column([dp, ui.Spacer()], padding=10)
    app.layout()
    test.assert_eq(dp.text(), "2026-01-31")
    click_on(app, dp)
    test.assert_true(dp.is_open)
    keym(app, "right")                             // Feb 1
    keym(app, "return")
    test.assert_eq(dp.text(), "2026-02-01")
    test.assert_false(dp.is_open)
    // Page Down then Escape: nothing changes.
    keym(app, "space")
    keym(app, "pagedown")
    keym(app, "escape")
    test.assert_eq(dp.text(), "2026-02-01")
    // Click a day: open, draw (places the grid), click the 14th.
    click_on(app, dp)
    app.draw()
    first := ui.weekday(2026, 2, 1)
    cell := first + 13
    c := dp._cell
    cx := dp._px + 6 + (cell % 7) * c + c / 2
    cy := dp._py + 6 + 2 * c + (cell / 7) * c + c / 2
    click(app, cx, cy)
    test.assert_eq(dp.text(), "2026-02-14")
    // The ">" arrow moves to March without picking.
    click_on(app, dp)
    app.draw()
    click(app, dp._px + dp._pw - 10, dp._py + 10)
    test.assert_eq(dp._vm, 3)
    test.assert_eq(dp.text(), "2026-02-14")
    keym(app, "escape")
    // set_date clamps to a real date.
    dp.set_date(2026, 2, 31)
    test.assert_eq(dp.text(), "2026-02-28")
    test.assert_eq(got, [1, 14, 28])
    app.close()
}

// ───── v1.6.0: TrueType fonts ─────
define system_font() -> String {
    for p in ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
              "/usr/share/fonts/TTF/DejaVuSans.ttf",
              "/usr/share/fonts/dejavu/DejaVuSans.ttf",
              "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
              "/System/Library/Fonts/Supplemental/Arial.ttf",
              "/Library/Fonts/Arial.ttf",
              "C:\\Windows\\Fonts\\arial.ttf"] {
        path: String = p
        if fs.exists(path) { return path }
    }
    return ""
}

define test_theme_font() -> void {
    path := system_font()
    if path == "" or not window.available() { return }
    app := new_app()
    font := window.load_font(path, 16)
    app.theme.font = font
    label := ui.Label("WWW")
    field := ui.TextInput("iiiWWW", columns=20)
    app.root = ui.Column([label, field], padding=10)
    app.layout()
    test.assert_eq(label.min_w, font.width("WWW"))
    test.assert_eq(label.min_h, font.line_height)
    test.assert_eq(app.theme.line(), font.line_height)
    // A click right after "iii" puts the cursor there (narrow letters).
    x3 := field.x + 8 + font.width("iii")
    mouse(app, "mouse_down", x3, field.y + field.height / 2)
    mouse(app, "mouse_up", x3, field.y + field.height / 2)
    test.assert_eq(field.cursor, 3)
    typed(app, "x")
    test.assert_eq(field.text, "iiixWWW")
    app.draw()
    // Proportional wrapping in a TextArea: "iiii" fits where "WWWW" doesn't.
    area := ui.TextArea("iiii iiii WWWW WWWW", rows=4, columns=6, wrap=true)
    app.root = ui.Row([area, ui.Spacer()], padding=8)
    app.layout()
    rows := area.layout()
    test.assert_true(rows.length() >= 2)
    first: List = rows[0]
    test.assert_eq(first[0], 0)
    app.draw()
    app.close()
}

define test_list_item_icons() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    a := ui.ListItem("alpha", icon="no/such.png", data=1)
    lv := ui.ListView([a, ui.ListItem("beta"), "plain"], on_select=fn(i, it) { picked = it.str() })
    table := ui.Table(["Name", "n"], [[ui.ListItem("x.qk", icon="no/such.png"), 3]])
    app.root = ui.Column([lv, table], padding=8)
    app.layout()
    app.draw()                                    // a missing icon draws nothing, no error
    test.assert_true(a._failed)
    click(app, lv.x + 20, lv.y + 2 + 24 + 10)
    test.assert_eq(picked, "beta")
    test.assert_eq(a.str(), "alpha")
    test.assert_eq(a.data, 1)
    app.close()
}

define test_canvas() -> void {
    if not window.available() { return }
    app := new_app()
    app.theme = ui.light()
    clicks := []
    canvas := ui.Canvas(on_draw=fn(win, x, y, w, h) {
        win.rect(x, y, w, h, window.red())
        win.rect(x - 50, y, 30, 30, window.blue())        // clipped away
    }, on_event=fn(e) {
        if e.kind == "mouse_down" { clicks.append([e.x, e.y]) }
    }, width=100, height=60)
    app.root = ui.Column([canvas, ui.Spacer()], padding=20)
    app.layout()
    test.assert_eq(canvas.width, 360)
    test.assert_eq(canvas.height, 60)
    app.draw()
    test.assert_eq(app.win.pixel(canvas.x + 5, canvas.y + 5), 0xe63946)
    test.assert_true(app.win.pixel(canvas.x - 25, canvas.y + 5) != 0x3478f6)
    click(app, canvas.x + 10, canvas.y + 10)
    test.assert_eq(clicks, [[canvas.x + 10, canvas.y + 10]])
    app.close()
}

define test_animation() -> void {
    if not window.available() { return }
    test.assert_eq(ui.lerp(0, 100, 0.5), 50)
    test.assert_eq(ui.lerp(100, 0, 0.25), 75)
    test.assert_eq(ui.lerp(-10, 10, 1.0), 10)
    test.assert_eq(ui.ease("linear", 0.3), 0.3)
    test.assert_eq(ui.ease("in", 1.0), 1.0)
    test.assert_eq(ui.ease("out", 0.0), 0.0)
    test.assert_true(ui.ease("in", 0.5) < 0.5 and ui.ease("out", 0.5) > 0.5)
    test.assert_true(ui.ease("back", 0.9) > 1.0)                // overshoots
    app := new_app()
    app.root = ui.Column([ui.Label("x")])
    seen := []
    finished := false
    app.animate(60, fn(t) { seen.append(t) }, ease="linear", on_done=fn() { finished = true })
    test.assert_true(app.animating())
    app.step()
    window.sleep(30)
    app.step()
    window.sleep(50)
    app.step()
    test.assert_true(finished)
    test.assert_false(app.animating())
    last: Double = seen[seen.length() - 1]
    test.assert_eq(last, 1.0)
    test.assert_true(seen.length() >= 2)
    // A cancelled animation stops calling back.
    count := 0
    anim := app.animate(1000, fn(t) { count = count + 1 })
    app.step()
    anim.cancel()
    app.step()
    app.step()
    test.assert_eq(count, 1)
    // Duration 0: one step at 1.0.
    got := []
    app.animate(0, fn(t) { got.append(t) })
    app.step()
    test.assert_eq(got, [1.0])
    app.close()
}

define composed(app: ui.App, s: String, cursor: Int) -> void {
    e := ev("compose")
    e.text = s
    e.cursor = cursor
    app.dispatch(e)
}

// IME: the composition shows at the cursor without changing the text; the
// input method gets the keys (Backspace edits the composition, not the
// text; Tab doesn't move focus); the committed text is inserted.
define test_text_input_ime_composition() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.TextInput("ab")
    b := ui.TextInput()
    app.root = ui.Column([a, b], padding=8)
    app.layout()
    click_on(app, a)
    test.assert_true(a.focused)
    composed(app, "にほ", 2)
    test.assert_true(a.composing())
    test.assert_eq(a.text, "ab")
    key(app, "backspace")
    key(app, "tab")
    test.assert_eq(a.text, "ab")
    test.assert_true(a.focused)
    test.assert_true(app.step())                  // draws the composition inline
    typed(app, "日本")
    composed(app, "", 0)
    test.assert_false(a.composing())
    test.assert_eq(a.text, "ab日本")
    test.assert_eq(a.cursor, 4)
    key(app, "backspace")                         // keys edit the text again
    test.assert_eq(a.text, "ab日")
    app.close()
}

define test_text_area_ime_composition() -> void {
    if not window.available() { return }
    app := new_app()
    area := ui.TextArea("one\ntwo", rows=3)
    app.root = ui.Column([area], padding=8)
    app.layout()
    click_on(app, area)
    composed(app, "한", 1)
    test.assert_true(app.step())
    test.assert_eq(area.text, "one\ntwo")
    typed(app, "한")
    test.assert_false(area.composing())
    test.assert_true(area.text.endswith("한"))
    app.close()
}

define rtl_app() -> ui.App {
    path := system_font()
    if path == "" or not window.available() { return null }
    f := window.load_font(path, 16)
    if not f.covers("שלום") { return null }
    t := ui.light()
    t.font = f
    return ui.App("rtl", 400, 300, theme=t, headless=true)
}

// Right-to-left text in a TextInput: right-aligned, a click near the
// right edge puts the cursor at the start, Left moves forward through the
// text, selection and typing work.
define test_text_input_right_to_left() -> void {
    app := rtl_app()
    if app == null { return }
    input := ui.TextInput("שלום", columns=20)
    app.root = ui.Column([input], padding=8)
    app.layout()
    test.assert_true(app.step())
    click(app, input.x + input.width - 9, input.y + input.height / 2)
    test.assert_true(input.focused)
    test.assert_eq(input.cursor, 0)                          // the start of the text is on the right
    click(app, input.x + 9, input.y + input.height / 2)
    test.assert_eq(input.cursor, 4)                          // left of the (right-aligned) text: its end
    key(app, "home")
    key(app, "left")                                         // RTL: Left moves on through the text
    test.assert_eq(input.cursor, 1)
    key(app, "right")
    test.assert_eq(input.cursor, 0)
    key(app, "end")
    typed(app, " עולם")
    test.assert_eq(input.text, "שלום עולם")
    key(app, "home")
    e := ev("key_down")
    e.key = "end"
    e.shift = true
    app.dispatch(e)
    test.assert_eq(input.selected_text(), "שלום עולם")
    test.assert_true(app.step())                             // selection drawn from the visual layout
    app.close()
}

define test_text_area_right_to_left_rows() -> void {
    app := rtl_app()
    if app == null { return }
    area := ui.TextArea("abc\nשלום", rows=3, columns=20)
    app.root = ui.Column([area], padding=8)
    app.layout()
    test.assert_true(app.step())
    lh := app.theme.line()
    // Second row (Hebrew) is right-aligned: a click near the right edge is its start.
    click(app, area.x + area.width - 9, area.y + 6 + lh + lh / 2)
    test.assert_eq(area.cursor, 4)                           // index 4 = the start of "שלום"
    click(app, area.x + 9, area.y + 6 + lh / 2)
    test.assert_eq(area.cursor, 0)                           // the Latin row is unchanged
    app.close()
}

// Accessibility tree: roles, names (from text, Labels, placeholders,
// accessible_name), values and states; Spacers and hidden widgets left out.
define test_accessibility_tree() -> void {
    if not window.available() { return }
    app := new_app()
    name := ui.TextInput("Ada")
    note := ui.TextInput(placeholder="Search")
    icon := ui.Button("*")
    icon.accessible_name = "Preferences"
    hidden := ui.Button("Hidden")
    hidden.visible = false
    lv := ui.ListView(["one", ui.ListItem("two")], rows=2)
    lv.selected = 1
    app.root = ui.Column([
        ui.Row([ui.Label("Name"), name]),
        note,
        ui.Checkbox("Subscribe", checked=true),
        ui.Slider(0, 10, value=4),
        ui.Spacer(),
        lv,
        ui.Tabs(["General", "Advanced"], [ui.Label("one"), ui.Label("two")], selected=1),
        ui.Row([icon, hidden]),
    ], padding=8)
    app.layout()
    tree := app.accessibility()
    test.assert_eq(tree.role, "window")
    test.assert_eq(tree.name, "ui test")
    field := tree.find("Name", "textbox")
    test.assert_true(field != null)                          // named by the Label before it
    test.assert_eq(field.value, "Ada")
    test.assert_true(field.has("editable"))
    search := tree.find("Search", "textbox")
    test.assert_true(search != null)                         // named by its placeholder
    sub := tree.find("Subscribe", "checkbox")
    test.assert_true(sub.has("checked"))
    test.assert_eq(sub.widget.access_role(), "checkbox")
    slider := tree.find("", "slider")
    test.assert_eq(slider.value, "4")
    test.assert_true(tree.find("two", "listitem").has("selected"))
    test.assert_false(tree.find("one", "listitem").has("selected"))
    test.assert_true(tree.find("Advanced", "tab").has("selected"))
    test.assert_true(tree.find("two", "text") != null)       // the shown page
    test.assert_true(tree.find("one", "text") == null)       // the hidden one isn't
    test.assert_true(tree.find("Preferences", "button") != null)
    test.assert_true(tree.find("Hidden") == null)
    dump := tree.dump()
    test.assert_true(dump.contains("checkbox \"Subscribe\" [focusable, checked]"))
    test.assert_false(dump.contains("spacer"))
    app.close()
}

// on_access hears focus moves, value changes of the focused widget, and
// announcements.
define test_accessibility_events() -> void {
    if not window.available() { return }
    app := new_app()
    heard := []
    app.on_access = fn(ev) {
        e: ui.AccessEvent = ev
        heard.append(e.kind + " " + e.node.describe())
    }
    name := ui.TextInput()
    ok := ui.Button("OK")
    app.root = ui.Column([ui.Row([ui.Label("Name"), name]), ok], padding=8)
    app.layout()
    test.assert_true(app.step())
    test.assert_eq(heard, [])                                 // nothing focused yet
    click_on(app, name)
    app.step()
    typed(app, "Al")
    app.step()
    app.step()                                                // no change: nothing new
    key(app, "tab")
    app.step()
    app.announce("Saved")
    test.assert_eq(heard, ["focus textbox \"Name\" [focusable, focused, editable]",
                           "value textbox \"Name\" = \"Al\" [focusable, focused, editable]",
                           "focus button \"OK\" [focusable, focused]",
                           "announce alert \"Saved\""])
    app.close()
}

// Open menus and dropdown lists appear in the tree with their items.
define test_accessibility_menus_and_dropdowns() -> void {
    if not window.available() { return }
    app := new_app()
    file := ui.Menu([ui.MenuItem("New", shortcut="Ctrl+N"), ui.MenuItem("-"), ui.MenuItem("Save", enabled=false)])
    bar := ui.MenuBar(["File"], [file])
    dd := ui.Dropdown(["Small", "Large"])
    app.root = ui.Column([bar, dd, ui.Spacer(120)])
    app.layout()
    app.draw()
    tree := app.accessibility()
    test.assert_true(tree.find("File", "menuitem").has("collapsed"))
    test.assert_eq(tree.find("", "combobox").value, "Small")
    test.assert_true(tree.find("Small", "option") == null)      // closed: no options
    click(app, bar.x + 10, bar.y + 5)
    app.draw()
    tree = app.accessibility()
    test.assert_true(tree.find("File", "menuitem").has("expanded"))
    new_item := tree.find("New", "menuitem")
    test.assert_eq(new_item.description, "Ctrl+N")
    test.assert_true(tree.find("Save", "menuitem").has("disabled"))
    test.assert_true(tree.find("-") == null)                    // separators left out
    key(app, "escape")
    click_on(app, dd)
    tree = app.accessibility()
    test.assert_true(tree.find("Large", "option") != null)
    test.assert_true(tree.find("", "combobox").has("expanded"))
    app.close()
}

define access_do(app: ui.App, node: ui.AccessNode, action: String, text: String = "") -> void {
    e := ev("access")
    e.target = node.id
    e.action = action
    e.text = text
    app.dispatch(e)
}

// Ids stay the same across rebuilds of the tree (widgets and items), and
// are all different.
define test_accessibility_ids_are_stable() -> void {
    if not window.available() { return }
    app := new_app()
    lv := ui.ListView(["a", "b"], rows=2)
    ok := ui.Button("OK")
    app.root = ui.Column([lv, ok])
    app.layout()
    t1 := app.accessibility_with_ids()
    t2 := app.accessibility_with_ids()
    test.assert_eq(t1.find("OK", "button").id, t2.find("OK", "button").id)
    test.assert_eq(t1.find("b", "listitem").id, t2.find("b", "listitem").id)
    test.assert_true(t1.find("a", "listitem").id != t1.find("b", "listitem").id)
    test.assert_true(t1.find("OK", "button").id > 0)
    app.close()
}

// A screen reader's requests (access events) reach the widgets.
define test_accessibility_actions() -> void {
    if not window.available() { return }
    app := new_app()
    clicks := []
    btn := ui.Button("Go", on_click=fn() { clicks.append("go") })
    box := ui.Checkbox("Agree")
    field := ui.TextInput()
    slider := ui.Slider(0, 10, value=2)
    lv := ui.ListView(["a", "b", "c"], rows=3)
    tabs := ui.Tabs(["One", "Two"], [ui.Label("1"), ui.Label("2")])
    tree := ui.TreeView([ui.TreeNode("root", [ui.TreeNode("leaf")])])
    dd := ui.Dropdown(["S", "M", "L"])
    app.root = ui.Column([btn, box, ui.Row([ui.Label("Name"), field]), slider, lv, tabs, tree, dd])
    app.layout()
    t := app.accessibility_with_ids()
    access_do(app, t.find("Go", "button"), "invoke")
    test.assert_eq(clicks, ["go"])
    access_do(app, t.find("Agree", "checkbox"), "toggle")
    test.assert_true(box.checked)
    access_do(app, t.find("Name", "textbox"), "set_value", "Ada")
    test.assert_eq(field.text, "Ada")
    access_do(app, t.find("Name", "textbox"), "focus")
    test.assert_true(field.focused)
    access_do(app, t.find("", "slider"), "set_range", "7")
    test.assert_eq(slider.value, 7)
    access_do(app, t.find("c", "listitem"), "select")
    test.assert_eq(lv.selected, 2)
    access_do(app, t.find("Two", "tab"), "select")
    test.assert_eq(tabs.selected, 1)
    access_do(app, t.find("root", "treeitem"), "expand")
    t = app.accessibility_with_ids()
    test.assert_true(t.find("leaf", "treeitem") != null)
    access_do(app, t.find("", "combobox"), "set_value", "L")
    test.assert_eq(dd.selected, 2)
    // A target that no longer exists is ignored.
    gone := ev("access")
    gone.target = 999999
    gone.action = "invoke"
    app.dispatch(gone)
    test.assert_eq(clicks, ["go"])
    app.close()
}

define position_of(xs: List, want: String) -> Int {
    i := 0
    while i < xs.length() {
        v: String = xs[i]
        if v == want { return i }
        i = i + 1
    }
    return -1
}

// The flat form sent to the screen-reader bridge: parallel arrays,
// parents before children, node 0 the window.
define test_accessibility_flat_export() -> void {
    if not window.available() { return }
    app := new_app()
    app.root = ui.Column([ui.Checkbox("A", checked=true), ui.Slider(0, 10, value=3), ui.ListView(["x", "y"], rows=2)])
    app.layout()
    out := [[], [], [], [], [], [], [], [], []]
    app._a11y_flatten(app.accessibility_with_ids(), -1, out)
    ids: List = out[0]
    parents: List = out[1]
    roles: List = out[2]
    states: List = out[6]
    boxes: List = out[7]
    nums: List = out[8]
    n := ids.length()
    test.assert_true(n >= 6)
    test.assert_eq(parents.length(), n)
    test.assert_eq(boxes.length(), 4 * n)
    test.assert_eq(nums.length(), 4 * n)
    p0: Int = parents[0]
    test.assert_eq(p0, -1)
    test.assert_eq(roles[0], "window")
    i := 1
    while i < n {
        pi: Int = parents[i]
        test.assert_true(pi >= 0 and pi < i)          // parents come first
        i = i + 1
    }
    ci := position_of(roles, "checkbox")
    cs: Int = states[ci]
    test.assert_eq(cs % 16 >= 8, true)                // checked bit
    si := position_of(roles, "slider")
    smax: Int = nums[4 * si + 2]
    sval: Int = nums[4 * si + 3]
    test.assert_eq(smax, 10)
    test.assert_eq(sval, 3)
    app.close()
}

// For the screen reader, focus in a list-like widget is on its selected
// item; and focus that leaves for nothing and comes back isn't repeated.
define test_accessibility_focus_goes_to_selected_item() -> void {
    if not window.available() { return }
    app := new_app()
    tabs := ui.Tabs(["General", "Advanced"], [ui.Label("1"), ui.Label("2")])
    app.root = ui.Column([tabs])
    app.layout()
    app.focus_on(tabs)
    tree := app.accessibility_with_ids()
    tl := tree.find("", "tablist")
    test.assert_eq(ui._a11y_focus_item(tl).name, "General")
    tabs.select(1)
    tree = app._a11y_prepare()
    adv := tree.find("Advanced", "tab")
    test.assert_true(adv.has("focused"))                    // the item carries the focus...
    test.assert_false(tree.find("", "tablist").has("focused"))   // ...not the strip
    test.assert_eq(app._a11y_focus_id, adv.id)
    heard := []
    app.on_access = fn(ev) {
        e: ui.AccessEvent = ev
        heard.append(e.kind)
    }
    name := ui.TextInput()
    app.root = ui.Column([name])
    app.layout()
    app.focus_on(name)
    app.step()
    app.focus = null
    app.step()
    app.focus_on(name)
    app.step()
    test.assert_eq(heard, ["focus"])
    app.close()
}

// v1.11.0: run() draws a frame only when something happened.
define test_frames_only_when_something_happened() -> void {
    if not window.available() { return }
    app := new_app()
    app.root = ui.Column([ui.Button("one"), ui.TextInput()], padding=10)
    app.step(false)
    test.assert_true(app._drew)                    // the first frame
    app.step(false)
    test.assert_false(app._drew)                   // nothing happened: not drawn again
    keym(app, "x")                                 // (dispatched directly: marks nothing by itself)
    app.redraw()
    app.step(false)
    test.assert_true(app._drew)                    // redraw() asks for one
    e := ev("mouse_move")
    e.x = 20
    e.y = 20
    app._pending.append(e)
    app.step(false)
    test.assert_true(app._drew)                    // an event: drawn
    app.step()
    test.assert_true(app._drew)                    // step() called yourself: always drawn
    test.assert_eq(app._next_wake(), -1)           // nothing blinks: wait for events
    inp: ui.TextInput = app.root.children()[1]
    app.focus_on(inp)
    w := app._next_wake()
    test.assert_true(w >= 0 and w <= 530)          // a focused caret blinks
    app.close()
}

// A title bar of the program's own: root laid out under it, its buttons,
// and the window told where it drags.
define test_title_bar() -> void {
    if not window.available() { return }
    app := ui.App("My app", 500, 300, headless=true, title_bar=true)
    test.assert_true(app.win.borderless())
    b := ui.Button("OK")
    app.root = ui.Column([b], padding=0)
    app.layout()
    bar := app.title_bar
    test.assert_eq(bar.y, 0)
    test.assert_eq(bar.width, 500)
    test.assert_eq(b.y, bar.height)                              // root below the bar
    test.assert_eq(app.win.hit_at(100, 10), "drag")
    test.assert_eq(app.win.hit_at(480, 10), "")                  // the close button
    test.assert_eq(app.win.hit_at(100, 150), "")
    test.assert_eq(bar.button_at(500 - 10, 5), 2)
    test.assert_eq(bar.button_at(500 - 46 * 3 + 2, 5), 0)
    test.assert_eq(bar.button_at(100, 5), -1)
    app.draw()                                                   // the title drawn in the bar
    bg := app.win.pixel(20, bar.height / 2)
    inked := 0
    for yy in 6..bar.height - 6 {
        for xx in 220..280 {
            if app.win.pixel(xx, yy) != bg { inked = inked + 1 }
        }
    }
    test.assert_true(inked > 10)
    click_on(app, b)                                             // the root still gets clicks
    test.assert_true(b.focused)
    // A menu bar in it: not a drag area.
    bar.content = ui.MenuBar(["File"], [ui.Menu([ui.MenuItem("Quit")])])
    app.layout()
    test.assert_eq(app.win.hit_at(bar.content.x + 4, 10), "")
    // Close: the button, through on_close.
    closed := []
    bar.on_close = fn() { closed.append(1) }
    click(app, 500 - 20, 10)
    test.assert_eq(closed.length(), 1)
    test.assert_true(app.is_open())
    click(app, 500 - 20, 10)
    bar.on_close = null
    click(app, 500 - 20, 10)
    test.assert_false(app.is_open())
}

// The side-bar look: a click opens a folder (on_expand first, to fill it),
// rows from the top edge, a badge from `icon`.
define test_tree_view_flat() -> void {
    if not window.available() { return }
    app := new_app()
    folder := ui.TreeNode("src", [ui.TreeNode("…")])
    file := ui.TreeNode("main.qk")
    loads := []
    tree := ui.TreeView([folder, file], flat=true, row_height=22, indent=12, guides=true,
                        icon=fn(n) {
                            node: ui.TreeNode = n
                            return node.children.length() > 0 ? null : ["Q", window.hex("#a074c4")]
                        },
                        on_expand=fn(n) {
                            node: ui.TreeNode = n
                            loads.append(node.text)
                            node.children.clear()
                            node.add(ui.TreeNode("util.qk"))
                        }, expand=true)
    app.root = ui.Column([tree], padding=0, expand=true)
    app.layout()
    click(app, tree.x + 40, tree.y + 5)                         // row 0: the folder
    test.assert_true(folder.expanded)
    test.assert_eq(", ".join(loads), "src")
    test.assert_eq(tree.visible_nodes().length(), 3)
    click(app, tree.x + 40, tree.y + 22 + 5)                     // row 1: its child
    sel: ui.TreeNode = tree.selected
    test.assert_eq(sel.text, "util.qk")
    click(app, tree.x + 40, tree.y + 5)                         // the folder again: closed
    test.assert_false(folder.expanded)
    test.assert_eq(loads.length(), 1)
    test.assert_eq(tree.indent(), 12)
    app.draw()                                                   // flat: no box, the badge drawn
    test.assert_eq(app.win.pixel(tree.x + tree.width - 2, tree.y + tree.height - 2), app.win.pixel(tree.x + tree.width - 2, tree.y + tree.height - 3))
    key(app, "right")                                            // keyboard opening: on_expand too
    test.assert_true(folder.expanded)
    test.assert_eq(loads.length(), 2)
    app.close()
}

// Timers: run on the App's loop (step), every / after / cancel.
define test_timers() -> void {
    if not window.available() { return }
    app := new_app()
    ticks := []
    once := []
    t := app.every(1, fn() { ticks.append(1) })
    app.after(0, fn() { once.append(1) })
    window.sleep(5)
    app.step()
    window.sleep(5)
    app.step()
    test.assert_eq(ticks.length(), 2)
    test.assert_eq(once.length(), 1)                             // after: once only
    t.cancel()
    window.sleep(5)
    app.step()
    test.assert_eq(ticks.length(), 2)
    test.assert_true(app._next_wake() < 0)                       // nothing left to wake for
    app.close()
}

// on_key returning true: the key goes no further (an app's own shortcut).
define test_on_key_can_keep_the_key() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("abc")
    app.root = ui.Column([field], padding=8)
    app.on_key = fn(e) {
        if e.key == "backspace" and e.ctrl { return true }
        return false
    }
    app.layout()
    click_on(app, field)
    keym(app, "backspace", ctrl=true)                            // kept by the app
    test.assert_eq(field.text, "abc")
    keym(app, "backspace")                                       // not kept: the field's
    test.assert_eq(field.text, "ab")
    app.close()
}

// ───── v1.13.0: Palette (command palette / quick open) ─────
define test_palette_query_keys_pick() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("behind")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    words := ["apple", "banana", "cherry", "avocado"]
    queries := []
    picked := []
    cancelled := []
    pal := ui.Palette(on_query=fn(q) {
        queries.append(q)
        out := []
        for w in words {
            s: String = w
            if s.find(String(q)) >= 0 {
                at := s.find(String(q))
                marks := []
                k := 0
                while k < String(q).length() {
                    marks.append(at + k)
                    k = k + 1
                }
                out.append(ui.PaletteItem(s, detail="fruit", hint="F" + String(out.length() + 1), data=s, marks=marks))
            }
        }
        return out
    }, on_pick=fn(it) {
        item: ui.PaletteItem = it
        picked.append(item.data)
    }, on_cancel=fn() { cancelled.append(true) }, placeholder="Find a fruit")
    pal.show()
    test.assert_true(pal.is_open)
    test.assert_eq(pal.items.length(), 4)
    test.assert_eq(pal.selected, 0)
    app.draw()
    typed(app, "a")                                              // goes to the palette, not the field
    test.assert_eq(field.text, "behind")
    test.assert_eq(pal.query(), "a")
    test.assert_eq(pal.items.length(), 3)                        // apple, banana, avocado
    keym(app, "up")                                              // wraps to the last
    test.assert_eq(pal.selected, 2)
    keym(app, "down")
    test.assert_eq(pal.selected, 0)
    keym(app, "down")
    keym(app, "return")
    test.assert_eq(picked, ["banana"])
    test.assert_true(not pal.is_open)
    // Typed keys reach the field again once it's closed.
    typed(app, "!")
    test.assert_eq(field.text, "behind!")
    // Open with text; nothing matches; Escape cancels.
    pal.show("zz")
    test.assert_eq(pal.items.length(), 0)
    test.assert_eq(pal.selected, -1)
    app.draw()
    keym(app, "return")                                          // nothing to pick
    test.assert_true(pal.is_open)
    keym(app, "backspace")
    keym(app, "backspace")
    test.assert_eq(pal.items.length(), 4)
    keym(app, "escape")
    test.assert_true(not pal.is_open)
    test.assert_eq(cancelled.length(), 1)
    // A click on a row picks it; a click outside closes.
    pal.show()
    app.draw()
    mouse(app, "mouse_move", pal._px + 20, pal._ly + pal._rh * 2 + 2)
    test.assert_eq(pal.selected, 2)
    mouse(app, "mouse_down", pal._px + 20, pal._ly + pal._rh * 2 + 2)
    test.assert_eq(picked, ["banana", "cherry"])
    pal.show()
    app.draw()
    mouse(app, "mouse_down", 2, app.win.height() - 2)
    test.assert_true(not pal.is_open)
    test.assert_eq(cancelled.length(), 2)
    app.close()
}

define test_palette_scrolls_and_strings() -> void {
    if not window.available() { return }
    app := new_app()
    app.root = ui.Column([ui.Label("x")], padding=8)
    app.layout()
    many := []
    i := 0
    while i < 40 {
        many.append("item " + String(i))
        i = i + 1
    }
    got := []
    pal := ui.Palette(on_query=fn(q) { return many }, on_pick=fn(it) { got.append(String(it)) }, rows=5)
    pal.show()
    app.draw()
    keym(app, "pagedown")
    test.assert_eq(pal.selected, 5)
    test.assert_true(pal._top > 0)
    keym(app, "end", ctrl=true)
    test.assert_eq(pal.selected, 39)
    test.assert_eq(pal._top, 35)
    keym(app, "down")                                            // wraps to the top
    test.assert_eq(pal.selected, 0)
    test.assert_eq(pal._top, 0)
    keym(app, "return")
    test.assert_eq(got, ["item 0"])
    app.close()
}

// ───── v1.14.0: tooltips that depend on where the mouse is ─────
struct Halves : ui.Widget {
    define __init(self) -> void {
        super().__init()
        self.min_w = 100
        self.min_h = 20
    }

    define tooltip_at(self, px: Int, py: Int) -> String {
        return px < self.x + self.width / 2 ? "left" : ""
    }
}

define test_tooltip_at_a_point() -> void {
    if not window.available() { return }
    app := new_app()
    h := Halves()
    app.root = ui.Row([h, ui.Spacer()], padding=0)
    app.layout()
    app.tooltip_delay = 0
    mouse(app, "mouse_move", h.x + 5, h.y + 5)
    test.assert_eq(app._tip_text, "left")
    test.assert_true(app._tip == h)
    mouse(app, "mouse_move", h.x + h.width - 5, h.y + 5)       // "" there: no tooltip
    test.assert_true(app._tip == null)
    app.close()
}
