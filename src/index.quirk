---
Widgets for `window`: labels, buttons, checkboxes, text fields and areas,
sliders, lists and dropdowns, laid out in rows, columns and scroll views,
with mouse, keyboard, Tab focus, the clipboard and tooltips handled for
you.

  `ui.App(title, width, height)`   — a window with a widget tree
  `app.root = ui.Column([...])`    — what it shows
  `app.run()`                      — until the window closes

Widgets:
  `ui.Label(text)`
  `ui.Button(text, on_click=fn() => ...)`
  `ui.Checkbox(text, checked=false, on_change=fn(on) => ...)`
  `ui.TextInput(text="", placeholder="", on_change=fn(s) => ..., on_submit=fn(s) => ...)`
  `ui.TextArea(text="", rows=6, columns=40, on_change=fn(s) => ..., wrap=false)`
  `ui.RadioGroup(options, selected=0, on_change=fn(i, item) => ...)`
  `ui.Slider(min=0, max=100, value=50, on_change=fn(v) => ...)`
  `ui.ProgressBar(value=0, max=100, show_text=false)`
  `ui.ListView(items, on_select=fn(i, item) => ...)`
  `ui.TreeView([ui.TreeNode("src", [ui.TreeNode("main.qk")])], on_select=fn(node) => ...)`
  `ui.Table(["Name", "Size"], rows, on_select=fn(i, row) => ..., editable=false)`
  `ui.ColorPicker(color=, on_change=fn(c) => ...)`
  `ui.Dropdown(options, selected=0, on_change=fn(i, item) => ...)`
Menus:
  `ui.MenuBar(["File"], [ui.Menu([ui.MenuItem("Open", on_click=fn() => ...)])])`
  `widget.context_menu = ui.Menu([...])` — opened by a right-click
Dialogs: `ui.FileDialog(mode="open"|"save"|"folder", dir=, on_pick=fn(path) => ...).show()`
More: `ui.DatePicker(year, month, day)`, `ui.SplitView(a, b, vertical=)`,
  `ui.Toolbar([ui.ToolButton("Save", icon="save.png", on_click=)])`,
  `ui.StatusBar(["Ready", "Ln 1"])`; a MenuItem's `shortcut` works window-wide
Drag and drop: `source.on_drag = fn() => data`, `target.on_drop = fn(data) => ...`;
  `ui.ListView(items, reorderable=true)` reorders by dragging
Layout:
  `ui.Column(children, padding=, spacing=)` — stacked top to bottom
  `ui.Row(children, padding=, spacing=)`    — side by side
  `ui.Panel(children, ...)`                 — a Column on a raised surface
  `ui.ScrollView(content, height=200)`      — scrolls content that's taller
  `ui.Tabs(titles, pages)`                  — one page at a time under a row of tabs
  `ui.Spacer()`                             — takes the free space

Every widget can `expand` (take a share of its container's free
space), be hidden (`visible = false`) or disabled (`enabled = false`).
Read and change widgets directly: `input.text`, `box.checked`,
`slider.value`, `label.text = "Done"`.

Keyboard: Tab / Shift+Tab move the focus; Enter or Space press the
focused button or checkbox; arrows move sliders and lists. Text fields:
Shift + arrows select, Ctrl+A / C / X / V select all, copy, cut and
paste (system clipboard), Ctrl+Z / Ctrl+Y undo and redo, Ctrl + arrows
move by word; double-click selects a word.

Tooltips: `w.tooltip = "..."`, or inline `ui.tooltip(widget, "...")`.

Themes: `ui.dark()` (default) and `ui.light()`, or your own `ui.Theme`;
`theme.font = window.load_font("DejaVuSans.ttf", 15)` for TrueType text.
Custom drawing: `ui.Canvas(on_draw=fn(win, x, y, w, h) => ...)`.
Animation: `app.animate(ms, fn(t) => ..., ease="out")`, `ui.lerp`, `ui.ease`.
Icons in lists / tables: `ui.ListItem("name", icon="file.png")`.

@example
use ui

app := ui.App("Greeter", 360, 220)
name := ui.TextInput(placeholder="Your name")
greeting := ui.Label("")
app.root = ui.Column([
    ui.Label("What's your name?"),
    name,
    ui.Button("Greet", on_click=fn() { greeting.text = "Hello, " + name.text + "!" }),
    greeting,
], padding=16)
app.run()
---
from typing.primitives.string use { String }
from typing.collections.list use { List }
use window
use fs
use sys

// Ids for the accessibility tree (Widget.access_id, App item ids).
_a11y_counter := [0]

define _max(a: Int, b: Int) -> Int {
    if a > b { return a }
    return b
}

define _min(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}

define _clamp(v: Int, lo: Int, hi: Int) -> Int {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

---
Blend colour `a` toward `b` by `percent` (0 = a, 100 = b). For hover and
pressed shades.
---
define mix(a: Int, b: Int, percent: Int) -> Int {
    ca := window.channels(a)
    cb := window.channels(b)
    p := _clamp(percent, 0, 100)
    r := (ca[0] * (100 - p) + cb[0] * p) / 100
    g := (ca[1] * (100 - p) + cb[1] * p) / 100
    bl := (ca[2] * (100 - p) + cb[2] * p) / 100
    al := (ca[3] * (100 - p) + cb[3] * p) / 100
    return window.rgba(r, g, bl, al)
}

// ===== Themes =====

---
Colours and sizes every widget draws with. Make your own by changing a
copy of `ui.dark()` / `ui.light()`.
  `background` — the window; `surface` — panels; `text`, `muted` — text
  `accent` / `accent_text` — buttons, checks, sliders, selection
  `input` — text field / list background; `border`; `focus` — focus ring
  `scale` — text size multiplier (1 = 8x16 pixel characters)
  `font`  — a `window.Font` for all text (null: the built-in 8x16 font);
            `theme.font = window.load_font("DejaVuSans.ttf", 15)`
---
struct Theme {
    background: Int
    surface: Int
    text: Int
    muted: Int
    accent: Int
    accent_text: Int
    input: Int
    border: Int
    focus: Int
    scale: Int
    font: window.Font
    weights: Map             // weight ("medium", "semibold", "bold") → its Font (see set_weight)

    define __init(self, background: Int, surface: Int, text: Int, muted: Int, accent: Int, accent_text: Int, input: Int, border: Int, focus: Int, scale: Int = 1) -> void {
        self.background = background
        self.surface = surface
        self.text = text
        self.muted = muted
        self.accent = accent
        self.accent_text = accent_text
        self.input = input
        self.border = border
        self.focus = focus
        self.scale = scale
        self.font = null
        self.weights = {}
    }

    ---
    The font for text of `weight` ("medium", "semibold", "bold", or 500 /
    600 / 700): `theme.set_weight("bold", window.load_font("Inter-Bold.ttf", 13))`.
    Without one, "semibold" and "bold" are drawn twice, a pixel apart.
    ---
    define set_weight(self, weight: String, font: window.Font) -> void {
        self.weights[_weight_name(weight)] = font
    }

    --- The font for `weight` ("" or "regular": `font`). ---
    define font_for(self, weight: String = "") -> window.Font {
        w := _weight_name(weight)
        if w != "regular" and self.weights.has(w) { return self.weights[w] }
        return self.font
    }

    // A weight drawn twice (no font of its own).
    define _doubled(self, weight: String) -> Bool {
        w := _weight_name(weight)
        return (w == "semibold" or w == "bold") and not self.weights.has(w)
    }

    --- Height of one line of text. ---
    define line(self) -> Int {
        if self.font != null { return self.font.line_height }
        return 16 * self.scale
    }

    --- Width of one (average) character — for sizes given in characters. ---
    define char_w(self) -> Int {
        if self.font != null { return _max(1, self.font.width("n")) }
        return 8 * self.scale
    }

    --- Width in pixels of `s` (its longest line) in the theme's font (of `weight`). ---
    define text_w(self, s: String, weight: String = "") -> Int {
        extra := self._doubled(weight) ? 1 : 0
        f := self.font_for(weight)
        if f != null { return f.width(s) + extra }
        return window.text_width(s, self.scale) + extra
    }

    --- Draw `s` at (x, y) in the theme's font (of `weight`). ---
    define draw_text(self, win: window.Window, s: String, x: Int, y: Int, color: Int, weight: String = "") -> void {
        f := self.font_for(weight)
        win.text(s, x, y, color, scale=self.scale, font=f)
        if self._doubled(weight) { win.text(s, x + 1, y, color, scale=self.scale, font=f) }
    }

    --- `s` cut to fit `px` pixels. ---
    define fit(self, s: String, px: Int) -> String {
        if self.text_w(s) <= px { return s }
        if self.font == null { return s.substring(0, _max(0, px / self.char_w())) }
        n := s.length()
        while n > 0 and self.text_w(s.substring(0, n)) > px { n = n - 1 }
        return s.substring(0, n)
    }
}

// "bold", "700", "Bold" → "bold"; unknown → "regular".
define _weight_name(weight: String) -> String {
    w := weight.trim().lower()
    if w == "500" or w == "medium" { return "medium" }
    if w == "600" or w == "semibold" or w == "semi-bold" { return "semibold" }
    if w == "700" or w == "800" or w == "900" or w == "bold" { return "bold" }
    return "regular"
}

--- Light text on dark grey, blue accent. ---
define dark() -> Theme {
    return Theme(window.hex("#1e1f24"), window.hex("#2a2c33"), window.hex("#e8e8ec"), window.hex("#8b8d98"),
                 window.hex("#4c8dff"), window.hex("#ffffff"), window.hex("#15161a"), window.hex("#3d404a"),
                 window.hex("#7fb0ff"))
}

--- Dark text on white, blue accent. ---
define light() -> Theme {
    return Theme(window.hex("#f4f5f7"), window.hex("#ffffff"), window.hex("#1d1f24"), window.hex("#6b6f7a"),
                 window.hex("#2f6fde"), window.hex("#ffffff"), window.hex("#ffffff"), window.hex("#c9ccd3"),
                 window.hex("#2f6fde"))
}

// ===== Widget base =====

---
What every widget has. Layout fills in `x`, `y`, `width`, `height` each
frame; `min_w` / `min_h` are the size the widget asks for.
  `expand`   — take a share of the container's free space
  `visible`  — false: not drawn and takes no space
  `enabled`  — false: drawn dimmed, ignores input
  `hovered`, `focused`, `pressed` — set by the App
  `tooltip`  — text shown when the mouse rests on it ("" = none)
  `context_menu` — a `ui.Menu` opened by a right-click on it (or null)
  `on_drag`  — `fn() => data`: the widget can be dragged, carrying `data`
  `on_drop`  — `fn(data)`: something dragged can be dropped on it
To make your own widget, subclass it and override `measure`, `draw` and
`handle` (and `children` for containers).
---
struct Widget {
    x: Int
    y: Int
    width: Int
    height: Int
    min_w: Int
    min_h: Int
    expand: Bool
    visible: Bool
    enabled: Bool
    focusable: Bool
    hovered: Bool
    focused: Bool
    pressed: Bool
    tooltip: String
    takes_clicks: Bool
    takes_tab: Bool          // Tab / Shift+Tab are its own keys (a code editor), not "next widget"
    context_menu: Menu
    on_drag: Callable
    on_drop: Callable
    accessible_name: String
    accessible_description: String
    _a11y_label: String
    _a11y_id: Int

    define __init(self) -> void {
        self.x = 0
        self.y = 0
        self.width = 0
        self.height = 0
        self.min_w = 0
        self.min_h = 0
        self.expand = false
        self.visible = true
        self.enabled = true
        self.focusable = false
        self.hovered = false
        self.focused = false
        self.pressed = false
        self.tooltip = ""
        self.takes_clicks = false
        self.takes_tab = false
        self.context_menu = null
        self.on_drag = null
        self.on_drop = null
        self.accessible_name = ""
        self.accessible_description = ""
        self._a11y_label = ""
        self._a11y_id = 0
    }

    --- Work out `min_w` / `min_h` (containers measure their children first). ---
    define measure(self, t: Theme) -> void {
    }

    --- Take the box (x, y, width, height); containers place their children inside. ---
    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
    }

    --- Draw into `win` inside the widget's box. ---
    define draw(self, win: window.Window, t: Theme) -> void {
    }

    --- React to an event; true if the widget used it. ---
    define handle(self, e: window.Event) -> Bool {
        return false
    }

    --- True while an input method is composing text in this widget (it gets every key). ---
    ---
    In how many ms it must be drawn again though nothing happened (a
    blinking caret), -1 for never. The App redraws only when something
    happened — an event, an animation — or when this says so.
    ---
    define next_redraw(self) -> Int {
        return -1
    }

    define composing(self) -> Bool {
        return false
    }

    --- Child widgets (containers). ---
    define children(self) -> List {
        return []
    }

    // ----- accessibility (screen readers): see App.accessibility() -----

    ---
    What the widget is to assistive technology: "button", "checkbox",
    "textbox", "slider", "list", "tab", "menu"... — "group" for a
    container, "none" for something purely visual (a Spacer).
    ---
    define access_role(self) -> String {
        return "group"
    }

    ---
    Its accessible name — what a screen reader says: `accessible_name` if
    set, else what the widget shows (a button's text), else the text of a
    Label just before it, else its tooltip.
    ---
    define access_name(self) -> String {
        if self.accessible_name != "" { return self.accessible_name }
        n := self._a11y_name()
        if n != "" { return n }
        if self._a11y_label != "" { return self._a11y_label }
        return self._a11y_fallback()
    }

    define _a11y_name(self) -> String {
        return ""
    }

    define _a11y_fallback(self) -> String {
        return self.tooltip
    }

    --- Its value as text — a field's text, a slider's number — or "". ---
    define access_value(self) -> String {
        return ""
    }

    --- States: "focusable", "focused", "disabled", "checked", "selected", "expanded"... ---
    define access_states(self) -> List {
        out := []
        if self.focusable { out.append("focusable") }
        if self.focused { out.append("focused") }
        if not self.enabled { out.append("disabled") }
        self._a11y_states(out)
        return out
    }

    define _a11y_states(self, out: List) -> void {
    }

    // The nodes inside: one per visible child widget. A Label followed by
    // a focusable widget names it (when it has no name of its own).
    // Lists, tables, tabs and menus give nodes for their items instead.
    define _a11y_children(self) -> List {
        out := []
        label := ""
        for c in self.children() {
            cw: Widget = c
            if not cw.visible { continue }
            role := cw.access_role()
            if role == "text" {
                label = cw.access_name()
            } elif cw.focusable and label != "" {
                cw._a11y_label = label
                label = ""
            } else {
                label = ""
            }
            node := cw.access_node()
            if node != null { out.append(node) }
        }
        return out
    }

    --- This widget as an `AccessNode` (children included); null when hidden or purely visual. ---
    define access_node(self) -> AccessNode {
        if not self.visible { return null }
        role := self.access_role()
        if role == "none" { return null }
        kids := self._a11y_children()      // first: may name children from Labels
        n := AccessNode(role, self.access_name(), self.access_value(), self.x, self.y, self.width, self.height)
        n.description = self.accessible_description
        if n.description == "" { n.description = self._a11y_description() }
        n.states = self.access_states()
        n.widget = self
        n.id = self.access_id()
        n.children = kids
        return n
    }

    define _a11y_description(self) -> String {
        return ""
    }

    --- A number identifying the widget to assistive technology, the same for its whole life. ---
    define access_id(self) -> Int {
        if self._a11y_id == 0 {
            _a11y_counter[0] = _a11y_counter[0] + 1
            self._a11y_id = _a11y_counter[0]
        }
        return self._a11y_id
    }

    ---
    Do what a screen reader asks: `action` is "invoke", "toggle",
    "set_value" / "set_range" (`value`), "select", "expand" or "collapse",
    on this widget or one of its items (`node.index`, `node.data`). True if
    it did something.
    ---
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        return false
    }

    // [min, max, value] for sliders and progress bars; [] otherwise.
    define _a11y_range(self) -> List {
        return []
    }

    ---
    The tooltip for the point (px, py) — `tooltip` by default. A widget
    whose parts say different things (a code editor's error marks, a
    table's cells) overrides it; "" for none there.
    ---
    define tooltip_at(self, px: Int, py: Int) -> String {
        return self.tooltip
    }

    --- True if (px, py) is inside the widget's box. ---
    define contains(self, px: Int, py: Int) -> Bool {
        return px >= self.x and py >= self.y and px < self.x + self.width and py < self.y + self.height
    }

    // Popups (Dropdown): drawn above everything, offered mouse events first.
    define draw_popup(self, win: window.Window, t: Theme) -> void {
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return false
    }

    define popup_handle(self, e: window.Event) -> Bool {
        return false
    }

    // Keys for an open popup that takes them itself (Menu); true if used.
    define popup_key(self, e: window.Event) -> Bool {
        return false
    }

    define close_popup(self) -> void {
    }

    // Open this popup at (px, py) (Menu).
    define open_at(self, px: Int, py: Int) -> void {
    }

    // True for a MenuBar (its menus' shortcuts work window-wide).
    define is_menu_bar(self) -> Bool {
        return false
    }
}

---
Give `w` a tooltip and return it — for building trees inline:
`ui.tooltip(ui.Button("Save", on_click=save), "Write the file (Ctrl+S)")`.
---
define tooltip(w: Widget, text: String) -> Widget {
    w.tooltip = text
    return w
}

// Draw the focus ring around a widget.
define _focus_ring(win: window.Window, w: Widget, t: Theme) -> void {
    win.rect(w.x - 2, w.y - 2, w.width + 4, w.height + 4, t.focus, fill=false)
}

// Text colour for a widget that may be disabled.
define _ink(w: Widget, color: Int, t: Theme) -> Int {
    if not w.enabled { return mix(color, t.background, 55) }
    return color
}

// Clip rectangles in force while drawing ([x, y, w, h], innermost last):
// scroll views nest, so each one draws inside the intersection.
_clips := []

define _clip_push(win: window.Window, x: Int, y: Int, w: Int, h: Int) -> void {
    nx := x
    ny := y
    nr := x + w
    nb := y + h
    if _clips.length() > 0 {
        top: List = _clips[_clips.length() - 1]
        tx: Int = top[0]
        ty: Int = top[1]
        tw: Int = top[2]
        th: Int = top[3]
        nx = _max(nx, tx)
        ny = _max(ny, ty)
        nr = _min(nr, tx + tw)
        nb = _min(nb, ty + th)
    }
    cw := _max(0, nr - nx)
    ch := _max(0, nb - ny)
    _clips.append([nx, ny, cw, ch])
    win.clip(nx, ny, cw, ch)
}

define _clip_pop(win: window.Window) -> void {
    if _clips.length() > 0 { _clips.pop() }
    if _clips.length() == 0 {
        win.unclip()
    } else {
        top: List = _clips[_clips.length() - 1]
        tx: Int = top[0]
        ty: Int = top[1]
        tw: Int = top[2]
        th: Int = top[3]
        win.clip(tx, ty, tw, th)
    }
}

// Open popups (Dropdown lists), topmost last.
_popups := []
// Where the title bar ends (y), for popups placed under it (Palette); 0 without one.
_bar_bottom := [0]

// Selection highlight colour.
define _sel_color(w: Widget, t: Theme) -> Int {
    if w.focused { return mix(t.accent, t.input, 55) }
    return mix(t.border, t.input, 30)
}

// Letters, digits and _ make up words (double-click, Ctrl+arrows).
define _wordy(c: String) -> Bool {
    return c.is_alpha() or c.is_digit() or c == "_"
}

// ===== Layout =====

---
Children stacked top to bottom, each as wide as the column. Free height
goes to children with `expand = true`.
---
struct Column : Widget {
    padding: Int
    spacing: Int
    background: Bool
    fill: Int                // a colour to fill it with, no border (-1: none) — a side panel
    _kids: List

    define __init(self, children: List, padding: Int = 0, spacing: Int = 8, expand: Bool = false) -> void {
        super().__init()
        self._kids = children
        self.padding = padding
        self.spacing = spacing
        self.background = false
        self.fill = -1
        self.expand = expand
    }

    define children(self) -> List {
        return self._kids
    }

    --- Add a widget at the end. ---
    define add(self, w: Widget) -> void {
        self._kids.append(w)
    }

    define measure(self, t: Theme) -> void {
        mw := 0
        mh := 0
        n := 0
        for c in self._kids {
            if c.visible {
                c.measure(t)
                mw = _max(mw, c.min_w)
                mh = mh + c.min_h
                n = n + 1
            }
        }
        if n > 1 { mh = mh + self.spacing * (n - 1) }
        self.min_w = mw + 2 * self.padding
        self.min_h = mh + 2 * self.padding
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        inner_w := width - 2 * self.padding
        free := height - self.min_h
        k := 0
        for c in self._kids {
            if c.visible and c.expand { k = k + 1 }
        }
        cy := y + self.padding
        for c in self._kids {
            if c.visible {
                ch := c.min_h
                if c.expand and k > 0 and free > 0 { ch = ch + free / k }
                c.place(x + self.padding, cy, inner_w, ch)
                cy = cy + ch + self.spacing
            }
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.fill != -1 { win.rect(self.x, self.y, self.width, self.height, self.fill) }
        if self.background {
            win.rect(self.x, self.y, self.width, self.height, t.surface)
            win.rect(self.x, self.y, self.width, self.height, t.border, fill=false)
        }
        for c in self._kids {
            if c.visible { c.draw(win, t) }
        }
    }
}

---
Children side by side, each as tall as the row. Free width goes to
children with `expand = true`.
---
struct Row : Widget {
    padding: Int
    spacing: Int
    _kids: List

    define __init(self, children: List, padding: Int = 0, spacing: Int = 8, expand: Bool = false) -> void {
        super().__init()
        self._kids = children
        self.padding = padding
        self.spacing = spacing
        self.expand = expand
    }

    define children(self) -> List {
        return self._kids
    }

    --- Add a widget at the end. ---
    define add(self, w: Widget) -> void {
        self._kids.append(w)
    }

    define measure(self, t: Theme) -> void {
        mw := 0
        mh := 0
        n := 0
        for c in self._kids {
            if c.visible {
                c.measure(t)
                mw = mw + c.min_w
                mh = _max(mh, c.min_h)
                n = n + 1
            }
        }
        if n > 1 { mw = mw + self.spacing * (n - 1) }
        self.min_w = mw + 2 * self.padding
        self.min_h = mh + 2 * self.padding
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        inner_h := height - 2 * self.padding
        free := width - self.min_w
        k := 0
        for c in self._kids {
            if c.visible and c.expand { k = k + 1 }
        }
        cx := x + self.padding
        for c in self._kids {
            if c.visible {
                cw := c.min_w
                if c.expand and k > 0 and free > 0 { cw = cw + free / k }
                c.place(cx, y + self.padding, cw, inner_h)
                cx = cx + cw + self.spacing
            }
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        for c in self._kids {
            if c.visible { c.draw(win, t) }
        }
    }
}

--- A Column drawn on a raised surface with a border (12px padding by default). ---
define Panel(children: List, padding: Int = 12, spacing: Int = 8, expand: Bool = false) -> Column {
    col := Column(children, padding, spacing, expand)
    col.background = true
    return col
}

--- Empty space that takes whatever its container has left over. ---
struct Spacer : Widget {
    size: Int
    define access_role(self) -> String {
        return "none"
    }


    define __init(self, size: Int = 0) -> void {
        super().__init()
        self.size = size
        self.expand = size == 0
    }

    define measure(self, t: Theme) -> void {
        self.min_w = self.size
        self.min_h = self.size
    }
}

// ===== Label =====

---
Text. "\n" starts a new line. `color` -1 uses the theme's text colour;
`align` is "left", "center" or "right".
---
struct Label : Widget {
    text: String
    color: Int
    align: String
    weight: String           // "regular", "medium", "semibold", "bold" (see Theme.set_weight)
    define access_role(self) -> String {
        return "text"
    }

    define _a11y_name(self) -> String {
        return self.text
    }


    define __init(self, text: String, color: Int = -1, align: String = "left", weight: String = "") -> void {
        super().__init()
        self.text = text
        self.color = color
        self.align = align
        self.weight = weight
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.text_w(self.text, self.weight)
        lines := self.text.split("\n").length()
        self.min_h = _max(1, lines) * t.line()
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        c := self.color
        if c == -1 { c = t.text }
        tw := t.text_w(self.text, self.weight)
        tx := self.x
        if self.align == "center" { tx = self.x + (self.width - tw) / 2 }
        if self.align == "right" { tx = self.x + self.width - tw }
        ty := self.y + (self.height - self.min_h) / 2
        t.draw_text(win, self.text, tx, ty, _ink(self, c, t), weight=self.weight)
    }
}

// ===== Button =====

---
A push button. `on_click` (no arguments) runs when it's clicked, or
when it has the focus and Enter / Space is pressed. `color`: its
background (-1: the theme's accent); `text_color` (-1: accent_text);
`weight` of its text ("medium", "semibold", "bold").
---
struct Button : Widget {
    text: String
    on_click: Callable
    color: Int
    text_color: Int
    weight: String
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "invoke" or not self.enabled { return false }
        self.click()
        return true
    }

    define access_role(self) -> String {
        return "button"
    }

    define _a11y_name(self) -> String {
        return self.text
    }


    define __init(self, text: String, on_click: Callable = null, expand: Bool = false, color: Int = -1, text_color: Int = -1, weight: String = "") -> void {
        super().__init()
        self.text = text
        self.on_click = on_click
        self.focusable = true
        self.expand = expand
        self.color = color
        self.text_color = text_color
        self.weight = weight
    }

    --- Press the button from code. ---
    define click(self) -> void {
        if self.enabled and self.on_click != null { self.on_click() }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.text_w(self.text, self.weight) + 4 * t.char_w()
        self.min_h = t.line() + 12
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        base := self.color != -1 ? self.color : t.accent
        bg := base
        if not self.enabled {
            bg = mix(base, t.background, 60)
        } elif self.pressed {
            bg = mix(base, window.black(), 25)
        } elif self.hovered {
            bg = mix(base, window.white(), 15)
        }
        win.rect(self.x, self.y, self.width, self.height, bg)
        tw := t.text_w(self.text, self.weight)
        ink := self.text_color != -1 ? self.text_color : t.accent_text
        t.draw_text(win, self.text, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2,
                    _ink(self, ink, t), weight=self.weight)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.click() }
            return true
        }
        if e.kind == "key_down" and (e.key == "return" or e.key == "space" or e.key == "keypad_enter") {
            self.click()
            return true
        }
        return false
    }
}

// ===== Checkbox =====

---
A box that's ticked or not, with a label. `on_change(checked)` runs when
the user toggles it.
---
struct Checkbox : Widget {
    text: String
    checked: Bool
    on_change: Callable
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if (action != "toggle" and action != "invoke") or not self.enabled { return false }
        self.toggle()
        return true
    }

    define access_role(self) -> String {
        return "checkbox"
    }

    define _a11y_name(self) -> String {
        return self.text
    }

    define _a11y_states(self, out: List) -> void {
        if self.checked { out.append("checked") }
    }


    define __init(self, text: String, checked: Bool = false, on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.checked = checked
        self.on_change = on_change
        self.focusable = true
    }

    --- Flip it, as a click would (runs `on_change`). ---
    define toggle(self) -> void {
        if not self.enabled { return }
        self.checked = not self.checked
        if self.on_change != null { self.on_change(self.checked) }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.line() + t.char_w() + t.text_w(self.text)
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        bx := self.x
        by := self.y + (self.height - s) / 2
        win.rect(bx, by, s, s, t.input)
        border := t.border
        if self.hovered { border = t.accent }
        win.rect(bx, by, s, s, border, fill=false)
        if self.checked {
            m := _max(2, s / 4)
            win.rect(bx + m, by + m, s - 2 * m, s - 2 * m, _ink(self, t.accent, t))
        }
        win.text(self.text, bx + s + t.char_w(), self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.toggle() }
            return true
        }
        if e.kind == "key_down" and (e.key == "space" or e.key == "return") {
            self.toggle()
            return true
        }
        return false
    }
}

// ===== Text editing (TextInput, TextArea) =====

---
What TextInput and TextArea share: the text, a cursor and a selection,
and the editing keys.
  `text`             — the contents; set it to replace them
  `cursor`           — position (0 = before the first character)
  `has_selection()`, `selection_start()`, `selection_end()`,
  `selected_text()`, `select(start, end)`, `select_all()`
  `insert(s)`        — type `s` at the cursor (replacing the selection)
  `copy()`, `cut()`, `paste()` — through the system clipboard
  `undo()`, `redo()` — Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z
Keys: Shift + arrows / Home / End select, Ctrl+A selects everything,
Ctrl+C / X / V copy, cut and paste (Cmd on macOS), Ctrl + Left / Right
move by word, Ctrl + Backspace / Delete erase a word. Mouse: click to
place the cursor, drag or Shift+click to select, double-click selects a
word, triple-click a line.
---
struct TextEdit : Widget {
    text: String
    cursor: Int
    anchor: Int
    on_change: Callable
    single_line: Bool
    _dragging: Bool
    _cw: Int
    _lh: Int
    _undo: List
    _redo: List
    _typing: Bool
    _t: Theme
    _compose: String
    _compose_cursor: Int
    _compose_len: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "set_value" or not self.enabled { return false }
        self._snapshot(false)
        self.text = self.single_line ? value.replace("\n", " ") : value
        self.cursor = self.text.length()
        self.anchor = self.cursor
        self._changed()
        return true
    }

    define access_role(self) -> String {
        return "textbox"
    }

    define access_value(self) -> String {
        return self.text
    }

    define _a11y_states(self, out: List) -> void {
        out.append("editable")
        if not self.single_line { out.append("multiline") }
        if self.has_selection() { out.append("has_selection") }
    }


    // The caret blinks (every 530 ms) while it has the focus.
    define next_redraw(self) -> Int {
        if not self.focused { return -1 }
        return 530 - window.ticks() % 530
    }

    define __init(self, text: String = "", on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.cursor = text.length()
        self.anchor = self.cursor
        self.on_change = on_change
        self.single_line = false
        self._dragging = false
        self._undo = []
        self._redo = []
        self._typing = false
        self._t = null
        self._cw = 8
        self._lh = 16
        self.focusable = true
        self._compose = ""
        self._compose_cursor = 0
        self._compose_len = 0
    }

    define composing(self) -> Bool {
        return self._compose != ""
    }

    define _text_w(self, s: String) -> Int {
        if self._t == null { return s.length() * self._cw }
        return self._t.text_w(s)
    }

    // The line the cursor is on reads right to left (Hebrew, Arabic...).
    define _rtl_here(self) -> Bool {
        a := self._line_start(self.cursor)
        b := self._line_end(self.cursor)
        if b <= a { return false }
        return window.is_rtl(self.text.substring(a, b))
    }

    // `s` needs the font's visual layout (right-to-left or mixed text).
    define _bidi(self, s: String) -> Bool {
        return self._t != null and self._t.font != null and window.has_rtl(s)
    }

    // An input method's composition (Chinese, Japanese, Korean...), drawn
    // at the cursor — (x, y) is the top of its line: the text on the field's
    // background, underlined (thick under the part the input method has
    // selected), with its own cursor. Tells the system where it is, so the
    // candidate list opens beside it. Returns its width.
    define _draw_compose(self, win: window.Window, t: Theme, x: Int, y: Int) -> Int {
        lh := t.line()
        c := self._compose
        cw := self._text_w(c)
        win.rect(x, y, cw, lh, t.input)
        win.text(c, x, y, t.text, scale=t.scale, font=t.font)
        win.rect(x, y + lh - 1, cw, 1, t.text)
        at := _clamp(self._compose_cursor, 0, c.length())
        cx := x + self._text_w(c.substring(0, at))
        if self._compose_len > 0 {
            end := _clamp(at + self._compose_len, at, c.length())
            win.rect(cx, y + lh - 2, self._text_w(c.substring(at, end)), 2, t.accent)
        }
        win.rect(cx, y, _max(1, t.scale), lh, t.text)
        win.text_input_area(x, y, _max(1, cw), lh)
        return cw
    }

    define _changed(self) -> void {
        if self.on_change != null { self.on_change(self.text) }
    }

    // Remember the state before an edit. A run of typed characters is one
    // undo step; anything else (paste, delete, Enter) starts a new one.
    define _snapshot(self, typing: Bool) -> void {
        if typing and self._typing and self._undo.length() > 0 {
            return
        }
        self._undo.append([self.text, self.cursor, self.anchor])
        if self._undo.length() > 200 {
            rest := []
            i := 1
            while i < self._undo.length() {
                rest.append(self._undo[i])
                i = i + 1
            }
            self._undo = rest
        }
        self._redo = []
        self._typing = typing
    }

    define _restore(self, state: List) -> void {
        t: String = state[0]
        c: Int = state[1]
        a: Int = state[2]
        self.text = t
        self.cursor = c
        self.anchor = a
        self._fix()
        self._typing = false
        self._changed()
    }

    --- Undo the last edit (Ctrl+Z); false when there's nothing to undo. ---
    define undo(self) -> Bool {
        if self._undo.length() == 0 { return false }
        self._redo.append([self.text, self.cursor, self.anchor])
        state: List = self._undo.pop()
        self._restore(state)
        return true
    }

    --- Redo what `undo` took back (Ctrl+Y / Ctrl+Shift+Z). ---
    define redo(self) -> Bool {
        if self._redo.length() == 0 { return false }
        self._undo.append([self.text, self.cursor, self.anchor])
        state: List = self._redo.pop()
        self._restore(state)
        return true
    }

    // Keep cursor / anchor inside the text (after `text` was set from code).
    define _fix(self) -> void {
        n := self.text.length()
        self.cursor = _clamp(self.cursor, 0, n)
        self.anchor = _clamp(self.anchor, 0, n)
    }

    --- True when some text is selected. ---
    define has_selection(self) -> Bool {
        self._fix()
        return self.anchor != self.cursor
    }

    --- Where the selection starts (== `selection_end()` when nothing is selected). ---
    define selection_start(self) -> Int {
        self._fix()
        return _min(self.anchor, self.cursor)
    }

    --- Where the selection ends. ---
    define selection_end(self) -> Int {
        self._fix()
        return _max(self.anchor, self.cursor)
    }

    --- The selected text ("" if none). ---
    define selected_text(self) -> String {
        return self.text.substring(self.selection_start(), self.selection_end())
    }

    --- Select from `start` to `end` (the cursor goes to `end`). ---
    define select(self, start: Int, end: Int) -> void {
        n := self.text.length()
        self.anchor = _clamp(start, 0, n)
        self.cursor = _clamp(end, 0, n)
    }

    --- Select everything. ---
    define select_all(self) -> void {
        self.select(0, self.text.length())
    }

    // Remove the selected text; true if there was any.
    define _cut_selection(self) -> Bool {
        if not self.has_selection() { return false }
        a := self.selection_start()
        b := self.selection_end()
        self.text = self.text.substring(0, a) + self.text.substring(b, self.text.length())
        self.cursor = a
        self.anchor = a
        return true
    }

    --- Insert `s` at the cursor, as typing would (replaces the selection). ---
    define insert(self, s: String) -> void {
        self._snapshot(s.length() == 1 and s != "\n" and not self.has_selection() and s != " ")
        self._cut_selection()
        self._fix()
        c := self.cursor
        self.text = self.text.substring(0, c) + s + self.text.substring(c, self.text.length())
        self.cursor = c + s.length()
        self.anchor = self.cursor
        self._changed()
    }

    --- Copy the selection to the clipboard. ---
    define copy(self) -> void {
        if self.has_selection() { window.set_clipboard(self.selected_text()) }
    }

    --- Copy the selection to the clipboard and remove it. ---
    define cut(self) -> void {
        if self.has_selection() {
            self.copy()
            self._snapshot(false)
            self._cut_selection()
            self._changed()
        }
    }

    --- Insert what's on the clipboard. ---
    define paste(self) -> void {
        s := self._clean(window.clipboard())
        if s.length() > 0 { self.insert(s) }
    }

    // What pasted text becomes: line breaks turn into spaces on one line.
    define _clean(self, s: String) -> String {
        if self.single_line { return s.replace("\r\n", " ").replace("\n", " ").replace("\t", " ") }
        return s.replace("\r\n", "\n")
    }

    define _move(self, to: Int, grow: Bool) -> void {
        self._typing = false
        self.cursor = _clamp(to, 0, self.text.length())
        if not grow { self.anchor = self.cursor }
    }

    // Start of the word before i / end of the word after i.
    define _word_left(self, i: Int) -> Int {
        j := i
        while j > 0 and not _wordy(self.text.substring(j - 1, j)) { j = j - 1 }
        while j > 0 and _wordy(self.text.substring(j - 1, j)) { j = j - 1 }
        return j
    }

    define _word_right(self, i: Int) -> Int {
        n := self.text.length()
        j := i
        while j < n and not _wordy(self.text.substring(j, j + 1)) { j = j + 1 }
        while j < n and _wordy(self.text.substring(j, j + 1)) { j = j + 1 }
        return j
    }

    // Select the word (or run of other characters) at i.
    define _select_word(self, i: Int) -> void {
        n := self.text.length()
        if n == 0 { return }
        at := _clamp(i, 0, n - 1)
        if i == n and i > 0 { at = i - 1 }
        kind := _wordy(self.text.substring(at, at + 1))
        a := at
        b := at + 1
        while a > 0 and _wordy(self.text.substring(a - 1, a)) == kind { a = a - 1 }
        while b < n and _wordy(self.text.substring(b, b + 1)) == kind { b = b + 1 }
        self.select(a, b)
    }

    // Start / end of the line holding i ("\n"-separated).
    define _line_start(self, i: Int) -> Int {
        j := _clamp(i, 0, self.text.length())
        while j > 0 and self.text.substring(j - 1, j) != "\n" { j = j - 1 }
        return j
    }

    define _line_end(self, i: Int) -> Int {
        n := self.text.length()
        j := _clamp(i, 0, n)
        while j < n and self.text.substring(j, j + 1) != "\n" { j = j + 1 }
        return j
    }

    // Pixel width of text[a:b] in the theme's font (fixed-width without one).
    define _span_w(self, a: Int, b: Int) -> Int {
        if b <= a { return 0 }
        if self._t == null or self._t.font == null { return (b - a) * self._cw }
        return self._t.text_w(self.text.substring(a, b))
    }

    // The index in [a, b] whose x offset from `a` is nearest to `rel` px.
    define _index_near(self, a: Int, b: Int, rel: Int) -> Int {
        if rel <= 0 { return a }
        if self._t == null or self._t.font == null {
            return _clamp(a + (rel + self._cw / 2) / self._cw, a, b)
        }
        prev := 0
        i := a + 1
        while i <= b {
            w := self._span_w(a, i)
            if w >= rel {
                if rel - prev < w - rel { return i - 1 }
                return i
            }
            prev = w
            i = i + 1
        }
        return b
    }

    --- The text index under the point (px, py) (where a click puts the cursor). ---
    define index_at(self, px: Int, py: Int) -> Int {
        return 0
    }

    // Editing keys and mouse handling both widgets share; true if used.
    define _edit(self, e: window.Event) -> Bool {
        if e.kind == "compose" {
            self._compose = e.text
            self._compose_cursor = e.cursor
            self._compose_len = e.length
            return true
        }
        // While composing, the input method uses the keys (Backspace edits
        // the composition, Enter accepts it) — they don't edit the text.
        if self._compose != "" and (e.kind == "key_down" or e.kind == "key_up") and not e.ctrl and not e.meta {
            return true
        }
        if e.kind == "text" {
            self._compose = ""
            self.insert(e.text)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            i := self.index_at(e.x, e.y)
            if e.clicks >= 3 {
                self.select(self._line_start(i), self._line_end(i))
            } elif e.clicks == 2 {
                self._select_word(i)
            } else {
                self._move(i, e.shift)
                self._dragging = true
            }
            return true
        }
        if e.kind == "mouse_move" {
            if self._dragging { self.cursor = self.index_at(e.x, e.y) }
            return self._dragging
        }
        if e.kind == "mouse_up" {
            self._dragging = false
            return true
        }
        if e.kind != "key_down" { return false }
        k := e.key
        mod := e.ctrl or e.meta
        // In a line that reads right to left, Left moves on through the
        // text (the cursor goes the way the arrow points).
        if (k == "left" or k == "right") and self._rtl_here() {
            k = k == "left" ? "right" : "left"
        }
        if mod and (k == "y" or (k == "z" and e.shift)) {
            self.redo()
        } elif mod and k == "z" {
            self.undo()
        } elif mod and k == "a" {
            self.select_all()
        } elif mod and k == "c" {
            self.copy()
        } elif mod and k == "x" {
            self.cut()
        } elif mod and k == "v" {
            self.paste()
        } elif k == "left" {
            if self.has_selection() and not e.shift {
                self._move(self.selection_start(), false)
            } elif mod {
                self._move(self._word_left(self.cursor), e.shift)
            } else {
                self._move(self.cursor - 1, e.shift)
            }
        } elif k == "right" {
            if self.has_selection() and not e.shift {
                self._move(self.selection_end(), false)
            } elif mod {
                self._move(self._word_right(self.cursor), e.shift)
            } else {
                self._move(self.cursor + 1, e.shift)
            }
        } elif k == "backspace" {
            if self.has_selection() or self.cursor > 0 { self._snapshot(false) }
            if self._cut_selection() {
                self._changed()
            } elif self.cursor > 0 {
                start := self.cursor - 1
                if mod { start = self._word_left(self.cursor) }
                self.text = self.text.substring(0, start) + self.text.substring(self.cursor, self.text.length())
                self.cursor = start
                self.anchor = start
                self._changed()
            }
        } elif k == "delete" {
            if self.has_selection() or self.cursor < self.text.length() { self._snapshot(false) }
            if self._cut_selection() {
                self._changed()
            } elif self.cursor < self.text.length() {
                stop := self.cursor + 1
                if mod { stop = self._word_right(self.cursor) }
                self.text = self.text.substring(0, self.cursor) + self.text.substring(stop, self.text.length())
                self.anchor = self.cursor
                self._changed()
            }
        } else {
            return false
        }
        return true
    }
}

// ===== TextInput =====

---
A one-line text field. Type when it has the focus (click it or Tab to
it); editing, selection and copy / paste as described for `TextEdit`.
`on_change(text)` runs on every edit, `on_submit(text)` on Enter.
`columns` sets its width in characters.
---
struct TextInput : TextEdit {
    placeholder: String
    columns: Int
    on_submit: Callable
    _scroll: Int
    _voff: Int
    // A placeholder names a field nothing else names, and describes it.
    define _a11y_fallback(self) -> String {
        if self.placeholder != "" { return self.placeholder }
        return self.tooltip
    }

    define _a11y_description(self) -> String {
        return self.placeholder
    }


    define __init(self, text: String = "", placeholder: String = "", on_change: Callable = null, on_submit: Callable = null, columns: Int = 20) -> void {
        super().__init(text, on_change)
        self.placeholder = placeholder
        self.columns = columns
        self.on_submit = on_submit
        self.single_line = true
        self._scroll = 0
        self._voff = 0
    }

    define measure(self, t: Theme) -> void {
        self._t = t
        self._cw = t.char_w()
        self._lh = t.line()
        self.min_w = self.columns * t.char_w() + 16
        self.min_h = t.line() + 12
    }

    define index_at(self, px: Int, py: Int) -> Int {
        if self._bidi(self.text) {
            return self._t.font.index_at(self.text, px - self.x - 8 - self._voff)
        }
        return self._index_near(self._scroll, self.text.length(), px - self.x - 8)
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if self._edit(e) { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        n := self.text.length()
        if k == "home" or (k == "up" and not e.shift) {
            self._move(0, e.shift)
        } elif k == "end" or (k == "down" and not e.shift) {
            self._move(n, e.shift)
        } elif k == "return" or k == "keypad_enter" {
            if self.on_submit != null { self.on_submit(self.text) }
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        self._fix()
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        self._t = t
        avail := _max(1, self.width - 16)
        n := self.text.length()
        if n > 0 and self._bidi(self.text) {
            self._draw_bidi(win, t, avail)
            return
        }
        // Keep the cursor in view.
        if self.cursor < self._scroll { self._scroll = self.cursor }
        while self._scroll < self.cursor and self._span_w(self._scroll, self.cursor) > avail { self._scroll = self._scroll + 1 }
        self._scroll = _clamp(self._scroll, 0, _max(0, n - 1))
        // The last character that fits.
        end := self._index_near(self._scroll, n, avail)
        while end > self._scroll and self._span_w(self._scroll, end) > avail { end = end - 1 }
        ty := self.y + (self.height - t.line()) / 2
        if n == 0 {
            // (Focused too, behind the cursor: a palette's field always is.)
            if self.placeholder.length() > 0 {
                win.text(t.fit(self.placeholder, avail), self.x + 8, ty, t.muted, scale=t.scale, font=t.font)
            }
        } else {
            if self.has_selection() {
                a := _max(self.selection_start(), self._scroll)
                b := _min(self.selection_end(), end)
                if b > a {
                    sx := self.x + 8 + self._span_w(self._scroll, a)
                    win.rect(sx, ty, self._span_w(a, b), t.line(), _sel_color(self, t))
                }
            }
            win.text(self.text.substring(self._scroll, end), self.x + 8, ty, _ink(self, t.text, t), scale=t.scale, font=t.font)
        }
        if not self.focused { self._compose = "" }
        if self.focused {
            cx := self.x + 8 + self._span_w(self._scroll, self.cursor)
            if self._compose != "" {
                // Inline: the composition at the cursor, the rest after it.
                _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
                win.rect(cx, self.y + 1, _max(0, self.x + self.width - 1 - cx), self.height - 2, t.input)
                cw := self._draw_compose(win, t, cx, ty)
                if end > self.cursor {
                    win.text(self.text.substring(self.cursor, end), cx + cw, ty, _ink(self, t.text, t), scale=t.scale, font=t.font)
                }
                _clip_pop(win)
            } else {
                win.text_input_area(cx, ty, 1, t.line())
                if (window.ticks() / 530) % 2 == 0 { win.rect(cx, ty, _max(1, t.scale), t.line(), t.text) }
            }
        }
    }

    // Right-to-left or mixed text: the font lays the whole line out in
    // visual order; it's aligned right when it reads right to left and
    // shifted to keep the cursor in view (clipped to the field).
    define _draw_bidi(self, win: window.Window, t: Theme, avail: Int) -> void {
        f := t.font
        ty := self.y + (self.height - t.line()) / 2
        self._scroll = 0
        off := 0
        if window.is_rtl(self.text) { off = avail - f.width(self.text) }
        ccx := f.caret_x(self.text, self.cursor)
        if off + ccx > avail { off = avail - ccx }
        if off + ccx < 0 { off = -ccx }
        self._voff = off
        x0 := self.x + 8 + off
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        if self.has_selection() {
            for piece in f.selection(self.text, self.selection_start(), self.selection_end()) {
                pc: List = piece
                px: Int = pc[0]
                pw: Int = pc[1]
                win.rect(x0 + px, ty, pw, t.line(), _sel_color(self, t))
            }
        }
        win.text(self.text, x0, ty, _ink(self, t.text, t), scale=t.scale, font=f)
        if not self.focused { self._compose = "" }
        if self.focused {
            cx := x0 + ccx
            if self._compose != "" {
                self._draw_compose(win, t, cx, ty)
            } else {
                win.text_input_area(cx, ty, 1, t.line())
                if (window.ticks() / 530) % 2 == 0 { win.rect(cx, ty, _max(1, t.scale), t.line(), t.text) }
            }
        }
        _clip_pop(win)
    }
}

// ===== TextArea =====

---
Multi-line text. Enter starts a new line; Up / Down / Page Up / Page Down
move between lines, Home / End to the start / end of the line (with Ctrl:
of the text). Editing, selection and copy / paste as for `TextEdit`.
`rows` / `columns` set the size it asks for; it scrolls (wheel, or by
following the cursor) when the text is bigger. With `wrap=true` long
lines break at spaces to fit the width (and the keys move along the
wrapped lines) instead of scrolling sideways. `on_change(text)` runs on
every edit.
---
struct TextArea : TextEdit {
    rows: Int
    columns: Int
    wrap: Bool
    _top: Int
    _left: Int
    _goal: Int

    define __init(self, text: String = "", rows: Int = 6, columns: Int = 40, on_change: Callable = null, expand: Bool = false, wrap: Bool = false) -> void {
        super().__init(text, on_change)
        self.rows = rows
        self.columns = columns
        self.wrap = wrap
        self.expand = expand
        self._top = 0
        self._left = 0
        self._goal = -1
    }

    --- The text split into lines (at "\n"; wrapping doesn't count). ---
    define lines(self) -> List {
        return self.text.split("\n")
    }

    define measure(self, t: Theme) -> void {
        self._t = t
        self._cw = t.char_w()
        self._lh = t.line()
        self.min_w = self.columns * t.char_w() + 16
        self.min_h = self.rows * t.line() + 12
    }

    // A right-to-left row is drawn against the right edge.
    define _row_off(self, seg: String) -> Int {
        if not window.is_rtl(seg) { return 0 }
        return _max(0, self.width - 16 - self._t.font.width(seg))
    }

    define _shown_rows(self) -> Int {
        return _max(1, (self.height - 12) / self._lh)
    }

    define _shown_cols(self) -> Int {
        if self.width <= 0 { return self.columns }
        return _max(1, (self.width - 16) / self._cw)
    }

    --- The rows on screen as [start, end] text ranges ("\n" not included). ---
    define layout(self) -> List {
        out := []
        n := self.text.length()
        cols := self._shown_cols()
        avail := _max(1, self.width - 16)
        if self.width <= 0 { avail = cols * self._cw }
        s := 0
        while true {
            e := self._line_end(s)
            if self.wrap {
                pos := s
                while self._span_w(pos, e) > avail {
                    // The most that fits (at least one character).
                    brk := self._index_near(pos, e, avail)
                    while brk > pos + 1 and self._span_w(pos, brk) > avail { brk = brk - 1 }
                    if brk <= pos { brk = pos + 1 }
                    j := brk
                    while j > pos and self.text.substring(j - 1, j) != " " { j = j - 1 }
                    if j > pos { brk = j }
                    out.append([pos, brk])
                    pos = brk
                }
                out.append([pos, e])
            } else {
                out.append([s, e])
            }
            if e >= n { break }
            s = e + 1
        }
        return out
    }

    // The row holding index i. At a wrap point the index starts the next row.
    define _row_of(self, rows: List, i: Int) -> Int {
        r := 0
        while r < rows.length() {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            if i >= ra and i < rb { return r }
            if i == rb {
                if r + 1 >= rows.length() { return r }
                nxt: List = rows[r + 1]
                na: Int = nxt[0]
                if na != rb { return r }
            }
            r = r + 1
        }
        return _max(0, rows.length() - 1)
    }

    // Index at column `col` of row `r` (clamped to the row; a wrapped row
    // stops before its wrap point, which belongs to the next row).
    define _at_row(self, rows: List, r: Int, col: Int) -> Int {
        if r < 0 { return 0 }
        if r >= rows.length() { return self.text.length() }
        row: List = rows[r]
        ra: Int = row[0]
        rb: Int = row[1]
        last := rb - ra
        if r + 1 < rows.length() {
            nxt: List = rows[r + 1]
            na: Int = nxt[0]
            if na == rb and last > 0 { last = last - 1 }
        }
        return ra + _clamp(col, 0, last)
    }

    define index_at(self, px: Int, py: Int) -> Int {
        rows := self.layout()
        r := self._top + (py - self.y - 6) / self._lh
        if py < self.y + 6 { r = self._top }
        left := self._left
        if self.wrap { left = 0 }
        if r < 0 or r >= rows.length() { return self._at_row(rows, r, 0) }
        row: List = rows[r]
        ra: Int = row[0]
        rb: Int = row[1]
        if rb > ra and self._bidi(self.text.substring(ra, rb)) {
            seg := self.text.substring(ra, rb)
            return self._at_row(rows, r, self._t.font.index_at(seg, px - self.x - 8 - self._row_off(seg)))
        }
        idx := self._index_near(_min(ra + left, rb), rb, px - self.x - 8)
        return self._at_row(rows, r, idx - ra)
    }

    define _vertical(self, by: Int, grow: Bool) -> void {
        rows := self.layout()
        r := self._row_of(rows, self.cursor)
        row: List = rows[r]
        ra: Int = row[0]
        // The goal is a pixel offset, so the cursor stays above itself with
        // a proportional font.
        if self._goal < 0 { self._goal = self._span_w(ra, self.cursor) }
        target := r + by
        if target < 0 {
            self._move(0, grow)
        } elif target >= rows.length() {
            self._move(self.text.length(), grow)
        } else {
            trow: List = rows[target]
            tra: Int = trow[0]
            trb: Int = trow[1]
            self._move(self._at_row(rows, target, self._index_near(tra, trb, self._goal) - tra), grow)
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "wheel" {
            most := _max(0, self.layout().length() - self._shown_rows())
            self._top = _clamp(self._top - e.dy * 3, 0, most)
            return true
        }
        if e.kind == "key_down" and (e.key == "up" or e.key == "down" or e.key == "pageup" or e.key == "pagedown") {
            by := 1
            if e.key == "up" { by = -1 }
            if e.key == "pageup" { by = -self._shown_rows() }
            if e.key == "pagedown" { by = self._shown_rows() }
            self._vertical(by, e.shift)
            return true
        }
        self._goal = -1
        if self._edit(e) { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        mod := e.ctrl or e.meta
        if k == "home" or k == "end" {
            if mod {
                if k == "home" { self._move(0, e.shift) } else { self._move(self.text.length(), e.shift) }
            } else {
                rows := self.layout()
                r := self._row_of(rows, self.cursor)
                if k == "home" { self._move(self._at_row(rows, r, 0), e.shift) }
                else { self._move(self._at_row(rows, r, 1000000), e.shift) }
            }
        } elif k == "return" or k == "keypad_enter" {
            self.insert("\n")
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        self._fix()
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        self._t = t
        lh := t.line()
        shown := self._shown_rows()
        rows := self.layout()
        if self.wrap { self._left = 0 }
        // Follow the cursor.
        cr := self._row_of(rows, self.cursor)
        crow: List = rows[cr]
        cra: Int = crow[0]
        cc := self.cursor - cra
        if self._dragging or self.focused {
            if cr < self._top { self._top = cr }
            if cr >= self._top + shown { self._top = cr - shown + 1 }
            if not self.wrap {
                if cc < self._left { self._left = cc }
                while self._left < cc and self._span_w(cra + self._left, self.cursor) > self.width - 16 { self._left = self._left + 1 }
            }
        }
        self._top = _clamp(self._top, 0, _max(0, rows.length() - 1))
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        sa := self.selection_start()
        sb := self.selection_end()
        r := self._top
        while r < rows.length() and r < self._top + shown {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            ly := self.y + 6 + (r - self._top) * lh
            bseg := ""
            if rb > ra { bseg = self.text.substring(ra, rb) }
            if rb > ra and self._bidi(bseg) {
                // Right-to-left / mixed row: laid out by the font.
                bx := self.x + 8 + self._row_off(bseg)
                if sb > sa and _max(sa, ra) < _min(sb, rb) {
                    for piece in t.font.selection(bseg, _max(sa, ra) - ra, _min(sb, rb) - ra) {
                        pc: List = piece
                        px: Int = pc[0]
                        pw: Int = pc[1]
                        win.rect(bx + px, ly, pw, lh, _sel_color(self, t))
                    }
                }
                win.text(bseg, bx, ly, _ink(self, t.text, t), scale=t.scale, font=t.font)
                r = r + 1
                continue
            }
            if sb > sa {
                a := _max(sa, ra)
                b := _min(sb, rb)
                // A selected line break shows as one extra cell.
                extra := 0
                hard := r + 1 >= rows.length()
                if not hard {
                    nxt: List = rows[r + 1]
                    na: Int = nxt[0]
                    hard = na != rb
                }
                if hard and sb > rb and sa <= rb and rb < self.text.length() { extra = 1 }
                start := ra + self._left
                sa2 := _max(a, start)
                if b > sa2 or (extra == 1 and b >= sa2) {
                    x1 := self.x + 8 + self._span_w(start, sa2)
                    x2 := self.x + 8 + self._span_w(start, _max(b, sa2)) + extra * self._cw
                    if x2 > x1 { win.rect(x1, ly, x2 - x1, lh, _sel_color(self, t)) }
                }
            }
            if rb - ra > self._left {
                win.text(self.text.substring(ra + self._left, rb), self.x + 8, ly,
                         _ink(self, t.text, t), scale=t.scale, font=t.font)
            }
            r = r + 1
        }
        if not self.focused { self._compose = "" }
        if self.focused and cr >= self._top and cr < self._top + shown {
            cx := self.x + 8 + self._span_w(cra + self._left, self.cursor)
            crb0: Int = crow[1]
            if crb0 > cra and self._bidi(self.text.substring(cra, crb0)) {
                cseg := self.text.substring(cra, crb0)
                cx = self.x + 8 + self._row_off(cseg) + t.font.caret_x(cseg, self.cursor - cra)
            }
            cy := self.y + 6 + (cr - self._top) * lh
            if self._compose != "" {
                // Inline: the composition at the cursor, the rest of the row after it.
                win.rect(cx, cy, _max(0, self.x + self.width - 1 - cx), lh, t.input)
                cw := self._draw_compose(win, t, cx, cy)
                crb: Int = crow[1]
                if crb > self.cursor {
                    win.text(self.text.substring(self.cursor, crb), cx + cw, cy, _ink(self, t.text, t), scale=t.scale, font=t.font)
                }
            } else {
                win.text_input_area(cx, cy, 1, lh)
                if (window.ticks() / 530) % 2 == 0 { win.rect(cx, cy, _max(1, t.scale), lh, t.text) }
            }
        }
        _clip_pop(win)
        // Scroll indicator when there are more rows than fit.
        if rows.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / rows.length())
            most := _max(1, rows.length() - shown)
            by := self.y + 2 + (track - bar) * _min(self._top, most) / most
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Slider =====

---
Pick a number between `min` and `max` by dragging (or with the arrow
keys, by `step`). `on_change(value)` runs when it moves.
---
struct Slider : Widget {
    min: Int
    max: Int
    value: Int
    step: Int
    on_change: Callable
    define _a11y_range(self) -> List {
        return [self.min, self.max, self.value]
    }

    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if (action != "set_range" and action != "set_value") or not self.enabled { return false }
        self.set(Int(value))
        return true
    }

    define access_role(self) -> String {
        return "slider"
    }

    define access_value(self) -> String {
        return String(self.value)
    }

    define _a11y_description(self) -> String {
        return String(self.min) + " to " + String(self.max)
    }


    define __init(self, min: Int = 0, max: Int = 100, value: Int = 50, on_change: Callable = null, step: Int = 1) -> void {
        super().__init()
        self.min = min
        self.max = max
        self.value = _clamp(value, min, max)
        self.step = step
        self.on_change = on_change
        self.focusable = true
    }

    --- Set the value (clamped to min..max); runs `on_change` if it changed. ---
    define set(self, v: Int) -> void {
        nv := _clamp(v, self.min, self.max)
        if nv != self.value {
            self.value = nv
            if self.on_change != null { self.on_change(nv) }
        }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 8
    }

    define _from_x(self, px: Int) -> void {
        span := _max(1, self.width - 16)
        rel := _clamp(px - self.x - 8, 0, span)
        self.set(self.min + (rel * (self.max - self.min) + span / 2) / span)
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_move" and self.pressed {
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_up" {
            self.pressed = false
            return true
        }
        if e.kind == "key_down" {
            if e.key == "left" or e.key == "down" {
                self.set(self.value - self.step)
                return true
            }
            if e.key == "right" or e.key == "up" {
                self.set(self.value + self.step)
                return true
            }
            if e.key == "home" {
                self.set(self.min)
                return true
            }
            if e.key == "end" {
                self.set(self.max)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        cy := self.y + self.height / 2
        span := _max(1, self.width - 16)
        range := _max(1, self.max - self.min)
        kx := self.x + 8 + (self.value - self.min) * span / range
        win.rect(self.x + 8, cy - 2, span, 4, t.border)
        win.rect(self.x + 8, cy - 2, kx - self.x - 8, 4, _ink(self, t.accent, t))
        knob := t.text
        if self.pressed or self.hovered { knob = t.accent }
        win.circle(kx, cy, _max(6, self.height / 3), _ink(self, knob, t))
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== RadioGroup =====

---
One choice out of `options` (anything with `.str()`), shown as a column
of round buttons. Click one, or Up / Down (Left / Right) when it has the
focus. `selected` is the index (-1 = none); `on_change(index, item)` runs
when it changes.
---
struct RadioGroup : Widget {
    options: List
    selected: Int
    on_change: Callable
    _row_h: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "select" or node.index < 0 or not self.enabled { return false }
        self.select(node.index)
        return true
    }

    define access_role(self) -> String {
        return "radiogroup"
    }

    define access_value(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return String(self.options[self.selected])
    }

    define _a11y_children(self) -> List {
        out := []
        n := self.options.length()
        i := 0
        while i < n {
            h := n > 0 ? self.height / n : 0
            item := AccessNode("radio", String(self.options[i]), "", self.x, self.y + i * h, self.width, h)._item(self, i)
            if i == self.selected { item.states.append("checked") }
            out.append(item)
            i = i + 1
        }
        return out
    }


    define __init(self, options: List, selected: Int = 0, on_change: Callable = null) -> void {
        super().__init()
        self.options = options
        self.selected = _clamp(selected, -1, options.length() - 1)
        self.on_change = on_change
        self._row_h = 24
        self.focusable = true
    }

    --- The chosen option as text ("" when none). ---
    define text(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return self.options[self.selected].str()
    }

    --- Choose option `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.options.length() == 0 or not self.enabled { return }
        ni := _clamp(i, 0, self.options.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.options[ni]) }
        }
    }

    define measure(self, t: Theme) -> void {
        self._row_h = t.line() + 8
        widest := 0
        for o in self.options { widest = _max(widest, t.text_w(o.str())) }
        self.min_w = t.line() + t.char_w() + widest
        self.min_h = _max(1, self.options.length()) * self._row_h
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y) / self._row_h
            if row >= 0 and row < self.options.length() { self.select(row) }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" {
            if e.key == "down" or e.key == "right" {
                self.select(self.selected + 1)
                return true
            }
            if e.key == "up" or e.key == "left" {
                self.select(_max(0, self.selected - 1))
                return true
            }
            if e.key == "home" {
                self.select(0)
                return true
            }
            if e.key == "end" {
                self.select(self.options.length() - 1)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        r := s / 2
        i := 0
        while i < self.options.length() {
            ry := self.y + i * self._row_h
            cx := self.x + r
            cy := ry + self._row_h / 2
            ring := t.border
            if self.hovered { ring = t.accent }
            win.circle(cx, cy, r, t.input)
            win.circle(cx, cy, r, ring, fill=false)
            if i == self.selected { win.circle(cx, cy, _max(2, r / 2), _ink(self, t.accent, t)) }
            win.text(self.options[i].str(), self.x + s + t.char_w(), cy - t.line() / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
            i = i + 1
        }
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== ProgressBar =====

---
How far along something is: `value` out of `max` (clamped), drawn as a
filled bar. `show_text` adds the percentage. Set `value` as work
progresses.
---
struct ProgressBar : Widget {
    value: Int
    max: Int
    show_text: Bool
    define _a11y_range(self) -> List {
        return [0, self.max, self.value]
    }

    define access_role(self) -> String {
        return "progressbar"
    }

    define access_value(self) -> String {
        if self.max <= 0 { return String(self.value) }
        return String(self.value * 100 / self.max) + "%"
    }


    define __init(self, value: Int = 0, max: Int = 100, show_text: Bool = false, expand: Bool = false) -> void {
        super().__init()
        self.value = value
        self.max = max
        self.show_text = show_text
        self.expand = expand
    }

    --- Progress from 0 to 100. ---
    define percent(self) -> Int {
        if self.max <= 0 { return 0 }
        return _clamp(self.value * 100 / self.max, 0, 100)
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        fill := (self.width - 2) * self.percent() / 100
        if fill > 0 { win.rect(self.x + 1, self.y + 1, fill, self.height - 2, _ink(self, t.accent, t)) }
        win.rect(self.x, self.y, self.width, self.height, t.border, fill=false)
        if self.show_text {
            label := self.percent().str() + "%"
            tw := t.text_w(label)
            win.text(label, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2, t.text, scale=t.scale, font=t.font)
        }
    }
}

// ===== ListItem (an entry with an icon) =====

---
An entry for a ListView or a Table cell with an `icon` (an image file,
drawn at the text's height) before its `text`; `data` keeps anything you
want with it. Its `.str()` is `text`, so sorting and `on_select` work as
with plain strings.
---
struct ListItem {
    text: String
    icon: String
    data: Any
    _img: window.Image
    _failed: Bool

    define __init(self, text: String, icon: String = "", data: Any = null) -> void {
        self.text = text
        self.icon = icon
        self.data = data
        self._img = null
        self._failed = false
    }

    define __str(self) -> String {
        return self.text
    }

    // Draw the icon and text from (x, y) in a row `h` tall, `maxw` wide.
    define draw(self, win: window.Window, t: Theme, x: Int, y: Int, h: Int, maxw: Int, color: Int) -> void {
        tx := x
        if self.icon.length() > 0 {
            if self._img == null and not self._failed {
                try {
                    self._img = win.load_image(self.icon)
                } catch (window.WindowError) {
                    self._failed = true
                }
            }
            sz := _min(h - 4, t.line())
            if self._img != null { win.image(self._img, x, y + (h - sz) / 2, width=sz, height=sz) }
            tx = x + sz + t.char_w() / 2
        }
        win.text(t.fit(self.text, maxw - (tx - x)), tx, y + (h - t.line()) / 2, color, scale=t.scale, font=t.font)
    }
}

// Draw a list / table entry: a ListItem with its icon, anything else as text.
define _draw_entry(win: window.Window, t: Theme, value: Any, x: Int, y: Int, h: Int, maxw: Int, color: Int) -> void {
    if value != null and type(value) == "ListItem" {
        li: ListItem = value
        li.draw(win, t, x, y, h, maxw, color)
        return
    }
    label := "None"
    if value != null { label = value.str() }
    win.text(t.fit(label, maxw), x, y + (h - t.line()) / 2, color, scale=t.scale, font=t.font)
}

// ===== ListView =====

---
A scrollable list of items (anything with `.str()`), one selectable.
`on_select(index, item)` runs when the selection changes; `selected` is
the index (-1 = none). `rows` sets how many rows it asks room for.
---
struct ListView : Widget {
    items: List
    selected: Int
    rows: Int
    on_select: Callable
    reorderable: Bool
    on_reorder: Callable
    _top: Int
    _press: Int
    _drop: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "select" or node.index < 0 or not self.enabled { return false }
        self.select(node.index)
        return true
    }

    define access_role(self) -> String {
        return "list"
    }

    define access_value(self) -> String {
        if self.selected < 0 or self.selected >= self.items.length() { return "" }
        return _entry_text(self.items[self.selected])
    }

    define _a11y_children(self) -> List {
        out := []
        i := 0
        while i < self.items.length() {
            item := AccessNode("listitem", _entry_text(self.items[i]), "", self.x, self.y, self.width, 0)._item(self, i)
            if i == self.selected { item.states.append("selected") }
            out.append(item)
            i = i + 1
        }
        return out
    }


    define __init(self, items: List, on_select: Callable = null, rows: Int = 6, expand: Bool = false, reorderable: Bool = false, on_reorder: Callable = null) -> void {
        super().__init()
        self.items = items
        self.selected = -1
        self.rows = rows
        self.on_select = on_select
        self.reorderable = reorderable
        self.on_reorder = on_reorder
        self._top = 0
        self._press = -1
        self._drop = -1
        self.focusable = true
        self.expand = expand
    }

    --- Move item `src` to position `dst` (both indices into `items`). ---
    define move_item(self, src: Int, dst: Int) -> void {
        n := self.items.length()
        if src < 0 or src >= n or dst < 0 or dst >= n or src == dst { return }
        item := self.items[src]
        rest := []
        i := 0
        while i < n {
            if i != src { rest.append(self.items[i]) }
            i = i + 1
        }
        out := []
        i = 0
        while i < rest.length() {
            if i == dst { out.append(item) }
            out.append(rest[i])
            i = i + 1
        }
        if dst >= rest.length() { out.append(item) }
        self.items.clear()
        for v in out { self.items.append(v) }
        if self.selected == src { self.selected = dst }
        if self.on_reorder != null { self.on_reorder(src, dst) }
    }

    define _row_at_y(self, py: Int) -> Int {
        return _clamp(self._top + (py - self.y - 2) / self._row_h(), 0, _max(0, self.items.length() - 1))
    }

    define _row_h(self) -> Int {
        return 24
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - 4) / self._row_h())
    }

    --- Select row `i` (clamped); runs `on_select` if it changed. ---
    define select(self, i: Int) -> void {
        if self.items.length() == 0 { return }
        ni := _clamp(i, 0, self.items.length() - 1)
        if ni < self._top { self._top = ni }
        if ni >= self._top + self._shown() { self._top = ni - self._shown() + 1 }
        if ni != self.selected {
            self.selected = ni
            if self.on_select != null { self.on_select(ni, self.items[ni]) }
        }
    }

    define measure(self, t: Theme) -> void {
        widest := 10
        for it in self.items { widest = _max(widest, t.text_w(it.str())) }
        self.min_w = _min(widest, 60 * t.char_w()) + 16
        self.min_h = self.rows * self._row_h() + 4
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 3 {             // (for a context menu: no on_select)
            row := (e.y - self.y - 2) / self._row_h()
            if row >= 0 and self._top + row < self.items.length() { self.selected = self._top + row }
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y - 2) / self._row_h()
            if row >= 0 and self._top + row < self.items.length() {
                self.select(self._top + row)
                self._press = self._top + row
            }
            return true
        }
        if e.kind == "mouse_move" and self.reorderable and self._press >= 0 and e.left {
            self._drop = self._row_at_y(e.y)
            return true
        }
        if e.kind == "mouse_up" {
            if self.reorderable and self._press >= 0 and self._drop >= 0 and self._drop != self._press {
                self.move_item(self._press, self._drop)
            }
            self._press = -1
            self._drop = -1
            return true
        }
        if e.kind == "wheel" {
            most := _max(0, self.items.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind == "key_down" {
            if e.key == "down" {
                self.select(self.selected + 1)
                return true
            }
            if e.key == "up" {
                self.select(_max(0, self.selected - 1))
                return true
            }
            if e.key == "home" {
                self.select(0)
                return true
            }
            if e.key == "end" {
                self.select(self.items.length() - 1)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        rh := self._row_h()
        shown := self._shown()
        most := _max(0, self.items.length() - shown)
        if self._top > most { self._top = most }
        i := self._top
        while i < self.items.length() and i < self._top + shown {
            ry := self.y + 2 + (i - self._top) * rh
            ink := t.text
            if i == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            }
            _draw_entry(win, t, self.items[i], self.x + 8, ry, rh, self.width - 16, _ink(self, ink, t))
            i = i + 1
        }
        // Where a dragged row would land.
        if self._drop >= 0 and self._drop != self._press and self._drop >= self._top and self._drop < self._top + shown {
            ly := self.y + 2 + (self._drop - self._top) * rh
            if self._drop > self._press { ly = ly + rh }
            win.rect(self.x + 2, ly - 1, self.width - 4, 2, t.focus)
        }
        // Scroll indicator when not everything fits.
        if self.items.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / self.items.length())
            by := self.y + 2 + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== SplitView =====

---
Two widgets side by side (or stacked: `vertical=true`) with a divider
you drag to share the space. `ratio` is the first pane's share in
percent; `min_size` the smallest a pane gets (pixels). It takes its
container's free space (`expand`) unless told otherwise.
---
struct SplitView : Widget {
    first: Widget
    second: Widget
    vertical: Bool
    ratio: Int
    min_size: Int
    on_change: Callable
    _drag: Bool

    define __init(self, first: Widget, second: Widget, vertical: Bool = false, ratio: Int = 50, min_size: Int = 40, expand: Bool = true, on_change: Callable = null) -> void {
        super().__init()
        self.first = first
        self.second = second
        self.vertical = vertical
        self.ratio = _clamp(ratio, 0, 100)
        self.min_size = min_size
        self.expand = expand
        self.on_change = on_change
        self._drag = false
        self.takes_clicks = true
    }

    define children(self) -> List {
        return [self.first, self.second]
    }

    define _bar(self) -> Int {
        return 6
    }

    define _span(self) -> Int {
        if self.vertical { return self.height }
        return self.width
    }

    // Size of the first pane in pixels.
    define _first_px(self) -> Int {
        room := self._span() - self._bar()
        px := room * self.ratio / 100
        lo := _min(self.min_size, room / 2)
        return _clamp(px, lo, _max(lo, room - lo))
    }

    define measure(self, t: Theme) -> void {
        self.first.measure(t)
        self.second.measure(t)
        if self.vertical {
            self.min_w = _max(self.first.min_w, self.second.min_w)
            self.min_h = 2 * self.min_size + self._bar()
        } else {
            self.min_w = 2 * self.min_size + self._bar()
            self.min_h = _max(self.first.min_h, self.second.min_h)
        }
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        a := self._first_px()
        b := self._bar()
        if self.vertical {
            self.first.place(x, y, width, a)
            self.second.place(x, y + a + b, width, _max(0, height - a - b))
        } else {
            self.first.place(x, y, a, height)
            self.second.place(x + a + b, y, _max(0, width - a - b), height)
        }
    }

    define _on_bar(self, px: Int, py: Int) -> Bool {
        a := self._first_px()
        if self.vertical { return py >= self.y + a and py < self.y + a + self._bar() }
        return px >= self.x + a and px < self.x + a + self._bar()
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 and self._on_bar(e.x, e.y) {
            self._drag = true
            return true
        }
        if e.kind == "mouse_move" and self._drag {
            pos := e.x - self.x - self._bar() / 2
            if self.vertical { pos = e.y - self.y - self._bar() / 2 }
            room := _max(1, self._span() - self._bar())
            nr := _clamp(pos * 100 / room, 0, 100)
            if nr != self.ratio {
                self.ratio = nr
                if self.on_change != null { self.on_change(nr) }
            }
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = false
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        _clip_push(win, self.first.x, self.first.y, self.first.width, self.first.height)
        if self.first.visible { self.first.draw(win, t) }
        _clip_pop(win)
        _clip_push(win, self.second.x, self.second.y, self.second.width, self.second.height)
        if self.second.visible { self.second.draw(win, t) }
        _clip_pop(win)
        a := self._first_px()
        bar := t.border
        if self._drag or self.hovered { bar = t.accent }
        if self.vertical {
            win.rect(self.x, self.y + a + self._bar() / 2 - 1, self.width, 2, bar)
        } else {
            win.rect(self.x + a + self._bar() / 2 - 1, self.y, 2, self.height, bar)
        }
    }
}

// ===== Toolbar / StatusBar =====

---
A button for a `ui.Toolbar`: an `icon` (an image file — PNG, JPEG, BMP,
GIF, TGA — drawn 16x16 times the theme scale) and / or `text`, plus a
`tooltip`. `on_click` like a Button. `ui.ToolButton("-")` is a separator.
---
struct ToolButton : Widget {
    text: String
    icon: String
    on_click: Callable
    _img: window.Image
    _img_failed: Bool
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "invoke" or not self.enabled { return false }
        self.click()
        return true
    }

    define access_role(self) -> String {
        return "button"
    }

    define _a11y_name(self) -> String {
        return self.text
    }


    define __init(self, text: String = "", icon: String = "", on_click: Callable = null, tooltip: String = "") -> void {
        super().__init()
        self.text = text
        self.icon = icon
        self.on_click = on_click
        self.tooltip = tooltip
        self._img = null
        self._img_failed = false
        self.focusable = text != "-"
    }

    define is_separator(self) -> Bool {
        return self.text == "-"
    }

    --- Press it from code. ---
    define click(self) -> void {
        if self.enabled and self.on_click != null { self.on_click() }
    }

    define _icon_size(self, t: Theme) -> Int {
        return 16 * t.scale
    }

    define measure(self, t: Theme) -> void {
        if self.is_separator() {
            self.min_w = 9
            self.min_h = t.line() + 12
            return
        }
        w := 12
        if self.icon.length() > 0 { w = w + self._icon_size(t) }
        if self.text.length() > 0 {
            if self.icon.length() > 0 { w = w + t.char_w() / 2 }
            w = w + t.text_w(self.text)
        }
        self.min_w = w
        self.min_h = _max(t.line(), self._icon_size(t)) + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled or self.is_separator() { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.click() }
            return true
        }
        if e.kind == "key_down" and (e.key == "return" or e.key == "space") {
            self.click()
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.is_separator() {
            win.rect(self.x + 4, self.y + 4, 1, self.height - 8, t.border)
            return
        }
        if self.pressed {
            win.rect(self.x, self.y, self.width, self.height, mix(t.surface, window.black(), 20))
        } elif self.hovered and self.enabled {
            win.rect(self.x, self.y, self.width, self.height, mix(t.surface, t.text, 12))
        }
        x := self.x + 6
        if self.icon.length() > 0 {
            if self._img == null and not self._img_failed {
                try {
                    self._img = win.load_image(self.icon)
                } catch (window.WindowError) {
                    self._img_failed = true
                }
            }
            sz := self._icon_size(t)
            iy := self.y + (self.height - sz) / 2
            if self._img != null {
                alpha := 255
                if not self.enabled { alpha = 90 }
                win.image(self._img, x, iy, width=sz, height=sz, alpha=alpha)
            } else {
                win.rect(x, iy, sz, sz, t.muted, fill=false)       // missing icon
            }
            x = x + sz + t.char_w() / 2
        }
        if self.text.length() > 0 {
            win.text(self.text, x, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        }
        if self.focused { _focus_ring(win, self, t) }
    }
}

---
A row of `ui.ToolButton`s on a raised strip, usually under the menu bar.
---
struct Toolbar : Row {
    define __init(self, buttons: List) -> void {
        super().__init(buttons, 3, 2)
    }
    define access_role(self) -> String {
        return "toolbar"
    }


    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.surface)
        win.rect(self.x, self.y + self.height - 1, self.width, 1, t.border)
        for c in self._kids {
            w: Widget = c
            if w.visible { w.draw(win, t) }
        }
    }
}

---
A strip of text sections along the bottom of a window:
`ui.StatusBar(["Ready", "Ln 1, Col 1"])`. The first section takes the
free space; the others are right-aligned. `set(i, text)` changes one.
`lead`: a coloured item at the left edge, a button (`on_lead()` on a
click, `lead_tip` its tooltip) — VS Code's remote indicator.
---
struct StatusBar : Widget {
    sections: List
    lead: String
    on_lead: Callable
    lead_tip: String
    _lead_w: Int
    define access_role(self) -> String {
        return "status"
    }

    define access_value(self) -> String {
        out := self.lead
        for sec in self.sections {
            if out != "" { out = out + " | " }
            out = out + String(sec)
        }
        return out
    }


    define __init(self, sections: List, lead: String = "", on_lead: Callable = null, lead_tip: String = "") -> void {
        super().__init()
        self.sections = sections
        self.lead = lead
        self.on_lead = on_lead
        self.lead_tip = lead_tip
        self._lead_w = 0
        self.takes_clicks = true
    }

    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "invoke" or self.lead == "" or self.on_lead == null { return false }
        self.on_lead()
        return true
    }

    // The lead item's width (0: none).
    define _lead_width(self, t: Theme) -> Int {
        if self.lead == "" { return 0 }
        return t.text_w(self.lead) + 2 * t.char_w()
    }

    define _on_lead(self, px: Int, py: Int) -> Bool {
        return self._lead_w > 0 and px >= self.x and px < self.x + self._lead_w and py >= self.y and py < self.y + self.height
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 and self._on_lead(e.x, e.y) {
            if self.on_lead != null { self.on_lead() }
            return true
        }
        return e.kind == "mouse_up"
    }

    define tooltip_at(self, px: Int, py: Int) -> String {
        if self._on_lead(px, py) and self.lead_tip != "" { return self.lead_tip }
        return self.tooltip
    }

    --- Change section `i`'s text (adds sections as needed). ---
    define set(self, i: Int, text: String) -> void {
        while self.sections.length() <= i { self.sections.append("") }
        self.sections[i] = text
    }

    --- Section `i`'s text ("" if there's none). ---
    define get(self, i: Int) -> String {
        if i < 0 or i >= self.sections.length() { return "" }
        return self.sections[i].str()
    }

    define measure(self, t: Theme) -> void {
        w := 0
        for sct in self.sections { w = w + t.text_w(sct.str()) + 3 * t.char_w() }
        self.min_w = w + self._lead_width(t)
        self.min_h = t.line() + 8
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.surface)
        win.rect(self.x, self.y, self.width, 1, t.border)
        ty := self.y + (self.height - t.line()) / 2
        self._lead_w = self._lead_width(t)
        lx := self.x
        if self._lead_w > 0 {
            bg := t.accent
            if self.hovered {
                m := win.mouse()
                if self._on_lead(m.0, m.1) { bg = mix(t.accent, t.accent_text, 15) }
            }
            win.rect(self.x, self.y, self._lead_w, self.height, bg)
            win.text(self.lead, self.x + t.char_w(), ty, t.accent_text, scale=t.scale, font=t.font)
            lx = self.x + self._lead_w
        }
        if self.sections.length() == 0 { return }
        win.text(self.get(0), lx + t.char_w(), ty, t.muted, scale=t.scale, font=t.font)
        rx := self.x + self.width - t.char_w()
        i := self.sections.length() - 1
        while i >= 1 {
            text := self.get(i)
            tw := t.text_w(text)
            rx = rx - tw
            win.text(text, rx, ty, t.muted, scale=t.scale, font=t.font)
            rx = rx - t.char_w()
            win.rect(rx, self.y + 4, 1, self.height - 8, t.border)
            rx = rx - t.char_w()
            i = i - 1
        }
    }
}

// ===== DatePicker =====

define _leap(y: Int) -> Bool {
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

--- Days in `month` (1-12) of `year`. ---
define days_in_month(year: Int, month: Int) -> Int {
    if month == 2 {
        if _leap(year) { return 29 }
        return 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 { return 30 }
    return 31
}

--- Day of the week of a date: 0 = Monday ... 6 = Sunday. ---
define weekday(year: Int, month: Int, day: Int) -> Int {
    // Sakamoto's method (0 = Sunday), shifted so the week starts on Monday.
    offsets := [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    y := year
    if month < 3 { y = y - 1 }
    o: Int = offsets[month - 1]
    sun0 := (y + y / 4 - y / 100 + y / 400 + o + day) % 7
    return (sun0 + 6) % 7
}

define _two(n: Int) -> String {
    if n < 10 { return "0" + n.str() }
    return n.str()
}

_MONTHS := ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

---
A date field that opens a month calendar. `year`, `month` (1-12), `day`;
`text()` is "YYYY-MM-DD". Click the field (or Space / Enter / Alt+Down) to
open it; in the calendar click a day, `<` / `>` change month, arrows move
by day / week, Page Up / Page Down by month, Enter picks, Escape closes.
`on_change(year, month, day)` runs when the date changes.
---
struct DatePicker : Widget {
    year: Int
    month: Int
    day: Int
    on_change: Callable
    is_open: Bool
    _vy: Int
    _vm: Int
    _cursor: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    _cell: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if not self.enabled { return false }
        if action == "expand" { self.open() } elif action == "collapse" { self.close() } else { return false }
        return true
    }

    define access_role(self) -> String {
        return "combobox"
    }

    define access_value(self) -> String {
        m := self.month < 10 ? "0" + String(self.month) : String(self.month)
        d := self.day < 10 ? "0" + String(self.day) : String(self.day)
        return String(self.year) + "-" + m + "-" + d
    }

    define _a11y_states(self, out: List) -> void {
        out.append(self.is_open ? "expanded" : "collapsed")
    }


    define __init(self, year: Int = 2026, month: Int = 1, day: Int = 1, on_change: Callable = null) -> void {
        super().__init()
        self.year = year
        self.month = _clamp(month, 1, 12)
        self.day = _clamp(day, 1, days_in_month(year, self.month))
        self.on_change = on_change
        self.is_open = false
        self._vy = self.year
        self._vm = self.month
        self._cursor = self.day
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
        self._cell = 28
        self.focusable = true
    }

    --- The date as "YYYY-MM-DD". ---
    define text(self) -> String {
        return self.year.str() + "-" + _two(self.month) + "-" + _two(self.day)
    }

    --- Set the date (clamped to a real date); runs `on_change` if it changed. ---
    define set_date(self, year: Int, month: Int, day: Int) -> void {
        m := _clamp(month, 1, 12)
        d := _clamp(day, 1, days_in_month(year, m))
        if year == self.year and m == self.month and d == self.day { return }
        self.year = year
        self.month = m
        self.day = d
        if self.on_change != null { self.on_change(year, m, d) }
    }

    --- Show the calendar (on the chosen date's month). ---
    define open(self) -> void {
        if self.is_open or not self.enabled { return }
        self._vy = self.year
        self._vm = self.month
        self._cursor = self.day
        self.is_open = true
        _popups.append(self)
    }

    --- Hide the calendar. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define close_popup(self) -> void {
        self.close()
    }

    // Move the shown month by `by` months (cursor clamped to it).
    define _shift_month(self, by: Int) -> void {
        idx := self._vy * 12 + (self._vm - 1) + by
        self._vy = idx / 12
        self._vm = idx % 12 + 1
        self._cursor = _clamp(self._cursor, 1, days_in_month(self._vy, self._vm))
    }

    // Move the cursor by `by` days, across months.
    define _shift_day(self, by: Int) -> void {
        d := self._cursor + by
        while d < 1 {
            self._shift_month(-1)
            d = d + days_in_month(self._vy, self._vm)
        }
        while d > days_in_month(self._vy, self._vm) {
            d = d - days_in_month(self._vy, self._vm)
            self._shift_month(1)
        }
        self._cursor = d
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.text_w("0000-00-00") + 16 + 3 * t.char_w()
        self.min_h = t.line() + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            if self.is_open { self.close() } else { self.open() }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" and not self.is_open {
            if e.key == "space" or e.key == "return" or (e.key == "down" and e.alt) {
                self.open()
                return true
            }
        }
        return false
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph
    }

    // The day under (px, py) in the shown month, or 0.
    define _day_at(self, px: Int, py: Int) -> Int {
        c := self._cell
        gx := (px - self._px - 6) / c
        gy := (py - self._py - 6 - 2 * c) / c
        if px < self._px + 6 or py < self._py + 6 + 2 * c or gx < 0 or gx > 6 { return 0 }
        d := gy * 7 + gx - weekday(self._vy, self._vm, 1) + 1
        if d < 1 or d > days_in_month(self._vy, self._vm) { return 0 }
        return d
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 {
            c := self._cell
            if e.y < self._py + 6 + c {
                if e.x < self._px + 6 + c { self._shift_month(-1) }
                elif e.x >= self._px + self._pw - 6 - c { self._shift_month(1) }
                return true
            }
            d := self._day_at(e.x, e.y)
            if d > 0 {
                self.set_date(self._vy, self._vm, d)
                self.close()
            }
            return true
        }
        if e.kind == "mouse_move" {
            d := self._day_at(e.x, e.y)
            if d > 0 { self._cursor = d }
            return true
        }
        return true
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind != "key_down" { return e.kind == "key_up" or e.kind == "text" or e.kind == "compose" }
        k := e.key
        if k == "left" { self._shift_day(-1) }
        elif k == "right" { self._shift_day(1) }
        elif k == "up" { self._shift_day(-7) }
        elif k == "down" { self._shift_day(7) }
        elif k == "pageup" { self._shift_month(-1) }
        elif k == "pagedown" { self._shift_month(1) }
        elif k == "home" { self._cursor = 1 }
        elif k == "end" { self._cursor = days_in_month(self._vy, self._vm) }
        elif k == "return" or k == "keypad_enter" or k == "space" {
            self.set_date(self._vy, self._vm, self._cursor)
            self.close()
        } elif k == "escape" or k == "tab" {
            self.close()
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused or self.is_open { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        win.text(self.text(), self.x + 8, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        // A small calendar glyph on the right.
        gx := self.x + self.width - 8 - 2 * t.char_w()
        gy := self.y + (self.height - t.line()) / 2 + 2
        gs := t.line() - 4
        win.rect(gx, gy, gs, gs, _ink(self, t.muted, t), fill=false)
        win.rect(gx, gy, gs, 3, _ink(self, t.muted, t))
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        c := _max(t.line() + 8, 3 * t.char_w() + 6)
        self._cell = c
        self._pw = 7 * c + 12
        self._ph = 8 * c + 12
        self._px = self.x
        self._py = self.y + self.height + 2
        if self._px + self._pw > win.width() { self._px = _max(0, win.width() - self._pw) }
        if self._py + self._ph > win.height() and self.y - self._ph - 2 >= 0 { self._py = self.y - self._ph - 2 }
        // Neither fits: keep it inside the window.
        self._py = _clamp(self._py, 0, _max(0, win.height() - self._ph))
        x := self._px
        y := self._py
        win.rect(x + 3, y + 3, self._pw, self._ph, mix(t.background, window.black(), 45))
        win.rect(x, y, self._pw, self._ph, t.surface)
        win.rect(x, y, self._pw, self._ph, t.border, fill=false)
        // Header: < Month Year >
        hy := y + 6 + (c - t.line()) / 2
        win.text("<", x + 6 + (c - t.char_w()) / 2, hy, t.text, scale=t.scale, font=t.font)
        win.text(">", x + self._pw - 6 - c + (c - t.char_w()) / 2, hy, t.text, scale=t.scale, font=t.font)
        title := _MONTHS[self._vm - 1].str() + " " + self._vy.str()
        win.text(title, x + (self._pw - t.text_w(title)) / 2, hy, t.text, scale=t.scale, font=t.font)
        // Weekday names.
        names := ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
        i := 0
        while i < 7 {
            wd: String = names[i]
            win.text(wd, x + 6 + i * c + (c - t.text_w(wd)) / 2, y + 6 + c + (c - t.line()) / 2, t.muted, scale=t.scale, font=t.font)
            i = i + 1
        }
        // Days.
        first := weekday(self._vy, self._vm, 1)
        count := days_in_month(self._vy, self._vm)
        d := 1
        while d <= count {
            cell := first + d - 1
            cx := x + 6 + (cell % 7) * c
            cy := y + 6 + 2 * c + (cell / 7) * c
            ink := t.text
            chosen := d == self.day and self._vm == self.month and self._vy == self.year
            if chosen {
                win.rect(cx + 1, cy + 1, c - 2, c - 2, t.accent)
                ink = t.accent_text
            }
            if d == self._cursor { win.rect(cx + 1, cy + 1, c - 2, c - 2, t.focus, fill=false) }
            label := d.str()
            win.text(label, cx + (c - t.text_w(label)) / 2, cy + (c - t.line()) / 2, ink, scale=t.scale, font=t.font)
            d = d + 1
        }
    }
}

// ===== ColorPicker =====

// HSV (hue 0-359, saturation / value 0-100) <-> colour, in whole numbers.
define hsv_to_color(h: Int, sat: Int, v: Int) -> Int {
    hh := ((h % 360) + 360) % 360
    ss := _clamp(sat, 0, 100)
    vv := _clamp(v, 0, 100)
    c := vv * ss * 255 / 10000                 // chroma, 0-255
    seg := hh / 60
    f := hh % 60
    x := c * (seg % 2 * 60 + (1 - 2 * (seg % 2)) * f) / 60
    m := vv * 255 / 100 - c
    r := 0
    g := 0
    b := 0
    if seg == 0 {
        r = c
        g = x
    } elif seg == 1 {
        r = x
        g = c
    } elif seg == 2 {
        g = c
        b = x
    } elif seg == 3 {
        g = x
        b = c
    } elif seg == 4 {
        r = x
        b = c
    } else {
        r = c
        b = x
    }
    return window.rgb(r + m, g + m, b + m)
}

--- [hue 0-359, saturation 0-100, value 0-100] of a colour. ---
define color_to_hsv(color: Int) -> List {
    ch := window.channels(color)
    r: Int = ch[0]
    g: Int = ch[1]
    b: Int = ch[2]
    mx := _max(r, _max(g, b))
    mn := _min(r, _min(g, b))
    d := mx - mn
    h := 0
    if d > 0 {
        if mx == r {
            h = (60 * (g - b) / d + 360) % 360
        } elif mx == g {
            h = 60 * (b - r) / d + 120
        } else {
            h = 60 * (r - g) / d + 240
        }
    }
    sat := 0
    if mx > 0 { sat = d * 100 / mx }
    return [h, sat, mx * 100 / 255]
}

---
Pick a colour: a square for saturation (left → right) and brightness
(bottom → top), a strip for the hue, and a swatch with its hex code.
Drag in either, or with the focus: Left / Right saturation, Up / Down
brightness, Page Up / Page Down hue. `color` is the colour (a `window`
colour Int); `on_change(color)` runs when it changes.
---
struct ColorPicker : Widget {
    color: Int
    hue: Int
    saturation: Int
    value: Int
    on_change: Callable
    size: Int
    _drag: Int
    define access_role(self) -> String {
        return "colorpicker"
    }

    define access_value(self) -> String {
        c := window.channels(self.color)
        return "rgb(" + String(c[0]) + ", " + String(c[1]) + ", " + String(c[2]) + ")"
    }


    define __init(self, color: Int = window.rgb(76, 141, 255), on_change: Callable = null, size: Int = 128) -> void {
        super().__init()
        self.on_change = on_change
        self.size = size
        self._drag = 0
        self.focusable = true
        self.set_color(color)
    }

    --- Set the colour from code (no `on_change`). ---
    define set_color(self, color: Int) -> void {
        hsv := color_to_hsv(color)
        h: Int = hsv[0]
        sv: Int = hsv[1]
        vv: Int = hsv[2]
        self.hue = h
        self.saturation = sv
        self.value = vv
        self.color = window.rgb(window.channels(color)[0], window.channels(color)[1], window.channels(color)[2])
    }

    --- The colour as "#rrggbb". ---
    define hex(self) -> String {
        ch := window.channels(self.color)
        digits := "0123456789abcdef"
        out := "#"
        for v in [ch[0], ch[1], ch[2]] {
            n: Int = v
            out = out + digits.substring(n / 16, n / 16 + 1) + digits.substring(n % 16, n % 16 + 1)
        }
        return out
    }

    define _set_hsv(self, h: Int, sat: Int, v: Int) -> void {
        self.hue = ((h % 360) + 360) % 360
        self.saturation = _clamp(sat, 0, 100)
        self.value = _clamp(v, 0, 100)
        nc := hsv_to_color(self.hue, self.saturation, self.value)
        if nc != self.color {
            self.color = nc
            if self.on_change != null { self.on_change(nc) }
        }
    }

    define _strip_x(self) -> Int {
        return self.x + self.size + 8
    }

    define measure(self, t: Theme) -> void {
        self.min_w = self.size + 8 + 16
        self.min_h = self.size + 8 + t.line() + 8
    }

    define _from_point(self, px: Int, py: Int) -> void {
        if self._drag == 1 {
            sat := _clamp(px - self.x, 0, self.size) * 100 / self.size
            v := 100 - _clamp(py - self.y, 0, self.size) * 100 / self.size
            self._set_hsv(self.hue, sat, v)
        } elif self._drag == 2 {
            h := _clamp(py - self.y, 0, self.size - 1) * 360 / self.size
            self._set_hsv(h, self.saturation, self.value)
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            // The square includes its right / bottom edge (full saturation, black).
            if e.x <= self.x + self.size and e.y <= self.y + self.size {
                self._drag = 1
            } elif e.x >= self._strip_x() and e.y <= self.y + self.size {
                self._drag = 2
            } else {
                self._drag = 0
            }
            self._from_point(e.x, e.y)
            return true
        }
        if e.kind == "mouse_move" and self._drag > 0 {
            self._from_point(e.x, e.y)
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = 0
            return true
        }
        if e.kind == "key_down" {
            k := e.key
            if k == "left" { self._set_hsv(self.hue, self.saturation - 5, self.value) }
            elif k == "right" { self._set_hsv(self.hue, self.saturation + 5, self.value) }
            elif k == "up" { self._set_hsv(self.hue, self.saturation, self.value + 5) }
            elif k == "down" { self._set_hsv(self.hue, self.saturation, self.value - 5) }
            elif k == "pageup" { self._set_hsv(self.hue + 10, self.saturation, self.value) }
            elif k == "pagedown" { self._set_hsv(self.hue - 10, self.saturation, self.value) }
            else { return false }
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        n := 16
        cell := _max(1, self.size / n)
        i := 0
        while i < n {
            j := 0
            while j < n {
                c := hsv_to_color(self.hue, i * 100 / (n - 1), 100 - j * 100 / (n - 1))
                win.rect(self.x + i * cell, self.y + j * cell, cell, cell, c)
                j = j + 1
            }
            i = i + 1
        }
        win.rect(self.x, self.y, n * cell, n * cell, t.border, fill=false)
        // Marker on the square.
        mx := self.x + self.saturation * self.size / 100
        my := self.y + (100 - self.value) * self.size / 100
        win.circle(mx, my, 5, window.white(), fill=false)
        win.circle(mx, my, 6, window.black(), fill=false)
        // Hue strip.
        sx := self._strip_x()
        segs := 32
        seg_h := _max(1, self.size / segs)
        k := 0
        while k < segs {
            win.rect(sx, self.y + k * seg_h, 16, seg_h, hsv_to_color(k * 360 / segs, 100, 100))
            k = k + 1
        }
        win.rect(sx, self.y, 16, segs * seg_h, t.border, fill=false)
        hy := self.y + self.hue * self.size / 360
        win.rect(sx - 2, hy - 1, 20, 3, t.text)
        // Swatch + hex.
        by := self.y + self.size + 8
        win.rect(self.x, by, 3 * t.line(), t.line() + 4, self.color)
        win.rect(self.x, by, 3 * t.line(), t.line() + 4, t.border, fill=false)
        win.text(self.hex(), self.x + 3 * t.line() + t.char_w(), by + 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== TreeView =====

---
One node of a `ui.TreeView`: `text`, `children` (TreeNodes), whether it's
`expanded`, and `data` — anything you want to keep with it.
`add(child)` adds a child and returns it.
---
struct TreeNode {
    text: String
    children: List
    expanded: Bool
    data: Any
    parent: TreeNode

    define __init(self, text: String, children: List = [], expanded: Bool = false, data: Any = null) -> void {
        self.text = text
        self.children = []
        self.expanded = expanded
        self.data = data
        self.parent = null
        for c in children {
            n: TreeNode = c
            self.add(n)
        }
    }

    --- Add `child` under this node; returns it. ---
    define add(self, child: TreeNode) -> TreeNode {
        child.parent = self
        self.children.append(child)
        return child
    }

    --- How deep it is (0 for a root). ---
    define depth(self) -> Int {
        d := 0
        p := self.parent
        while p != null {
            d = d + 1
            p = p.parent
        }
        return d
    }
}

---
A tree of `ui.TreeNode`s, nested nodes indented. Click the arrow (or
double-click the row) to expand / collapse; click a row to select it.
Keys: Up / Down move, Right expands (or goes to the first child), Left
collapses (or goes to the parent), Enter toggles. `on_select(node)` runs
when the selection changes; `selected` is the node (or null);
`on_expand(node)` runs just before a node opens (fill in its children
then: a folder read lazily).

`flat=true` is the look of a side bar (a file explorer): no box, rows lit
under the mouse, the selected row tinted (outlined while focused), thin
chevrons, and a click on a parent opens / closes it. `row_height`,
`indent`, `guides` (lines down each level) and `icon` — `fn(node)` giving
`[text, colour]` (a badge before the name: "Q", "{}") or null — fine-tune
either look; `background` fills it (-1: the theme's input colour, or
nothing when flat).
---
struct TreeView : Widget {
    roots: List
    selected: TreeNode
    on_select: Callable
    on_expand: Callable
    rows: Int
    flat: Bool
    row_height: Int
    guides: Bool
    icon: Callable
    background: Int
    _top: Int
    _ind: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if node.data == null or not self.enabled { return false }
        tn: TreeNode = node.data
        if action == "select" {
            self.select(tn)
        } elif (action == "expand" and not tn.expanded) or (action == "collapse" and tn.expanded) {
            self.toggle(tn)
        } else {
            return false
        }
        return true
    }

    define access_role(self) -> String {
        return "tree"
    }

    define access_value(self) -> String {
        if self.selected == null { return "" }
        return self.selected.text
    }

    define _a11y_children(self) -> List {
        return self._a11y_nodes(self.roots, 1)
    }

    // Tree items, nested — the children of an expanded node only.
    define _a11y_nodes(self, nodes: List, level: Int) -> List {
        out := []
        for nd in nodes {
            tn: TreeNode = nd
            item := AccessNode("treeitem", tn.text, "", self.x, self.y, self.width, 0)._item(self, -1)
            item.data = tn
            item.level = level
            if tn.children.length() > 0 {
                item.states.append(tn.expanded ? "expanded" : "collapsed")
                if tn.expanded { item.children = self._a11y_nodes(tn.children, level + 1) }
            }
            if self.selected != null and tn == self.selected { item.states.append("selected") }
            out.append(item)
        }
        return out
    }


    define __init(self, roots: List, on_select: Callable = null, rows: Int = 8, expand: Bool = false,
                  flat: Bool = false, row_height: Int = 24, indent: Int = 16, guides: Bool = false,
                  icon: Callable = null, on_expand: Callable = null, background: Int = -1) -> void {
        super().__init()
        self.roots = roots
        self.selected = null
        self.on_select = on_select
        self.on_expand = on_expand
        self.rows = rows
        self.expand = expand
        self.flat = flat
        self.row_height = row_height
        self.guides = guides
        self.icon = icon
        self.background = background
        self._top = 0
        self._ind = indent
        self.focusable = true
    }

    --- How far each level is indented (pixels). ---
    define indent(self) -> Int {
        return self._ind
    }

    define set_indent(self, px: Int) -> void {
        self._ind = _max(0, px)
    }

    define _row_h(self) -> Int {
        return self.row_height
    }

    define _open(self, node: TreeNode) -> void {
        if self.on_expand != null { self.on_expand(node) }
        node.expanded = true
    }

    define _pad(self) -> Int {
        return self.flat ? 0 : 2
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - 2 * self._pad()) / self._row_h())
    }

    define _flatten(self, nodes: List, out: List) -> void {
        for c in nodes {
            n: TreeNode = c
            out.append(n)
            if n.expanded { self._flatten(n.children, out) }
        }
    }

    --- The nodes on screen in order (expanded parents' children included). ---
    define visible_nodes(self) -> List {
        out := []
        self._flatten(self.roots, out)
        return out
    }

    define _index_of(self, vis: List, n: TreeNode) -> Int {
        i := 0
        while i < vis.length() {
            v: TreeNode = vis[i]
            if v == n { return i }
            i = i + 1
        }
        return -1
    }

    --- Select `node` (null: none); runs `on_select` if it changed. ---
    define select(self, node: TreeNode) -> void {
        if node == self.selected { return }
        self.selected = node
        if node != null {
            vis := self.visible_nodes()
            i := self._index_of(vis, node)
            if i >= 0 {
                if i < self._top { self._top = i }
                if i >= self._top + self._shown() { self._top = i - self._shown() + 1 }
            }
        }
        if self.on_select != null { self.on_select(node) }
    }

    --- Expand or collapse `node`. ---
    define toggle(self, node: TreeNode) -> void {
        if node.children.length() == 0 { return }
        if node.expanded { node.expanded = false } else { self._open(node) }
        // A selected node hidden by the collapse: select the collapsed one.
        if not node.expanded and self.selected != null {
            p := self.selected.parent
            while p != null {
                if p == node {
                    self.select(node)
                    return
                }
                p = p.parent
            }
        }
    }

    define measure(self, t: Theme) -> void {
        widest := 10
        for c in self.visible_nodes() {
            n: TreeNode = c
            widest = _max(widest, n.depth() * self._ind + 16 + t.text_w(n.text) + (self.icon != null ? 18 : 0))
        }
        self.min_w = _min(widest, 60 * t.char_w()) + 16
        self.min_h = self.rows * self._row_h() + 2 * self._pad()
    }

    --- The node on the row at (px, py) (null: none there). ---
    define node_at(self, px: Int, py: Int) -> TreeNode {
        if px < self.x or px >= self.x + self.width or py < self.y + self._pad() { return null }
        vis := self.visible_nodes()
        i := self._top + (py - self.y - self._pad()) / self._row_h()
        if i < 0 or i >= vis.length() { return null }
        n: TreeNode = vis[i]
        return n
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        vis := self.visible_nodes()
        // A right-click selects its row for the context menu — quietly: no
        // toggle, no on_select (it isn't a pick: a file isn't opened).
        if e.kind == "mouse_down" and e.button == 3 {
            n := self.node_at(e.x, e.y)
            if n != null { self.selected = n }
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y - self._pad()) / self._row_h()
            i := self._top + row
            if row >= 0 and i < vis.length() {
                n: TreeNode = vis[i]
                arrow_x := self.x + 6 + n.depth() * self._ind
                if self.flat {
                    if e.clicks <= 1 { self.toggle(n) }            // a click opens / closes a parent (not again on a double-click)
                } elif e.clicks >= 2 or (e.x >= arrow_x - 2 and e.x < arrow_x + 14) {
                    self.toggle(n)
                }
                self.select(n)
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "wheel" {
            most := _max(0, vis.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind != "key_down" or vis.length() == 0 { return false }
        k := e.key
        cur := self._index_of(vis, self.selected)
        if k == "down" {
            self.select(vis[_min(vis.length() - 1, cur + 1)])
        } elif k == "up" {
            self.select(vis[_max(0, cur - 1)])
        } elif k == "home" {
            self.select(vis[0])
        } elif k == "end" {
            self.select(vis[vis.length() - 1])
        } elif self.selected == null {
            return false
        } elif k == "right" {
            n := self.selected
            if n.children.length() > 0 and not n.expanded {
                self._open(n)
            } elif n.children.length() > 0 {
                self.select(n.children[0])
            }
        } elif k == "left" {
            n := self.selected
            if n.expanded {
                n.expanded = false
            } elif n.parent != null {
                self.select(n.parent)
            }
        } elif k == "return" or k == "keypad_enter" or k == "space" {
            self.toggle(self.selected)
        } else {
            return false
        }
        return true
    }

    // The badge `icon(node)` gives, at tx; where the name starts.
    define _draw_icon(self, win: window.Window, t: Theme, n: TreeNode, tx: Int, ry: Int, rh: Int) -> Int {
        if self.icon == null { return tx }
        got := self.icon(n)
        if got == null { return tx }
        parts: List = got
        label := String(parts[0])
        color: Int = parts[1]
        if label != "" {
            lw := t.text_w(label)
            win.text(label, tx + _max(0, (14 - lw) / 2), ry + (rh - t.line()) / 2, _ink(self, color, t), scale=t.scale, font=t.font)
        }
        return tx + 20
    }

    // The side-bar look (flat=true).
    define _draw_flat(self, win: window.Window, t: Theme) -> void {
        base := self.background != -1 ? self.background : t.background
        if self.background != -1 { win.rect(self.x, self.y, self.width, self.height, base) }
        vis := self.visible_nodes()
        rh := self._row_h()
        shown := self._shown()
        most := _max(0, vis.length() - shown)
        if self._top > most { self._top = most }
        hover_row := -1
        if self.hovered {
            m := win.mouse()
            if m.0 >= self.x and m.0 < self.x + self.width and m.1 >= self.y {
                hover_row = (m.1 - self.y) / rh
            }
        }
        guide := mix(base, t.text, 14)
        _clip_push(win, self.x, self.y, self.width, self.height)
        i := self._top
        while i < vis.length() and i < self._top + shown {
            n: TreeNode = vis[i]
            ry := self.y + (i - self._top) * rh
            if n == self.selected {
                if self.focused {
                    win.rect(self.x, ry, self.width, rh, mix(base, t.accent, 28))
                    win.rect(self.x, ry, self.width, rh, t.accent, fill=false)
                } else {
                    win.rect(self.x, ry, self.width, rh, mix(base, t.text, 13))
                }
            } elif i - self._top == hover_row {
                win.rect(self.x, ry, self.width, rh, mix(base, t.text, 7))
            }
            depth := n.depth()
            if self.guides {
                d := 0
                while d < depth {
                    win.rect(self.x + 10 + d * self._ind, ry, 1, rh, guide)
                    d = d + 1
                }
            }
            ax := self.x + 6 + depth * self._ind
            cy := ry + rh / 2
            ink := _ink(self, t.text, t)
            if n.children.length() > 0 {
                // A thin chevron: › closed, ⌄ open.
                if n.expanded {
                    win.line(ax, cy - 2, ax + 4, cy + 2, ink)
                    win.line(ax + 4, cy + 2, ax + 8, cy - 2, ink)
                } else {
                    win.line(ax + 2, cy - 4, ax + 6, cy, ink)
                    win.line(ax + 6, cy, ax + 2, cy + 4, ink)
                }
            }
            tx := self._draw_icon(win, t, n, ax + 16, ry, rh)
            win.text(n.text, tx, ry + (rh - t.line()) / 2, ink, scale=t.scale, font=t.font)
            i = i + 1
        }
        _clip_pop(win)
        if vis.length() > shown and self.hovered {
            bar := _max(16, self.height * shown / vis.length())
            by := self.y + (self.height - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 8, by, 8, bar, mix(base, t.text, 22))
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.flat {
            self._draw_flat(win, t)
            return
        }
        win.rect(self.x, self.y, self.width, self.height, self.background != -1 ? self.background : t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        vis := self.visible_nodes()
        rh := self._row_h()
        shown := self._shown()
        most := _max(0, vis.length() - shown)
        if self._top > most { self._top = most }
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        i := self._top
        while i < vis.length() and i < self._top + shown {
            n: TreeNode = vis[i]
            ry := self.y + 2 + (i - self._top) * rh
            ink := t.text
            if n == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            }
            ax := self.x + 6 + n.depth() * self._ind
            cy := ry + rh / 2
            if n.children.length() > 0 {
                // A small triangle: pointing right (collapsed) or down (expanded).
                r := 0
                while r <= 4 {
                    if n.expanded {
                        win.line(ax + r, cy - 2 + r, ax + 8 - r, cy - 2 + r, _ink(self, ink, t))
                    } else {
                        win.line(ax + 2 + r, cy - 4 + r, ax + 2 + r, cy + 4 - r, _ink(self, ink, t))
                    }
                    r = r + 1
                }
            }
            tx := ax + 14
            tx = self._draw_icon(win, t, n, tx, ry, rh)
            win.text(n.text, tx, ry + (rh - t.line()) / 2, _ink(self, ink, t), scale=t.scale, font=t.font)
            i = i + 1
        }
        _clip_pop(win)
        if vis.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / vis.length())
            by := self.y + 2 + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Table =====

---
Rows of values under column headers: `ui.Table(["Name", "Size"], rows)`,
each row a List (anything with `.str()`). Columns size to their content
(or set `widths`); click a row (or Up / Down) to select it, click a
header to sort by that column (again: reverse). `on_select(index, row)`
runs when the selection changes — `index` into `rows`, whatever the sort.
With `editable=true` a cell can be changed in place: Left / Right pick
the column, Enter / F2 or a double-click edit it, Enter saves, Escape
cancels. The new value goes into `rows` (an Int column stays an Int when
the text is a number) and `on_edit(index, column, value)` runs.
---
struct Table : Widget {
    columns: List
    rows: List
    widths: List
    selected: Int
    on_select: Callable
    visible_rows: Int
    sort_column: Int
    sort_descending: Bool
    _order: List
    _top: Int
    _last_w: List
    editable: Bool
    column: Int
    on_edit: Callable
    _editor: TextInput
    _edit_row: Int
    _edit_col: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "select" or node.index < 0 or not self.enabled { return false }
        self.select(node.index)
        return true
    }

    define access_role(self) -> String {
        return "table"
    }

    define _a11y_children(self) -> List {
        out := []
        head := AccessNode("row", "", "", self.x, self.y, self.width, 0)
        for col in self.columns {
            head.children.append(AccessNode("columnheader", String(col)))
        }
        out.append(head)
        i := 0
        while i < self.rows.length() {
            cells: List = self.rows[i]
            row := AccessNode("row", "", "", self.x, self.y, self.width, 0)._item(self, i)
            names := ""
            for cell in cells {
                txt := _entry_text(cell)
                row.children.append(AccessNode("cell", txt))
                if names != "" { names = names + ", " }
                names = names + txt
            }
            row.name = names
            if i == self.selected { row.states.append("selected") }
            out.append(row)
            i = i + 1
        }
        return out
    }


    define __init(self, columns: List, rows: List, on_select: Callable = null, visible_rows: Int = 8, expand: Bool = false, editable: Bool = false, on_edit: Callable = null) -> void {
        super().__init()
        self.columns = columns
        self.rows = rows
        self.widths = []
        self.selected = -1
        self.on_select = on_select
        self.visible_rows = visible_rows
        self.expand = expand
        self.sort_column = -1
        self.sort_descending = false
        self._order = []
        self._top = 0
        self._last_w = []
        self.editable = editable
        self.column = 0
        self.on_edit = on_edit
        self._editor = TextInput("")
        self._edit_row = -1
        self._edit_col = -1
        self.focusable = true
    }

    --- True while a cell is being edited. ---
    define editing(self) -> Bool {
        return self._edit_row >= 0
    }

    --- Edit cell (row index `r`, column `c`) in place. ---
    define edit_cell(self, r: Int, c: Int) -> void {
        if r < 0 or r >= self.rows.length() or c < 0 or c >= self.columns.length() { return }
        self.select(r)
        self.column = c
        self._edit_row = r
        self._edit_col = c
        self._editor.text = self._cell(r, c)
        self._editor.select_all()
        self._editor._undo = []
        self._editor.focused = true
    }

    --- Stop editing; `save` keeps the typed value. ---
    define finish_edit(self, save: Bool = true) -> void {
        if not self.editing() { return }
        r := self._edit_row
        c := self._edit_col
        self._edit_row = -1
        self._edit_col = -1
        self._editor.focused = false
        if not save { return }
        row: List = self.rows[r]
        while row.length() <= c { row.append("") }
        text := self._editor.text
        old := row[c]
        value: Any = text
        if type(old) == "Int" and self._numeric(text) { value = text.to_int() }
        row[c] = value
        self._order = []                          // re-sort with the new value
        if self.on_edit != null { self.on_edit(r, c, value) }
    }

    // The cell rectangle of (row index r, column c) as [x, y, w, h], or [].
    define _cell_rect(self, r: Int, c: Int) -> List {
        order := self._ordered()
        pos := -1
        i := 0
        while i < order.length() {
            v: Int = order[i]
            if v == r { pos = i }
            i = i + 1
        }
        if pos < self._top or pos >= self._top + self._shown() or c >= self._last_w.length() { return [] }
        x := self.x + 2
        k := 0
        while k < c {
            w: Int = self._last_w[k]
            x = x + w
            k = k + 1
        }
        cw: Int = self._last_w[c]
        rh := self._row_h()
        return [x, self.y + 2 + rh + (pos - self._top) * rh, cw, rh]
    }

    define _row_h(self) -> Int {
        return 24
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - self._row_h() - 4) / self._row_h())
    }

    // A whole-number cell ("42", "-7"), compared by value when sorting.
    define _numeric(self, s: String) -> Bool {
        if s.length() == 0 { return false }
        if s.startswith("-") { return s.length() > 1 and s.substring(1, s.length()).is_digit() }
        return s.is_digit()
    }

    define _cell(self, r: Int, c: Int) -> String {
        row: List = self.rows[r]
        if c >= row.length() { return "" }
        return row[c].str()
    }

    // Row indices in display order (sorted when a header was clicked).
    define _ordered(self) -> List {
        if self._order.length() != self.rows.length() {
            order := []
            i := 0
            while i < self.rows.length() {
                order.append(i)
                i = i + 1
            }
            self._order = order
            if self.sort_column >= 0 { self._sort() }
        }
        return self._order
    }

    // a before b in the current sort: numbers by value, the rest as text.
    define _before(self, a: Int, b: Int) -> Bool {
        x := self._cell(a, self.sort_column)
        y := self._cell(b, self.sort_column)
        less := x < y
        greater := x > y
        if self._numeric(x) and self._numeric(y) {
            xi := x.to_int()
            yi := y.to_int()
            less = xi < yi
            greater = xi > yi
        }
        if self.sort_descending { return greater }
        return less
    }

    define _sort(self) -> void {
        // Insertion sort: stable, and tables are small.
        order := self._order
        i := 1
        while i < order.length() {
            cur: Int = order[i]
            j := i - 1
            while j >= 0 {
                prev: Int = order[j]
                if not self._before(cur, prev) { break }
                order[j + 1] = prev
                j = j - 1
            }
            order[j + 1] = cur
            i = i + 1
        }
    }

    --- Sort by column `c` (`descending` for largest / last first). ---
    define sort_by(self, c: Int, descending: Bool = false) -> void {
        self.sort_column = c
        self.sort_descending = descending
        self._ordered()
        self._sort()
    }

    --- Select row `i` (an index into `rows`; -1: none); runs `on_select` if it changed. ---
    define select(self, i: Int) -> void {
        ni := _clamp(i, -1, self.rows.length() - 1)
        if ni == self.selected { return }
        self.selected = ni
        if ni >= 0 {
            pos := 0
            order := self._ordered()
            while pos < order.length() {
                v: Int = order[pos]
                if v == ni { break }
                pos = pos + 1
            }
            if pos < self._top { self._top = pos }
            if pos >= self._top + self._shown() { self._top = pos - self._shown() + 1 }
            if self.on_select != null { self.on_select(ni, self.rows[ni]) }
        }
    }

    define _col_widths(self, t: Theme) -> List {
        out := []
        c := 0
        while c < self.columns.length() {
            if c < self.widths.length() {
                out.append(self.widths[c])
            } else {
                w := t.text_w(self.columns[c].str()) + 3 * t.char_w()
                r := 0
                while r < self.rows.length() {
                    w = _max(w, t.text_w(self._cell(r, c)) + 2 * t.char_w())
                    r = r + 1
                }
                out.append(_min(w, 40 * t.char_w()))
            }
            c = c + 1
        }
        return out
    }

    define measure(self, t: Theme) -> void {
        total := 0
        for w in self._col_widths(t) {
            n: Int = w
            total = total + n
        }
        self.min_w = total + 4
        self.min_h = (self.visible_rows + 1) * self._row_h() + 4
    }

    // Display position under py (-1 for the header, -2 outside).
    define _pos_at(self, py: Int) -> Int {
        if py < self.y + 2 + self._row_h() { return -1 }
        p := self._top + (py - self.y - 2 - self._row_h()) / self._row_h()
        if p >= self.rows.length() { return -2 }
        return p
    }

    define _col_at(self, px: Int) -> Int {
        // Widths of the last draw.
        x := self.x + 2
        c := 0
        while c < self._last_w.length() {
            w: Int = self._last_w[c]
            if px >= x and px < x + w { return c }
            x = x + w
            c = c + 1
        }
        return -1
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if self.editing() {
            rect := self._cell_rect(self._edit_row, self._edit_col)
            inside := false
            if rect.length() == 4 and (e.kind == "mouse_down" or e.kind == "mouse_move" or e.kind == "mouse_up") {
                rx: Int = rect[0]
                ry: Int = rect[1]
                rw: Int = rect[2]
                rhh: Int = rect[3]
                inside = e.x >= rx and e.y >= ry and e.x < rx + rw and e.y < ry + rhh
            }
            if e.kind == "key_down" and (e.key == "return" or e.key == "keypad_enter") {
                self.finish_edit(true)
                return true
            }
            if e.kind == "key_down" and e.key == "escape" {
                self.finish_edit(false)
                return true
            }
            if e.kind == "key_down" or e.kind == "text" or e.kind == "compose" or inside or (e.kind != "mouse_down" and self._editor._dragging) {
                self._editor.handle(e)
                return true
            }
            if e.kind == "mouse_down" { self.finish_edit(true) }      // a click elsewhere saves
        }
        order := self._ordered()
        if e.kind == "mouse_down" and e.button == 1 {
            p := self._pos_at(e.y)
            if p >= 0 and self.editable {
                c := self._col_at(e.x)
                if c >= 0 { self.column = c }
                if e.clicks >= 2 and c >= 0 {
                    r: Int = order[p]
                    self.edit_cell(r, c)
                    return true
                }
            }
            if p == -1 {
                c := self._col_at(e.x)
                if c >= 0 { self.sort_by(c, c == self.sort_column and not self.sort_descending) }
            } elif p >= 0 {
                self.select(order[p])
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "wheel" {
            most := _max(0, self.rows.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind != "key_down" or self.rows.length() == 0 { return false }
        cur := -1
        i := 0
        while i < order.length() {
            v: Int = order[i]
            if v == self.selected { cur = i }
            i = i + 1
        }
        k := e.key
        if self.editable and (k == "return" or k == "keypad_enter" or k == "f2") and self.selected >= 0 {
            self.edit_cell(self.selected, self.column)
            return true
        }
        if self.editable and k == "left" {
            self.column = _max(0, self.column - 1)
            return true
        }
        if self.editable and k == "right" {
            self.column = _min(self.columns.length() - 1, self.column + 1)
            return true
        }
        if k == "down" {
            self.select(order[_min(order.length() - 1, cur + 1)])
        } elif k == "up" {
            self.select(order[_max(0, cur - 1)])
        } elif k == "home" {
            self.select(order[0])
        } elif k == "end" {
            self.select(order[order.length() - 1])
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        ws := self._col_widths(t)
        self._last_w = ws
        rh := self._row_h()
        order := self._ordered()
        shown := self._shown()
        most := _max(0, order.length() - shown)
        if self._top > most { self._top = most }
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        // Header.
        hy := self.y + 2
        win.rect(self.x + 2, hy, self.width - 4, rh, t.surface)
        x := self.x + 2
        c := 0
        while c < self.columns.length() {
            w: Int = ws[c]
            label := self.columns[c].str()
            if c == self.sort_column {
                if self.sort_descending { label = label + " v" } else { label = label + " ^" }
            }
            win.text(label, x + t.char_w(), hy + (rh - t.line()) / 2, t.text, scale=t.scale, font=t.font)
            if c > 0 { win.rect(x, hy + 4, 1, rh - 8, t.border) }
            x = x + w
            c = c + 1
        }
        win.rect(self.x + 2, hy + rh - 1, self.width - 4, 1, t.border)
        // Rows.
        p := self._top
        while p < order.length() and p < self._top + shown {
            ri: Int = order[p]
            ry := hy + rh + (p - self._top) * rh
            ink := t.text
            if ri == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            } elif (p - self._top) % 2 == 1 {
                win.rect(self.x + 2, ry, self.width - 4, rh, mix(t.input, t.surface, 50))
            }
            x = self.x + 2
            c = 0
            while c < self.columns.length() {
                w: Int = ws[c]
                rowl: List = self.rows[ri]
                if c < rowl.length() {
                    _draw_entry(win, t, rowl[c], x + t.char_w(), ry, rh, w - 2 * t.char_w(), _ink(self, ink, t))
                }
                x = x + w
                c = c + 1
            }
            p = p + 1
        }
        if self.editable and self.selected >= 0 and self.focused {
            sel := self._cell_rect(self.selected, self.column)
            if sel.length() == 4 {
                sx: Int = sel[0]
                sy: Int = sel[1]
                sw: Int = sel[2]
                shh: Int = sel[3]
                win.rect(sx, sy, sw, shh, t.accent_text, fill=false)
            }
        }
        if self.editing() {
            if not self.focused {
                self.finish_edit(true)                // focus moved away: keep the value
            } else {
                rect := self._cell_rect(self._edit_row, self._edit_col)
                if rect.length() == 4 {
                    ex: Int = rect[0]
                    ey: Int = rect[1]
                    ew: Int = rect[2]
                    ehh: Int = rect[3]
                    self._editor.measure(t)
                    self._editor.place(ex, ey, ew, ehh)
                    self._editor.draw(win, t)
                }
            }
        }
        _clip_pop(win)
        if order.length() > shown {
            track := self.height - rh - 4
            bar := _max(8, track * shown / order.length())
            by := self.y + 2 + rh + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== ScrollView =====

// The focused widget inside w (w included), or null.
define _focused_in(w: Widget) -> Widget {
    if not w.visible { return null }
    if w.focused { return w }
    for c in w.children() {
        f := _focused_in(c)
        if f != null { return f }
    }
    return null
}

---
Shows `content` (any widget, usually a Column) in an area `height`
pixels tall that scrolls when the content is taller: mouse wheel, drag
the scroll bar, or Tab to a widget that's out of view. `offset` is how
far it's scrolled (pixels). With `expand` it takes its container's free
height instead.
---
struct ScrollView : Widget {
    content: Widget
    max_height: Int
    offset: Int
    step: Int
    _drag: Int
    _seen_focus: Widget
    define access_role(self) -> String {
        return "scrollpane"
    }


    define __init(self, content: Widget, height: Int = 200, expand: Bool = false) -> void {
        super().__init()
        self.content = content
        self.max_height = height
        self.expand = expand
        self.offset = 0
        self.step = 40
        self._drag = -1
        self._seen_focus = null
        self.takes_clicks = true
    }

    define children(self) -> List {
        return [self.content]
    }

    define _bar_w(self) -> Int {
        return 10
    }

    define _most(self) -> Int {
        return _max(0, self.content.min_h - self.height)
    }

    --- Scroll so `pixels` from the top of the content is at the top (clamped). ---
    define scroll_to(self, pixels: Int) -> void {
        self.offset = _clamp(pixels, 0, self._most())
    }

    define measure(self, t: Theme) -> void {
        self.content.measure(t)
        self.min_w = self.content.min_w + self._bar_w()
        self.min_h = _min(self.content.min_h, self.max_height)
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.offset = _clamp(self.offset, 0, self._most())
        cw := width - self._bar_w()
        ch := _max(self.content.min_h, height)
        self.content.place(x, y - self.offset, cw, ch)
        // Newly focused widget out of view (Tab): scroll to it, once.
        f := _focused_in(self.content)
        if f != null and f != self._seen_focus {
            if f.y < y {
                self.scroll_to(self.offset - (y - f.y))
            } elif f.y + f.height > y + height {
                self.scroll_to(self.offset + (f.y + f.height - y - height))
            }
            self.content.place(x, y - self.offset, cw, ch)
        }
        self._seen_focus = f
    }

    define _thumb(self) -> List {
        track := self.height
        bar := _max(16, track * self.height / _max(1, self.content.min_h))
        ty := self.y + (track - bar) * self.offset / _max(1, self._most())
        return [ty, bar]
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "wheel" {
            if self._most() == 0 { return false }
            self.scroll_to(self.offset - e.dy * self.step)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 and self._most() > 0 and e.x >= self.x + self.width - self._bar_w() {
            th := self._thumb()
            ty: Int = th[0]
            bar: Int = th[1]
            if e.y >= ty and e.y < ty + bar {
                self._drag = e.y - ty
            } else {
                // Click on the track: jump there, then drag from the middle.
                self._drag = bar / 2
                self._drag_to(e.y)
            }
            return true
        }
        if e.kind == "mouse_move" and self._drag >= 0 {
            self._drag_to(e.y)
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = -1
            return true
        }
        return false
    }

    define _drag_to(self, py: Int) -> void {
        th := self._thumb()
        bar: Int = th[1]
        room := _max(1, self.height - bar)
        rel := _clamp(py - self._drag - self.y, 0, room)
        self.scroll_to(rel * self._most() / room)
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        _clip_push(win, self.x, self.y, self.width, self.height)
        self.content.draw(win, t)
        _clip_pop(win)
        if self._most() > 0 {
            th := self._thumb()
            ty: Int = th[0]
            bar: Int = th[1]
            bx := self.x + self.width - self._bar_w() + 3
            win.rect(bx, self.y, 4, self.height, mix(t.border, t.background, 40))
            thumb := t.muted
            if self._drag >= 0 or self.hovered { thumb = mix(t.muted, t.text, 40) }
            win.rect(bx, ty, 4, bar, thumb)
        }
    }
}

// ===== Dropdown =====

---
Pick one of `options` (anything with `.str()`) from a list that opens
below the field. Click it, or Space / Enter / Alt+Down when focused;
Up / Down change the choice directly while it's closed. `selected` is
the index; `on_change(index, item)` runs when it changes.
---
struct Dropdown : Widget {
    options: List
    selected: Int
    on_change: Callable
    is_open: Bool
    max_rows: Int
    _hover: Int
    _top: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if not self.enabled { return false }
        if action == "select" and node.index >= 0 {
            self.select(node.index)
            self.close()
        } elif action == "expand" {
            self.open()
        } elif action == "collapse" {
            self.close()
        } elif action == "set_value" {
            i := 0
            while i < self.options.length() {
                if String(self.options[i]) == value {
                    self.select(i)
                    return true
                }
                i = i + 1
            }
            return false
        } else {
            return false
        }
        return true
    }

    define access_role(self) -> String {
        return "combobox"
    }

    define access_value(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return String(self.options[self.selected])
    }

    define _a11y_states(self, out: List) -> void {
        out.append(self.is_open ? "expanded" : "collapsed")
    }

    define _a11y_children(self) -> List {
        out := []
        if not self.is_open { return out }
        i := 0
        while i < self.options.length() {
            item := AccessNode("option", String(self.options[i]))._item(self, i)
            if i == self.selected { item.states.append("selected") }
            out.append(item)
            i = i + 1
        }
        return out
    }


    define __init(self, options: List, selected: Int = 0, on_change: Callable = null, expand: Bool = false) -> void {
        super().__init()
        self.options = options
        self.selected = _clamp(selected, 0, _max(0, options.length() - 1))
        self.on_change = on_change
        self.expand = expand
        self.is_open = false
        self.max_rows = 8
        self._hover = -1
        self._top = 0
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
        self.focusable = true
    }

    --- The chosen option as text ("" when there are none). ---
    define text(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return self.options[self.selected].str()
    }

    --- Choose option `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.options.length() == 0 { return }
        ni := _clamp(i, 0, self.options.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.options[ni]) }
        }
    }

    --- Show the list. ---
    define open(self) -> void {
        if self.is_open or not self.enabled or self.options.length() == 0 { return }
        self.is_open = true
        self._hover = self.selected
        _popups.append(self)
    }

    --- Hide the list. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define close_popup(self) -> void {
        self.close()
    }

    define _rows(self) -> Int {
        return _max(1, _min(self.max_rows, self.options.length()))
    }

    define _row_h(self) -> Int {
        return 24
    }

    define measure(self, t: Theme) -> void {
        widest := 4 * t.char_w()
        for o in self.options { widest = _max(widest, t.text_w(o.str())) }
        self.min_w = widest + 16 + 3 * t.char_w()
        self.min_h = t.line() + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            if self.is_open { self.close() } else { self.open() }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        if self.is_open {
            if k == "down" {
                self._hover = _min(self.options.length() - 1, self._hover + 1)
            } elif k == "up" {
                self._hover = _max(0, self._hover - 1)
            } elif k == "home" {
                self._hover = 0
            } elif k == "end" {
                self._hover = self.options.length() - 1
            } elif k == "return" or k == "keypad_enter" or k == "space" {
                if self._hover >= 0 { self.select(self._hover) }
                self.close()
            } elif k == "escape" {
                self.close()
            } else {
                return false
            }
            if self._hover < self._top { self._top = self._hover }
            if self._hover >= self._top + self._rows() { self._top = self._hover - self._rows() + 1 }
            return true
        }
        if k == "space" or k == "return" or k == "keypad_enter" or (k == "down" and e.alt) {
            self.open()
        } elif k == "down" {
            self.select(self.selected + 1)
        } elif k == "up" {
            self.select(self.selected - 1)
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused or self.is_open {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        cw := t.char_w()
        label := self.text()
        label = t.fit(label, self.width - 16 - 3 * cw)
        win.text(label, self.x + 8, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale, font=t.font)
        // The arrow: a small filled triangle pointing down.
        ax := self.x + self.width - 8 - cw
        ay := self.y + self.height / 2 - 2
        half := _max(3, cw / 2)
        r := 0
        while r <= half {
            win.line(ax - half + r, ay + r, ax + half - r, ay + r, _ink(self, t.muted, t))
            r = r + 1
        }
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph
    }

    define popup_handle(self, e: window.Event) -> Bool {
        rh := self._row_h()
        if e.kind == "mouse_move" {
            row := (e.y - self._py - 2) / rh
            self._hover = _clamp(self._top + row, 0, self.options.length() - 1)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self._py - 2) / rh
            i := self._top + row
            if i >= 0 and i < self.options.length() { self.select(i) }
            self.close()
            return true
        }
        if e.kind == "wheel" {
            most := _max(0, self.options.length() - self._rows())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        return e.kind == "mouse_up"
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        rh := self._row_h()
        rows := self._rows()
        self._pw = self.width
        self._ph = rows * rh + 4
        self._px = self.x
        self._py = self.y + self.height + 2
        // No room below: open upwards.
        if self._py + self._ph > win.height() and self.y - self._ph - 2 >= 0 { self._py = self.y - self._ph - 2 }
        self._top = _clamp(self._top, 0, _max(0, self.options.length() - rows))
        win.rect(self._px + 3, self._py + 3, self._pw, self._ph, mix(t.background, window.black(), 45))   // shadow
        win.rect(self._px, self._py, self._pw, self._ph, t.surface)
        win.rect(self._px, self._py, self._pw, self._ph, t.border, fill=false)
        fit := self._pw - 16
        i := self._top
        while i < self.options.length() and i < self._top + rows {
            ry := self._py + 2 + (i - self._top) * rh
            ink := t.text
            if i == self._hover {
                win.rect(self._px + 2, ry, self._pw - 4, rh, t.accent)
                ink = t.accent_text
            } elif i == self.selected {
                win.rect(self._px + 2, ry, self._pw - 4, rh, mix(t.accent, t.surface, 75))
            }
            label := self.options[i].str()
            label = t.fit(label, fit)
            win.text(label, self._px + 8, ry + (rh - t.line()) / 2, ink, scale=t.scale, font=t.font)
            i = i + 1
        }
        if self.options.length() > rows {
            track := self._ph - 4
            bar := _max(8, track * rows / self.options.length())
            most := _max(1, self.options.length() - rows)
            by := self._py + 2 + (track - bar) * self._top / most
            win.rect(self._px + self._pw - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Tabs =====

---
Pages under a row of tabs: `ui.Tabs(["General", "Advanced"], [page1, page2])`.
Click a tab, or Left / Right when the tab row has the focus. `selected`
is the page shown; `on_change(index, title)` runs when it changes;
`add(title, page)` adds one, `close(i)` removes one.
`closable=true` puts a × on each tab: clicking it (or middle-clicking the
tab) calls `on_close(index)` — say, to ask about unsaved changes, then
`close(index)` — or, without an `on_close`, closes the tab.
---
struct Tabs : Widget {
    titles: List
    pages: List
    selected: Int
    on_change: Callable
    closable: Bool           // a × on each tab
    on_close: Callable       // on_close(index) when it's clicked (else the tab just closes)
    _tab_h: Int
    _xs: List
    _mx: Int
    _my: Int
    _cw: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "select" or node.index < 0 or not self.enabled { return false }
        self.select(node.index)
        return true
    }

    define access_role(self) -> String {
        return "tablist"
    }

    define access_value(self) -> String {
        if self.selected < 0 or self.selected >= self.titles.length() { return "" }
        return String(self.titles[self.selected])
    }

    // One "tab" per title, then the shown page as a "tabpanel".
    define _a11y_children(self) -> List {
        out := []
        i := 0
        while i < self.titles.length() {
            tab := AccessNode("tab", String(self.titles[i]))._item(self, i)
            if i == self.selected { tab.states.append("selected") }
            out.append(tab)
            i = i + 1
        }
        p := self.page()
        if p != null and p.visible {
            pw: Widget = p
            panel := AccessNode("tabpanel", self.access_value(), "", pw.x, pw.y, pw.width, pw.height)
            node := pw.access_node()
            if node != null { panel.children.append(node) }
            out.append(panel)
        }
        return out
    }


    define __init(self, titles: List, pages: List, selected: Int = 0, on_change: Callable = null, expand: Bool = false,
                  closable: Bool = false, on_close: Callable = null) -> void {
        super().__init()
        self.titles = titles
        self.pages = pages
        self.selected = _clamp(selected, 0, _max(0, pages.length() - 1))
        self.on_change = on_change
        self.closable = closable
        self.on_close = on_close
        self.expand = expand
        self._tab_h = 28
        self._xs = []
        self._mx = -1
        self._my = -1
        self._cw = 8
        self.focusable = true
    }

    ---
    Remove tab `i` (its title and page). The selection stays on the same
    page when it can (the one after it when it's the one removed); runs
    `on_change` when the page shown changes.
    ---
    define close(self, i: Int) -> void {
        if i < 0 or i >= self.pages.length() { return }
        shown := self.selected
        self.titles.remove_at(i)
        self.pages.remove_at(i)
        n := self.pages.length()
        if n == 0 {
            self.selected = 0
            return
        }
        if i < shown {
            self.selected = shown - 1                       // the same page, one place left
        } elif i == shown {
            self.selected = _clamp(shown, 0, n - 1)         // the next one (or the new last)
            if self.on_change != null { self.on_change(self.selected, self.titles[self.selected]) }
        }
    }

    --- Add a page with its tab title. ---
    define add(self, title: String, page: Widget) -> void {
        self.titles.append(title)
        self.pages.append(page)
    }

    --- Show page `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.pages.length() == 0 { return }
        ni := _clamp(i, 0, self.pages.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.titles[ni]) }
        }
    }

    --- The page being shown (null when there are none). ---
    define page(self) -> Widget {
        if self.selected < 0 or self.selected >= self.pages.length() { return null }
        return self.pages[self.selected]
    }

    define children(self) -> List {
        p := self.page()
        if p == null { return [] }
        return [p]
    }

    define measure(self, t: Theme) -> void {
        self._tab_h = t.line() + 12
        tw := 0
        for title in self.titles { tw = tw + t.text_w(title.str()) + (self.closable ? 6 : 3) * t.char_w() }
        pw := 0
        ph := 0
        for pg in self.pages {
            w: Widget = pg
            w.measure(t)
            pw = _max(pw, w.min_w)
            ph = _max(ph, w.min_h)
        }
        self.min_w = _max(tw, pw + 16)
        self.min_h = self._tab_h + ph + 16
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        p := self.page()
        if p != null { p.place(x + 8, y + self._tab_h + 8, width - 16, height - self._tab_h - 16) }
    }

    // Is x on tab i's × (with the char width the last draw used)?
    define _on_close_box(self, i: Int, px: Int) -> Bool {
        if i + 1 >= self._xs.length() { return false }
        b: Int = self._xs[i + 1]
        size := self._cw * 2
        return px >= b - size - 8 and px < b - 4
    }

    // The tab under x, or -1.
    define _tab_at(self, px: Int) -> Int {
        i := 0
        while i + 1 < self._xs.length() {
            a: Int = self._xs[i]
            b: Int = self._xs[i + 1]
            if px >= a and px < b { return i }
            i = i + 1
        }
        return -1
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_move" {
            self._mx = e.x
            self._my = e.y
            return false
        }
        if e.kind == "mouse_down" and (e.button == 1 or e.button == 2) {
            if e.y < self.y + self._tab_h {
                i := self._tab_at(e.x)
                if i >= 0 and self.closable and (e.button == 2 or self._on_close_box(i, e.x)) {
                    // The ×, or a middle click on the tab.
                    if self.on_close != null { self.on_close(i) } else { self.close(i) }
                    return true
                }
                if i >= 0 and e.button == 1 { self.select(i) }
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" {
            if e.key == "right" or (e.key == "tab" and e.ctrl and not e.shift) {
                self.select((self.selected + 1) % _max(1, self.pages.length()))
                return true
            }
            if e.key == "left" or (e.key == "tab" and e.ctrl and e.shift) {
                self.select((self.selected + self.pages.length() - 1) % _max(1, self.pages.length()))
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        th := self._tab_h
        win.rect(self.x, self.y + th, self.width, self.height - th, t.surface)
        win.rect(self.x, self.y + th, self.width, self.height - th, t.border, fill=false)
        xs := [self.x]
        tx := self.x
        i := 0
        self._cw = t.char_w()
        if self.closable and self.hovered {
            pointer := win.mouse()                      // (mouse_move goes to the App, not to widgets)
            self._mx = pointer.0
            self._my = pointer.1
        } elif not self.hovered {
            self._mx = -1
        }
        while i < self.titles.length() {
            title := self.titles[i].str()
            w := t.text_w(title) + (self.closable ? 6 : 3) * t.char_w()
            bg := t.background
            ink := t.muted
            if i == self.selected {
                bg = t.surface
                ink = t.text
            } elif self.hovered {
                ink = mix(t.muted, t.text, 40)
            }
            win.rect(tx, self.y, w, th + 1, bg)
            win.rect(tx, self.y, w, th + 1, t.border, fill=false)
            if i == self.selected {
                win.rect(tx + 1, self.y + th, w - 2, 1, t.surface)                 // open into the page
                win.rect(tx, self.y, w, 2, _ink(self, t.accent, t))
            }
            if self.closable {
                // The title on the left, the × on the right (brighter under the mouse).
                win.text(title, tx + t.char_w() + t.char_w() / 2, self.y + (th - t.line()) / 2,
                         _ink(self, ink, t), scale=t.scale, font=t.font)
                size := t.char_w() * 2
                bx := tx + w - size - 6
                over := self._my >= self.y and self._my < self.y + th and self._mx >= bx - 2 and self._mx < tx + w - 4
                if over { win.rect(bx - 2, self.y + (th - size) / 2, size + 4, size, mix(bg, t.text, 15)) }
                xink := over ? t.text : (i == self.selected ? t.muted : mix(t.muted, bg, 30))
                win.text("×", bx + (size - t.text_w("×")) / 2, self.y + (th - t.line()) / 2,
                         _ink(self, xink, t), scale=t.scale, font=t.font)
            } else {
                win.text(title, tx + (w - t.text_w(title)) / 2, self.y + (th - t.line()) / 2,
                         _ink(self, ink, t), scale=t.scale, font=t.font)
            }
            tx = tx + w
            xs.append(tx)
            i = i + 1
        }
        self._xs = xs
        if self.focused {
            win.rect(self.x - 2, self.y - 2, tx - self.x + 4, th + 4, t.focus, fill=false)
        }
        p := self.page()
        if p != null and p.visible { p.draw(win, t) }
    }
}

// ===== Menus =====

---
One entry of a `ui.Menu`: `text`, `on_click` (no arguments), an optional
`shortcut` label shown on the right (just text — bind the keys yourself
with `app.on_key`), and `enabled`. `ui.MenuItem("-")` is a separator.
---
struct MenuItem {
    text: String
    on_click: Callable
    shortcut: String
    enabled: Bool
    bound: Bool              // false: the shortcut is only shown (the focused widget handles that key)

    define __init(self, text: String, on_click: Callable = null, shortcut: String = "", enabled: Bool = true, bound: Bool = true) -> void {
        self.text = text
        self.on_click = on_click
        self.shortcut = shortcut
        self.enabled = enabled
        self.bound = bound
    }

    --- True for a separator line. ---
    define is_separator(self) -> Bool {
        return self.text == "-"
    }

    --- True when key event `e` is this item's `shortcut` ("Ctrl+S", "Ctrl+Shift+N", "F5", "Delete"; Ctrl also matches Cmd). ---
    define matches(self, e: window.Event) -> Bool {
        if self.shortcut.length() == 0 or e.kind != "key_down" or not self.bound { return false }
        parts := self.shortcut.split("+")
        ctrl := false
        shift := false
        alt := false
        key := ""
        for p in parts {
            word: String = p
            w := word.trim().lower()
            if w == "ctrl" or w == "cmd" or w == "control" { ctrl = true }
            elif w == "shift" { shift = true }
            elif w == "alt" or w == "option" { alt = true }
            elif w == "del" { key = "delete" }
            elif w == "esc" { key = "escape" }
            elif w == "enter" { key = "return" }
            elif w == "pgup" { key = "pageup" }
            elif w == "pgdn" { key = "pagedown" }
            elif w == "ins" { key = "insert" }
            else { key = w }
        }
        if key.length() == 0 { return false }
        return e.key == key and (e.ctrl or e.meta) == ctrl and e.shift == shift and e.alt == alt
    }
}

---
A list of `ui.MenuItem`s that pops up: under a `ui.MenuBar` title, or
where the user right-clicks a widget whose `context_menu` it is
(`menu.open_at(x, y)` from code). Click an item, or Up / Down and Enter;
Escape closes it.
---
struct Menu : Widget {
    items: List
    is_open: Bool
    bar: MenuBar
    _hover: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if action != "invoke" or node.index < 0 { return false }
        self.activate(node.index)
        return true
    }

    define access_role(self) -> String {
        return "menu"
    }

    define _a11y_children(self) -> List {
        out := []
        k := -1
        for it in self.items {
            mi: MenuItem = it
            k = k + 1
            if mi.is_separator() { continue }
            node := AccessNode("menuitem", mi.text)._item(self, k)
            node.description = mi.shortcut
            if not mi.enabled { node.states.append("disabled") }
            out.append(node)
        }
        return out
    }


    define __init(self, items: List) -> void {
        super().__init()
        self.items = items
        self.is_open = false
        self.bar = null
        self._hover = -1
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
    }

    define _item(self, i: Int) -> MenuItem {
        return self.items[i]
    }

    define _usable(self, i: Int) -> Bool {
        if i < 0 or i >= self.items.length() { return false }
        it := self._item(i)
        return it.enabled and not it.is_separator()
    }

    define open_at(self, px: Int, py: Int) -> void {
        if self.is_open { self.close() }
        self._px = px
        self._py = py
        self._hover = -1
        self.is_open = true
        _popups.append(self)
    }

    --- Hide it. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
        if self.bar != null { self.bar.close_popup() }
    }

    define close_popup(self) -> void {
        self.close()
    }

    // Run item i: close every popup first (its action may open another).
    define activate(self, i: Int) -> void {
        if not self._usable(i) { return }
        it := self._item(i)
        _close_popups()
        if it.on_click != null { it.on_click() }
    }

    define _row_h(self, i: Int) -> Int {
        if self._item(i).is_separator() { return 9 }
        return 24
    }

    define _row_at(self, py: Int) -> Int {
        y := self._py + 2
        i := 0
        while i < self.items.length() {
            h := self._row_h(i)
            if py >= y and py < y + h { return i }
            y = y + h
            i = i + 1
        }
        return -1
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        if px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph { return true }
        // A menu bar's title row belongs to its open menu (hover to switch).
        return self.bar != null and self.bar.contains(px, py)
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if self.bar != null and self.bar.contains(e.x, e.y) {
            return self.bar._while_open(e)
        }
        if e.kind == "mouse_move" {
            r := self._row_at(e.y)
            if self._usable(r) { self._hover = r } else { self._hover = -1 }
            return true
        }
        if (e.kind == "mouse_up" or e.kind == "mouse_down") and e.button == 1 {
            r := self._row_at(e.y)
            if e.kind == "mouse_up" and self._usable(r) { self.activate(r) }
            return true
        }
        return true
    }

    define _step(self, by: Int) -> void {
        n := self.items.length()
        if n == 0 { return }
        i := self._hover
        tries := 0
        while tries < n {
            i = (i + by + n) % n
            if self._usable(i) {
                self._hover = i
                return
            }
            tries = tries + 1
        }
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind != "key_down" { return e.kind == "key_up" or e.kind == "text" or e.kind == "compose" }
        k := e.key
        if k == "down" {
            self._step(1)
        } elif k == "up" {
            if self._hover < 0 { self._hover = 0 }
            self._step(-1)
        } elif k == "return" or k == "keypad_enter" or k == "space" {
            if self._usable(self._hover) { self.activate(self._hover) } else { self.close() }
        } elif k == "escape" {
            self.close()
        } elif (k == "left" or k == "right") and self.bar != null {
            self.bar._switch(k == "right")
        } else {
            return true          // an open menu takes the keyboard
        }
        return true
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        cw := t.char_w()
        widest := 0
        hint := 0
        h := 4
        i := 0
        while i < self.items.length() {
            it := self._item(i)
            widest = _max(widest, t.text_w(it.text))
            hint = _max(hint, t.text_w(it.shortcut))
            h = h + self._row_h(i)
            i = i + 1
        }
        self._pw = widest + 4 * cw + 16
        if hint > 0 { self._pw = self._pw + hint + 3 * cw }
        self._ph = h
        // Keep it on screen.
        if self._px + self._pw > win.width() { self._px = _max(0, win.width() - self._pw) }
        if self._py + self._ph > win.height() { self._py = _max(0, self._py - self._ph) }
        win.rect(self._px + 3, self._py + 3, self._pw, self._ph, mix(t.background, window.black(), 45))
        win.rect(self._px, self._py, self._pw, self._ph, t.surface)
        win.rect(self._px, self._py, self._pw, self._ph, t.border, fill=false)
        y := self._py + 2
        i = 0
        while i < self.items.length() {
            it := self._item(i)
            rh := self._row_h(i)
            if it.is_separator() {
                win.rect(self._px + 6, y + rh / 2, self._pw - 12, 1, t.border)
            } else {
                ink := t.text
                if not it.enabled { ink = mix(t.text, t.surface, 55) }
                if i == self._hover {
                    win.rect(self._px + 2, y, self._pw - 4, rh, t.accent)
                    ink = t.accent_text
                }
                ty := y + (rh - t.line()) / 2
                win.text(it.text, self._px + 2 * cw, ty, ink, scale=t.scale, font=t.font)
                if it.shortcut.length() > 0 {
                    sw := t.text_w(it.shortcut)
                    sink := t.muted
                    if i == self._hover { sink = t.accent_text }
                    win.text(it.shortcut, self._px + self._pw - 2 * cw - sw, ty, sink, scale=t.scale, font=t.font)
                }
            }
            y = y + rh
            i = i + 1
        }
    }
}

---
A row of menu titles, usually at the top of the window:
`ui.MenuBar(["File", "Edit"], [file_menu, edit_menu])`. Click a title to
open its menu; while one is open, moving over another title (or Left /
Right) switches to it.
---
struct MenuBar : Widget {
    titles: List
    menus: List
    flat: Bool               // no bar of its own (in a TitleBar): titles lit when hovered / open
    _open: Int
    _xs: List
    define access_action(self, action: String, value: String, node: AccessNode) -> Bool {
        if node.index < 0 { return false }
        if action == "expand" or action == "invoke" {
            self.open_menu(node.index)
        } elif action == "collapse" {
            self.close_popup()
        } else {
            return false
        }
        return true
    }

    define access_role(self) -> String {
        return "menubar"
    }

    define _a11y_children(self) -> List {
        out := []
        i := 0
        while i < self.titles.length() {
            node := AccessNode("menuitem", String(self.titles[i]))._item(self, i)
            if i < self.menus.length() {
                m: Menu = self.menus[i]
                node.states.append(m.is_open ? "expanded" : "collapsed")
                if m.is_open { node.children.append(m.access_node()) }
            }
            out.append(node)
            i = i + 1
        }
        return out
    }


    define __init(self, titles: List, menus: List, flat: Bool = false) -> void {
        super().__init()
        self.titles = titles
        self.menus = menus
        self.flat = flat
        self._open = -1
        self._xs = []
        self.takes_clicks = true
        for m in menus {
            mm: Menu = m
            mm.bar = self
        }
    }

    define is_menu_bar(self) -> Bool {
        return true
    }

    define measure(self, t: Theme) -> void {
        w := 0
        for title in self.titles { w = w + t.text_w(title.str()) + 2 * t.char_w() }
        self.min_w = w
        self.min_h = t.line() + 10
    }

    define _title_at(self, px: Int) -> Int {
        i := 0
        while i + 1 < self._xs.length() {
            a: Int = self._xs[i]
            b: Int = self._xs[i + 1]
            if px >= a and px < b { return i }
            i = i + 1
        }
        return -1
    }

    --- Open menu `i` under its title (-1: close). ---
    define open_menu(self, i: Int) -> void {
        if self._open >= 0 and self._open < self.menus.length() {
            was: Menu = self.menus[self._open]
            self._open = -1
            was.close()
        }
        if i < 0 or i >= self.menus.length() or i + 1 >= self._xs.length() { return }
        m: Menu = self.menus[i]
        x: Int = self._xs[i]
        m.open_at(x, self.y + self.height)
        self._open = i
    }

    define close_popup(self) -> void {
        self._open = -1
    }

    define _switch(self, forward: Bool) -> void {
        n := self.menus.length()
        if n == 0 or self._open < 0 { return }
        nxt := (self._open + n - 1) % n
        if forward { nxt = (self._open + 1) % n }
        self.open_menu(nxt)
    }

    // Mouse over the bar while one of its menus is open.
    define _while_open(self, e: window.Event) -> Bool {
        i := self._title_at(e.x)
        if e.kind == "mouse_move" {
            if i >= 0 and i != self._open { self.open_menu(i) }
        } elif e.kind == "mouse_down" and e.button == 1 {
            if i == self._open or i < 0 { self.open_menu(-1) } else { self.open_menu(i) }
        }
        return true
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 {
            i := self._title_at(e.x)
            if i >= 0 { self.open_menu(i) }
            return true
        }
        return e.kind == "mouse_up"
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if not self.flat {
            win.rect(self.x, self.y, self.width, self.height, t.surface)
            win.rect(self.x, self.y + self.height - 1, self.width, 1, t.border)
        }
        hover := -1
        if self.flat and self.hovered and self._xs.length() > 0 {
            m := win.mouse()
            if m.1 >= self.y and m.1 < self.y + self.height { hover = self._title_at(m.0) }
        }
        xs := [self.x]
        tx := self.x
        i := 0
        while i < self.titles.length() {
            title := self.titles[i].str()
            w := t.text_w(title) + 2 * t.char_w()
            ink := t.text
            if self.flat {
                if i == self._open or i == hover {
                    win.rect(tx, self.y + 3, w, self.height - 6, mix(t.surface, t.text, i == self._open ? 18 : 10))
                }
            } elif i == self._open {
                win.rect(tx, self.y, w, self.height - 1, t.accent)
                ink = t.accent_text
            }
            win.text(title, tx + t.char_w(), self.y + (self.height - t.line()) / 2, ink, scale=t.scale, font=t.font)
            tx = tx + w
            xs.append(tx)
            i = i + 1
        }
        self._xs = xs
    }
}

// ===== FileDialog =====

---
A window-sized dialog to pick a file (`mode="open"`), a name to save as
(`mode="save"`) or a folder (`mode="folder"`), starting in `dir`.
`filter` (e.g. "*.qk") limits the files shown. `show()` opens it;
`on_pick(path)` runs with the full path chosen, `on_cancel()` (optional)
when it's dismissed. Double-click or Enter opens a folder or picks a
file; Backspace goes up a folder; Tab moves between the list and the
name field; Escape cancels. While it's open it takes all input.
---
struct FileDialog : Widget {
    mode: String
    dir: String
    filter: String
    title: String
    show_hidden: Bool
    on_pick: Callable
    on_cancel: Callable
    is_open: Bool
    _names: List
    _dirs: List
    _list: ListView
    _name: TextInput
    _ok: Button
    _cancel: Button
    _in_name: Bool
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    define access_role(self) -> String {
        return "dialog"
    }

    define _a11y_name(self) -> String {
        return self.title
    }


    define __init(self, mode: String = "open", dir: String = ".", on_pick: Callable = null, filter: String = "", title: String = "", on_cancel: Callable = null) -> void {
        super().__init()
        self.mode = mode
        self.dir = fs.absolute(dir)
        self.filter = filter
        self.title = title
        if title == "" {
            if mode == "save" { self.title = "Save as" }
            elif mode == "folder" { self.title = "Choose a folder" }
            else { self.title = "Open" }
        }
        self.show_hidden = false
        self.on_pick = on_pick
        self.on_cancel = on_cancel
        self.is_open = false
        self._names = []
        self._dirs = []
        self._list = ListView([], rows=8)
        self._name = TextInput("", columns=30)
        label := "Open"
        if mode == "save" { label = "Save" }
        if mode == "folder" { label = "Choose" }
        self._ok = Button(label)
        self._cancel = Button("Cancel")
        self._in_name = mode == "save"
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
    }

    --- Open the dialog (reading `dir`). ---
    define show(self) -> void {
        _close_popups()
        self.go(self.dir)
        self.is_open = true
        _popups.append(self)
    }

    --- Show folder `path`. ---
    define go(self, path: String) -> void {
        if not fs.is_dir(path) { return }
        self.dir = fs.absolute(path)
        dirs := []
        files := []
        for e in fs.list_dir(self.dir) {
            name: String = e
            if not self.show_hidden and name.startswith(".") { continue }
            if fs.is_dir(fs.join(self.dir, name)) {
                dirs.append(name)
            } elif self.mode != "folder" and (self.filter == "" or fs.matches(self.filter, name)) {
                files.append(name)
            }
        }
        dirs = _sorted_names(dirs)
        files = _sorted_names(files)
        names := []
        kinds := []
        if fs.dirname(self.dir) != self.dir {
            names.append("..")
            kinds.append(true)
        }
        for d in dirs {
            names.append(d)
            kinds.append(true)
        }
        for f in files {
            names.append(f)
            kinds.append(false)
        }
        self._names = names
        self._dirs = kinds
        shown := []
        i := 0
        while i < names.length() {
            n: String = names[i]
            isd: Bool = kinds[i]
            if isd and n != ".." { shown.append(n + "/") } else { shown.append(n) }
            i = i + 1
        }
        self._list.items = shown
        self._list.selected = -1
        self._list._top = 0
        if shown.length() > 0 { self._list.select(0) }
    }

    --- Dismiss the dialog without a choice. ---
    define cancel(self) -> void {
        self.close_popup()
        if self.on_cancel != null { self.on_cancel() }
    }

    define close_popup(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define _pick(self, path: String) -> void {
        self.close_popup()
        if self.on_pick != null { self.on_pick(path) }
    }

    // Enter / double-click on list row i.
    define _open_row(self, i: Int) -> void {
        if i < 0 or i >= self._names.length() { return }
        name: String = self._names[i]
        isd: Bool = self._dirs[i]
        if name == ".." {
            self.go(fs.dirname(self.dir))
        } elif isd {
            self.go(fs.join(self.dir, name))
        } elif self.mode == "save" {
            self._name.text = name
            self._name.select_all()
            self._confirm()
        } else {
            self._pick(fs.join(self.dir, name))
        }
    }

    // The Open / Save / Choose button.
    define _confirm(self) -> void {
        if self.mode == "save" {
            name := self._name.text.trim()
            if name.length() > 0 { self._pick(fs.join(self.dir, name)) }
        } elif self.mode == "folder" {
            i := self._list.selected
            if i >= 0 and i < self._names.length() {
                n: String = self._names[i]
                if n != ".." {
                    self._pick(fs.join(self.dir, n))
                    return
                }
            }
            self._pick(self.dir)
        } else {
            self._open_row(self._list.selected)
        }
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return true                               // modal: every click is ours
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if self._list.contains(e.x, e.y) or (e.kind == "wheel") {
            if e.kind == "mouse_down" {
                self._in_name = false
                self._list.focused = true
                self._name.focused = false
            }
            self._list.handle(e)
            if e.kind == "mouse_down" and e.button == 1 and e.clicks >= 2 { self._open_row(self._list.selected) }
            elif e.kind == "mouse_down" and self.mode == "save" {
                i := self._list.selected
                if i >= 0 {
                    isd: Bool = self._dirs[i]
                    if not isd { self._name.text = self._names[i] }
                }
            }
            return true
        }
        if self.mode == "save" and (self._name.contains(e.x, e.y) or self._name._dragging) {
            if e.kind == "mouse_down" {
                self._in_name = true
                self._name.focused = true
                self._list.focused = false
            }
            self._name.handle(e)
            return true
        }
        for b in [self._ok, self._cancel] {
            btn: Button = b
            if e.kind == "mouse_down" and e.button == 1 { btn.pressed = btn.contains(e.x, e.y) }
            if e.kind == "mouse_up" and e.button == 1 {
                was := btn.pressed
                btn.pressed = false
                if was and btn.contains(e.x, e.y) {
                    if btn == self._ok { self._confirm() } else { self.cancel() }
                    return true
                }
            }
        }
        return true
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind == "key_down" {
            k := e.key
            if k == "escape" {
                self.cancel()
                return true
            }
            if k == "tab" and self.mode == "save" {
                self._in_name = not self._in_name
                return true
            }
            if k == "return" or k == "keypad_enter" {
                if self._in_name { self._confirm() } else { self._open_row(self._list.selected) }
                return true
            }
            if k == "backspace" and not self._in_name {
                self.go(fs.dirname(self.dir))
                return true
            }
        }
        if self._in_name { self._name.handle(e) } else { self._list.handle(e) }
        return true
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        // Dim what's behind, then a centred panel.
        win.rect(0, 0, win.width(), win.height(), window.rgba(0, 0, 0, 110))
        self._pw = _min(win.width() - 24, 520)
        self._ph = _min(win.height() - 24, 380)
        self._px = (win.width() - self._pw) / 2
        self._py = (win.height() - self._ph) / 2
        x := self._px
        y := self._py
        w := self._pw
        h := self._ph
        win.rect(x + 4, y + 4, w, h, mix(t.background, window.black(), 50))
        win.rect(x, y, w, h, t.surface)
        win.rect(x, y, w, h, t.border, fill=false)
        lh := t.line()
        win.text(self.title, x + 12, y + 10, t.text, scale=t.scale, font=t.font)
        shown_dir := self.dir
        // Too long: keep the end ("...quirk/packages").
        if t.text_w(shown_dir) > w - 24 {
            cut := 0
            while cut < shown_dir.length() and t.text_w("..." + shown_dir.substring(cut, shown_dir.length())) > w - 24 { cut = cut + 1 }
            shown_dir = "..." + shown_dir.substring(cut, shown_dir.length())
        }
        win.text(shown_dir, x + 12, y + 10 + lh + 4, t.muted, scale=t.scale, font=t.font)
        top := y + 10 + 2 * lh + 14
        bottom := y + h - 12 - (lh + 12)          // the buttons row
        if self.mode == "save" { bottom = bottom - (lh + 12) - 8 }
        self._list.focused = not self._in_name
        self._name.focused = self._in_name
        self._list.measure(t)
        self._list.place(x + 12, top, w - 24, _max(30, bottom - top - 8))
        self._list.draw(win, t)
        if self.mode == "save" {
            self._name.measure(t)
            self._name.place(x + 12, bottom, w - 24, lh + 12)
            self._name.draw(win, t)
        }
        by := y + h - 12 - (lh + 12)
        for b in [self._cancel, self._ok] {
            btn: Button = b
            btn.measure(t)
        }
        okw := self._ok.min_w
        cw := self._cancel.min_w
        self._ok.place(x + w - 12 - okw, by, okw, lh + 12)
        self._cancel.place(x + w - 12 - okw - 8 - cw, by, cw, lh + 12)
        self._cancel.draw(win, t)
        self._ok.draw(win, t)
    }
}

// ===== Palette =====

---
A row of a `Palette`: its `label`, a muted `detail` after it (a file's
folder), a `hint` on the right (a shortcut), any `data`. `marks` /
`detail_marks` are character indices drawn in the accent colour — the
letters a fuzzy match found. `separator`: a line above the row (the start
of a group, as VS Code's remote menu).
---
struct PaletteItem {
    label: String
    detail: String
    hint: String
    data: Any
    marks: List
    detail_marks: List
    separator: Bool

    define __init(self, label: String, detail: String = "", hint: String = "", data: Any = null, marks: List = null, detail_marks: List = null, separator: Bool = false) -> void {
        self.label = label
        self.separator = separator
        self.detail = detail
        self.hint = hint
        self.data = data
        self.marks = marks != null ? marks : []
        self.detail_marks = detail_marks != null ? detail_marks : []
    }

    define __str(self) -> String {
        return self.label
    }
}

---
A command palette / quick open: a search field over a list, at the top of
the window (under the title bar). `on_query(text) -> List` gives the rows
for what's typed — `PaletteItem`s, or anything with `.str()`; Enter or a
click runs `on_pick(item)`, Escape or a click outside closes it
(`on_cancel()`). Up / Down (wrapping), Page Up / Page Down, Home / End
(with Ctrl) move. `show(text)` opens it with `text` typed.

    p := ui.Palette(on_query=fn(q) { return rows_for(q) }, on_pick=fn(it) { run(it) },
                    placeholder="Type a command")
    p.show()        // e.g. from Ctrl+Shift+P
---
struct Palette : Widget {
    placeholder: String
    on_query: Callable
    on_pick: Callable
    on_cancel: Callable
    rows: Int                // rows shown at most
    max_width: Int           // the panel's width at most (px)
    empty_text: String       // shown when nothing matches
    items: List              // the rows for the text typed
    selected: Int
    is_open: Bool
    input: TextInput
    _top: Int                // first row shown
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    _ly: Int                 // where the rows start
    _rh: Int
    _shown: Int              // rows that fit (the window may be short)

    define __init(self, on_query: Callable = null, on_pick: Callable = null, placeholder: String = "", on_cancel: Callable = null, rows: Int = 12, max_width: Int = 600) -> void {
        super().__init()
        self.placeholder = placeholder
        self.on_query = on_query
        self.on_pick = on_pick
        self.on_cancel = on_cancel
        self.rows = rows
        self.max_width = max_width
        self.empty_text = "No matching results"
        self.items = []
        self.selected = -1
        self.is_open = false
        self.input = TextInput("", placeholder=placeholder, columns=40)
        self._top = 0
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
        self._ly = 0
        self._rh = 0
        self._shown = rows
    }

    define access_role(self) -> String {
        return "dialog"
    }

    define _a11y_name(self) -> String {
        return self.placeholder
    }

    define access_value(self) -> String {
        return self.input.text
    }

    --- Open it with `text` typed (the cursor after it), the rows for it listed. ---
    define show(self, text: String = "") -> void {
        _close_popups()
        self.input.placeholder = self.placeholder
        self.input.text = text
        self.input.cursor = text.length()
        self.input.anchor = self.input.cursor
        self.input.focused = true
        self.is_open = true
        _popups.append(self)
        self.refresh()
    }

    --- The text typed. ---
    define query(self) -> String {
        return self.input.text
    }

    --- Ask `on_query` for the rows again (the first one selected). ---
    define refresh(self) -> void {
        got: List = []
        if self.on_query != null {
            r := self.on_query(self.input.text)
            if r != null { got = r }
        }
        self.items = got
        self._top = 0
        self.selected = got.length() > 0 ? 0 : -1
    }

    --- Close it without picking. ---
    define cancel(self) -> void {
        if not self.is_open { return }
        self.close_popup()
        if self.on_cancel != null { self.on_cancel() }
    }

    define close_popup(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        self.input.focused = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    --- Pick row `i` (the selected one by default): close, then `on_pick(item)`. ---
    define pick(self, i: Int = -1) -> void {
        at := i >= 0 ? i : self.selected
        if at < 0 or at >= self.items.length() { return }
        it := self.items[at]
        self.close_popup()
        if self.on_pick != null { self.on_pick(it) }
    }

    --- Select row `i` (kept on screen). ---
    define select(self, i: Int) -> void {
        n := self.items.length()
        if n == 0 {
            self.selected = -1
            return
        }
        self.selected = _clamp(i, 0, n - 1)
        vis := _max(1, _min(self.rows, self._shown))
        if self.selected < self._top { self._top = self.selected }
        if self.selected >= self._top + vis { self._top = self.selected - vis + 1 }
    }

    define next_redraw(self) -> Int {
        return self.input.next_redraw()      // the caret blinks
    }

    define _row_at(self, px: Int, py: Int) -> Int {
        if self._rh <= 0 or px < self._px or px >= self._px + self._pw or py < self._ly { return -1 }
        i := self._top + (py - self._ly) / self._rh
        if i >= self.items.length() or i >= self._top + self._shown { return -1 }
        return i
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return true                           // a click outside closes it (below)
    }

    define popup_handle(self, e: window.Event) -> Bool {
        inside := e.x >= self._px and e.x < self._px + self._pw and e.y >= self._py and e.y < self._py + self._ph
        if e.kind == "mouse_down" and not inside and not self.input._dragging {
            self.cancel()
            return true
        }
        if self.input.contains(e.x, e.y) or self.input._dragging {
            before := self.input.text
            self.input.handle(e)
            if self.input.text != before { self.refresh() }
            return true
        }
        if e.kind == "wheel" {
            n := self.items.length()
            self._top = _clamp(self._top - e.dy * 3, 0, _max(0, n - self._shown))
            return true
        }
        i := self._row_at(e.x, e.y)
        if e.kind == "mouse_move" and i >= 0 { self.selected = i }
        if e.kind == "mouse_down" and e.button == 1 and i >= 0 {
            self.selected = i
            self.pick(i)
        }
        return true
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind == "key_down" {
            k := e.key
            n := self.items.length()
            if k == "escape" {
                self.cancel()
                return true
            }
            if k == "return" or k == "keypad_enter" {
                self.pick()
                return true
            }
            if k == "up" or k == "down" {
                if n > 0 {
                    step := k == "up" ? n - 1 : 1
                    self.select(self.selected < 0 ? 0 : (self.selected + step) % n)
                }
                return true
            }
            if k == "pageup" {
                self.select(self.selected - self.rows)
                return true
            }
            if k == "pagedown" {
                self.select(self.selected + self.rows)
                return true
            }
            if (k == "home" or k == "end") and e.ctrl {
                self.select(k == "home" ? 0 : n - 1)
                return true
            }
            if k == "tab" { return true }
        }
        before := self.input.text
        self.input.handle(e)
        if self.input.text != before { self.refresh() }
        return true
    }

    // Text with the characters at `marks` in `hi` (the rest in `ink`), from x; its width.
    define _marked(self, win: window.Window, t: Theme, s: String, marks: List, x: Int, y: Int, ink: Int, hi: Int) -> Int {
        if marks.length() == 0 {
            win.text(s, x, y, ink, scale=t.scale, font=t.font)
            return t.text_w(s)
        }
        on := {}
        for m in marks { on[String(m)] = true }
        n := s.length()
        start := 0
        cur := on.has("0")
        i := 1
        while i <= n {
            here := i < n and on.has(String(i))
            if i == n or here != cur {
                piece := s.substring(start, i)
                px := x + t.text_w(s.substring(0, start))
                win.text(piece, px, y, cur ? hi : ink, scale=t.scale, font=t.font)
                if cur { win.text(piece, px + 1, y, hi, scale=t.scale, font=t.font) }     // (bold)
                start = i
                cur = here
            }
            i = i + 1
        }
        return t.text_w(s)
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        lh := t.line()
        cw := t.char_w()
        self._rh = lh + 8
        self._pw = _min(win.width() - 16, self.max_width)
        self._px = (win.width() - self._pw) / 2
        self._py = _bar_bottom[0] + 6
        n := self.items.length()
        shown := _min(n, self.rows)
        if n == 0 { shown = 1 }
        room := win.height() - self._py - 8 - (lh + 12) - 16
        if room > 0 and shown * self._rh > room { shown = _max(1, room / self._rh) }
        self._shown = shown
        self._ph = 8 + lh + 12 + 8 + shown * self._rh + 6
        x := self._px
        y := self._py
        w := self._pw
        win.rect(x + 3, y + 4, w, self._ph, mix(t.background, window.black(), 55))
        win.rect(x, y, w, self._ph, t.surface)
        win.rect(x, y, w, self._ph, t.border, fill=false)
        self.input.measure(t)
        self.input.focused = true
        self.input.place(x + 8, y + 8, w - 16, lh + 12)
        self.input.draw(win, t)
        self._ly = y + 8 + lh + 12 + 8
        if n == 0 {
            win.text(self.empty_text, x + 2 * cw, self._ly + (self._rh - lh) / 2, t.muted, scale=t.scale, font=t.font)
            return
        }
        hi := mix(t.accent, t.text, 35)
        sel_bg := mix(t.accent, t.surface, 60)
        i := self._top
        ry := self._ly
        while i < n and i < self._top + shown {
            v := self.items[i]
            ty := ry + (self._rh - lh) / 2
            if i == self.selected { win.rect(x + 4, ry, w - 8, self._rh, sel_bg) }
            lx := x + 2 * cw
            right := x + w - 2 * cw
            if v != null and type(v) == "PaletteItem" {
                it: PaletteItem = v
                if it.separator and i > self._top { win.rect(x + 4, ry, w - 8, 1, t.border) }
                if it.hint.length() > 0 {
                    hw := t.text_w(it.hint)
                    right = right - hw
                    win.text(it.hint, right, ty, t.muted, scale=t.scale, font=t.font)
                    right = right - 2 * cw
                }
                label := t.fit(it.label, right - lx)
                lw := self._marked(win, t, label, it.marks, lx, ty, t.text, hi)
                if it.detail.length() > 0 and lx + lw + 2 * cw < right {
                    dx := lx + lw + cw
                    detail := t.fit(it.detail, right - dx)
                    self._marked(win, t, detail, it.detail_marks, dx, ty, t.muted, hi)
                }
            } else {
                label := v == null ? "None" : v.str()
                win.text(t.fit(label, right - lx), lx, ty, t.text, scale=t.scale, font=t.font)
            }
            ry = ry + self._rh
            i = i + 1
        }
        if n > shown {
            // A scroll thumb on the right.
            track := shown * self._rh
            th := _max(12, track * shown / n)
            ty := self._ly + (track - th) * self._top / _max(1, n - shown)
            win.rect(x + w - 6, ty, 3, th, mix(t.muted, t.surface, 40))
        }
    }
}

---
A line of a previewed app's events file as a `window.Event` (null if it
isn't one) — see `App` (QUIRK_UI_PREVIEW). `preview_line(e)` writes one.
---
define preview_event(line: String) -> window.Event {
    l := line.replace("\r", "")
    if l.startswith("text ") {
        e := window.Event("text")
        e.text = l.substring(5, l.length())
        return e
    }
    p := l.split(" ")
    if p.length() == 0 { return null }
    kind := String(p[0])
    nums := []
    try {
        i := 1
        while i < p.length() {
            nums.append(Int(String(p[i])))
            i = i + 1
        }
    } catch (Exception) {
        nums = nums
    }
    if kind == "mouse_move" or kind == "mouse_down" or kind == "mouse_up" {
        if p.length() < 3 { return null }
        e := window.Event(kind)
        e.x = _nth(nums, 0)
        e.y = _nth(nums, 1)
        e.button = kind == "mouse_move" ? 0 : _max(1, _nth(nums, 2))
        e.clicks = kind == "mouse_down" ? _max(1, _nth(nums, 3)) : 0
        e.left = kind == "mouse_down" and e.button == 1
        return e
    }
    if kind == "wheel" {
        e := window.Event("wheel")
        e.dx = _nth(nums, 0)
        e.dy = _nth(nums, 1)
        return e
    }
    if (kind == "key_down" or kind == "key_up") and p.length() >= 2 {
        e := window.Event(kind)
        e.key = String(p[1])
        e.ctrl = p.length() > 2 and String(p[2]) == "1"
        e.shift = p.length() > 3 and String(p[3]) == "1"
        e.alt = p.length() > 4 and String(p[4]) == "1"
        e.meta = p.length() > 5 and String(p[5]) == "1"
        return e
    }
    return null
}

define _bit(v: Bool) -> String {
    return v ? "1" : "0"
}

define _nth(nums: List, i: Int) -> Int {
    if i < nums.length() { return Int(nums[i]) }
    return 0
}

--- The events-file line for `e` ("" for an event a preview doesn't pass on). ---
define preview_line(e: window.Event) -> String {
    k := e.kind
    if k == "mouse_move" { return "mouse_move " + String(e.x) + " " + String(e.y) }
    if k == "mouse_down" { return "mouse_down " + String(e.x) + " " + String(e.y) + " " + String(e.button) + " " + String(_max(1, e.clicks)) }
    if k == "mouse_up" { return "mouse_up " + String(e.x) + " " + String(e.y) + " " + String(e.button) }
    if k == "wheel" { return "wheel " + String(e.dx) + " " + String(e.dy) }
    if k == "key_down" { return "key_down " + e.key + " " + _bit(e.ctrl) + " " + _bit(e.shift) + " " + _bit(e.alt) + " " + _bit(e.meta) }
    if k == "key_up" { return "key_up " + e.key }
    if k == "text" and not e.text.contains("\n") { return "text " + e.text }
    return ""
}

// Every visible MenuBar in the tree.
define _all_menu_bars(w: Widget) -> List {
    out := []
    _collect_bars(w, out)
    return out
}

define _collect_bars(w: Widget, out: List) -> void {
    if not w.visible { return }
    if w.is_menu_bar() { out.append(w) }
    for c in w.children() {
        cw: Widget = c
        _collect_bars(cw, out)
    }
}

// Names sorted, ignoring case (insertion sort; folders are small).
define _sorted_names(names: List) -> List {
    out := []
    for n in names { out.append(n) }
    i := 1
    while i < out.length() {
        cur: String = out[i]
        j := i - 1
        while j >= 0 {
            prev: String = out[j]
            if prev.lower() <= cur.lower() { break }
            out[j + 1] = prev
            j = j - 1
        }
        out[j + 1] = cur
        i = i + 1
    }
    return out
}

// ===== Canvas =====

---
A widget you draw yourself: `on_draw(win, x, y, width, height)` runs every
frame (drawing is clipped to the canvas), `on_event(e)` gets its mouse
events (coordinates are the window's) and keys while it has the focus.
`width` / `height` are the size it asks for; with `expand` it takes free
space.
---
struct Canvas : Widget {
    on_draw: Callable
    on_event: Callable
    want_w: Int
    want_h: Int
    define access_role(self) -> String {
        return "graphic"
    }


    define __init(self, on_draw: Callable = null, on_event: Callable = null, width: Int = 200, height: Int = 150, expand: Bool = false, focusable: Bool = false) -> void {
        super().__init()
        self.on_draw = on_draw
        self.on_event = on_event
        self.want_w = width
        self.want_h = height
        self.expand = expand
        self.focusable = focusable
        self.takes_clicks = true
    }

    define measure(self, t: Theme) -> void {
        self.min_w = self.want_w
        self.min_h = self.want_h
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled or self.on_event == null { return false }
        self.on_event(e)
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.on_draw == null { return }
        _clip_push(win, self.x, self.y, self.width, self.height)
        self.on_draw(win, self.x, self.y, self.width, self.height)
        _clip_pop(win)
    }
}

// ===== Animation =====

--- `a` + (`b` - `a`) * `t` (t from 0.0 to 1.0), rounded. ---
define lerp(a: Int, b: Int, t: Double) -> Int {
    r := a.to_float() + (b - a).to_float() * t
    if r >= 0.0 { return (r + 0.5).to_int() }
    return (r - 0.5).to_int()
}

---
Easing: progress `t` (0.0-1.0) reshaped — "linear", "in" (starts slow),
"out" (ends slow), "in_out" (both), "back" (overshoots a little, then
settles).
---
define ease(name: String, t: Double) -> Double {
    x := t
    if x < 0.0 { x = 0.0 }
    if x > 1.0 { x = 1.0 }
    if name == "in" { return x * x * x }
    if name == "out" {
        y := 1.0 - x
        return 1.0 - y * y * y
    }
    if name == "in_out" {
        if x < 0.5 { return 4.0 * x * x * x }
        y := -2.0 * x + 2.0
        return 1.0 - y * y * y / 2.0
    }
    if name == "back" {
        c := 1.70158
        y := x - 1.0
        return 1.0 + (c + 1.0) * y * y * y + c * y * y
    }
    return x
}

---
A running animation (`app.animate`). `cancel()` stops it (no more
`on_step`, no `on_done`); `done` says whether it has finished.
---
struct Animation {
    start: Int
    duration: Int
    on_step: Callable
    on_done: Callable
    easing: String
    done: Bool

    define __init(self, duration: Int, on_step: Callable, easing: String, on_done: Callable) -> void {
        self.start = window.ticks()
        self.duration = _max(0, duration)
        self.on_step = on_step
        self.on_done = on_done
        self.easing = easing
        self.done = false
    }

    --- Stop it where it is. ---
    define cancel(self) -> void {
        self.done = true
    }

    // Run one frame at time `now`; true while it's still going.
    define _tick(self, now: Int) -> Bool {
        if self.done { return false }
        p := 1.0
        if self.duration > 0 { p = (now - self.start).to_float() / self.duration.to_float() }
        if p > 1.0 { p = 1.0 }
        if self.on_step != null { self.on_step(ease(self.easing, p)) }
        if p >= 1.0 {
            self.done = true
            if self.on_done != null { self.on_done() }
            return false
        }
        return true
    }
}

// ===== App =====

// Visible, enabled, focusable widgets in tree order (Tab order).
define _focus_chain(w: Widget, out: List) -> void {
    if not w.visible { return }
    if w.focusable and w.enabled { out.append(w) }
    for c in w.children() { _focus_chain(c, out) }
}

// The deepest visible widget at (px, py) that takes clicks (focusable,
// or `takes_clicks`), or null.
define _hit(w: Widget, px: Int, py: Int) -> Widget {
    if not w.visible or not w.contains(px, py) { return null }
    kids := w.children()
    i := kids.length() - 1
    while i >= 0 {
        found := _hit(kids[i], px, py)
        if found != null { return found }
        i = i - 1
    }
    if w.focusable or w.takes_clicks { return w }
    return null
}

// Every visible widget containing (px, py), outermost first.
define _path(w: Widget, px: Int, py: Int, out: List) -> void {
    if not w.visible or not w.contains(px, py) { return }
    out.append(w)
    kids := w.children()
    i := kids.length() - 1
    while i >= 0 {
        before := out.length()
        _path(kids[i], px, py, out)
        if out.length() > before { return }
        i = i - 1
    }
}

// The deepest widget at (px, py) with a tooltip, or null.
define _tip_at(w: Widget, px: Int, py: Int) -> Widget {
    path := []
    _path(w, px, py, path)
    i := path.length() - 1
    while i >= 0 {
        c: Widget = path[i]
        if c.tooltip_at(px, py).length() > 0 { return c }
        i = i - 1
    }
    return null
}

define _close_popups() -> void {
    while _popups.length() > 0 {
        o: Widget = _popups[_popups.length() - 1]
        o.close_popup()
        if _popups.length() > 0 {
            top: Widget = _popups[_popups.length() - 1]
            if top == o { _popups.pop() }
        }
    }
}

define _list_has(items: List, x: Any) -> Bool {
    for it in items {
        if it == x { return true }
    }
    return false
}

define _clear_hover(w: Widget) -> void {
    w.hovered = false
    for c in w.children() { _clear_hover(c) }
}

---
The title bar of an `App(title_bar=true)`: the window's title, an optional
widget on its left (`content`: a `MenuBar`, say), and minimize / maximize
(restore) / close buttons on its right. Drawn by the program in its theme
instead of the system's; dragging it moves the window (with the system's
snapping), a double-click maximizes, and the window's edges still resize
it. `app.title_bar` is it.
---
struct TitleBar : Widget {
    win: window.Window
    content: Widget          // shown on the left (null: none)
    on_close: Callable       // the close button (default: close the window)
    active: Bool             // the window has the keyboard focus (dimmed when not)
    button_w: Int
    _press: Int              // the button pressed (-1: none)

    define __init(self, win: window.Window, content: Widget = null, on_close: Callable = null) -> void {
        super().__init()
        self.win = win
        self.content = content
        self.on_close = on_close
        self.active = true
        self.button_w = 46
        self._press = -1
        self.takes_clicks = true
    }

    define children(self) -> List {
        if self.content == null { return [] }
        return [self.content]
    }

    define access_role(self) -> String {
        return "group"
    }

    define _a11y_name(self) -> String {
        return self.win.title
    }

    define measure(self, t: Theme) -> void {
        self.min_h = _max(32, t.line() + 14)
        self.min_w = 3 * self.button_w + 40
        if self.content != null {
            self.content.measure(t)
            self.min_w = self.min_w + self.content.min_w
            self.min_h = _max(self.min_h, self.content.min_h)
        }
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        _bar_bottom[0] = y + height
        if self.content != null {
            self.content.place(x + 8, y + (height - self.content.min_h) / 2, self.content.min_w, self.content.min_h)
        }
    }

    --- Where the buttons are: [x, y, width, height]. ---
    define buttons_box(self) -> List {
        return [self.x + self.width - 3 * self.button_w, self.y, 3 * self.button_w, self.height]
    }

    --- The button at (px, py): 0 minimize, 1 maximize / restore, 2 close, -1 none. ---
    define button_at(self, px: Int, py: Int) -> Int {
        left := self.x + self.width - 3 * self.button_w
        if py < self.y or py >= self.y + self.height or px < left or px >= self.x + self.width { return -1 }
        return _clamp((px - left) / self.button_w, 0, 2)
    }

    --- What a press here doesn't drag: the buttons and `content`. ---
    define holes(self) -> List {
        out := [self.buttons_box()]
        if self.content != null and self.content.visible {
            out.append([self.content.x, self.content.y, self.content.width, self.content.height])
        }
        return out
    }

    --- Press button `i` from code (0 minimize, 1 maximize / restore, 2 close). ---
    define press(self, i: Int) -> void {
        if i == 0 { self.win.minimize() }
        if i == 1 {
            if self.win.maximized() { self.win.restore() } else { self.win.maximize() }
        }
        if i == 2 {
            if self.on_close != null { self.on_close() } else { self.win.close() }
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        bg := mix(t.background, t.surface, 60)
        ink := self.active ? t.text : t.muted
        win.rect(self.x, self.y, self.width, self.height, bg)
        win.rect(self.x, self.y + self.height - 1, self.width, 1, t.border)
        if self.content != null { self.content.draw(win, t) }
        // The title, centred in the window; past the content if they'd meet.
        title := self.win.title
        tw := t.text_w(title)
        left := self.content != null ? self.content.x + self.content.width + 16 : self.x + 12
        right := self.x + self.width - 3 * self.button_w - 12
        tx := self.x + (self.width - tw) / 2
        if tx < left { tx = left }
        if tx + tw > right { tx = _max(left, right - tw) }
        _clip_push(win, left, self.y, _max(0, right - left), self.height)
        win.text(title, tx, self.y + (self.height - t.line()) / 2, ink, scale=t.scale, font=t.font)
        _clip_pop(win)
        // The buttons: hovered one lit (close: red), pressed one darker.
        hover := -1
        if self.hovered or self._press >= 0 {
            m := win.mouse()
            hover = self.button_at(m.0, m.1)
        }
        i := 0
        while i < 3 {
            bx := self.x + self.width - (3 - i) * self.button_w
            glyph := ink
            if hover == i {
                lit := i == 2 ? window.hex("#c42b1c") : mix(bg, t.text, 12)
                if self._press == i { lit = i == 2 ? window.hex("#b22a1b") : mix(bg, t.text, 20) }
                win.rect(bx, self.y, self.button_w, self.height - 1, lit)
                if i == 2 { glyph = window.white() }
            }
            cx := bx + self.button_w / 2
            cy := self.y + self.height / 2
            if i == 0 { win.rect(cx - 5, cy, 10, 1, glyph) }
            if i == 1 {
                if self.win.maximized() {
                    win.rect(cx - 5, cy - 3, 8, 8, glyph, fill=false)          // restore: two windows
                    win.rect(cx - 3, cy - 5, 8, 1, glyph)
                    win.rect(cx + 4, cy - 5, 1, 8, glyph)
                } else {
                    win.rect(cx - 5, cy - 5, 10, 10, glyph, fill=false)
                }
            }
            if i == 2 {
                win.line(cx - 5, cy - 5, cx + 5, cy + 5, glyph)
                win.line(cx - 5, cy + 5, cx + 5, cy - 5, glyph)
            }
            i = i + 1
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 {
            self._press = self.button_at(e.x, e.y)
            // A double-click on the bar itself (where the system didn't take it).
            if self._press < 0 and e.clicks == 2 { self.press(1) }
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self._press
            self._press = -1
            if was >= 0 and self.button_at(e.x, e.y) == was { self.press(was) }
            return true
        }
        return false
    }
}

---
A timer from `app.every(ms, fn)` / `app.after(ms, fn)`: `fn()` runs on
the App's loop, between frames. It doesn't draw a frame by itself: call
`app.redraw()` in it when it changed something. `cancel()` stops it.
---
struct Timer {
    interval: Int            // ms between runs (0: once)
    action: Callable
    due: Int                 // when it runs next (window.ticks())
    active: Bool

    define __init(self, interval: Int, action: Callable, due: Int) -> void {
        self.interval = interval
        self.action = action
        self.due = due
        self.active = true
    }

    --- Don't run it again. ---
    define cancel(self) -> void {
        self.active = false
    }
}

// What an App with a title bar lays out: the bar on top, `body` (the
// App's root) in the rest.
struct _Frame : Widget {
    bar: TitleBar
    body: Widget

    define __init(self, bar: TitleBar) -> void {
        super().__init()
        self.bar = bar
        self.body = null
    }

    define children(self) -> List {
        if self.body == null { return [self.bar] }
        return [self.body, self.bar]
    }

    define access_role(self) -> String {
        return "group"
    }

    define measure(self, t: Theme) -> void {
        self.bar.measure(t)
        self.min_w = self.bar.min_w
        self.min_h = self.bar.min_h
        if self.body != null {
            self.body.measure(t)
            self.min_w = _max(self.min_w, self.body.min_w)
            self.min_h = self.min_h + self.body.min_h
        }
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        bh := self.bar.min_h
        self.bar.place(x, y, width, bh)
        if self.body != null { self.body.place(x, y + bh, width, _max(0, height - bh)) }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.body != null { self.body.draw(win, t) }
        self.bar.draw(win, t)
    }
}

---
A window showing a widget tree. Set `root`, then `run()`.
  `theme`     — colours (`ui.dark()` by default)
  `on_frame`  — optional `fn()` called once per frame before drawing
  `focus`     — the widget with the keyboard focus (or null)
  `tooltip_delay` — ms the mouse rests on a widget before its tooltip shows
  `on_key`    — optional `fn(e)` called for every key press, before the
                focused widget sees it (shortcuts: `if e.ctrl and e.key == "s"`);
                returning true keeps the key from the focused widget
`step()` runs one frame yourself (custom loops, tests).
---
// ===== Accessibility =====

---
One thing in the accessibility tree (`App.accessibility()`) — what a
screen reader is told about a widget or one of its items: `role`
("button", "checkbox", "textbox", "list", "listitem", "tab", "menuitem",
...), `name` (what it's called), `value` (a field's text, a slider's
number, the selected option), `description`, `states` ("focused",
"disabled", "checked", "selected", "expanded"...), its box, `children`,
and the `widget` it came from (null for items). `level` is the depth of
a tree item.
---
struct AccessNode {
    role: String
    name: String
    value: String
    description: String
    states: List
    x: Int
    y: Int
    width: Int
    height: Int
    level: Int
    children: List
    widget: Widget
    id: Int
    index: Int
    data: Any

    define __init(self, role: String, name: String = "", value: String = "", x: Int = 0, y: Int = 0, width: Int = 0, height: Int = 0) -> void {
        self.role = role
        self.name = name
        self.value = value
        self.description = ""
        self.states = []
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.level = 0
        self.children = []
        self.widget = null
        self.id = 0
        self.index = -1
        self.data = null
    }

    // The widget's id; items get theirs from App (by parent and position).
    define _item(self, owner: Widget, index: Int) -> AccessNode {
        self.widget = owner
        self.index = index
        return self
    }

    --- True if `state` ("focused", "checked"...) is one of its states. ---
    define has(self, state: String) -> Bool {
        for st in self.states {
            s: String = st
            if s == state { return true }
        }
        return false
    }

    --- The first node (this one or below) named `name` — and with `role`, when given — or null. ---
    define find(self, name: String, role: String = "") -> AccessNode {
        if self.name == name and (role == "" or self.role == role) { return self }
        for c in self.children {
            cn: AccessNode = c
            hit := cn.find(name, role)
            if hit != null { return hit }
        }
        return null
    }

    --- The first node (this one or below) with `state` (e.g. "focused"), or null. ---
    define find_state(self, state: String) -> AccessNode {
        if self.has(state) { return self }
        for c in self.children {
            cn: AccessNode = c
            hit := cn.find_state(state)
            if hit != null { return hit }
        }
        return null
    }

    --- One line: `button "Save" [focusable, focused]`, with `= value` when it has one. ---
    define describe(self) -> String {
        out := self.role
        if self.name != "" { out = out + " \"" + self.name + "\"" }
        if self.value != "" { out = out + " = \"" + self.value + "\"" }
        if self.states.length() > 0 {
            parts := ""
            for st in self.states {
                s: String = st
                if parts != "" { parts = parts + ", " }
                parts = parts + s
            }
            out = out + " [" + parts + "]"
        }
        return out
    }

    --- The whole subtree, one `describe()` line per node, indented — for tests and debugging. ---
    define dump(self, indent: Int = 0) -> String {
        out := " " * (indent * 2) + self.describe() + "\n"
        for c in self.children {
            cn: AccessNode = c
            out = out + cn.dump(indent + 1)
        }
        return out
    }

    define __str(self) -> String {
        return self.describe()
    }
}

---
A change assistive technology should hear about (`App.on_access`):
`kind` is "focus" (keyboard focus moved to `node`), "value" (the focused
widget's name, value or states changed) or "announce" (`App.announce`:
`node.name` is the message).
---
struct AccessEvent {
    kind: String
    node: AccessNode

    define __init(self, kind: String, node: AccessNode) -> void {
        self.kind = kind
        self.node = node
    }
}

// The node a screen reader's focus is on when widget node `wn` has the
// keyboard focus: the selected item of a list-like widget, else `wn`.
define _a11y_focus_item(wn: AccessNode) -> AccessNode {
    r := wn.role
    if r != "list" and r != "tree" and r != "tablist" and r != "radiogroup" and r != "table" { return wn }
    state := r == "radiogroup" ? "checked" : "selected"
    for c in wn.children {
        cn: AccessNode = c
        if cn.role == "tabpanel" { continue }
        hit := cn.find_state(state)
        if hit != null { return hit }
    }
    return wn
}

// A list / table entry as text (a ListItem's text, or the value).
define _entry_text(v: Any) -> String {
    if v != null and type(v) == "ListItem" {
        li: ListItem = v
        return li.text
    }
    return String(v)
}

struct App {
    win: window.Window
    root: Widget
    theme: Theme
    focus: Widget
    on_frame: Callable
    on_key: Callable
    tooltip_delay: Int
    _capture: Widget
    _tip: Widget
    _tip_since: Int
    _tip_text: String        // what the tooltip says (a new text waits the delay again)
    _mx: Int
    _my: Int
    _drag_src: Widget
    _drag_from_x: Int
    _drag_from_y: Int
    _drag_data: Any
    _dragging: Bool
    _anims: List
    on_access: Callable
    _a11y_focus: Widget
    _a11y_key: String
    _a11y_last: AccessNode
    _a11y_ids: Map
    _a11y_nodes: Map
    _a11y_reported: Widget
    _a11y_focus_id: Int
    _a11y_sent_focus: Int
    _dirty: Bool             // something changed since the last frame drawn
    _pending: List           // events read while waiting (run), for the next step
    _drew: Bool              // the last step drew a frame
    _tip_shown: Bool         // the pending tooltip has been drawn
    title_bar: TitleBar      // with `title_bar=true`: the program's own (else null)
    _frame: _Frame
    _hit_key: String         // the title bar's areas last told the window
    _timers: List
    _wake_draws: Bool        // the wake _next_wake gave is for a frame (not just a timer)
    _pv_dir: String          // QUIRK_UI_PREVIEW: a folder an IDE shows this app through ("": not previewed)
    _pv_off: Int             // how much of <folder>/events was read
    _pv_n: Int               // frames written

    define __init(self, title: String, width: Int, height: Int, theme: Theme = null, resizable: Bool = true, headless: Bool = false, title_bar: Bool = false) -> void {
        // Previewed (an IDE's live view): no window of its own, at the
        // view's size; each frame drawn goes to <folder>/frame.bmp, the
        // view's mouse and keys come from <folder>/events.
        self._pv_dir = sys.env("QUIRK_UI_PREVIEW")
        self._pv_off = 0
        self._pv_n = 0
        w := width
        h := height
        hl := headless
        if self._pv_dir != "" {
            hl = true
            size := sys.env("QUIRK_UI_PREVIEW_SIZE").split("x")
            if size.length() == 2 {
                try {
                    w = _max(100, Int(String(size[0])))
                    h = _max(100, Int(String(size[1])))
                } catch (Exception) {
                    w = width
                    h = height
                }
            }
            self._preview_start()
        }
        self.win = window.open(title, w, h, resizable=resizable, headless=hl, borderless=title_bar)
        self.root = Column([])
        self.title_bar = null
        self._frame = null
        self._hit_key = ""
        self._timers = []
        self._wake_draws = true
        if title_bar {
            self.title_bar = TitleBar(self.win, on_close=fn() { self.close() })
            self._frame = _Frame(self.title_bar)
        }
        if theme == null {
            self.theme = dark()
        } else {
            self.theme = theme
        }
        self.focus = null
        self._dirty = true
        self._pending = []
        self._drew = false
        self._tip_shown = false
        self.on_frame = null
        self.on_key = null
        self.tooltip_delay = 500
        self._capture = null
        self._tip = null
        self._tip_text = ""
        self._tip_since = 0
        self._mx = -1
        self._my = -1
        self._drag_src = null
        self._drag_from_x = 0
        self._drag_from_y = 0
        self._drag_data = null
        self._dragging = false
        self._anims = []
        self.on_access = null
        self._a11y_focus = null
        self._a11y_key = ""
        self._a11y_last = null
        self._a11y_ids = {}
        self._a11y_nodes = {}
        self._a11y_reported = null
        self._a11y_focus_id = 0
        self._a11y_sent_focus = 0
        _close_popups()
    }

    ---
    The window as assistive technology (a screen reader) sees it: a tree
    of `AccessNode`s — role, name, value, states and box of every visible
    widget and item, open popups (menus, dropdown lists) last. Rebuilt on
    each call.
    @example
    print(app.accessibility().dump())
    ---
    define accessibility(self) -> AccessNode {
        top := AccessNode("window", self.win.title, "", 0, 0, self.win.width(), self.win.height())
        if self.win.is_open() and self._tree() != null {
            rn := self._tree().access_node()
            if rn != null { top.children.append(rn) }
            for pw in _popups {
                pop: Widget = pw
                pn := pop.access_node()
                if pn != null and not (pop == self._tree()) { top.children.append(pn) }
            }
        }
        if self.focus != null and self.focus.focused {
            top.states.append("active")
        }
        return top
    }

    ---
    Have assistive technology say `message` (an "announce" event to
    `on_access`) — for things that happen without a focus change: "Saved",
    "3 results".
    ---
    define announce(self, message: String) -> void {
        if self.on_access != null { self.on_access(AccessEvent("announce", AccessNode("alert", message))) }
        self.win.access_announce(message)
    }

    // Give every node an id (widgets have theirs; items get one per parent
    // and position, kept across frames) and remember them by id.
    define _a11y_number(self, node: AccessNode, parent_id: Int, pos: Int) -> void {
        if node.id == 0 {
            key := String(parent_id) + "/" + String(pos)
            if self._a11y_ids.has(key) {
                v: Int = self._a11y_ids[key]
                node.id = v
            } else {
                _a11y_counter[0] = _a11y_counter[0] + 1
                node.id = _a11y_counter[0]
                self._a11y_ids[key] = node.id
            }
        }
        self._a11y_nodes[String(node.id)] = node
        i := 0
        for c in node.children {
            cn: AccessNode = c
            self._a11y_number(cn, node.id, i)
            i = i + 1
        }
    }

    // The tree as the flat arrays Window.access_update takes.
    define _a11y_flatten(self, node: AccessNode, parent: Int, out: List) -> void {
        ids: List = out[0]
        me := ids.length()
        ids.append(node.id)
        pl: List = out[1]
        pl.append(parent)
        rl: List = out[2]
        rl.append(node.role)
        nl: List = out[3]
        nl.append(node.name)
        vl: List = out[4]
        vl.append(node.value)
        dl: List = out[5]
        dl.append(node.description)
        bits := 0
        for st in node.states {
            s: String = st
            if s == "focusable" { bits = bits + 1 }
            elif s == "focused" { bits = bits + 2 }
            elif s == "disabled" { bits = bits + 4 }
            elif s == "checked" { bits = bits + 8 }
            elif s == "selected" { bits = bits + 16 }
            elif s == "expanded" { bits = bits + 32 }
            elif s == "collapsed" { bits = bits + 64 }
            elif s == "editable" { bits = bits + 128 }
            elif s == "multiline" { bits = bits + 256 }
        }
        sl: List = out[6]
        sl.append(bits)
        bl: List = out[7]
        bl.append(node.x)
        bl.append(node.y)
        bl.append(node.width)
        bl.append(node.height)
        ml: List = out[8]
        ml.append(node.level)
        rng := []
        if node.widget != null and node.index < 0 { rng = node.widget._a11y_range() }
        if rng.length() == 3 {
            ml.append(rng[0])
            ml.append(rng[1])
            ml.append(rng[2])
        } else {
            ml.append(0)
            ml.append(0)
            ml.append(0)
        }
        for c in node.children {
            cn: AccessNode = c
            self._a11y_flatten(cn, me, out)
        }
    }

    ---
    The tree with ids (`AccessNode.id`), as last sent to a screen reader
    — also what `access` events' targets refer to. Rebuilt on each call.
    ---
    define accessibility_with_ids(self) -> AccessNode {
        tree := self.accessibility()
        tree.id = -1
        self._a11y_nodes = {}
        self._a11y_number(tree, 0, 0)
        return tree
    }

    // While a screen reader reads the window: send it the tree. In a
    // list, tree, tab strip, radio group or table the screen reader's focus
    // is the selected item (it then says "photo.png, list item" or
    // "Advanced, tab item, selected", and a new selection is a focus move)
    // — as native Windows controls do.
    define _a11y_sync(self) -> void {
        if not self.win.access_active() { return }
        tree := self._a11y_prepare()
        out := [[], [], [], [], [], [], [], [], []]
        self._a11y_flatten(tree, -1, out)
        self.win.access_update(out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7], out[8])
    }

    // The tree with ids, the screen reader's focus moved onto a selected item.
    define _a11y_prepare(self) -> AccessNode {
        tree := self.accessibility_with_ids()
        self._a11y_focus_id = 0
        f := self.focus
        if f != null and f.focused and self._a11y_nodes.has(String(f.access_id())) {
            wn: AccessNode = self._a11y_nodes[String(f.access_id())]
            target := _a11y_focus_item(wn)
            if target != wn {
                kept := []
                for st in wn.states {
                    s: String = st
                    if s != "focused" { kept.append(s) }
                }
                wn.states = kept
                target.states.append("focused")
            }
            self._a11y_focus_id = target.id
        }
        return tree
    }

    // A screen reader's request (an "access" event).
    define _access_do(self, e: window.Event) -> void {
        key := String(e.target)
        if not self._a11y_nodes.has(key) { self.accessibility_with_ids() }
        if not self._a11y_nodes.has(key) { return }
        node: AccessNode = self._a11y_nodes[key]
        w := node.widget
        if w == null { return }
        if e.action == "focus" {
            if w.focusable and w.enabled { self.focus_on(w) }
            return
        }
        w.access_action(e.action, e.text, node)
    }

    // After a frame: tell `on_access` when focus moved, or the focused
    // widget's name / value / states changed.
    define _a11y_check(self) -> void {
        active := self.win.access_active()
        if self.on_access == null and not active { return }
        f := self.focus
        if f == null {
            self._a11y_focus = null
            return
        }
        // The screen reader's focus (the widget, or its selected item).
        moved := false
        if active and self._a11y_focus_id != 0 and self._a11y_focus_id != self._a11y_sent_focus {
            self.win.access_focus(self._a11y_focus_id)
            self._a11y_sent_focus = self._a11y_focus_id
            moved = true
        }
        if f != self._a11y_focus {
            self.accessibility()                  // names fields from the Labels before them
            node := f.access_node()
            self._a11y_focus = f
            if node == null { return }
            self._a11y_key = node.describe()
            self._a11y_last = node
            // Focus that left for nothing and came back isn't news.
            if f != self._a11y_reported {
                self._a11y_reported = f
                if self.on_access != null { self.on_access(AccessEvent("focus", node)) }
            }
            return
        }
        node := f.access_node()
        if node == null { return }
        k := node.describe()
        if k != self._a11y_key {
            self._a11y_key = k
            if self.on_access != null { self.on_access(AccessEvent("value", node)) }
            // (A new selection in a list-like widget was a focus move above.)
            if active and not moved and self._a11y_focus_id == node.id {
                before := self._a11y_last
                if before == null or before.value != node.value { self.win.access_changed(node.id, "value") }
                if before == null or before.name != node.name { self.win.access_changed(node.id, "name") }
                if before == null or before.has("checked") != node.has("checked") { self.win.access_changed(node.id, "checked") }
                if before == null or before.has("expanded") != node.has("expanded") { self.win.access_changed(node.id, "expanded") }
            }
            self._a11y_last = node
        }
    }

    ---
    Animate over `duration` ms: `on_step(t)` runs every frame with the
    eased progress `t` (0.0 → 1.0; the last call is exactly 1.0), then
    `on_done()`. `ease` is "linear", "in", "out", "in_out" or "back".
    @example
    app.animate(300, fn(t) { panel.x_offset = ui.lerp(-200, 0, t) }, ease="out")
    ---
    define animate(self, duration: Int, on_step: Callable, ease: String = "in_out", on_done: Callable = null) -> Animation {
        a := Animation(duration, on_step, ease, on_done)
        self._anims.append(a)
        return a
    }

    --- True while an animation is running. ---
    define animating(self) -> Bool {
        for a in self._anims {
            an: Animation = a
            if not an.done { return true }
        }
        return false
    }

    define _run_animations(self) -> void {
        if self._anims.length() == 0 { return }
        now := window.ticks()
        live := []
        for a in self._anims {
            an: Animation = a
            if an._tick(now) { live.append(an) }
        }
        self._anims = live
    }

    --- True while something is being dragged (see `Widget.on_drag`). ---
    define dragging(self) -> Bool {
        return self._dragging
    }

    // Menus whose shortcuts apply now.
    define _shortcut_menus(self, w: Widget, out: List) -> void {
        if not w.visible or not w.enabled { return }
        if w.context_menu != null and _focused_in(w) != null { out.append(w.context_menu) }
        for c in w.children() {
            cw: Widget = c
            self._shortcut_menus(cw, out)
        }
    }

    // Run the enabled menu item whose shortcut is `e`; true if one did.
    define _run_shortcut(self, e: window.Event) -> Bool {
        menus := []
        self._shortcut_menus(self._tree(), menus)
        for b in _all_menu_bars(self._tree()) {
            bar: MenuBar = b
            for m in bar.menus { menus.append(m) }
        }
        for mm in menus {
            menu: Menu = mm
            for it in menu.items {
                item: MenuItem = it
                if item.enabled and not item.is_separator() and item.matches(e) {
                    if item.on_click != null { item.on_click() }
                    return true
                }
            }
        }
        return false
    }

    // The innermost widget at (px, py) that something can be dropped on.
    define _drop_target(self, px: Int, py: Int) -> Widget {
        path := []
        _path(self._tree(), px, py, path)
        i := path.length() - 1
        while i >= 0 {
            w: Widget = path[i]
            if w.on_drop != null and w.enabled { return w }
            i = i - 1
        }
        return null
    }

    --- True until the window is closed. ---
    define is_open(self) -> Bool {
        return self.win.is_open()
    }

    --- Close the window (ends `run`). ---
    define close(self) -> void {
        self.win.close()
    }

    --- Give `w` the keyboard focus (null: nobody). ---
    define focus_on(self, w: Widget) -> void {
        if w != self.focus { _close_popups() }
        if self.focus != null { self.focus.focused = false }
        self.focus = w
        if w != null { w.focused = true }
    }

    define _cycle_focus(self, backwards: Bool) -> void {
        chain := []
        _focus_chain(self._tree(), chain)
        if chain.length() == 0 { return }
        idx := -1
        i := 0
        for c in chain {
            if c.focused { idx = i }
            i = i + 1
        }
        next := 0
        if backwards {
            next = chain.length() - 1
            if idx > 0 { next = idx - 1 }
        } elif idx >= 0 {
            next = (idx + 1) % chain.length()
        }
        self.focus_on(chain[next])
    }

    // What's laid out and drawn: `root`, under the title bar if there's one.
    define _tree(self) -> Widget {
        if self._frame == null { return self.root }
        self._frame.body = self.root
        return self._frame
    }

    --- Measure and place the tree to fill the window. ---
    define layout(self) -> void {
        tree := self._tree()
        tree.measure(self.theme)
        if self.title_bar == null {
            tree.place(0, 0, self.win.width(), self.win.height())
        } else {
            // Maximized on Windows, the window overhangs the screen: keep
            // the bar (and the rest) inside what's visible.
            m := self.win.inset()
            l: Int = m[0]
            tp: Int = m[1]
            r: Int = m[2]
            b: Int = m[3]
            tree.place(l, tp, _max(0, self.win.width() - l - r), _max(0, self.win.height() - tp - b))
            // Tell the window where the bar drags it (only when that moved).
            bar := self.title_bar
            holes := bar.holes()
            key := String(bar.x) + "," + String(bar.y) + " " + String(bar.width) + "x" + String(bar.height) + String(holes)
            if key != self._hit_key {
                self._hit_key = key
                self.win.set_hit_areas([[bar.x, bar.y, bar.width, bar.height]], holes)
            }
        }
    }

    --- Route one event to the widget it's for (also usable from tests). ---
    define dispatch(self, e: window.Event) -> void {
        k := e.kind
        if k == "access" {
            self._access_do(e)
            return
        }
        if self.title_bar != null and (k == "focus" or k == "blur") { self.title_bar.active = k == "focus" }
        if k == "mouse_move" or k == "mouse_down" or k == "mouse_up" or k == "wheel" or k == "key_down" or k == "blur" {
            if k == "mouse_move" {
                self._mx = e.x
                self._my = e.y
                tip := _tip_at(self._tree(), e.x, e.y)
                text := tip != null ? tip.tooltip_at(e.x, e.y) : ""
                if tip != self._tip or text != self._tip_text {
                    self._tip = tip
                    self._tip_text = text
                    self._tip_since = window.ticks()
                }
            } else {
                self._tip_since = -1      // hidden until the mouse moves to another widget
            }
        }
        // An open popup gets the mouse first; a click anywhere else closes it.
        if _popups.length() > 0 and (k == "mouse_move" or k == "mouse_down" or k == "mouse_up" or k == "wheel") {
            top: Widget = _popups[_popups.length() - 1]
            px := e.x
            py := e.y
            if k == "wheel" {
                px = self.win.mouse().0
                py = self.win.mouse().1
            }
            if top.popup_contains(px, py) {
                _clear_hover(self._tree())
                top.popup_handle(e)
                return
            }
            if k == "mouse_down" {
                owner := _hit(self._tree(), e.x, e.y)
                _close_popups()
                // A click on the popup's own field just closes it.
                if owner == top {
                    self._capture = owner
                    return
                }
            }
        }
        // Drag and drop: past 4 px of movement with the button held, the
        // pressed widget's `on_drag` data travels to an `on_drop` target.
        if k == "mouse_move" and self._drag_src != null and e.left and not self._dragging {
            dx := e.x - self._drag_from_x
            dy := e.y - self._drag_from_y
            if dx * dx + dy * dy > 16 {
                self._drag_data = self._drag_src.on_drag()
                if self._drag_data != null {
                    self._dragging = true
                    if self._capture != null { self._capture.pressed = false }
                } else {
                    self._drag_src = null
                }
            }
        }
        if k == "mouse_up" and self._dragging {
            target := self._drop_target(e.x, e.y)
            data := self._drag_data
            self._dragging = false
            self._drag_src = null
            self._drag_data = null
            if self._capture != null {
                cap := self._capture
                self._capture = null
                cap.pressed = false
                // Released somewhere else: no click.
                ev := window.Event("mouse_up")
                ev.x = -100000
                ev.y = -100000
                ev.button = e.button
                cap.handle(ev)
            }
            if target != null { target.on_drop(data) }
            return
        }
        if k == "mouse_up" { self._drag_src = null }
        if k == "mouse_move" {
            _clear_hover(self._tree())
            over := _hit(self._tree(), e.x, e.y)
            if over != null { over.hovered = true }
            if self._capture != null { self._capture.handle(e) }
            return
        }
        // Right-click: the context menu of the innermost widget that has one.
        if k == "mouse_down" and e.button == 3 {
            path := []
            _path(self._tree(), e.x, e.y, path)
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.context_menu != null and w.enabled {
                    _close_popups()
                    // The widget sees the click first: a list or a tree selects
                    // the row it's on, so the menu is about that row.
                    w.handle(e)
                    w.context_menu.open_at(e.x, e.y)
                    return
                }
                i = i - 1
            }
            return
        }
        if k == "mouse_down" and e.button == 1 {
            path := []
            _path(self._tree(), e.x, e.y, path)
            self._drag_src = null
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.on_drag != null and w.enabled {
                    self._drag_src = w
                    self._drag_from_x = e.x
                    self._drag_from_y = e.y
                    break
                }
                i = i - 1
            }
        }
        if k == "mouse_down" {
            target := _hit(self._tree(), e.x, e.y)
            if target != null and target.enabled {
                if target.focusable { self.focus_on(target) }
                self._capture = target
                target.handle(e)
            } else {
                self.focus_on(null)
            }
            return
        }
        if k == "mouse_up" {
            if self._capture != null {
                cap := self._capture
                self._capture = null
                cap.handle(e)
            }
            return
        }
        if k == "wheel" {
            // Innermost widget under the mouse that uses it (a list inside a
            // scroll view scrolls itself; elsewhere the scroll view scrolls).
            path := []
            mx := self.win.mouse().0
            my := self.win.mouse().1
            if self._mx >= 0 {
                mx = self._mx
                my = self._my
            }
            _path(self._tree(), mx, my, path)
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.enabled and w.handle(e) { return }
                i = i - 1
            }
            return
        }
        // An input method composing in the focused field gets every key
        // (no shortcuts, no Tab) until it's done.
        if (k == "key_down" or k == "key_up" or k == "compose" or k == "text") and self.focus != null and self.focus.composing() {
            self.focus.handle(e)
            return
        }
        // on_key returning true keeps the key from everyone else (an app's
        // own shortcut — not typed into the focused terminal / field too).
        if k == "key_down" and self.on_key != null {
            used := self.on_key(e)
            if used == true { return }
        }
        // Menu shortcuts: from any menu bar, and the right-click menus of the
        // focused widget and those around it. Not while a popup is open.
        if k == "key_down" and _popups.length() == 0 and self._run_shortcut(e) { return }
        // An open popup that takes keys (a menu) gets them first.
        if (k == "key_down" or k == "key_up" or k == "text" or k == "compose") and _popups.length() > 0 {
            top: Widget = _popups[_popups.length() - 1]
            if top.popup_key(e) { return }
        }
        if k == "key_down" and e.key == "tab" and not e.ctrl and not (self.focus != null and self.focus.takes_tab) {
            self._cycle_focus(e.shift)
            return
        }
        if k == "key_down" or k == "key_up" or k == "text" or k == "compose" {
            if self.focus != null and self.focus.visible and self.focus.enabled { self.focus.handle(e) }
            return
        }
        if k == "blur" {
            _clear_hover(self._tree())
        }
    }

    --- One frame: handle events, lay out, draw, present. False once the window is closed. ---
    --- Draw again at the next frame — after changing widgets outside an event (a timer, a task). ---
    define redraw(self) -> void {
        self._dirty = true
    }

    ---
    Run `action()` every `ms` milliseconds while the App runs (polling
    something: a process's output, a file). Returns the `Timer`.
    @example app.every(50, fn() { term.poll() })
    ---
    define every(self, ms: Int, action: Callable) -> Timer {
        t := Timer(_max(1, ms), action, window.ticks() + _max(1, ms))
        self._timers.append(t)
        return t
    }

    --- Run `action()` once, `ms` milliseconds from now. Returns the `Timer`. ---
    define after(self, ms: Int, action: Callable) -> Timer {
        t := Timer(0, action, window.ticks() + _max(0, ms))
        self._timers.append(t)
        return t
    }

    // The timers that are due: run (and the frame drawn); the done ones dropped.
    define _run_timers(self) -> void {
        if self._timers.length() == 0 { return }
        now := window.ticks()
        keep := []
        for x in self._timers {
            t: Timer = x
            if not t.active { continue }
            if now >= t.due {
                t.action()
                if t.interval > 0 and t.active {
                    t.due = now + t.interval
                } else {
                    t.active = false
                }
            }
            if t.active { keep.append(t) }
        }
        // (A timer added while they ran is in self._timers, not keep.)
        for x in self._timers {
            t: Timer = x
            if t.active and not _list_has(keep, t) { keep.append(t) }
        }
        self._timers = keep
    }

    ---
    One frame: the events, then layout, draw and present. Called by
    `run`, it draws only when something changed (`force=false`); called
    yourself (tests, your own loop), it always draws.
    ---
    define step(self, force: Bool = true) -> Bool {
        events := self._pending
        self._pending = []
        for e in self.win.events() { events.append(e) }
        if self._pv_dir != "" {
            for pe in self._preview_events() {
                ev: window.Event = pe
                self.win._track(ev)
                events.append(ev)
            }
        }
        for ev in events {
            e: window.Event = ev
            if not self.win.is_open() { return false }
            self.dispatch(e)
            self._dirty = true
        }
        if not self.win.is_open() { return false }
        self._run_timers()
        if not self.win.is_open() { return false }
        if self._anims.length() > 0 { self._dirty = true }
        self._run_animations()
        if self.on_frame != null {
            self.on_frame()
            self._dirty = true                      // (it may have changed anything)
        }
        if not self.win.is_open() { return false }
        self._drew = false
        if not force and not self._dirty { return true }
        self.layout()
        self.draw()
        self.win.present()
        if self._pv_dir != "" { self._preview_frame() }
        self._a11y_sync()
        self._a11y_check()
        self._dirty = false
        self._drew = true
        return true
    }

    // In how many ms a frame is due though no event comes (-1: none): an
    // animation now, a tooltip when its delay is over, a caret's blink.
    define _next_wake(self) -> Int {
        if self._anims.length() > 0 or self.on_frame != null {
            self._wake_draws = true
            return 0
        }
        wake := -1
        tip := self._tip
        if tip != null and tip.visible and self._tip_since >= 0 {
            left := self.tooltip_delay - (window.ticks() - self._tip_since)
            if left > 0 {
                wake = left
                self._tip_shown = false
            } elif not self._tip_shown {
                self._tip_shown = true
                wake = 0
            }
        }
        if self.focus != null and self.focus.visible {
            f := self.focus.next_redraw()
            if f >= 0 and (wake < 0 or f < wake) { wake = f }
        }
        if _popups.length() > 0 {
            top: Widget = _popups[_popups.length() - 1]
            f := top.next_redraw()
            if f >= 0 and (wake < 0 or f < wake) { wake = f }
        }
        self._wake_draws = true
        if self._timers.length() > 0 {
            now := window.ticks()
            for x in self._timers {
                t: Timer = x
                if not t.active { continue }
                left := _max(0, t.due - now)
                if wake < 0 or left < wake {
                    wake = left
                    self._wake_draws = false
                }
            }
        }
        return wake
    }

    // ----- previewed (QUIRK_UI_PREVIEW=<folder>) -----
    //   <folder>/frame.bmp  the last frame (written to frame.tmp.bmp, then renamed)
    //   <folder>/frame.n    a number, one more for each frame (across restarts)
    //   <folder>/events     lines the view appends: "mouse_move x y",
    //                       "mouse_down x y button clicks", "mouse_up x y button",
    //                       "wheel dx dy", "key_down key ctrl shift alt meta",
    //                       "key_up key", "text <the rest of the line>"

    define _preview_start(self) -> void {
        d := self._pv_dir
        try {
            ev := fs.join(d, "events")
            if fs.is_file(ev) { self._pv_off = fs.read_text(ev).length() }      // (a restart: not the old ones)
            n := fs.join(d, "frame.n")
            if fs.is_file(n) { self._pv_n = Int(fs.read_text(n).trim()) }
        } catch (Exception) {
            self._pv_off = 0
        }
    }

    define _preview_frame(self) -> void {
        d := self._pv_dir
        try {
            tmp := fs.join(d, "frame.tmp.bmp")
            self.win.screenshot(tmp)
            fs.rename(tmp, fs.join(d, "frame.bmp"))
            self._pv_n = self._pv_n + 1
            fs.write_text(fs.join(d, "frame.n"), String(self._pv_n))
        } catch (Exception) {
            self._pv_n = self._pv_n          // (the view may be reading it: the next frame)
        }
    }

    define _preview_events(self) -> List {
        out := []
        // The view made the folder and removes it when it stops: then this
        // app goes too (it may outlive a watcher that was killed).
        if not fs.is_dir(self._pv_dir) {
            self.close()
            return out
        }
        p := fs.join(self._pv_dir, "events")
        if not fs.is_file(p) { return out }
        text := ""
        try { text = fs.read_text(p) } catch (e: Exception) { return out }
        if text.length() <= self._pv_off { return out }
        chunk := text.substring(self._pv_off, text.length())
        end := -1
        at := chunk.find("\n")
        while at >= 0 {
            end = at
            at = chunk.find("\n", at + 1)
        }
        if end < 0 { return out }                       // (a line still being written)
        self._pv_off = self._pv_off + end + 1
        for l in chunk.substring(0, end).split("\n") {
            e := preview_event(String(l))
            if e != null { out.append(e) }
        }
        return out
    }

    --- Draw the tree, open popups and the tooltip (what `step` shows). ---
    define draw(self) -> void {
        t := self.theme
        _clips.clear()
        self.win.unclip()
        self.win.clear(t.background)
        self._tree().draw(self.win, t)
        if self._dragging {
            over := self._drop_target(self._mx, self._my)
            if over != null { self.win.rect(over.x - 2, over.y - 2, over.width + 4, over.height + 4, t.accent, fill=false) }
            label := "?"
            if self._drag_data != null { label = self._drag_data.str() }
            if label.length() > 30 { label = label.substring(0, 30) + "..." }
            lw := t.text_w(label) + 12
            self.win.rect(self._mx + 12, self._my + 8, lw, t.line() + 6, mix(t.surface, t.accent, 25))
            self.win.rect(self._mx + 12, self._my + 8, lw, t.line() + 6, t.accent, fill=false)
            self.win.text(label, self._mx + 18, self._my + 11, t.text, scale=t.scale, font=t.font)
        }
        for o in _popups {
            p: Widget = o
            p.draw_popup(self.win, t)
        }
        tip := self._tip
        if tip != null {
            if tip.visible and self._tip_since >= 0 and window.ticks() - self._tip_since >= self.tooltip_delay {
                self._draw_tip(self._tip_text)
            }
        }
    }

    define _draw_tip(self, text: String) -> void {
        t := self.theme
        tw := t.text_w(text) + 12
        th := text.split("\n").length() * t.line() + 8
        tx := _clamp(self._mx + 12, 0, _max(0, self.win.width() - tw))
        ty := self._my + 20
        if ty + th > self.win.height() { ty = _max(0, self._my - th - 4) }
        self.win.rect(tx, ty, tw, th, mix(t.surface, t.text, 12))
        self.win.rect(tx, ty, tw, th, t.border, fill=false)
        self.win.text(text, tx + 6, ty + 4, t.text, scale=t.scale, font=t.font)
    }

    --- Run until the window closes, about `fps` frames a second. ---
    ---
    Run until the window closes. A frame is drawn when something happened
    — input, a resize, an animation, a caret's blink, `redraw()` — at most
    `fps` times a second; in between, it waits for the next event instead
    of drawing the same picture again (a window that isn't touched costs
    almost nothing, and input isn't held up behind frames nobody needs).
    ---
    define run(self, fps: Int = 60) -> void {
        budget := 1000 / fps
        while self.is_open() {
            start := window.ticks()
            if not self.step(false) { break }
            if not self.is_open() { break }
            if self._drew {
                left := budget - (window.ticks() - start)
                if left > 0 { window.sleep(left) }       // (events that arrive meanwhile: one frame)
                continue
            }
            wake := self._next_wake()
            if wake == 0 {
                if self._wake_draws { self._dirty = true }
                continue
            }
            // (Previewed: the view's events come from a file — look every 30 ms.)
            looked := self._pv_dir != "" and (wake < 0 or wake > 30)
            if looked { wake = 30 }
            e := self.win.wait_event(wake < 0 ? 250 : wake)
            if e != null {
                self._pending.append(e)
            } elif wake > 0 and self._wake_draws and not looked {
                self._dirty = true                       // a frame that's due (blink, tooltip)
            }
        }
    }
}
