// ui v1.2.0, headless: layout, events routed by App.dispatch, widget
// state and drawing. Every test is skipped (passes) without SDL2.
use window
use ui
use test

define new_app() -> ui.App {
    return ui.App("ui test", 400, 300, headless=true)
}

define ev(kind: String) -> window.Event {
    return window.Event(kind)
}

define click(app: ui.App, x: Int, y: Int) -> void {
    d := ev("mouse_down")
    d.x = x
    d.y = y
    d.button = 1
    app.dispatch(d)
    u := ev("mouse_up")
    u.x = x
    u.y = y
    u.button = 1
    app.dispatch(u)
}

define click_on(app: ui.App, w: ui.Widget) -> void {
    click(app, w.x + w.width / 2, w.y + w.height / 2)
}

define key(app: ui.App, k: String) -> void {
    e := ev("key_down")
    e.key = k
    app.dispatch(e)
}

define typed(app: ui.App, s: String) -> void {
    e := ev("text")
    e.text = s
    app.dispatch(e)
}

// ───── layout ─────
define test_column_stacks_and_stretches() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.Label("one")
    b := ui.Button("two")
    app.root = ui.Column([a, b], padding=10, spacing=6)
    app.layout()
    test.assert_eq(a.x, 10)
    test.assert_eq(a.y, 10)
    test.assert_eq(a.width, 380)
    test.assert_eq(a.height, 16)
    test.assert_eq(b.y, 32)
    test.assert_eq(b.height, 28)
    app.close()
}

define test_expand_takes_free_space() -> void {
    if not window.available() { return }
    app := new_app()
    top := ui.Label("top")
    filler := ui.Spacer()
    bottom := ui.Button("bottom")
    app.root = ui.Column([top, filler, bottom])
    app.layout()
    test.assert_eq(bottom.y + bottom.height, 300)
    row_a := ui.Button("a")
    row_b := ui.TextInput()
    row_b.expand = true
    app.root = ui.Row([row_a, row_b], padding=0, spacing=4)
    app.layout()
    test.assert_eq(row_b.x + row_b.width, 400)
    app.close()
}

define test_hidden_widgets_take_no_space() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.Label("a")
    b := ui.Label("b")
    c := ui.Label("c")
    b.visible = false
    app.root = ui.Column([a, b, c], spacing=4)
    app.layout()
    test.assert_eq(c.y, 20)
    app.close()
}

// ───── widgets ─────
define test_button_click_and_keyboard() -> void {
    if not window.available() { return }
    app := new_app()
    count := 0
    btn := ui.Button("Go", on_click=fn() { count = count + 1 })
    app.root = ui.Column([btn], padding=8)
    app.layout()
    click_on(app, btn)
    test.assert_eq(count, 1)
    test.assert_true(btn.focused)
    key(app, "return")
    key(app, "space")
    test.assert_eq(count, 3)
    btn.enabled = false
    click_on(app, btn)
    test.assert_eq(count, 3)
    app.close()
}

define test_release_outside_does_not_click() -> void {
    if not window.available() { return }
    app := new_app()
    count := 0
    btn := ui.Button("Go", on_click=fn() { count = count + 1 })
    app.root = ui.Column([btn], padding=8)
    app.layout()
    d := ev("mouse_down")
    d.x = btn.x + 2
    d.y = btn.y + 2
    d.button = 1
    app.dispatch(d)
    test.assert_true(btn.pressed)
    u := ev("mouse_up")
    u.x = 390
    u.y = 290
    u.button = 1
    app.dispatch(u)
    test.assert_false(btn.pressed)
    test.assert_eq(count, 0)
    app.close()
}

define test_checkbox_toggles() -> void {
    if not window.available() { return }
    app := new_app()
    seen := []
    box := ui.Checkbox("Agree", on_change=fn(on) { seen.append(on) })
    app.root = ui.Column([box], padding=8)
    app.layout()
    click_on(app, box)
    test.assert_true(box.checked)
    key(app, "space")
    test.assert_false(box.checked)
    test.assert_eq(seen.length(), 2)
    app.close()
}

define test_text_input_editing() -> void {
    if not window.available() { return }
    app := new_app()
    changes := 0
    submitted := ""
    input := ui.TextInput(placeholder="name", on_change=fn(s) { changes = changes + 1 },
                          on_submit=fn(s) { submitted = s })
    app.root = ui.Column([input], padding=8)
    app.layout()
    click_on(app, input)
    test.assert_true(input.focused)
    typed(app, "Héllo")
    test.assert_eq(input.text, "Héllo")
    test.assert_eq(input.cursor, 5)
    key(app, "home")
    typed(app, ">")
    key(app, "end")
    key(app, "backspace")
    key(app, "left")
    key(app, "delete")
    test.assert_eq(input.text, ">Hél")
    key(app, "return")
    test.assert_eq(submitted, ">Hél")
    test.assert_eq(changes, 4)
    app.close()
}

define test_slider_mouse_and_keys() -> void {
    if not window.available() { return }
    app := new_app()
    s := ui.Slider(min=0, max=10, value=5)
    app.root = ui.Column([s], padding=8)
    app.layout()
    click(app, s.x + 8, s.y + s.height / 2)
    test.assert_eq(s.value, 0)
    click(app, s.x + s.width - 8, s.y + s.height / 2)
    test.assert_eq(s.value, 10)
    key(app, "left")
    key(app, "left")
    test.assert_eq(s.value, 8)
    key(app, "home")
    test.assert_eq(s.value, 0)
    s.set(99)
    test.assert_eq(s.value, 10)
    app.close()
}

define test_list_view_select_and_scroll() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    items := ["a", "b", "c", "d", "e", "f", "g", "h"]
    lv := ui.ListView(items, on_select=fn(i, item) { picked = item }, rows=3)
    app.root = ui.Column([lv], padding=8)
    app.layout()
    click(app, lv.x + 10, lv.y + 2 + 24 + 5)
    test.assert_eq(lv.selected, 1)
    test.assert_eq(picked, "b")
    key(app, "end")
    test.assert_eq(lv.selected, 7)
    test.assert_eq(picked, "h")
    key(app, "up")
    test.assert_eq(lv.selected, 6)
    app.close()
}

// ───── focus ─────
define test_tab_cycles_focus() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.TextInput()
    lbl := ui.Label("not focusable")
    b := ui.Button("b")
    c := ui.Checkbox("c")
    app.root = ui.Column([a, lbl, ui.Row([b, c])])
    app.layout()
    key(app, "tab")
    test.assert_true(a.focused)
    key(app, "tab")
    test.assert_true(b.focused)
    test.assert_false(a.focused)
    key(app, "tab")
    test.assert_true(c.focused)
    key(app, "tab")
    test.assert_true(a.focused)
    shift_tab := ev("key_down")
    shift_tab.key = "tab"
    shift_tab.shift = true
    app.dispatch(shift_tab)
    test.assert_true(c.focused)
    app.close()
}

define test_keys_go_to_the_focused_widget() -> void {
    if not window.available() { return }
    app := new_app()
    a := ui.TextInput()
    b := ui.TextInput()
    app.root = ui.Column([a, b])
    app.layout()
    click_on(app, b)
    typed(app, "x")
    test.assert_eq(a.text, "")
    test.assert_eq(b.text, "x")
    click(app, 399, 299)
    test.assert_true(app.focus == null)
    typed(app, "y")
    test.assert_eq(b.text, "x")
    app.close()
}

// ───── drawing / frames ─────
define test_step_draws_theme_and_widgets() -> void {
    if not window.available() { return }
    app := ui.App("draw", 200, 100, theme=ui.light(), headless=true)
    btn := ui.Button("OK")
    app.root = ui.Column([btn], padding=10)
    test.assert_true(app.step())
    test.assert_eq(app.win.pixel(2, 2), window.hex("#f4f5f7") % 16777216)
    test.assert_eq(app.win.pixel(btn.x + 2, btn.y + 2), window.hex("#2f6fde") % 16777216)
    app.close()
    test.assert_false(app.step())
}

define test_on_frame_runs_each_step() -> void {
    if not window.available() { return }
    app := new_app()
    frames := 0
    app.on_frame = fn() { frames = frames + 1 }
    app.step()
    app.step()
    test.assert_eq(frames, 2)
    app.close()
}

define test_mix() -> void {
    test.assert_eq(ui.mix(window.rgb(0, 0, 0), window.rgb(200, 100, 50), 50), window.rgb(100, 50, 25))
    test.assert_eq(ui.mix(window.red(), window.blue(), 0), window.red())
}

// ───── v1.1.0: selection, clipboard, TextArea, ScrollView, Dropdown, tooltips ─────
define keym(app: ui.App, k: String, shift: Bool = false, ctrl: Bool = false) -> void {
    e := ev("key_down")
    e.key = k
    e.shift = shift
    e.ctrl = ctrl
    app.dispatch(e)
}

define mouse(app: ui.App, kind: String, x: Int, y: Int, clicks: Int = 1) -> void {
    e := ev(kind)
    e.x = x
    e.y = y
    e.button = 1
    e.clicks = clicks
    e.left = kind == "mouse_move"
    app.dispatch(e)
}

define wheel(app: ui.App, x: Int, y: Int, dy: Int) -> void {
    mouse(app, "mouse_move", x, y)
    e := ev("wheel")
    e.dy = dy
    app.dispatch(e)
}

define test_text_input_select_type_over_and_clipboard() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("hello world")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    keym(app, "home")
    i := 0
    while i < 5 {
        keym(app, "right", shift=true)
        i = i + 1
    }
    test.assert_true(field.has_selection())
    test.assert_eq(field.selected_text(), "hello")
    typed(app, "HEY")
    test.assert_eq(field.text, "HEY world")
    test.assert_false(field.has_selection())
    keym(app, "a", ctrl=true)
    test.assert_eq(field.selected_text(), "HEY world")
    keym(app, "c", ctrl=true)
    test.assert_eq(window.clipboard(), "HEY world")
    keym(app, "delete")
    test.assert_eq(field.text, "")
    keym(app, "v", ctrl=true)
    keym(app, "v", ctrl=true)
    test.assert_eq(field.text, "HEY worldHEY world")
    field.select(3, 9)
    keym(app, "x", ctrl=true)
    test.assert_eq(window.clipboard(), " world")
    test.assert_eq(field.text, "HEYHEY world")
    // Left / Right with a selection collapse it to that end.
    field.select(1, 4)
    keym(app, "left")
    test.assert_eq(field.cursor, 1)
    test.assert_false(field.has_selection())
    app.close()
}

define test_text_input_word_moves() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("one two  three")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    keym(app, "end")
    keym(app, "left", ctrl=true)
    test.assert_eq(field.cursor, 9)
    keym(app, "left", ctrl=true)
    test.assert_eq(field.cursor, 4)
    keym(app, "right", ctrl=true)
    test.assert_eq(field.cursor, 7)
    keym(app, "backspace", ctrl=true)
    test.assert_eq(field.text, "one   three")
    keym(app, "home")
    keym(app, "delete", ctrl=true)
    test.assert_eq(field.text, "   three")
    app.close()
}

define test_text_input_mouse_selection_and_one_line_paste() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("alpha beta gamma", columns=30)
    app.root = ui.Column([field], padding=8)
    app.layout()
    cx := field.x + 8 + 8 * 7          // inside "beta"
    cy := field.y + field.height / 2
    mouse(app, "mouse_down", cx, cy, 2)
    mouse(app, "mouse_up", cx, cy, 2)
    test.assert_eq(field.selected_text(), "beta")
    // Drag from the start of "alpha" to the end of it.
    mouse(app, "mouse_down", field.x + 8, cy)
    mouse(app, "mouse_move", field.x + 8 + 8 * 5, cy)
    mouse(app, "mouse_up", field.x + 8 + 8 * 5, cy)
    test.assert_eq(field.selected_text(), "alpha")
    window.set_clipboard("one\ntwo")
    field.paste()
    test.assert_eq(field.text, "one two beta gamma")
    app.close()
}

define test_text_area_lines_and_selection() -> void {
    if not window.available() { return }
    app := new_app()
    changes := 0
    area := ui.TextArea("first\nsecond line\nx", rows=4, on_change=fn(s) { changes = changes + 1 })
    app.root = ui.Column([area], padding=8)
    app.layout()
    click_on(app, area)
    keym(app, "home", ctrl=true)
    test.assert_eq(area.cursor, 0)
    keym(app, "end")
    test.assert_eq(area.cursor, 5)                 // end of "first"
    keym(app, "down")
    test.assert_eq(area.cursor, 11)                // column 5 of "second line"
    keym(app, "down")
    test.assert_eq(area.cursor, 19)                // "x" is short: end of it
    keym(app, "up")
    test.assert_eq(area.cursor, 11)                // back to column 5
    keym(app, "home")
    keym(app, "up", shift=true)
    test.assert_eq(area.selected_text(), "first\n")
    keym(app, "return")
    test.assert_eq(area.text, "\nsecond line\nx")
    test.assert_eq(area.lines().length(), 3)
    typed(app, "top")
    test.assert_eq(area.text, "\ntopsecond line\nx")
    test.assert_true(changes >= 2)
    // Triple-click selects a whole line.
    lx := area.x + 10
    ly := area.y + 6 + 16 + 4                      // second visible line
    mouse(app, "mouse_down", lx, ly, 3)
    mouse(app, "mouse_up", lx, ly, 3)
    test.assert_eq(area.selected_text(), "topsecond line")
    app.close()
}

define test_scroll_view_wheel_clip_and_follow_focus() -> void {
    if not window.available() { return }
    app := new_app()
    buttons := []
    i := 0
    while i < 20 {
        buttons.append(ui.Button("Item " + i.str()))
        i = i + 1
    }
    content := ui.Column(buttons, spacing=4)
    view := ui.ScrollView(content, height=100)
    below := ui.Label("below")
    app.root = ui.Column([view, below], padding=10)
    app.layout()
    test.assert_eq(view.height, 100)
    test.assert_eq(below.y, 10 + 100 + 8)
    first: ui.Button = buttons[0]
    test.assert_eq(first.y, 10)
    wheel(app, view.x + 20, view.y + 20, -2)          // towards you: scroll down
    app.layout()
    test.assert_eq(view.offset, 80)
    test.assert_eq(first.y, 10 - 80)
    // The content doesn't draw outside the view.
    app.theme = ui.light()
    app.draw()
    test.assert_eq(app.win.pixel(view.x + 20, below.y + 30), app.win.pixel(395, 295))
    // Tab to the last button: the view scrolls to show it.
    last: ui.Button = buttons[19]
    app.focus_on(buttons[18])
    keym(app, "tab")
    app.layout()
    test.assert_true(last.focused)
    test.assert_eq(last.y + last.height, view.y + view.height)
    // Wheel up past the top stops at 0.
    wheel(app, view.x + 20, view.y + 20, 50)
    app.layout()
    test.assert_eq(view.offset, 0)
    app.close()
}

define test_scroll_view_bar_drag_and_nested_list() -> void {
    if not window.available() { return }
    app := new_app()
    items := []
    i := 0
    while i < 30 {
        items.append("row " + i.str())
        i = i + 1
    }
    lv := ui.ListView(items, rows=3)
    filler := ui.Spacer(400)
    view := ui.ScrollView(ui.Column([lv, filler]), height=150)
    app.root = ui.Column([view], padding=10)
    app.layout()
    // Wheel over the list scrolls the list, not the view.
    wheel(app, lv.x + 10, lv.y + 10, -2)
    app.layout()
    test.assert_eq(view.offset, 0)
    test.assert_eq(lv._top, 2)
    // Drag the scroll bar to the bottom.
    bx := view.x + view.width - 4
    focused_before := app.focus
    mouse(app, "mouse_down", bx, view.y + 5)
    mouse(app, "mouse_move", bx, view.y + 400)
    mouse(app, "mouse_up", bx, view.y + 400)
    app.layout()
    test.assert_eq(view.offset, content_most(view))
    test.assert_true(app.focus == focused_before)   // the bar doesn't take the focus
    app.close()
}

define content_most(v: ui.ScrollView) -> Int {
    return v.content.min_h - v.height
}

define test_dropdown_mouse_and_keyboard() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    dd := ui.Dropdown(["Small", "Medium", "Large"], on_change=fn(i, item) { picked = item.str() })
    other := ui.Button("other")
    app.root = ui.Column([dd, ui.Spacer(120), other], padding=10)      // clear of the open list
    app.layout()
    test.assert_eq(dd.text(), "Small")
    click_on(app, dd)
    test.assert_true(dd.is_open)
    app.draw()                                   // places the list
    row_y := dd.y + dd.height + 2 + 2 + 24 + 12  // middle of the second row
    mouse(app, "mouse_move", dd.x + 10, row_y)
    mouse(app, "mouse_down", dd.x + 10, row_y)
    mouse(app, "mouse_up", dd.x + 10, row_y)
    test.assert_false(dd.is_open)
    test.assert_eq(dd.selected, 1)
    test.assert_eq(picked, "Medium")
    // Keyboard: Space opens, Down, Enter picks.
    keym(app, "space")
    test.assert_true(dd.is_open)
    keym(app, "down")
    keym(app, "return")
    test.assert_false(dd.is_open)
    test.assert_eq(dd.text(), "Large")
    // Closed: Up changes the choice directly; Escape closes an open list.
    keym(app, "up")
    test.assert_eq(dd.selected, 1)
    keym(app, "space")
    keym(app, "escape")
    test.assert_false(dd.is_open)
    // A click elsewhere closes it (and still reaches what was clicked).
    count := 0
    other.on_click = fn() { count = count + 1 }
    click_on(app, dd)
    test.assert_true(dd.is_open)
    app.draw()
    click_on(app, other)
    test.assert_false(dd.is_open)
    test.assert_eq(count, 1)
    // A second click on the field closes it.
    click_on(app, dd)
    click_on(app, dd)
    test.assert_false(dd.is_open)
    app.close()
}

define test_tooltip_after_delay() -> void {
    if not window.available() { return }
    app := new_app()
    app.theme = ui.light()
    label := ui.tooltip(ui.Label("hover me"), "A helpful hint")
    app.root = ui.Column([label, ui.Spacer()], padding=10)
    app.layout()
    mx := label.x + 4
    my := label.y + 4
    tip_px := mx + 12 + 2                        // inside the tooltip box
    tip_py := my + 20 + 2
    app.tooltip_delay = 100000
    mouse(app, "mouse_move", mx, my)
    app.draw()
    bg := app.win.pixel(395, 295)
    test.assert_eq(app.win.pixel(tip_px, tip_py), bg)
    app.tooltip_delay = 0
    app.draw()
    test.assert_true(app.win.pixel(tip_px, tip_py) != bg)
    // A click hides it.
    mouse(app, "mouse_down", mx, my)
    app.draw()
    test.assert_eq(app.win.pixel(tip_px, tip_py), bg)
    app.close()
}

// ───── v1.2.0: undo / redo, RadioGroup, ProgressBar, Tabs ─────
define test_undo_redo_groups_typing() -> void {
    if not window.available() { return }
    app := new_app()
    field := ui.TextInput("")
    app.root = ui.Column([field], padding=8)
    app.layout()
    click_on(app, field)
    typed(app, "h")
    typed(app, "i")
    typed(app, " ")
    typed(app, "y")
    typed(app, "o")
    test.assert_eq(field.text, "hi yo")
    keym(app, "z", ctrl=true)                  // the word "yo"
    test.assert_eq(field.text, "hi ")
    keym(app, "z", ctrl=true)                  // the space
    test.assert_eq(field.text, "hi")
    keym(app, "z", ctrl=true)                  // "hi"
    test.assert_eq(field.text, "")
    test.assert_false(field.undo())            // nothing left
    keym(app, "y", ctrl=true)
    test.assert_eq(field.text, "hi")
    keym(app, "z", ctrl=true, shift=true)      // Ctrl+Shift+Z redoes too
    test.assert_eq(field.text, "hi ")
    // A new edit drops what could be redone.
    typed(app, "!")
    test.assert_false(field.redo())
    keym(app, "backspace")
    keym(app, "z", ctrl=true)
    test.assert_eq(field.text, "hi !")
    // Paste and cut are their own steps.
    window.set_clipboard("XY")
    keym(app, "v", ctrl=true)
    test.assert_eq(field.text, "hi !XY")
    keym(app, "z", ctrl=true)
    test.assert_eq(field.text, "hi !")
    app.close()
}

define test_radio_group() -> void {
    if not window.available() { return }
    app := new_app()
    picked := ""
    rg := ui.RadioGroup(["Red", "Green", "Blue"], selected=0, on_change=fn(i, item) { picked = item.str() })
    app.root = ui.Column([rg], padding=10)
    app.layout()
    test.assert_eq(rg.height, 3 * 24)
    mouse(app, "mouse_down", rg.x + 5, rg.y + 24 * 2 + 10)
    mouse(app, "mouse_up", rg.x + 5, rg.y + 24 * 2 + 10)
    test.assert_eq(rg.selected, 2)
    test.assert_eq(picked, "Blue")
    test.assert_true(rg.focused)
    keym(app, "up")
    test.assert_eq(rg.text(), "Green")
    keym(app, "home")
    test.assert_eq(rg.selected, 0)
    keym(app, "end")
    keym(app, "down")                           // stays on the last
    test.assert_eq(rg.selected, 2)
    app.close()
}

define test_progress_bar() -> void {
    if not window.available() { return }
    app := new_app()
    app.theme = ui.light()
    bar := ui.ProgressBar(value=25, max=200, show_text=true)
    app.root = ui.Column([bar], padding=10)
    app.layout()
    test.assert_eq(bar.percent(), 12)
    bar.value = 500
    test.assert_eq(bar.percent(), 100)
    bar.value = 50
    bar.max = 100
    app.draw()
    // Left half filled with the accent, right half not.
    test.assert_eq(app.win.pixel(bar.x + bar.width / 4, bar.y + 3), window.hex("#2f6fde") % 0x1000000)
    test.assert_eq(app.win.pixel(bar.x + bar.width * 3 / 4 + 20, bar.y + 3), window.hex("#ffffff") % 0x1000000)
    app.close()
}

define test_tabs_switch_pages() -> void {
    if not window.available() { return }
    app := new_app()
    changes := []
    first := ui.Button("on page one")
    second := ui.Label("page two")
    tabs := ui.Tabs(["One", "Two"], [first, second], on_change=fn(i, title) { changes.append(title) })
    app.root = ui.Column([tabs], padding=10, expand=true)
    app.layout()
    app.draw()                                   // places the tab row
    test.assert_true(tabs.page() == first)
    test.assert_true(first.y > tabs.y + 20)
    // Click the second tab (right after the first).
    one_w := window.text_width("One") + 24
    mouse(app, "mouse_down", tabs.x + one_w + 10, tabs.y + 10)
    mouse(app, "mouse_up", tabs.x + one_w + 10, tabs.y + 10)
    test.assert_eq(tabs.selected, 1)
    test.assert_eq(changes, ["Two"])
    // Only the shown page is in the tree (hit-testing, Tab order).
    test.assert_eq(tabs.children().length(), 1)
    keym(app, "left")
    test.assert_eq(tabs.selected, 0)
    keym(app, "tab", ctrl=true)                  // Ctrl+Tab: next tab, not next widget
    test.assert_eq(tabs.selected, 1)
    tabs.add("Three", ui.Label("page three"))
    keym(app, "right")
    test.assert_eq(tabs.selected, 2)
    keym(app, "right")                           // wraps
    test.assert_eq(tabs.selected, 0)
    app.close()
}
