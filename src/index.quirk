---
Widgets for `window`: labels, buttons, checkboxes, text fields and areas,
sliders, lists and dropdowns, laid out in rows, columns and scroll views,
with mouse, keyboard, Tab focus, the clipboard and tooltips handled for
you.

  `ui.App(title, width, height)`   — a window with a widget tree
  `app.root = ui.Column([...])`    — what it shows
  `app.run()`                      — until the window closes

Widgets:
  `ui.Label(text)`
  `ui.Button(text, on_click=fn() => ...)`
  `ui.Checkbox(text, checked=false, on_change=fn(on) => ...)`
  `ui.TextInput(text="", placeholder="", on_change=fn(s) => ..., on_submit=fn(s) => ...)`
  `ui.TextArea(text="", rows=6, columns=40, on_change=fn(s) => ..., wrap=false)`
  `ui.RadioGroup(options, selected=0, on_change=fn(i, item) => ...)`
  `ui.Slider(min=0, max=100, value=50, on_change=fn(v) => ...)`
  `ui.ProgressBar(value=0, max=100, show_text=false)`
  `ui.ListView(items, on_select=fn(i, item) => ...)`
  `ui.TreeView([ui.TreeNode("src", [ui.TreeNode("main.qk")])], on_select=fn(node) => ...)`
  `ui.Table(["Name", "Size"], rows, on_select=fn(i, row) => ..., editable=false)`
  `ui.ColorPicker(color=, on_change=fn(c) => ...)`
  `ui.Dropdown(options, selected=0, on_change=fn(i, item) => ...)`
Menus:
  `ui.MenuBar(["File"], [ui.Menu([ui.MenuItem("Open", on_click=fn() => ...)])])`
  `widget.context_menu = ui.Menu([...])` — opened by a right-click
Dialogs: `ui.FileDialog(mode="open"|"save"|"folder", dir=, on_pick=fn(path) => ...).show()`
More: `ui.DatePicker(year, month, day)`, `ui.SplitView(a, b, vertical=)`,
  `ui.Toolbar([ui.ToolButton("Save", icon="save.png", on_click=)])`,
  `ui.StatusBar(["Ready", "Ln 1"])`; a MenuItem's `shortcut` works window-wide
Drag and drop: `source.on_drag = fn() => data`, `target.on_drop = fn(data) => ...`;
  `ui.ListView(items, reorderable=true)` reorders by dragging
Layout:
  `ui.Column(children, padding=, spacing=)` — stacked top to bottom
  `ui.Row(children, padding=, spacing=)`    — side by side
  `ui.Panel(children, ...)`                 — a Column on a raised surface
  `ui.ScrollView(content, height=200)`      — scrolls content that's taller
  `ui.Tabs(titles, pages)`                  — one page at a time under a row of tabs
  `ui.Spacer()`                             — takes the free space

Every widget can `expand` (take a share of its container's free
space), be hidden (`visible = false`) or disabled (`enabled = false`).
Read and change widgets directly: `input.text`, `box.checked`,
`slider.value`, `label.text = "Done"`.

Keyboard: Tab / Shift+Tab move the focus; Enter or Space press the
focused button or checkbox; arrows move sliders and lists. Text fields:
Shift + arrows select, Ctrl+A / C / X / V select all, copy, cut and
paste (system clipboard), Ctrl+Z / Ctrl+Y undo and redo, Ctrl + arrows
move by word; double-click selects a word.

Tooltips: `w.tooltip = "..."`, or inline `ui.tooltip(widget, "...")`.

Themes: `ui.dark()` (default) and `ui.light()`, or your own `ui.Theme`.

@example
use ui

app := ui.App("Greeter", 360, 220)
name := ui.TextInput(placeholder="Your name")
greeting := ui.Label("")
app.root = ui.Column([
    ui.Label("What's your name?"),
    name,
    ui.Button("Greet", on_click=fn() { greeting.text = "Hello, " + name.text + "!" }),
    greeting,
], padding=16)
app.run()
---
from typing.primitives.string use { String }
from typing.collections.list use { List }
use window
use fs

define _max(a: Int, b: Int) -> Int {
    if a > b { return a }
    return b
}

define _min(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}

define _clamp(v: Int, lo: Int, hi: Int) -> Int {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

---
Blend colour `a` toward `b` by `percent` (0 = a, 100 = b). For hover and
pressed shades.
---
define mix(a: Int, b: Int, percent: Int) -> Int {
    ca := window.channels(a)
    cb := window.channels(b)
    p := _clamp(percent, 0, 100)
    r := (ca[0] * (100 - p) + cb[0] * p) / 100
    g := (ca[1] * (100 - p) + cb[1] * p) / 100
    bl := (ca[2] * (100 - p) + cb[2] * p) / 100
    al := (ca[3] * (100 - p) + cb[3] * p) / 100
    return window.rgba(r, g, bl, al)
}

// ===== Themes =====

---
Colours and sizes every widget draws with. Make your own by changing a
copy of `ui.dark()` / `ui.light()`.
  `background` — the window; `surface` — panels; `text`, `muted` — text
  `accent` / `accent_text` — buttons, checks, sliders, selection
  `input` — text field / list background; `border`; `focus` — focus ring
  `scale` — text size multiplier (1 = 8x16 pixel characters)
---
struct Theme {
    background: Int
    surface: Int
    text: Int
    muted: Int
    accent: Int
    accent_text: Int
    input: Int
    border: Int
    focus: Int
    scale: Int

    define __init(self, background: Int, surface: Int, text: Int, muted: Int, accent: Int, accent_text: Int, input: Int, border: Int, focus: Int, scale: Int = 1) -> void {
        self.background = background
        self.surface = surface
        self.text = text
        self.muted = muted
        self.accent = accent
        self.accent_text = accent_text
        self.input = input
        self.border = border
        self.focus = focus
        self.scale = scale
    }

    --- Height of one line of text. ---
    define line(self) -> Int {
        return 16 * self.scale
    }

    --- Width of one character. ---
    define char_w(self) -> Int {
        return 8 * self.scale
    }
}

--- Light text on dark grey, blue accent. ---
define dark() -> Theme {
    return Theme(window.hex("#1e1f24"), window.hex("#2a2c33"), window.hex("#e8e8ec"), window.hex("#8b8d98"),
                 window.hex("#4c8dff"), window.hex("#ffffff"), window.hex("#15161a"), window.hex("#3d404a"),
                 window.hex("#7fb0ff"))
}

--- Dark text on white, blue accent. ---
define light() -> Theme {
    return Theme(window.hex("#f4f5f7"), window.hex("#ffffff"), window.hex("#1d1f24"), window.hex("#6b6f7a"),
                 window.hex("#2f6fde"), window.hex("#ffffff"), window.hex("#ffffff"), window.hex("#c9ccd3"),
                 window.hex("#2f6fde"))
}

// ===== Widget base =====

---
What every widget has. Layout fills in `x`, `y`, `width`, `height` each
frame; `min_w` / `min_h` are the size the widget asks for.
  `expand`   — take a share of the container's free space
  `visible`  — false: not drawn and takes no space
  `enabled`  — false: drawn dimmed, ignores input
  `hovered`, `focused`, `pressed` — set by the App
  `tooltip`  — text shown when the mouse rests on it ("" = none)
  `context_menu` — a `ui.Menu` opened by a right-click on it (or null)
  `on_drag`  — `fn() => data`: the widget can be dragged, carrying `data`
  `on_drop`  — `fn(data)`: something dragged can be dropped on it
To make your own widget, subclass it and override `measure`, `draw` and
`handle` (and `children` for containers).
---
struct Widget {
    x: Int
    y: Int
    width: Int
    height: Int
    min_w: Int
    min_h: Int
    expand: Bool
    visible: Bool
    enabled: Bool
    focusable: Bool
    hovered: Bool
    focused: Bool
    pressed: Bool
    tooltip: String
    takes_clicks: Bool
    context_menu: Menu
    on_drag: Callable
    on_drop: Callable

    define __init(self) -> void {
        self.x = 0
        self.y = 0
        self.width = 0
        self.height = 0
        self.min_w = 0
        self.min_h = 0
        self.expand = false
        self.visible = true
        self.enabled = true
        self.focusable = false
        self.hovered = false
        self.focused = false
        self.pressed = false
        self.tooltip = ""
        self.takes_clicks = false
        self.context_menu = null
        self.on_drag = null
        self.on_drop = null
    }

    --- Work out `min_w` / `min_h` (containers measure their children first). ---
    define measure(self, t: Theme) -> void {
    }

    --- Take the box (x, y, width, height); containers place their children inside. ---
    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
    }

    --- Draw into `win` inside the widget's box. ---
    define draw(self, win: window.Window, t: Theme) -> void {
    }

    --- React to an event; true if the widget used it. ---
    define handle(self, e: window.Event) -> Bool {
        return false
    }

    --- Child widgets (containers). ---
    define children(self) -> List {
        return []
    }

    --- True if (px, py) is inside the widget's box. ---
    define contains(self, px: Int, py: Int) -> Bool {
        return px >= self.x and py >= self.y and px < self.x + self.width and py < self.y + self.height
    }

    // Popups (Dropdown): drawn above everything, offered mouse events first.
    define draw_popup(self, win: window.Window, t: Theme) -> void {
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return false
    }

    define popup_handle(self, e: window.Event) -> Bool {
        return false
    }

    // Keys for an open popup that takes them itself (Menu); true if used.
    define popup_key(self, e: window.Event) -> Bool {
        return false
    }

    define close_popup(self) -> void {
    }

    // Open this popup at (px, py) (Menu).
    define open_at(self, px: Int, py: Int) -> void {
    }

    // True for a MenuBar (its menus' shortcuts work window-wide).
    define is_menu_bar(self) -> Bool {
        return false
    }
}

---
Give `w` a tooltip and return it — for building trees inline:
`ui.tooltip(ui.Button("Save", on_click=save), "Write the file (Ctrl+S)")`.
---
define tooltip(w: Widget, text: String) -> Widget {
    w.tooltip = text
    return w
}

// Draw the focus ring around a widget.
define _focus_ring(win: window.Window, w: Widget, t: Theme) -> void {
    win.rect(w.x - 2, w.y - 2, w.width + 4, w.height + 4, t.focus, fill=false)
}

// Text colour for a widget that may be disabled.
define _ink(w: Widget, color: Int, t: Theme) -> Int {
    if not w.enabled { return mix(color, t.background, 55) }
    return color
}

// Clip rectangles in force while drawing ([x, y, w, h], innermost last):
// scroll views nest, so each one draws inside the intersection.
_clips := []

define _clip_push(win: window.Window, x: Int, y: Int, w: Int, h: Int) -> void {
    nx := x
    ny := y
    nr := x + w
    nb := y + h
    if _clips.length() > 0 {
        top: List = _clips[_clips.length() - 1]
        tx: Int = top[0]
        ty: Int = top[1]
        tw: Int = top[2]
        th: Int = top[3]
        nx = _max(nx, tx)
        ny = _max(ny, ty)
        nr = _min(nr, tx + tw)
        nb = _min(nb, ty + th)
    }
    cw := _max(0, nr - nx)
    ch := _max(0, nb - ny)
    _clips.append([nx, ny, cw, ch])
    win.clip(nx, ny, cw, ch)
}

define _clip_pop(win: window.Window) -> void {
    if _clips.length() > 0 { _clips.pop() }
    if _clips.length() == 0 {
        win.unclip()
    } else {
        top: List = _clips[_clips.length() - 1]
        tx: Int = top[0]
        ty: Int = top[1]
        tw: Int = top[2]
        th: Int = top[3]
        win.clip(tx, ty, tw, th)
    }
}

// Open popups (Dropdown lists), topmost last.
_popups := []

// Selection highlight colour.
define _sel_color(w: Widget, t: Theme) -> Int {
    if w.focused { return mix(t.accent, t.input, 55) }
    return mix(t.border, t.input, 30)
}

// Letters, digits and _ make up words (double-click, Ctrl+arrows).
define _wordy(c: String) -> Bool {
    return c.is_alpha() or c.is_digit() or c == "_"
}

// ===== Layout =====

---
Children stacked top to bottom, each as wide as the column. Free height
goes to children with `expand = true`.
---
struct Column : Widget {
    padding: Int
    spacing: Int
    background: Bool
    _kids: List

    define __init(self, children: List, padding: Int = 0, spacing: Int = 8, expand: Bool = false) -> void {
        super().__init()
        self._kids = children
        self.padding = padding
        self.spacing = spacing
        self.background = false
        self.expand = expand
    }

    define children(self) -> List {
        return self._kids
    }

    --- Add a widget at the end. ---
    define add(self, w: Widget) -> void {
        self._kids.append(w)
    }

    define measure(self, t: Theme) -> void {
        mw := 0
        mh := 0
        n := 0
        for c in self._kids {
            if c.visible {
                c.measure(t)
                mw = _max(mw, c.min_w)
                mh = mh + c.min_h
                n = n + 1
            }
        }
        if n > 1 { mh = mh + self.spacing * (n - 1) }
        self.min_w = mw + 2 * self.padding
        self.min_h = mh + 2 * self.padding
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        inner_w := width - 2 * self.padding
        free := height - self.min_h
        k := 0
        for c in self._kids {
            if c.visible and c.expand { k = k + 1 }
        }
        cy := y + self.padding
        for c in self._kids {
            if c.visible {
                ch := c.min_h
                if c.expand and k > 0 and free > 0 { ch = ch + free / k }
                c.place(x + self.padding, cy, inner_w, ch)
                cy = cy + ch + self.spacing
            }
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.background {
            win.rect(self.x, self.y, self.width, self.height, t.surface)
            win.rect(self.x, self.y, self.width, self.height, t.border, fill=false)
        }
        for c in self._kids {
            if c.visible { c.draw(win, t) }
        }
    }
}

---
Children side by side, each as tall as the row. Free width goes to
children with `expand = true`.
---
struct Row : Widget {
    padding: Int
    spacing: Int
    _kids: List

    define __init(self, children: List, padding: Int = 0, spacing: Int = 8, expand: Bool = false) -> void {
        super().__init()
        self._kids = children
        self.padding = padding
        self.spacing = spacing
        self.expand = expand
    }

    define children(self) -> List {
        return self._kids
    }

    --- Add a widget at the end. ---
    define add(self, w: Widget) -> void {
        self._kids.append(w)
    }

    define measure(self, t: Theme) -> void {
        mw := 0
        mh := 0
        n := 0
        for c in self._kids {
            if c.visible {
                c.measure(t)
                mw = mw + c.min_w
                mh = _max(mh, c.min_h)
                n = n + 1
            }
        }
        if n > 1 { mw = mw + self.spacing * (n - 1) }
        self.min_w = mw + 2 * self.padding
        self.min_h = mh + 2 * self.padding
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        inner_h := height - 2 * self.padding
        free := width - self.min_w
        k := 0
        for c in self._kids {
            if c.visible and c.expand { k = k + 1 }
        }
        cx := x + self.padding
        for c in self._kids {
            if c.visible {
                cw := c.min_w
                if c.expand and k > 0 and free > 0 { cw = cw + free / k }
                c.place(cx, y + self.padding, cw, inner_h)
                cx = cx + cw + self.spacing
            }
        }
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        for c in self._kids {
            if c.visible { c.draw(win, t) }
        }
    }
}

--- A Column drawn on a raised surface with a border (12px padding by default). ---
define Panel(children: List, padding: Int = 12, spacing: Int = 8, expand: Bool = false) -> Column {
    col := Column(children, padding, spacing, expand)
    col.background = true
    return col
}

--- Empty space that takes whatever its container has left over. ---
struct Spacer : Widget {
    size: Int

    define __init(self, size: Int = 0) -> void {
        super().__init()
        self.size = size
        self.expand = size == 0
    }

    define measure(self, t: Theme) -> void {
        self.min_w = self.size
        self.min_h = self.size
    }
}

// ===== Label =====

---
Text. "\n" starts a new line. `color` -1 uses the theme's text colour;
`align` is "left", "center" or "right".
---
struct Label : Widget {
    text: String
    color: Int
    align: String

    define __init(self, text: String, color: Int = -1, align: String = "left") -> void {
        super().__init()
        self.text = text
        self.color = color
        self.align = align
    }

    define measure(self, t: Theme) -> void {
        self.min_w = window.text_width(self.text, t.scale)
        lines := self.text.split("\n").length()
        self.min_h = _max(1, lines) * t.line()
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        c := self.color
        if c == -1 { c = t.text }
        tw := window.text_width(self.text, t.scale)
        tx := self.x
        if self.align == "center" { tx = self.x + (self.width - tw) / 2 }
        if self.align == "right" { tx = self.x + self.width - tw }
        ty := self.y + (self.height - self.min_h) / 2
        win.text(self.text, tx, ty, _ink(self, c, t), scale=t.scale)
    }
}

// ===== Button =====

---
A push button. `on_click` (no arguments) runs when it's clicked, or
when it has the focus and Enter / Space is pressed.
---
struct Button : Widget {
    text: String
    on_click: Callable

    define __init(self, text: String, on_click: Callable = null, expand: Bool = false) -> void {
        super().__init()
        self.text = text
        self.on_click = on_click
        self.focusable = true
        self.expand = expand
    }

    --- Press the button from code. ---
    define click(self) -> void {
        if self.enabled and self.on_click != null { self.on_click() }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = window.text_width(self.text, t.scale) + 4 * t.char_w()
        self.min_h = t.line() + 12
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        bg := t.accent
        if not self.enabled {
            bg = mix(t.accent, t.background, 60)
        } elif self.pressed {
            bg = mix(t.accent, window.black(), 25)
        } elif self.hovered {
            bg = mix(t.accent, window.white(), 15)
        }
        win.rect(self.x, self.y, self.width, self.height, bg)
        tw := window.text_width(self.text, t.scale)
        win.text(self.text, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2,
                 _ink(self, t.accent_text, t), scale=t.scale)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.click() }
            return true
        }
        if e.kind == "key_down" and (e.key == "return" or e.key == "space" or e.key == "keypad_enter") {
            self.click()
            return true
        }
        return false
    }
}

// ===== Checkbox =====

---
A box that's ticked or not, with a label. `on_change(checked)` runs when
the user toggles it.
---
struct Checkbox : Widget {
    text: String
    checked: Bool
    on_change: Callable

    define __init(self, text: String, checked: Bool = false, on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.checked = checked
        self.on_change = on_change
        self.focusable = true
    }

    --- Flip it, as a click would (runs `on_change`). ---
    define toggle(self) -> void {
        if not self.enabled { return }
        self.checked = not self.checked
        if self.on_change != null { self.on_change(self.checked) }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = t.line() + t.char_w() + window.text_width(self.text, t.scale)
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        bx := self.x
        by := self.y + (self.height - s) / 2
        win.rect(bx, by, s, s, t.input)
        border := t.border
        if self.hovered { border = t.accent }
        win.rect(bx, by, s, s, border, fill=false)
        if self.checked {
            m := _max(2, s / 4)
            win.rect(bx + m, by + m, s - 2 * m, s - 2 * m, _ink(self, t.accent, t))
        }
        win.text(self.text, bx + s + t.char_w(), self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale)
        if self.focused { _focus_ring(win, self, t) }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.toggle() }
            return true
        }
        if e.kind == "key_down" and (e.key == "space" or e.key == "return") {
            self.toggle()
            return true
        }
        return false
    }
}

// ===== Text editing (TextInput, TextArea) =====

---
What TextInput and TextArea share: the text, a cursor and a selection,
and the editing keys.
  `text`             — the contents; set it to replace them
  `cursor`           — position (0 = before the first character)
  `has_selection()`, `selection_start()`, `selection_end()`,
  `selected_text()`, `select(start, end)`, `select_all()`
  `insert(s)`        — type `s` at the cursor (replacing the selection)
  `copy()`, `cut()`, `paste()` — through the system clipboard
  `undo()`, `redo()` — Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z
Keys: Shift + arrows / Home / End select, Ctrl+A selects everything,
Ctrl+C / X / V copy, cut and paste (Cmd on macOS), Ctrl + Left / Right
move by word, Ctrl + Backspace / Delete erase a word. Mouse: click to
place the cursor, drag or Shift+click to select, double-click selects a
word, triple-click a line.
---
struct TextEdit : Widget {
    text: String
    cursor: Int
    anchor: Int
    on_change: Callable
    single_line: Bool
    _dragging: Bool
    _cw: Int
    _lh: Int
    _undo: List
    _redo: List
    _typing: Bool

    define __init(self, text: String = "", on_change: Callable = null) -> void {
        super().__init()
        self.text = text
        self.cursor = text.length()
        self.anchor = self.cursor
        self.on_change = on_change
        self.single_line = false
        self._dragging = false
        self._undo = []
        self._redo = []
        self._typing = false
        self._cw = 8
        self._lh = 16
        self.focusable = true
    }

    define _changed(self) -> void {
        if self.on_change != null { self.on_change(self.text) }
    }

    // Remember the state before an edit. A run of typed characters is one
    // undo step; anything else (paste, delete, Enter) starts a new one.
    define _snapshot(self, typing: Bool) -> void {
        if typing and self._typing and self._undo.length() > 0 {
            return
        }
        self._undo.append([self.text, self.cursor, self.anchor])
        if self._undo.length() > 200 {
            rest := []
            i := 1
            while i < self._undo.length() {
                rest.append(self._undo[i])
                i = i + 1
            }
            self._undo = rest
        }
        self._redo = []
        self._typing = typing
    }

    define _restore(self, state: List) -> void {
        t: String = state[0]
        c: Int = state[1]
        a: Int = state[2]
        self.text = t
        self.cursor = c
        self.anchor = a
        self._fix()
        self._typing = false
        self._changed()
    }

    --- Undo the last edit (Ctrl+Z); false when there's nothing to undo. ---
    define undo(self) -> Bool {
        if self._undo.length() == 0 { return false }
        self._redo.append([self.text, self.cursor, self.anchor])
        state: List = self._undo.pop()
        self._restore(state)
        return true
    }

    --- Redo what `undo` took back (Ctrl+Y / Ctrl+Shift+Z). ---
    define redo(self) -> Bool {
        if self._redo.length() == 0 { return false }
        self._undo.append([self.text, self.cursor, self.anchor])
        state: List = self._redo.pop()
        self._restore(state)
        return true
    }

    // Keep cursor / anchor inside the text (after `text` was set from code).
    define _fix(self) -> void {
        n := self.text.length()
        self.cursor = _clamp(self.cursor, 0, n)
        self.anchor = _clamp(self.anchor, 0, n)
    }

    --- True when some text is selected. ---
    define has_selection(self) -> Bool {
        self._fix()
        return self.anchor != self.cursor
    }

    --- Where the selection starts (== `selection_end()` when nothing is selected). ---
    define selection_start(self) -> Int {
        self._fix()
        return _min(self.anchor, self.cursor)
    }

    --- Where the selection ends. ---
    define selection_end(self) -> Int {
        self._fix()
        return _max(self.anchor, self.cursor)
    }

    --- The selected text ("" if none). ---
    define selected_text(self) -> String {
        return self.text.substring(self.selection_start(), self.selection_end())
    }

    --- Select from `start` to `end` (the cursor goes to `end`). ---
    define select(self, start: Int, end: Int) -> void {
        n := self.text.length()
        self.anchor = _clamp(start, 0, n)
        self.cursor = _clamp(end, 0, n)
    }

    --- Select everything. ---
    define select_all(self) -> void {
        self.select(0, self.text.length())
    }

    // Remove the selected text; true if there was any.
    define _cut_selection(self) -> Bool {
        if not self.has_selection() { return false }
        a := self.selection_start()
        b := self.selection_end()
        self.text = self.text.substring(0, a) + self.text.substring(b, self.text.length())
        self.cursor = a
        self.anchor = a
        return true
    }

    --- Insert `s` at the cursor, as typing would (replaces the selection). ---
    define insert(self, s: String) -> void {
        self._snapshot(s.length() == 1 and s != "\n" and not self.has_selection() and s != " ")
        self._cut_selection()
        self._fix()
        c := self.cursor
        self.text = self.text.substring(0, c) + s + self.text.substring(c, self.text.length())
        self.cursor = c + s.length()
        self.anchor = self.cursor
        self._changed()
    }

    --- Copy the selection to the clipboard. ---
    define copy(self) -> void {
        if self.has_selection() { window.set_clipboard(self.selected_text()) }
    }

    --- Copy the selection to the clipboard and remove it. ---
    define cut(self) -> void {
        if self.has_selection() {
            self.copy()
            self._snapshot(false)
            self._cut_selection()
            self._changed()
        }
    }

    --- Insert what's on the clipboard. ---
    define paste(self) -> void {
        s := self._clean(window.clipboard())
        if s.length() > 0 { self.insert(s) }
    }

    // What pasted text becomes: line breaks turn into spaces on one line.
    define _clean(self, s: String) -> String {
        if self.single_line { return s.replace("\r\n", " ").replace("\n", " ").replace("\t", " ") }
        return s.replace("\r\n", "\n")
    }

    define _move(self, to: Int, grow: Bool) -> void {
        self._typing = false
        self.cursor = _clamp(to, 0, self.text.length())
        if not grow { self.anchor = self.cursor }
    }

    // Start of the word before i / end of the word after i.
    define _word_left(self, i: Int) -> Int {
        j := i
        while j > 0 and not _wordy(self.text.substring(j - 1, j)) { j = j - 1 }
        while j > 0 and _wordy(self.text.substring(j - 1, j)) { j = j - 1 }
        return j
    }

    define _word_right(self, i: Int) -> Int {
        n := self.text.length()
        j := i
        while j < n and not _wordy(self.text.substring(j, j + 1)) { j = j + 1 }
        while j < n and _wordy(self.text.substring(j, j + 1)) { j = j + 1 }
        return j
    }

    // Select the word (or run of other characters) at i.
    define _select_word(self, i: Int) -> void {
        n := self.text.length()
        if n == 0 { return }
        at := _clamp(i, 0, n - 1)
        if i == n and i > 0 { at = i - 1 }
        kind := _wordy(self.text.substring(at, at + 1))
        a := at
        b := at + 1
        while a > 0 and _wordy(self.text.substring(a - 1, a)) == kind { a = a - 1 }
        while b < n and _wordy(self.text.substring(b, b + 1)) == kind { b = b + 1 }
        self.select(a, b)
    }

    // Start / end of the line holding i ("\n"-separated).
    define _line_start(self, i: Int) -> Int {
        j := _clamp(i, 0, self.text.length())
        while j > 0 and self.text.substring(j - 1, j) != "\n" { j = j - 1 }
        return j
    }

    define _line_end(self, i: Int) -> Int {
        n := self.text.length()
        j := _clamp(i, 0, n)
        while j < n and self.text.substring(j, j + 1) != "\n" { j = j + 1 }
        return j
    }

    --- The text index under the point (px, py) (where a click puts the cursor). ---
    define index_at(self, px: Int, py: Int) -> Int {
        return 0
    }

    // Editing keys and mouse handling both widgets share; true if used.
    define _edit(self, e: window.Event) -> Bool {
        if e.kind == "text" {
            self.insert(e.text)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            i := self.index_at(e.x, e.y)
            if e.clicks >= 3 {
                self.select(self._line_start(i), self._line_end(i))
            } elif e.clicks == 2 {
                self._select_word(i)
            } else {
                self._move(i, e.shift)
                self._dragging = true
            }
            return true
        }
        if e.kind == "mouse_move" {
            if self._dragging { self.cursor = self.index_at(e.x, e.y) }
            return self._dragging
        }
        if e.kind == "mouse_up" {
            self._dragging = false
            return true
        }
        if e.kind != "key_down" { return false }
        k := e.key
        mod := e.ctrl or e.meta
        if mod and (k == "y" or (k == "z" and e.shift)) {
            self.redo()
        } elif mod and k == "z" {
            self.undo()
        } elif mod and k == "a" {
            self.select_all()
        } elif mod and k == "c" {
            self.copy()
        } elif mod and k == "x" {
            self.cut()
        } elif mod and k == "v" {
            self.paste()
        } elif k == "left" {
            if self.has_selection() and not e.shift {
                self._move(self.selection_start(), false)
            } elif mod {
                self._move(self._word_left(self.cursor), e.shift)
            } else {
                self._move(self.cursor - 1, e.shift)
            }
        } elif k == "right" {
            if self.has_selection() and not e.shift {
                self._move(self.selection_end(), false)
            } elif mod {
                self._move(self._word_right(self.cursor), e.shift)
            } else {
                self._move(self.cursor + 1, e.shift)
            }
        } elif k == "backspace" {
            if self.has_selection() or self.cursor > 0 { self._snapshot(false) }
            if self._cut_selection() {
                self._changed()
            } elif self.cursor > 0 {
                start := self.cursor - 1
                if mod { start = self._word_left(self.cursor) }
                self.text = self.text.substring(0, start) + self.text.substring(self.cursor, self.text.length())
                self.cursor = start
                self.anchor = start
                self._changed()
            }
        } elif k == "delete" {
            if self.has_selection() or self.cursor < self.text.length() { self._snapshot(false) }
            if self._cut_selection() {
                self._changed()
            } elif self.cursor < self.text.length() {
                stop := self.cursor + 1
                if mod { stop = self._word_right(self.cursor) }
                self.text = self.text.substring(0, self.cursor) + self.text.substring(stop, self.text.length())
                self.anchor = self.cursor
                self._changed()
            }
        } else {
            return false
        }
        return true
    }
}

// ===== TextInput =====

---
A one-line text field. Type when it has the focus (click it or Tab to
it); editing, selection and copy / paste as described for `TextEdit`.
`on_change(text)` runs on every edit, `on_submit(text)` on Enter.
`columns` sets its width in characters.
---
struct TextInput : TextEdit {
    placeholder: String
    columns: Int
    on_submit: Callable
    _scroll: Int

    define __init(self, text: String = "", placeholder: String = "", on_change: Callable = null, on_submit: Callable = null, columns: Int = 20) -> void {
        super().__init(text, on_change)
        self.placeholder = placeholder
        self.columns = columns
        self.on_submit = on_submit
        self.single_line = true
        self._scroll = 0
    }

    define measure(self, t: Theme) -> void {
        self._cw = t.char_w()
        self._lh = t.line()
        self.min_w = self.columns * t.char_w() + 16
        self.min_h = t.line() + 12
    }

    define _visible_chars(self) -> Int {
        return _max(1, (self.width - 16) / self._cw)
    }

    define index_at(self, px: Int, py: Int) -> Int {
        col := (px - self.x - 8 + self._cw / 2) / self._cw
        if px < self.x + 8 { col = 0 }
        return _clamp(self._scroll + col, 0, self.text.length())
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if self._edit(e) { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        n := self.text.length()
        if k == "home" or (k == "up" and not e.shift) {
            self._move(0, e.shift)
        } elif k == "end" or (k == "down" and not e.shift) {
            self._move(n, e.shift)
        } elif k == "return" or k == "keypad_enter" {
            if self.on_submit != null { self.on_submit(self.text) }
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        self._fix()
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        cw := t.char_w()
        visible := _max(1, (self.width - 16) / cw)
        // Keep the cursor in view.
        if self.cursor < self._scroll { self._scroll = self.cursor }
        if self.cursor > self._scroll + visible { self._scroll = self.cursor - visible }
        self._scroll = _clamp(self._scroll, 0, _max(0, self.text.length() - 1))
        ty := self.y + (self.height - t.line()) / 2
        if self.text.length() == 0 {
            if not self.focused and self.placeholder.length() > 0 {
                shown := self.placeholder
                if shown.length() > visible { shown = shown.substring(0, visible) }
                win.text(shown, self.x + 8, ty, t.muted, scale=t.scale)
            }
        } else {
            end := _min(self.text.length(), self._scroll + visible)
            if self.has_selection() {
                a := _max(self.selection_start(), self._scroll)
                b := _min(self.selection_end(), end)
                if b > a {
                    win.rect(self.x + 8 + (a - self._scroll) * cw, ty, (b - a) * cw, t.line(), _sel_color(self, t))
                }
            }
            win.text(self.text.substring(self._scroll, end), self.x + 8, ty, _ink(self, t.text, t), scale=t.scale)
        }
        if self.focused and (window.ticks() / 530) % 2 == 0 {
            cx := self.x + 8 + (self.cursor - self._scroll) * cw
            win.rect(cx, ty, _max(1, t.scale), t.line(), t.text)
        }
    }
}

// ===== TextArea =====

---
Multi-line text. Enter starts a new line; Up / Down / Page Up / Page Down
move between lines, Home / End to the start / end of the line (with Ctrl:
of the text). Editing, selection and copy / paste as for `TextEdit`.
`rows` / `columns` set the size it asks for; it scrolls (wheel, or by
following the cursor) when the text is bigger. With `wrap=true` long
lines break at spaces to fit the width (and the keys move along the
wrapped lines) instead of scrolling sideways. `on_change(text)` runs on
every edit.
---
struct TextArea : TextEdit {
    rows: Int
    columns: Int
    wrap: Bool
    _top: Int
    _left: Int
    _goal: Int

    define __init(self, text: String = "", rows: Int = 6, columns: Int = 40, on_change: Callable = null, expand: Bool = false, wrap: Bool = false) -> void {
        super().__init(text, on_change)
        self.rows = rows
        self.columns = columns
        self.wrap = wrap
        self.expand = expand
        self._top = 0
        self._left = 0
        self._goal = -1
    }

    --- The text split into lines (at "\n"; wrapping doesn't count). ---
    define lines(self) -> List {
        return self.text.split("\n")
    }

    define measure(self, t: Theme) -> void {
        self._cw = t.char_w()
        self._lh = t.line()
        self.min_w = self.columns * t.char_w() + 16
        self.min_h = self.rows * t.line() + 12
    }

    define _shown_rows(self) -> Int {
        return _max(1, (self.height - 12) / self._lh)
    }

    define _shown_cols(self) -> Int {
        if self.width <= 0 { return self.columns }
        return _max(1, (self.width - 16) / self._cw)
    }

    --- The rows on screen as [start, end] text ranges ("\n" not included). ---
    define layout(self) -> List {
        out := []
        n := self.text.length()
        cols := self._shown_cols()
        s := 0
        while true {
            e := self._line_end(s)
            if self.wrap {
                pos := s
                while e - pos > cols {
                    brk := pos + cols
                    j := brk
                    while j > pos and self.text.substring(j - 1, j) != " " { j = j - 1 }
                    if j > pos { brk = j }
                    out.append([pos, brk])
                    pos = brk
                }
                out.append([pos, e])
            } else {
                out.append([s, e])
            }
            if e >= n { break }
            s = e + 1
        }
        return out
    }

    // The row holding index i. At a wrap point the index starts the next row.
    define _row_of(self, rows: List, i: Int) -> Int {
        r := 0
        while r < rows.length() {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            if i >= ra and i < rb { return r }
            if i == rb {
                if r + 1 >= rows.length() { return r }
                nxt: List = rows[r + 1]
                na: Int = nxt[0]
                if na != rb { return r }
            }
            r = r + 1
        }
        return _max(0, rows.length() - 1)
    }

    // Index at column `col` of row `r` (clamped to the row; a wrapped row
    // stops before its wrap point, which belongs to the next row).
    define _at_row(self, rows: List, r: Int, col: Int) -> Int {
        if r < 0 { return 0 }
        if r >= rows.length() { return self.text.length() }
        row: List = rows[r]
        ra: Int = row[0]
        rb: Int = row[1]
        last := rb - ra
        if r + 1 < rows.length() {
            nxt: List = rows[r + 1]
            na: Int = nxt[0]
            if na == rb and last > 0 { last = last - 1 }
        }
        return ra + _clamp(col, 0, last)
    }

    define index_at(self, px: Int, py: Int) -> Int {
        rows := self.layout()
        r := self._top + (py - self.y - 6) / self._lh
        if py < self.y + 6 { r = self._top }
        left := self._left
        if self.wrap { left = 0 }
        col := left + (px - self.x - 8 + self._cw / 2) / self._cw
        if px < self.x + 8 { col = left }
        return self._at_row(rows, r, col)
    }

    define _vertical(self, by: Int, grow: Bool) -> void {
        rows := self.layout()
        r := self._row_of(rows, self.cursor)
        row: List = rows[r]
        ra: Int = row[0]
        if self._goal < 0 { self._goal = self.cursor - ra }
        target := r + by
        if target < 0 {
            self._move(0, grow)
        } elif target >= rows.length() {
            self._move(self.text.length(), grow)
        } else {
            self._move(self._at_row(rows, target, self._goal), grow)
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "wheel" {
            most := _max(0, self.layout().length() - self._shown_rows())
            self._top = _clamp(self._top - e.dy * 3, 0, most)
            return true
        }
        if e.kind == "key_down" and (e.key == "up" or e.key == "down" or e.key == "pageup" or e.key == "pagedown") {
            by := 1
            if e.key == "up" { by = -1 }
            if e.key == "pageup" { by = -self._shown_rows() }
            if e.key == "pagedown" { by = self._shown_rows() }
            self._vertical(by, e.shift)
            return true
        }
        self._goal = -1
        if self._edit(e) { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        mod := e.ctrl or e.meta
        if k == "home" or k == "end" {
            if mod {
                if k == "home" { self._move(0, e.shift) } else { self._move(self.text.length(), e.shift) }
            } else {
                rows := self.layout()
                r := self._row_of(rows, self.cursor)
                if k == "home" { self._move(self._at_row(rows, r, 0), e.shift) }
                else { self._move(self._at_row(rows, r, 1000000), e.shift) }
            }
        } elif k == "return" or k == "keypad_enter" {
            self.insert("\n")
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        self._fix()
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        cw := t.char_w()
        lh := t.line()
        shown := self._shown_rows()
        cols := self._shown_cols()
        rows := self.layout()
        if self.wrap { self._left = 0 }
        // Follow the cursor.
        cr := self._row_of(rows, self.cursor)
        crow: List = rows[cr]
        cra: Int = crow[0]
        cc := self.cursor - cra
        if self._dragging or self.focused {
            if cr < self._top { self._top = cr }
            if cr >= self._top + shown { self._top = cr - shown + 1 }
            if not self.wrap {
                if cc < self._left { self._left = cc }
                if cc > self._left + cols { self._left = cc - cols }
            }
        }
        self._top = _clamp(self._top, 0, _max(0, rows.length() - 1))
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        sa := self.selection_start()
        sb := self.selection_end()
        r := self._top
        while r < rows.length() and r < self._top + shown {
            row: List = rows[r]
            ra: Int = row[0]
            rb: Int = row[1]
            ly := self.y + 6 + (r - self._top) * lh
            if sb > sa {
                a := _max(sa, ra)
                b := _min(sb, rb)
                // A selected line break shows as one extra cell.
                extra := 0
                hard := r + 1 >= rows.length()
                if not hard {
                    nxt: List = rows[r + 1]
                    na: Int = nxt[0]
                    hard = na != rb
                }
                if hard and sb > rb and sa <= rb and rb < self.text.length() { extra = 1 }
                ca := a - ra - self._left
                cb := b - ra - self._left + extra
                if cb > ca and (b > a or extra == 1) {
                    win.rect(self.x + 8 + _max(0, ca) * cw, ly, (cb - _max(0, ca)) * cw, lh, _sel_color(self, t))
                }
            }
            if rb - ra > self._left {
                win.text(self.text.substring(ra + self._left, _min(rb, ra + self._left + cols + 1)), self.x + 8, ly,
                         _ink(self, t.text, t), scale=t.scale)
            }
            r = r + 1
        }
        if self.focused and (window.ticks() / 530) % 2 == 0 and cr >= self._top and cr < self._top + shown {
            win.rect(self.x + 8 + (cc - self._left) * cw, self.y + 6 + (cr - self._top) * lh, _max(1, t.scale), lh, t.text)
        }
        _clip_pop(win)
        // Scroll indicator when there are more rows than fit.
        if rows.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / rows.length())
            most := _max(1, rows.length() - shown)
            by := self.y + 2 + (track - bar) * _min(self._top, most) / most
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Slider =====

---
Pick a number between `min` and `max` by dragging (or with the arrow
keys, by `step`). `on_change(value)` runs when it moves.
---
struct Slider : Widget {
    min: Int
    max: Int
    value: Int
    step: Int
    on_change: Callable

    define __init(self, min: Int = 0, max: Int = 100, value: Int = 50, on_change: Callable = null, step: Int = 1) -> void {
        super().__init()
        self.min = min
        self.max = max
        self.value = _clamp(value, min, max)
        self.step = step
        self.on_change = on_change
        self.focusable = true
    }

    --- Set the value (clamped to min..max); runs `on_change` if it changed. ---
    define set(self, v: Int) -> void {
        nv := _clamp(v, self.min, self.max)
        if nv != self.value {
            self.value = nv
            if self.on_change != null { self.on_change(nv) }
        }
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 8
    }

    define _from_x(self, px: Int) -> void {
        span := _max(1, self.width - 16)
        rel := _clamp(px - self.x - 8, 0, span)
        self.set(self.min + (rel * (self.max - self.min) + span / 2) / span)
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_move" and self.pressed {
            self._from_x(e.x)
            return true
        }
        if e.kind == "mouse_up" {
            self.pressed = false
            return true
        }
        if e.kind == "key_down" {
            if e.key == "left" or e.key == "down" {
                self.set(self.value - self.step)
                return true
            }
            if e.key == "right" or e.key == "up" {
                self.set(self.value + self.step)
                return true
            }
            if e.key == "home" {
                self.set(self.min)
                return true
            }
            if e.key == "end" {
                self.set(self.max)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        cy := self.y + self.height / 2
        span := _max(1, self.width - 16)
        range := _max(1, self.max - self.min)
        kx := self.x + 8 + (self.value - self.min) * span / range
        win.rect(self.x + 8, cy - 2, span, 4, t.border)
        win.rect(self.x + 8, cy - 2, kx - self.x - 8, 4, _ink(self, t.accent, t))
        knob := t.text
        if self.pressed or self.hovered { knob = t.accent }
        win.circle(kx, cy, _max(6, self.height / 3), _ink(self, knob, t))
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== RadioGroup =====

---
One choice out of `options` (anything with `.str()`), shown as a column
of round buttons. Click one, or Up / Down (Left / Right) when it has the
focus. `selected` is the index (-1 = none); `on_change(index, item)` runs
when it changes.
---
struct RadioGroup : Widget {
    options: List
    selected: Int
    on_change: Callable
    _row_h: Int

    define __init(self, options: List, selected: Int = 0, on_change: Callable = null) -> void {
        super().__init()
        self.options = options
        self.selected = _clamp(selected, -1, options.length() - 1)
        self.on_change = on_change
        self._row_h = 24
        self.focusable = true
    }

    --- The chosen option as text ("" when none). ---
    define text(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return self.options[self.selected].str()
    }

    --- Choose option `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.options.length() == 0 or not self.enabled { return }
        ni := _clamp(i, 0, self.options.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.options[ni]) }
        }
    }

    define measure(self, t: Theme) -> void {
        self._row_h = t.line() + 8
        widest := 0
        for o in self.options { widest = _max(widest, window.text_width(o.str(), t.scale)) }
        self.min_w = t.line() + t.char_w() + widest
        self.min_h = _max(1, self.options.length()) * self._row_h
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y) / self._row_h
            if row >= 0 and row < self.options.length() { self.select(row) }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" {
            if e.key == "down" or e.key == "right" {
                self.select(self.selected + 1)
                return true
            }
            if e.key == "up" or e.key == "left" {
                self.select(_max(0, self.selected - 1))
                return true
            }
            if e.key == "home" {
                self.select(0)
                return true
            }
            if e.key == "end" {
                self.select(self.options.length() - 1)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        s := t.line()
        r := s / 2
        i := 0
        while i < self.options.length() {
            ry := self.y + i * self._row_h
            cx := self.x + r
            cy := ry + self._row_h / 2
            ring := t.border
            if self.hovered { ring = t.accent }
            win.circle(cx, cy, r, t.input)
            win.circle(cx, cy, r, ring, fill=false)
            if i == self.selected { win.circle(cx, cy, _max(2, r / 2), _ink(self, t.accent, t)) }
            win.text(self.options[i].str(), self.x + s + t.char_w(), cy - t.line() / 2, _ink(self, t.text, t), scale=t.scale)
            i = i + 1
        }
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== ProgressBar =====

---
How far along something is: `value` out of `max` (clamped), drawn as a
filled bar. `show_text` adds the percentage. Set `value` as work
progresses.
---
struct ProgressBar : Widget {
    value: Int
    max: Int
    show_text: Bool

    define __init(self, value: Int = 0, max: Int = 100, show_text: Bool = false, expand: Bool = false) -> void {
        super().__init()
        self.value = value
        self.max = max
        self.show_text = show_text
        self.expand = expand
    }

    --- Progress from 0 to 100. ---
    define percent(self) -> Int {
        if self.max <= 0 { return 0 }
        return _clamp(self.value * 100 / self.max, 0, 100)
    }

    define measure(self, t: Theme) -> void {
        self.min_w = 160
        self.min_h = t.line() + 4
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        fill := (self.width - 2) * self.percent() / 100
        if fill > 0 { win.rect(self.x + 1, self.y + 1, fill, self.height - 2, _ink(self, t.accent, t)) }
        win.rect(self.x, self.y, self.width, self.height, t.border, fill=false)
        if self.show_text {
            label := self.percent().str() + "%"
            tw := window.text_width(label, t.scale)
            win.text(label, self.x + (self.width - tw) / 2, self.y + (self.height - t.line()) / 2, t.text, scale=t.scale)
        }
    }
}

// ===== ListView =====

---
A scrollable list of items (anything with `.str()`), one selectable.
`on_select(index, item)` runs when the selection changes; `selected` is
the index (-1 = none). `rows` sets how many rows it asks room for.
---
struct ListView : Widget {
    items: List
    selected: Int
    rows: Int
    on_select: Callable
    reorderable: Bool
    on_reorder: Callable
    _top: Int
    _press: Int
    _drop: Int

    define __init(self, items: List, on_select: Callable = null, rows: Int = 6, expand: Bool = false, reorderable: Bool = false, on_reorder: Callable = null) -> void {
        super().__init()
        self.items = items
        self.selected = -1
        self.rows = rows
        self.on_select = on_select
        self.reorderable = reorderable
        self.on_reorder = on_reorder
        self._top = 0
        self._press = -1
        self._drop = -1
        self.focusable = true
        self.expand = expand
    }

    --- Move item `src` to position `dst` (both indices into `items`). ---
    define move_item(self, src: Int, dst: Int) -> void {
        n := self.items.length()
        if src < 0 or src >= n or dst < 0 or dst >= n or src == dst { return }
        item := self.items[src]
        rest := []
        i := 0
        while i < n {
            if i != src { rest.append(self.items[i]) }
            i = i + 1
        }
        out := []
        i = 0
        while i < rest.length() {
            if i == dst { out.append(item) }
            out.append(rest[i])
            i = i + 1
        }
        if dst >= rest.length() { out.append(item) }
        self.items.clear()
        for v in out { self.items.append(v) }
        if self.selected == src { self.selected = dst }
        if self.on_reorder != null { self.on_reorder(src, dst) }
    }

    define _row_at_y(self, py: Int) -> Int {
        return _clamp(self._top + (py - self.y - 2) / self._row_h(), 0, _max(0, self.items.length() - 1))
    }

    define _row_h(self) -> Int {
        return 24
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - 4) / self._row_h())
    }

    --- Select row `i` (clamped); runs `on_select` if it changed. ---
    define select(self, i: Int) -> void {
        if self.items.length() == 0 { return }
        ni := _clamp(i, 0, self.items.length() - 1)
        if ni < self._top { self._top = ni }
        if ni >= self._top + self._shown() { self._top = ni - self._shown() + 1 }
        if ni != self.selected {
            self.selected = ni
            if self.on_select != null { self.on_select(ni, self.items[ni]) }
        }
    }

    define measure(self, t: Theme) -> void {
        widest := 10
        for it in self.items { widest = _max(widest, window.text_width(it.str(), t.scale)) }
        self.min_w = _min(widest, 60 * t.char_w()) + 16
        self.min_h = self.rows * self._row_h() + 4
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y - 2) / self._row_h()
            if row >= 0 and self._top + row < self.items.length() {
                self.select(self._top + row)
                self._press = self._top + row
            }
            return true
        }
        if e.kind == "mouse_move" and self.reorderable and self._press >= 0 and e.left {
            self._drop = self._row_at_y(e.y)
            return true
        }
        if e.kind == "mouse_up" {
            if self.reorderable and self._press >= 0 and self._drop >= 0 and self._drop != self._press {
                self.move_item(self._press, self._drop)
            }
            self._press = -1
            self._drop = -1
            return true
        }
        if e.kind == "wheel" {
            most := _max(0, self.items.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind == "key_down" {
            if e.key == "down" {
                self.select(self.selected + 1)
                return true
            }
            if e.key == "up" {
                self.select(_max(0, self.selected - 1))
                return true
            }
            if e.key == "home" {
                self.select(0)
                return true
            }
            if e.key == "end" {
                self.select(self.items.length() - 1)
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        rh := self._row_h()
        shown := self._shown()
        most := _max(0, self.items.length() - shown)
        if self._top > most { self._top = most }
        i := self._top
        while i < self.items.length() and i < self._top + shown {
            ry := self.y + 2 + (i - self._top) * rh
            ink := t.text
            if i == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            }
            label := self.items[i].str()
            fit := _max(1, (self.width - 16) / t.char_w())
            if label.length() > fit { label = label.substring(0, fit) }
            win.text(label, self.x + 8, ry + (rh - t.line()) / 2, _ink(self, ink, t), scale=t.scale)
            i = i + 1
        }
        // Where a dragged row would land.
        if self._drop >= 0 and self._drop != self._press and self._drop >= self._top and self._drop < self._top + shown {
            ly := self.y + 2 + (self._drop - self._top) * rh
            if self._drop > self._press { ly = ly + rh }
            win.rect(self.x + 2, ly - 1, self.width - 4, 2, t.focus)
        }
        // Scroll indicator when not everything fits.
        if self.items.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / self.items.length())
            by := self.y + 2 + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== SplitView =====

---
Two widgets side by side (or stacked: `vertical=true`) with a divider
you drag to share the space. `ratio` is the first pane's share in
percent; `min_size` the smallest a pane gets (pixels). It takes its
container's free space (`expand`) unless told otherwise.
---
struct SplitView : Widget {
    first: Widget
    second: Widget
    vertical: Bool
    ratio: Int
    min_size: Int
    on_change: Callable
    _drag: Bool

    define __init(self, first: Widget, second: Widget, vertical: Bool = false, ratio: Int = 50, min_size: Int = 40, expand: Bool = true, on_change: Callable = null) -> void {
        super().__init()
        self.first = first
        self.second = second
        self.vertical = vertical
        self.ratio = _clamp(ratio, 0, 100)
        self.min_size = min_size
        self.expand = expand
        self.on_change = on_change
        self._drag = false
        self.takes_clicks = true
    }

    define children(self) -> List {
        return [self.first, self.second]
    }

    define _bar(self) -> Int {
        return 6
    }

    define _span(self) -> Int {
        if self.vertical { return self.height }
        return self.width
    }

    // Size of the first pane in pixels.
    define _first_px(self) -> Int {
        room := self._span() - self._bar()
        px := room * self.ratio / 100
        lo := _min(self.min_size, room / 2)
        return _clamp(px, lo, _max(lo, room - lo))
    }

    define measure(self, t: Theme) -> void {
        self.first.measure(t)
        self.second.measure(t)
        if self.vertical {
            self.min_w = _max(self.first.min_w, self.second.min_w)
            self.min_h = 2 * self.min_size + self._bar()
        } else {
            self.min_w = 2 * self.min_size + self._bar()
            self.min_h = _max(self.first.min_h, self.second.min_h)
        }
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        a := self._first_px()
        b := self._bar()
        if self.vertical {
            self.first.place(x, y, width, a)
            self.second.place(x, y + a + b, width, _max(0, height - a - b))
        } else {
            self.first.place(x, y, a, height)
            self.second.place(x + a + b, y, _max(0, width - a - b), height)
        }
    }

    define _on_bar(self, px: Int, py: Int) -> Bool {
        a := self._first_px()
        if self.vertical { return py >= self.y + a and py < self.y + a + self._bar() }
        return px >= self.x + a and px < self.x + a + self._bar()
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 and self._on_bar(e.x, e.y) {
            self._drag = true
            return true
        }
        if e.kind == "mouse_move" and self._drag {
            pos := e.x - self.x - self._bar() / 2
            if self.vertical { pos = e.y - self.y - self._bar() / 2 }
            room := _max(1, self._span() - self._bar())
            nr := _clamp(pos * 100 / room, 0, 100)
            if nr != self.ratio {
                self.ratio = nr
                if self.on_change != null { self.on_change(nr) }
            }
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = false
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        _clip_push(win, self.first.x, self.first.y, self.first.width, self.first.height)
        if self.first.visible { self.first.draw(win, t) }
        _clip_pop(win)
        _clip_push(win, self.second.x, self.second.y, self.second.width, self.second.height)
        if self.second.visible { self.second.draw(win, t) }
        _clip_pop(win)
        a := self._first_px()
        bar := t.border
        if self._drag or self.hovered { bar = t.accent }
        if self.vertical {
            win.rect(self.x, self.y + a + self._bar() / 2 - 1, self.width, 2, bar)
        } else {
            win.rect(self.x + a + self._bar() / 2 - 1, self.y, 2, self.height, bar)
        }
    }
}

// ===== Toolbar / StatusBar =====

---
A button for a `ui.Toolbar`: an `icon` (an image file — PNG, JPEG, BMP,
GIF, TGA — drawn 16x16 times the theme scale) and / or `text`, plus a
`tooltip`. `on_click` like a Button. `ui.ToolButton("-")` is a separator.
---
struct ToolButton : Widget {
    text: String
    icon: String
    on_click: Callable
    _img: window.Image
    _img_failed: Bool

    define __init(self, text: String = "", icon: String = "", on_click: Callable = null, tooltip: String = "") -> void {
        super().__init()
        self.text = text
        self.icon = icon
        self.on_click = on_click
        self.tooltip = tooltip
        self._img = null
        self._img_failed = false
        self.focusable = text != "-"
    }

    define is_separator(self) -> Bool {
        return self.text == "-"
    }

    --- Press it from code. ---
    define click(self) -> void {
        if self.enabled and self.on_click != null { self.on_click() }
    }

    define _icon_size(self, t: Theme) -> Int {
        return 16 * t.scale
    }

    define measure(self, t: Theme) -> void {
        if self.is_separator() {
            self.min_w = 9
            self.min_h = t.line() + 12
            return
        }
        w := 12
        if self.icon.length() > 0 { w = w + self._icon_size(t) }
        if self.text.length() > 0 {
            if self.icon.length() > 0 { w = w + t.char_w() / 2 }
            w = w + window.text_width(self.text, t.scale)
        }
        self.min_w = w
        self.min_h = _max(t.line(), self._icon_size(t)) + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled or self.is_separator() { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            self.pressed = true
            return true
        }
        if e.kind == "mouse_up" and e.button == 1 {
            was := self.pressed
            self.pressed = false
            if was and self.contains(e.x, e.y) { self.click() }
            return true
        }
        if e.kind == "key_down" and (e.key == "return" or e.key == "space") {
            self.click()
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        if self.is_separator() {
            win.rect(self.x + 4, self.y + 4, 1, self.height - 8, t.border)
            return
        }
        if self.pressed {
            win.rect(self.x, self.y, self.width, self.height, mix(t.surface, window.black(), 20))
        } elif self.hovered and self.enabled {
            win.rect(self.x, self.y, self.width, self.height, mix(t.surface, t.text, 12))
        }
        x := self.x + 6
        if self.icon.length() > 0 {
            if self._img == null and not self._img_failed {
                try {
                    self._img = win.load_image(self.icon)
                } catch (err: window.WindowError) {
                    self._img_failed = true
                }
            }
            sz := self._icon_size(t)
            iy := self.y + (self.height - sz) / 2
            if self._img != null {
                alpha := 255
                if not self.enabled { alpha = 90 }
                win.image(self._img, x, iy, width=sz, height=sz, alpha=alpha)
            } else {
                win.rect(x, iy, sz, sz, t.muted, fill=false)       // missing icon
            }
            x = x + sz + t.char_w() / 2
        }
        if self.text.length() > 0 {
            win.text(self.text, x, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale)
        }
        if self.focused { _focus_ring(win, self, t) }
    }
}

---
A row of `ui.ToolButton`s on a raised strip, usually under the menu bar.
---
struct Toolbar : Row {
    define __init(self, buttons: List) -> void {
        super().__init(buttons, 3, 2)
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.surface)
        win.rect(self.x, self.y + self.height - 1, self.width, 1, t.border)
        for c in self._kids {
            w: Widget = c
            if w.visible { w.draw(win, t) }
        }
    }
}

---
A strip of text sections along the bottom of a window:
`ui.StatusBar(["Ready", "Ln 1, Col 1"])`. The first section takes the
free space; the others are right-aligned. `set(i, text)` changes one.
---
struct StatusBar : Widget {
    sections: List

    define __init(self, sections: List) -> void {
        super().__init()
        self.sections = sections
    }

    --- Change section `i`'s text (adds sections as needed). ---
    define set(self, i: Int, text: String) -> void {
        while self.sections.length() <= i { self.sections.append("") }
        self.sections[i] = text
    }

    --- Section `i`'s text ("" if there's none). ---
    define get(self, i: Int) -> String {
        if i < 0 or i >= self.sections.length() { return "" }
        return self.sections[i].str()
    }

    define measure(self, t: Theme) -> void {
        w := 0
        for sct in self.sections { w = w + window.text_width(sct.str(), t.scale) + 3 * t.char_w() }
        self.min_w = w
        self.min_h = t.line() + 8
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.surface)
        win.rect(self.x, self.y, self.width, 1, t.border)
        ty := self.y + (self.height - t.line()) / 2
        if self.sections.length() == 0 { return }
        win.text(self.get(0), self.x + t.char_w(), ty, t.muted, scale=t.scale)
        rx := self.x + self.width - t.char_w()
        i := self.sections.length() - 1
        while i >= 1 {
            text := self.get(i)
            tw := window.text_width(text, t.scale)
            rx = rx - tw
            win.text(text, rx, ty, t.muted, scale=t.scale)
            rx = rx - t.char_w()
            win.rect(rx, self.y + 4, 1, self.height - 8, t.border)
            rx = rx - t.char_w()
            i = i - 1
        }
    }
}

// ===== DatePicker =====

define _leap(y: Int) -> Bool {
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

--- Days in `month` (1-12) of `year`. ---
define days_in_month(year: Int, month: Int) -> Int {
    if month == 2 {
        if _leap(year) { return 29 }
        return 28
    }
    if month == 4 or month == 6 or month == 9 or month == 11 { return 30 }
    return 31
}

--- Day of the week of a date: 0 = Monday ... 6 = Sunday. ---
define weekday(year: Int, month: Int, day: Int) -> Int {
    // Sakamoto's method (0 = Sunday), shifted so the week starts on Monday.
    offsets := [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    y := year
    if month < 3 { y = y - 1 }
    o: Int = offsets[month - 1]
    sun0 := (y + y / 4 - y / 100 + y / 400 + o + day) % 7
    return (sun0 + 6) % 7
}

define _two(n: Int) -> String {
    if n < 10 { return "0" + n.str() }
    return n.str()
}

_MONTHS := ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

---
A date field that opens a month calendar. `year`, `month` (1-12), `day`;
`text()` is "YYYY-MM-DD". Click the field (or Space / Enter / Alt+Down) to
open it; in the calendar click a day, `<` / `>` change month, arrows move
by day / week, Page Up / Page Down by month, Enter picks, Escape closes.
`on_change(year, month, day)` runs when the date changes.
---
struct DatePicker : Widget {
    year: Int
    month: Int
    day: Int
    on_change: Callable
    is_open: Bool
    _vy: Int
    _vm: Int
    _cursor: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int
    _cell: Int

    define __init(self, year: Int = 2026, month: Int = 1, day: Int = 1, on_change: Callable = null) -> void {
        super().__init()
        self.year = year
        self.month = _clamp(month, 1, 12)
        self.day = _clamp(day, 1, days_in_month(year, self.month))
        self.on_change = on_change
        self.is_open = false
        self._vy = self.year
        self._vm = self.month
        self._cursor = self.day
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
        self._cell = 28
        self.focusable = true
    }

    --- The date as "YYYY-MM-DD". ---
    define text(self) -> String {
        return self.year.str() + "-" + _two(self.month) + "-" + _two(self.day)
    }

    --- Set the date (clamped to a real date); runs `on_change` if it changed. ---
    define set_date(self, year: Int, month: Int, day: Int) -> void {
        m := _clamp(month, 1, 12)
        d := _clamp(day, 1, days_in_month(year, m))
        if year == self.year and m == self.month and d == self.day { return }
        self.year = year
        self.month = m
        self.day = d
        if self.on_change != null { self.on_change(year, m, d) }
    }

    --- Show the calendar (on the chosen date's month). ---
    define open(self) -> void {
        if self.is_open or not self.enabled { return }
        self._vy = self.year
        self._vm = self.month
        self._cursor = self.day
        self.is_open = true
        _popups.append(self)
    }

    --- Hide the calendar. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define close_popup(self) -> void {
        self.close()
    }

    // Move the shown month by `by` months (cursor clamped to it).
    define _shift_month(self, by: Int) -> void {
        idx := self._vy * 12 + (self._vm - 1) + by
        self._vy = idx / 12
        self._vm = idx % 12 + 1
        self._cursor = _clamp(self._cursor, 1, days_in_month(self._vy, self._vm))
    }

    // Move the cursor by `by` days, across months.
    define _shift_day(self, by: Int) -> void {
        d := self._cursor + by
        while d < 1 {
            self._shift_month(-1)
            d = d + days_in_month(self._vy, self._vm)
        }
        while d > days_in_month(self._vy, self._vm) {
            d = d - days_in_month(self._vy, self._vm)
            self._shift_month(1)
        }
        self._cursor = d
    }

    define measure(self, t: Theme) -> void {
        self.min_w = window.text_width("0000-00-00", t.scale) + 16 + 3 * t.char_w()
        self.min_h = t.line() + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            if self.is_open { self.close() } else { self.open() }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" and not self.is_open {
            if e.key == "space" or e.key == "return" or (e.key == "down" and e.alt) {
                self.open()
                return true
            }
        }
        return false
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph
    }

    // The day under (px, py) in the shown month, or 0.
    define _day_at(self, px: Int, py: Int) -> Int {
        c := self._cell
        gx := (px - self._px - 6) / c
        gy := (py - self._py - 6 - 2 * c) / c
        if px < self._px + 6 or py < self._py + 6 + 2 * c or gx < 0 or gx > 6 { return 0 }
        d := gy * 7 + gx - weekday(self._vy, self._vm, 1) + 1
        if d < 1 or d > days_in_month(self._vy, self._vm) { return 0 }
        return d
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 {
            c := self._cell
            if e.y < self._py + 6 + c {
                if e.x < self._px + 6 + c { self._shift_month(-1) }
                elif e.x >= self._px + self._pw - 6 - c { self._shift_month(1) }
                return true
            }
            d := self._day_at(e.x, e.y)
            if d > 0 {
                self.set_date(self._vy, self._vm, d)
                self.close()
            }
            return true
        }
        if e.kind == "mouse_move" {
            d := self._day_at(e.x, e.y)
            if d > 0 { self._cursor = d }
            return true
        }
        return true
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind != "key_down" { return e.kind == "key_up" or e.kind == "text" }
        k := e.key
        if k == "left" { self._shift_day(-1) }
        elif k == "right" { self._shift_day(1) }
        elif k == "up" { self._shift_day(-7) }
        elif k == "down" { self._shift_day(7) }
        elif k == "pageup" { self._shift_month(-1) }
        elif k == "pagedown" { self._shift_month(1) }
        elif k == "home" { self._cursor = 1 }
        elif k == "end" { self._cursor = days_in_month(self._vy, self._vm) }
        elif k == "return" or k == "keypad_enter" or k == "space" {
            self.set_date(self._vy, self._vm, self._cursor)
            self.close()
        } elif k == "escape" or k == "tab" {
            self.close()
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused or self.is_open { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        win.text(self.text(), self.x + 8, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale)
        // A small calendar glyph on the right.
        gx := self.x + self.width - 8 - 2 * t.char_w()
        gy := self.y + (self.height - t.line()) / 2 + 2
        gs := t.line() - 4
        win.rect(gx, gy, gs, gs, _ink(self, t.muted, t), fill=false)
        win.rect(gx, gy, gs, 3, _ink(self, t.muted, t))
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        c := _max(t.line() + 8, 3 * t.char_w() + 6)
        self._cell = c
        self._pw = 7 * c + 12
        self._ph = 8 * c + 12
        self._px = self.x
        self._py = self.y + self.height + 2
        if self._px + self._pw > win.width() { self._px = _max(0, win.width() - self._pw) }
        if self._py + self._ph > win.height() and self.y - self._ph - 2 >= 0 { self._py = self.y - self._ph - 2 }
        // Neither fits: keep it inside the window.
        self._py = _clamp(self._py, 0, _max(0, win.height() - self._ph))
        x := self._px
        y := self._py
        win.rect(x + 3, y + 3, self._pw, self._ph, mix(t.background, window.black(), 45))
        win.rect(x, y, self._pw, self._ph, t.surface)
        win.rect(x, y, self._pw, self._ph, t.border, fill=false)
        // Header: < Month Year >
        hy := y + 6 + (c - t.line()) / 2
        win.text("<", x + 6 + (c - t.char_w()) / 2, hy, t.text, scale=t.scale)
        win.text(">", x + self._pw - 6 - c + (c - t.char_w()) / 2, hy, t.text, scale=t.scale)
        title := _MONTHS[self._vm - 1].str() + " " + self._vy.str()
        win.text(title, x + (self._pw - window.text_width(title, t.scale)) / 2, hy, t.text, scale=t.scale)
        // Weekday names.
        names := ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
        i := 0
        while i < 7 {
            wd: String = names[i]
            win.text(wd, x + 6 + i * c + (c - window.text_width(wd, t.scale)) / 2, y + 6 + c + (c - t.line()) / 2, t.muted, scale=t.scale)
            i = i + 1
        }
        // Days.
        first := weekday(self._vy, self._vm, 1)
        count := days_in_month(self._vy, self._vm)
        d := 1
        while d <= count {
            cell := first + d - 1
            cx := x + 6 + (cell % 7) * c
            cy := y + 6 + 2 * c + (cell / 7) * c
            ink := t.text
            chosen := d == self.day and self._vm == self.month and self._vy == self.year
            if chosen {
                win.rect(cx + 1, cy + 1, c - 2, c - 2, t.accent)
                ink = t.accent_text
            }
            if d == self._cursor { win.rect(cx + 1, cy + 1, c - 2, c - 2, t.focus, fill=false) }
            label := d.str()
            win.text(label, cx + (c - window.text_width(label, t.scale)) / 2, cy + (c - t.line()) / 2, ink, scale=t.scale)
            d = d + 1
        }
    }
}

// ===== ColorPicker =====

// HSV (hue 0-359, saturation / value 0-100) <-> colour, in whole numbers.
define hsv_to_color(h: Int, sat: Int, v: Int) -> Int {
    hh := ((h % 360) + 360) % 360
    ss := _clamp(sat, 0, 100)
    vv := _clamp(v, 0, 100)
    c := vv * ss * 255 / 10000                 // chroma, 0-255
    seg := hh / 60
    f := hh % 60
    x := c * (seg % 2 * 60 + (1 - 2 * (seg % 2)) * f) / 60
    m := vv * 255 / 100 - c
    r := 0
    g := 0
    b := 0
    if seg == 0 {
        r = c
        g = x
    } elif seg == 1 {
        r = x
        g = c
    } elif seg == 2 {
        g = c
        b = x
    } elif seg == 3 {
        g = x
        b = c
    } elif seg == 4 {
        r = x
        b = c
    } else {
        r = c
        b = x
    }
    return window.rgb(r + m, g + m, b + m)
}

--- [hue 0-359, saturation 0-100, value 0-100] of a colour. ---
define color_to_hsv(color: Int) -> List {
    ch := window.channels(color)
    r: Int = ch[0]
    g: Int = ch[1]
    b: Int = ch[2]
    mx := _max(r, _max(g, b))
    mn := _min(r, _min(g, b))
    d := mx - mn
    h := 0
    if d > 0 {
        if mx == r {
            h = (60 * (g - b) / d + 360) % 360
        } elif mx == g {
            h = 60 * (b - r) / d + 120
        } else {
            h = 60 * (r - g) / d + 240
        }
    }
    sat := 0
    if mx > 0 { sat = d * 100 / mx }
    return [h, sat, mx * 100 / 255]
}

---
Pick a colour: a square for saturation (left → right) and brightness
(bottom → top), a strip for the hue, and a swatch with its hex code.
Drag in either, or with the focus: Left / Right saturation, Up / Down
brightness, Page Up / Page Down hue. `color` is the colour (a `window`
colour Int); `on_change(color)` runs when it changes.
---
struct ColorPicker : Widget {
    color: Int
    hue: Int
    saturation: Int
    value: Int
    on_change: Callable
    size: Int
    _drag: Int

    define __init(self, color: Int = window.rgb(76, 141, 255), on_change: Callable = null, size: Int = 128) -> void {
        super().__init()
        self.on_change = on_change
        self.size = size
        self._drag = 0
        self.focusable = true
        self.set_color(color)
    }

    --- Set the colour from code (no `on_change`). ---
    define set_color(self, color: Int) -> void {
        hsv := color_to_hsv(color)
        h: Int = hsv[0]
        sv: Int = hsv[1]
        vv: Int = hsv[2]
        self.hue = h
        self.saturation = sv
        self.value = vv
        self.color = window.rgb(window.channels(color)[0], window.channels(color)[1], window.channels(color)[2])
    }

    --- The colour as "#rrggbb". ---
    define hex(self) -> String {
        ch := window.channels(self.color)
        digits := "0123456789abcdef"
        out := "#"
        for v in [ch[0], ch[1], ch[2]] {
            n: Int = v
            out = out + digits.substring(n / 16, n / 16 + 1) + digits.substring(n % 16, n % 16 + 1)
        }
        return out
    }

    define _set_hsv(self, h: Int, sat: Int, v: Int) -> void {
        self.hue = ((h % 360) + 360) % 360
        self.saturation = _clamp(sat, 0, 100)
        self.value = _clamp(v, 0, 100)
        nc := hsv_to_color(self.hue, self.saturation, self.value)
        if nc != self.color {
            self.color = nc
            if self.on_change != null { self.on_change(nc) }
        }
    }

    define _strip_x(self) -> Int {
        return self.x + self.size + 8
    }

    define measure(self, t: Theme) -> void {
        self.min_w = self.size + 8 + 16
        self.min_h = self.size + 8 + t.line() + 8
    }

    define _from_point(self, px: Int, py: Int) -> void {
        if self._drag == 1 {
            sat := _clamp(px - self.x, 0, self.size) * 100 / self.size
            v := 100 - _clamp(py - self.y, 0, self.size) * 100 / self.size
            self._set_hsv(self.hue, sat, v)
        } elif self._drag == 2 {
            h := _clamp(py - self.y, 0, self.size - 1) * 360 / self.size
            self._set_hsv(h, self.saturation, self.value)
        }
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            // The square includes its right / bottom edge (full saturation, black).
            if e.x <= self.x + self.size and e.y <= self.y + self.size {
                self._drag = 1
            } elif e.x >= self._strip_x() and e.y <= self.y + self.size {
                self._drag = 2
            } else {
                self._drag = 0
            }
            self._from_point(e.x, e.y)
            return true
        }
        if e.kind == "mouse_move" and self._drag > 0 {
            self._from_point(e.x, e.y)
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = 0
            return true
        }
        if e.kind == "key_down" {
            k := e.key
            if k == "left" { self._set_hsv(self.hue, self.saturation - 5, self.value) }
            elif k == "right" { self._set_hsv(self.hue, self.saturation + 5, self.value) }
            elif k == "up" { self._set_hsv(self.hue, self.saturation, self.value + 5) }
            elif k == "down" { self._set_hsv(self.hue, self.saturation, self.value - 5) }
            elif k == "pageup" { self._set_hsv(self.hue + 10, self.saturation, self.value) }
            elif k == "pagedown" { self._set_hsv(self.hue - 10, self.saturation, self.value) }
            else { return false }
            return true
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        n := 16
        cell := _max(1, self.size / n)
        i := 0
        while i < n {
            j := 0
            while j < n {
                c := hsv_to_color(self.hue, i * 100 / (n - 1), 100 - j * 100 / (n - 1))
                win.rect(self.x + i * cell, self.y + j * cell, cell, cell, c)
                j = j + 1
            }
            i = i + 1
        }
        win.rect(self.x, self.y, n * cell, n * cell, t.border, fill=false)
        // Marker on the square.
        mx := self.x + self.saturation * self.size / 100
        my := self.y + (100 - self.value) * self.size / 100
        win.circle(mx, my, 5, window.white(), fill=false)
        win.circle(mx, my, 6, window.black(), fill=false)
        // Hue strip.
        sx := self._strip_x()
        segs := 32
        seg_h := _max(1, self.size / segs)
        k := 0
        while k < segs {
            win.rect(sx, self.y + k * seg_h, 16, seg_h, hsv_to_color(k * 360 / segs, 100, 100))
            k = k + 1
        }
        win.rect(sx, self.y, 16, segs * seg_h, t.border, fill=false)
        hy := self.y + self.hue * self.size / 360
        win.rect(sx - 2, hy - 1, 20, 3, t.text)
        // Swatch + hex.
        by := self.y + self.size + 8
        win.rect(self.x, by, 3 * t.line(), t.line() + 4, self.color)
        win.rect(self.x, by, 3 * t.line(), t.line() + 4, t.border, fill=false)
        win.text(self.hex(), self.x + 3 * t.line() + t.char_w(), by + 2, _ink(self, t.text, t), scale=t.scale)
        if self.focused { _focus_ring(win, self, t) }
    }
}

// ===== TreeView =====

---
One node of a `ui.TreeView`: `text`, `children` (TreeNodes), whether it's
`expanded`, and `data` — anything you want to keep with it.
`add(child)` adds a child and returns it.
---
struct TreeNode {
    text: String
    children: List
    expanded: Bool
    data: Any
    parent: TreeNode

    define __init(self, text: String, children: List = [], expanded: Bool = false, data: Any = null) -> void {
        self.text = text
        self.children = []
        self.expanded = expanded
        self.data = data
        self.parent = null
        for c in children {
            n: TreeNode = c
            self.add(n)
        }
    }

    --- Add `child` under this node; returns it. ---
    define add(self, child: TreeNode) -> TreeNode {
        child.parent = self
        self.children.append(child)
        return child
    }

    --- How deep it is (0 for a root). ---
    define depth(self) -> Int {
        d := 0
        p := self.parent
        while p != null {
            d = d + 1
            p = p.parent
        }
        return d
    }
}

---
A tree of `ui.TreeNode`s, nested nodes indented. Click the arrow (or
double-click the row) to expand / collapse; click a row to select it.
Keys: Up / Down move, Right expands (or goes to the first child), Left
collapses (or goes to the parent), Enter toggles. `on_select(node)` runs
when the selection changes; `selected` is the node (or null).
---
struct TreeView : Widget {
    roots: List
    selected: TreeNode
    on_select: Callable
    rows: Int
    _top: Int
    _ind: Int

    define __init(self, roots: List, on_select: Callable = null, rows: Int = 8, expand: Bool = false) -> void {
        super().__init()
        self.roots = roots
        self.selected = null
        self.on_select = on_select
        self.rows = rows
        self.expand = expand
        self._top = 0
        self._ind = 16
        self.focusable = true
    }

    define _row_h(self) -> Int {
        return 24
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - 4) / self._row_h())
    }

    define _flatten(self, nodes: List, out: List) -> void {
        for c in nodes {
            n: TreeNode = c
            out.append(n)
            if n.expanded { self._flatten(n.children, out) }
        }
    }

    --- The nodes on screen in order (expanded parents' children included). ---
    define visible_nodes(self) -> List {
        out := []
        self._flatten(self.roots, out)
        return out
    }

    define _index_of(self, vis: List, n: TreeNode) -> Int {
        i := 0
        while i < vis.length() {
            v: TreeNode = vis[i]
            if v == n { return i }
            i = i + 1
        }
        return -1
    }

    --- Select `node` (null: none); runs `on_select` if it changed. ---
    define select(self, node: TreeNode) -> void {
        if node == self.selected { return }
        self.selected = node
        if node != null {
            vis := self.visible_nodes()
            i := self._index_of(vis, node)
            if i >= 0 {
                if i < self._top { self._top = i }
                if i >= self._top + self._shown() { self._top = i - self._shown() + 1 }
            }
        }
        if self.on_select != null { self.on_select(node) }
    }

    --- Expand or collapse `node`. ---
    define toggle(self, node: TreeNode) -> void {
        if node.children.length() == 0 { return }
        node.expanded = not node.expanded
        // A selected node hidden by the collapse: select the collapsed one.
        if not node.expanded and self.selected != null {
            p := self.selected.parent
            while p != null {
                if p == node {
                    self.select(node)
                    return
                }
                p = p.parent
            }
        }
    }

    define measure(self, t: Theme) -> void {
        widest := 10
        for c in self.visible_nodes() {
            n: TreeNode = c
            widest = _max(widest, n.depth() * self._ind + 16 + window.text_width(n.text, t.scale))
        }
        self.min_w = _min(widest, 60 * t.char_w()) + 16
        self.min_h = self.rows * self._row_h() + 4
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        vis := self.visible_nodes()
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self.y - 2) / self._row_h()
            i := self._top + row
            if row >= 0 and i < vis.length() {
                n: TreeNode = vis[i]
                arrow_x := self.x + 6 + n.depth() * self._ind
                if e.clicks >= 2 or (e.x >= arrow_x - 2 and e.x < arrow_x + 14) {
                    self.toggle(n)
                }
                self.select(n)
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "wheel" {
            most := _max(0, vis.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind != "key_down" or vis.length() == 0 { return false }
        k := e.key
        cur := self._index_of(vis, self.selected)
        if k == "down" {
            self.select(vis[_min(vis.length() - 1, cur + 1)])
        } elif k == "up" {
            self.select(vis[_max(0, cur - 1)])
        } elif k == "home" {
            self.select(vis[0])
        } elif k == "end" {
            self.select(vis[vis.length() - 1])
        } elif self.selected == null {
            return false
        } elif k == "right" {
            n := self.selected
            if n.children.length() > 0 and not n.expanded {
                n.expanded = true
            } elif n.children.length() > 0 {
                self.select(n.children[0])
            }
        } elif k == "left" {
            n := self.selected
            if n.expanded {
                n.expanded = false
            } elif n.parent != null {
                self.select(n.parent)
            }
        } elif k == "return" or k == "keypad_enter" or k == "space" {
            self.toggle(self.selected)
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        vis := self.visible_nodes()
        rh := self._row_h()
        shown := self._shown()
        most := _max(0, vis.length() - shown)
        if self._top > most { self._top = most }
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        i := self._top
        while i < vis.length() and i < self._top + shown {
            n: TreeNode = vis[i]
            ry := self.y + 2 + (i - self._top) * rh
            ink := t.text
            if n == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            }
            ax := self.x + 6 + n.depth() * self._ind
            cy := ry + rh / 2
            if n.children.length() > 0 {
                // A small triangle: pointing right (collapsed) or down (expanded).
                r := 0
                while r <= 4 {
                    if n.expanded {
                        win.line(ax + r, cy - 2 + r, ax + 8 - r, cy - 2 + r, _ink(self, ink, t))
                    } else {
                        win.line(ax + 2 + r, cy - 4 + r, ax + 2 + r, cy + 4 - r, _ink(self, ink, t))
                    }
                    r = r + 1
                }
            }
            win.text(n.text, ax + 14, ry + (rh - t.line()) / 2, _ink(self, ink, t), scale=t.scale)
            i = i + 1
        }
        _clip_pop(win)
        if vis.length() > shown {
            track := self.height - 4
            bar := _max(8, track * shown / vis.length())
            by := self.y + 2 + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Table =====

---
Rows of values under column headers: `ui.Table(["Name", "Size"], rows)`,
each row a List (anything with `.str()`). Columns size to their content
(or set `widths`); click a row (or Up / Down) to select it, click a
header to sort by that column (again: reverse). `on_select(index, row)`
runs when the selection changes — `index` into `rows`, whatever the sort.
With `editable=true` a cell can be changed in place: Left / Right pick
the column, Enter / F2 or a double-click edit it, Enter saves, Escape
cancels. The new value goes into `rows` (an Int column stays an Int when
the text is a number) and `on_edit(index, column, value)` runs.
---
struct Table : Widget {
    columns: List
    rows: List
    widths: List
    selected: Int
    on_select: Callable
    visible_rows: Int
    sort_column: Int
    sort_descending: Bool
    _order: List
    _top: Int
    _last_w: List
    editable: Bool
    column: Int
    on_edit: Callable
    _editor: TextInput
    _edit_row: Int
    _edit_col: Int

    define __init(self, columns: List, rows: List, on_select: Callable = null, visible_rows: Int = 8, expand: Bool = false, editable: Bool = false, on_edit: Callable = null) -> void {
        super().__init()
        self.columns = columns
        self.rows = rows
        self.widths = []
        self.selected = -1
        self.on_select = on_select
        self.visible_rows = visible_rows
        self.expand = expand
        self.sort_column = -1
        self.sort_descending = false
        self._order = []
        self._top = 0
        self._last_w = []
        self.editable = editable
        self.column = 0
        self.on_edit = on_edit
        self._editor = TextInput("")
        self._edit_row = -1
        self._edit_col = -1
        self.focusable = true
    }

    --- True while a cell is being edited. ---
    define editing(self) -> Bool {
        return self._edit_row >= 0
    }

    --- Edit cell (row index `r`, column `c`) in place. ---
    define edit_cell(self, r: Int, c: Int) -> void {
        if r < 0 or r >= self.rows.length() or c < 0 or c >= self.columns.length() { return }
        self.select(r)
        self.column = c
        self._edit_row = r
        self._edit_col = c
        self._editor.text = self._cell(r, c)
        self._editor.select_all()
        self._editor._undo = []
        self._editor.focused = true
    }

    --- Stop editing; `save` keeps the typed value. ---
    define finish_edit(self, save: Bool = true) -> void {
        if not self.editing() { return }
        r := self._edit_row
        c := self._edit_col
        self._edit_row = -1
        self._edit_col = -1
        self._editor.focused = false
        if not save { return }
        row: List = self.rows[r]
        while row.length() <= c { row.append("") }
        text := self._editor.text
        old := row[c]
        value: Any = text
        if type(old) == "Int" and self._numeric(text) { value = text.to_int() }
        row[c] = value
        self._order = []                          // re-sort with the new value
        if self.on_edit != null { self.on_edit(r, c, value) }
    }

    // The cell rectangle of (row index r, column c) as [x, y, w, h], or [].
    define _cell_rect(self, r: Int, c: Int) -> List {
        order := self._ordered()
        pos := -1
        i := 0
        while i < order.length() {
            v: Int = order[i]
            if v == r { pos = i }
            i = i + 1
        }
        if pos < self._top or pos >= self._top + self._shown() or c >= self._last_w.length() { return [] }
        x := self.x + 2
        k := 0
        while k < c {
            w: Int = self._last_w[k]
            x = x + w
            k = k + 1
        }
        cw: Int = self._last_w[c]
        rh := self._row_h()
        return [x, self.y + 2 + rh + (pos - self._top) * rh, cw, rh]
    }

    define _row_h(self) -> Int {
        return 24
    }

    define _shown(self) -> Int {
        return _max(1, (self.height - self._row_h() - 4) / self._row_h())
    }

    // A whole-number cell ("42", "-7"), compared by value when sorting.
    define _numeric(self, s: String) -> Bool {
        if s.length() == 0 { return false }
        if s.startswith("-") { return s.length() > 1 and s.substring(1, s.length()).is_digit() }
        return s.is_digit()
    }

    define _cell(self, r: Int, c: Int) -> String {
        row: List = self.rows[r]
        if c >= row.length() { return "" }
        return row[c].str()
    }

    // Row indices in display order (sorted when a header was clicked).
    define _ordered(self) -> List {
        if self._order.length() != self.rows.length() {
            order := []
            i := 0
            while i < self.rows.length() {
                order.append(i)
                i = i + 1
            }
            self._order = order
            if self.sort_column >= 0 { self._sort() }
        }
        return self._order
    }

    // a before b in the current sort: numbers by value, the rest as text.
    define _before(self, a: Int, b: Int) -> Bool {
        x := self._cell(a, self.sort_column)
        y := self._cell(b, self.sort_column)
        less := x < y
        greater := x > y
        if self._numeric(x) and self._numeric(y) {
            xi := x.to_int()
            yi := y.to_int()
            less = xi < yi
            greater = xi > yi
        }
        if self.sort_descending { return greater }
        return less
    }

    define _sort(self) -> void {
        // Insertion sort: stable, and tables are small.
        order := self._order
        i := 1
        while i < order.length() {
            cur: Int = order[i]
            j := i - 1
            while j >= 0 {
                prev: Int = order[j]
                if not self._before(cur, prev) { break }
                order[j + 1] = prev
                j = j - 1
            }
            order[j + 1] = cur
            i = i + 1
        }
    }

    --- Sort by column `c` (`descending` for largest / last first). ---
    define sort_by(self, c: Int, descending: Bool = false) -> void {
        self.sort_column = c
        self.sort_descending = descending
        self._ordered()
        self._sort()
    }

    --- Select row `i` (an index into `rows`; -1: none); runs `on_select` if it changed. ---
    define select(self, i: Int) -> void {
        ni := _clamp(i, -1, self.rows.length() - 1)
        if ni == self.selected { return }
        self.selected = ni
        if ni >= 0 {
            pos := 0
            order := self._ordered()
            while pos < order.length() {
                v: Int = order[pos]
                if v == ni { break }
                pos = pos + 1
            }
            if pos < self._top { self._top = pos }
            if pos >= self._top + self._shown() { self._top = pos - self._shown() + 1 }
            if self.on_select != null { self.on_select(ni, self.rows[ni]) }
        }
    }

    define _col_widths(self, t: Theme) -> List {
        out := []
        c := 0
        while c < self.columns.length() {
            if c < self.widths.length() {
                out.append(self.widths[c])
            } else {
                w := window.text_width(self.columns[c].str(), t.scale) + 3 * t.char_w()
                r := 0
                while r < self.rows.length() {
                    w = _max(w, window.text_width(self._cell(r, c), t.scale) + 2 * t.char_w())
                    r = r + 1
                }
                out.append(_min(w, 40 * t.char_w()))
            }
            c = c + 1
        }
        return out
    }

    define measure(self, t: Theme) -> void {
        total := 0
        for w in self._col_widths(t) {
            n: Int = w
            total = total + n
        }
        self.min_w = total + 4
        self.min_h = (self.visible_rows + 1) * self._row_h() + 4
    }

    // Display position under py (-1 for the header, -2 outside).
    define _pos_at(self, py: Int) -> Int {
        if py < self.y + 2 + self._row_h() { return -1 }
        p := self._top + (py - self.y - 2 - self._row_h()) / self._row_h()
        if p >= self.rows.length() { return -2 }
        return p
    }

    define _col_at(self, px: Int) -> Int {
        // Widths of the last draw.
        x := self.x + 2
        c := 0
        while c < self._last_w.length() {
            w: Int = self._last_w[c]
            if px >= x and px < x + w { return c }
            x = x + w
            c = c + 1
        }
        return -1
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if self.editing() {
            rect := self._cell_rect(self._edit_row, self._edit_col)
            inside := false
            if rect.length() == 4 and (e.kind == "mouse_down" or e.kind == "mouse_move" or e.kind == "mouse_up") {
                rx: Int = rect[0]
                ry: Int = rect[1]
                rw: Int = rect[2]
                rhh: Int = rect[3]
                inside = e.x >= rx and e.y >= ry and e.x < rx + rw and e.y < ry + rhh
            }
            if e.kind == "key_down" and (e.key == "return" or e.key == "keypad_enter") {
                self.finish_edit(true)
                return true
            }
            if e.kind == "key_down" and e.key == "escape" {
                self.finish_edit(false)
                return true
            }
            if e.kind == "key_down" or e.kind == "text" or inside or (e.kind != "mouse_down" and self._editor._dragging) {
                self._editor.handle(e)
                return true
            }
            if e.kind == "mouse_down" { self.finish_edit(true) }      // a click elsewhere saves
        }
        order := self._ordered()
        if e.kind == "mouse_down" and e.button == 1 {
            p := self._pos_at(e.y)
            if p >= 0 and self.editable {
                c := self._col_at(e.x)
                if c >= 0 { self.column = c }
                if e.clicks >= 2 and c >= 0 {
                    r: Int = order[p]
                    self.edit_cell(r, c)
                    return true
                }
            }
            if p == -1 {
                c := self._col_at(e.x)
                if c >= 0 { self.sort_by(c, c == self.sort_column and not self.sort_descending) }
            } elif p >= 0 {
                self.select(order[p])
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "wheel" {
            most := _max(0, self.rows.length() - self._shown())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        if e.kind != "key_down" or self.rows.length() == 0 { return false }
        cur := -1
        i := 0
        while i < order.length() {
            v: Int = order[i]
            if v == self.selected { cur = i }
            i = i + 1
        }
        k := e.key
        if self.editable and (k == "return" or k == "keypad_enter" or k == "f2") and self.selected >= 0 {
            self.edit_cell(self.selected, self.column)
            return true
        }
        if self.editable and k == "left" {
            self.column = _max(0, self.column - 1)
            return true
        }
        if self.editable and k == "right" {
            self.column = _min(self.columns.length() - 1, self.column + 1)
            return true
        }
        if k == "down" {
            self.select(order[_min(order.length() - 1, cur + 1)])
        } elif k == "up" {
            self.select(order[_max(0, cur - 1)])
        } elif k == "home" {
            self.select(order[0])
        } elif k == "end" {
            self.select(order[order.length() - 1])
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused { border = t.accent }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        ws := self._col_widths(t)
        self._last_w = ws
        rh := self._row_h()
        order := self._ordered()
        shown := self._shown()
        most := _max(0, order.length() - shown)
        if self._top > most { self._top = most }
        _clip_push(win, self.x + 1, self.y + 1, self.width - 2, self.height - 2)
        // Header.
        hy := self.y + 2
        win.rect(self.x + 2, hy, self.width - 4, rh, t.surface)
        x := self.x + 2
        c := 0
        while c < self.columns.length() {
            w: Int = ws[c]
            label := self.columns[c].str()
            if c == self.sort_column {
                if self.sort_descending { label = label + " v" } else { label = label + " ^" }
            }
            win.text(label, x + t.char_w(), hy + (rh - t.line()) / 2, t.text, scale=t.scale)
            if c > 0 { win.rect(x, hy + 4, 1, rh - 8, t.border) }
            x = x + w
            c = c + 1
        }
        win.rect(self.x + 2, hy + rh - 1, self.width - 4, 1, t.border)
        // Rows.
        p := self._top
        while p < order.length() and p < self._top + shown {
            ri: Int = order[p]
            ry := hy + rh + (p - self._top) * rh
            ink := t.text
            if ri == self.selected {
                win.rect(self.x + 2, ry, self.width - 4, rh, _ink(self, t.accent, t))
                ink = t.accent_text
            } elif (p - self._top) % 2 == 1 {
                win.rect(self.x + 2, ry, self.width - 4, rh, mix(t.input, t.surface, 50))
            }
            x = self.x + 2
            c = 0
            while c < self.columns.length() {
                w: Int = ws[c]
                cell := self._cell(ri, c)
                fit := _max(1, (w - 2 * t.char_w()) / t.char_w())
                if cell.length() > fit { cell = cell.substring(0, fit) }
                win.text(cell, x + t.char_w(), ry + (rh - t.line()) / 2, _ink(self, ink, t), scale=t.scale)
                x = x + w
                c = c + 1
            }
            p = p + 1
        }
        if self.editable and self.selected >= 0 and self.focused {
            sel := self._cell_rect(self.selected, self.column)
            if sel.length() == 4 {
                sx: Int = sel[0]
                sy: Int = sel[1]
                sw: Int = sel[2]
                shh: Int = sel[3]
                win.rect(sx, sy, sw, shh, t.accent_text, fill=false)
            }
        }
        if self.editing() {
            if not self.focused {
                self.finish_edit(true)                // focus moved away: keep the value
            } else {
                rect := self._cell_rect(self._edit_row, self._edit_col)
                if rect.length() == 4 {
                    ex: Int = rect[0]
                    ey: Int = rect[1]
                    ew: Int = rect[2]
                    ehh: Int = rect[3]
                    self._editor.measure(t)
                    self._editor.place(ex, ey, ew, ehh)
                    self._editor.draw(win, t)
                }
            }
        }
        _clip_pop(win)
        if order.length() > shown {
            track := self.height - rh - 4
            bar := _max(8, track * shown / order.length())
            by := self.y + 2 + rh + (track - bar) * self._top / _max(1, most)
            win.rect(self.x + self.width - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== ScrollView =====

// The focused widget inside w (w included), or null.
define _focused_in(w: Widget) -> Widget {
    if not w.visible { return null }
    if w.focused { return w }
    for c in w.children() {
        f := _focused_in(c)
        if f != null { return f }
    }
    return null
}

---
Shows `content` (any widget, usually a Column) in an area `height`
pixels tall that scrolls when the content is taller: mouse wheel, drag
the scroll bar, or Tab to a widget that's out of view. `offset` is how
far it's scrolled (pixels). With `expand` it takes its container's free
height instead.
---
struct ScrollView : Widget {
    content: Widget
    max_height: Int
    offset: Int
    step: Int
    _drag: Int
    _seen_focus: Widget

    define __init(self, content: Widget, height: Int = 200, expand: Bool = false) -> void {
        super().__init()
        self.content = content
        self.max_height = height
        self.expand = expand
        self.offset = 0
        self.step = 40
        self._drag = -1
        self._seen_focus = null
        self.takes_clicks = true
    }

    define children(self) -> List {
        return [self.content]
    }

    define _bar_w(self) -> Int {
        return 10
    }

    define _most(self) -> Int {
        return _max(0, self.content.min_h - self.height)
    }

    --- Scroll so `pixels` from the top of the content is at the top (clamped). ---
    define scroll_to(self, pixels: Int) -> void {
        self.offset = _clamp(pixels, 0, self._most())
    }

    define measure(self, t: Theme) -> void {
        self.content.measure(t)
        self.min_w = self.content.min_w + self._bar_w()
        self.min_h = _min(self.content.min_h, self.max_height)
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        self.offset = _clamp(self.offset, 0, self._most())
        cw := width - self._bar_w()
        ch := _max(self.content.min_h, height)
        self.content.place(x, y - self.offset, cw, ch)
        // Newly focused widget out of view (Tab): scroll to it, once.
        f := _focused_in(self.content)
        if f != null and f != self._seen_focus {
            if f.y < y {
                self.scroll_to(self.offset - (y - f.y))
            } elif f.y + f.height > y + height {
                self.scroll_to(self.offset + (f.y + f.height - y - height))
            }
            self.content.place(x, y - self.offset, cw, ch)
        }
        self._seen_focus = f
    }

    define _thumb(self) -> List {
        track := self.height
        bar := _max(16, track * self.height / _max(1, self.content.min_h))
        ty := self.y + (track - bar) * self.offset / _max(1, self._most())
        return [ty, bar]
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "wheel" {
            if self._most() == 0 { return false }
            self.scroll_to(self.offset - e.dy * self.step)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 and self._most() > 0 and e.x >= self.x + self.width - self._bar_w() {
            th := self._thumb()
            ty: Int = th[0]
            bar: Int = th[1]
            if e.y >= ty and e.y < ty + bar {
                self._drag = e.y - ty
            } else {
                // Click on the track: jump there, then drag from the middle.
                self._drag = bar / 2
                self._drag_to(e.y)
            }
            return true
        }
        if e.kind == "mouse_move" and self._drag >= 0 {
            self._drag_to(e.y)
            return true
        }
        if e.kind == "mouse_up" {
            self._drag = -1
            return true
        }
        return false
    }

    define _drag_to(self, py: Int) -> void {
        th := self._thumb()
        bar: Int = th[1]
        room := _max(1, self.height - bar)
        rel := _clamp(py - self._drag - self.y, 0, room)
        self.scroll_to(rel * self._most() / room)
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        _clip_push(win, self.x, self.y, self.width, self.height)
        self.content.draw(win, t)
        _clip_pop(win)
        if self._most() > 0 {
            th := self._thumb()
            ty: Int = th[0]
            bar: Int = th[1]
            bx := self.x + self.width - self._bar_w() + 3
            win.rect(bx, self.y, 4, self.height, mix(t.border, t.background, 40))
            thumb := t.muted
            if self._drag >= 0 or self.hovered { thumb = mix(t.muted, t.text, 40) }
            win.rect(bx, ty, 4, bar, thumb)
        }
    }
}

// ===== Dropdown =====

---
Pick one of `options` (anything with `.str()`) from a list that opens
below the field. Click it, or Space / Enter / Alt+Down when focused;
Up / Down change the choice directly while it's closed. `selected` is
the index; `on_change(index, item)` runs when it changes.
---
struct Dropdown : Widget {
    options: List
    selected: Int
    on_change: Callable
    is_open: Bool
    max_rows: Int
    _hover: Int
    _top: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int

    define __init(self, options: List, selected: Int = 0, on_change: Callable = null, expand: Bool = false) -> void {
        super().__init()
        self.options = options
        self.selected = _clamp(selected, 0, _max(0, options.length() - 1))
        self.on_change = on_change
        self.expand = expand
        self.is_open = false
        self.max_rows = 8
        self._hover = -1
        self._top = 0
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
        self.focusable = true
    }

    --- The chosen option as text ("" when there are none). ---
    define text(self) -> String {
        if self.selected < 0 or self.selected >= self.options.length() { return "" }
        return self.options[self.selected].str()
    }

    --- Choose option `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.options.length() == 0 { return }
        ni := _clamp(i, 0, self.options.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.options[ni]) }
        }
    }

    --- Show the list. ---
    define open(self) -> void {
        if self.is_open or not self.enabled or self.options.length() == 0 { return }
        self.is_open = true
        self._hover = self.selected
        _popups.append(self)
    }

    --- Hide the list. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define close_popup(self) -> void {
        self.close()
    }

    define _rows(self) -> Int {
        return _max(1, _min(self.max_rows, self.options.length()))
    }

    define _row_h(self) -> Int {
        return 24
    }

    define measure(self, t: Theme) -> void {
        widest := 4 * t.char_w()
        for o in self.options { widest = _max(widest, window.text_width(o.str(), t.scale)) }
        self.min_w = widest + 16 + 3 * t.char_w()
        self.min_h = t.line() + 12
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            if self.is_open { self.close() } else { self.open() }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind != "key_down" { return false }
        k := e.key
        if self.is_open {
            if k == "down" {
                self._hover = _min(self.options.length() - 1, self._hover + 1)
            } elif k == "up" {
                self._hover = _max(0, self._hover - 1)
            } elif k == "home" {
                self._hover = 0
            } elif k == "end" {
                self._hover = self.options.length() - 1
            } elif k == "return" or k == "keypad_enter" or k == "space" {
                if self._hover >= 0 { self.select(self._hover) }
                self.close()
            } elif k == "escape" {
                self.close()
            } else {
                return false
            }
            if self._hover < self._top { self._top = self._hover }
            if self._hover >= self._top + self._rows() { self._top = self._hover - self._rows() + 1 }
            return true
        }
        if k == "space" or k == "return" or k == "keypad_enter" or (k == "down" and e.alt) {
            self.open()
        } elif k == "down" {
            self.select(self.selected + 1)
        } elif k == "up" {
            self.select(self.selected - 1)
        } else {
            return false
        }
        return true
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.input)
        border := t.border
        if self.focused or self.is_open {
            border = t.accent
        } elif self.hovered {
            border = mix(t.border, t.text, 30)
        }
        win.rect(self.x, self.y, self.width, self.height, border, fill=false)
        cw := t.char_w()
        label := self.text()
        fit := _max(1, (self.width - 16 - 3 * cw) / cw)
        if label.length() > fit { label = label.substring(0, fit) }
        win.text(label, self.x + 8, self.y + (self.height - t.line()) / 2, _ink(self, t.text, t), scale=t.scale)
        // The arrow: a small filled triangle pointing down.
        ax := self.x + self.width - 8 - cw
        ay := self.y + self.height / 2 - 2
        half := _max(3, cw / 2)
        r := 0
        while r <= half {
            win.line(ax - half + r, ay + r, ax + half - r, ay + r, _ink(self, t.muted, t))
            r = r + 1
        }
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph
    }

    define popup_handle(self, e: window.Event) -> Bool {
        rh := self._row_h()
        if e.kind == "mouse_move" {
            row := (e.y - self._py - 2) / rh
            self._hover = _clamp(self._top + row, 0, self.options.length() - 1)
            return true
        }
        if e.kind == "mouse_down" and e.button == 1 {
            row := (e.y - self._py - 2) / rh
            i := self._top + row
            if i >= 0 and i < self.options.length() { self.select(i) }
            self.close()
            return true
        }
        if e.kind == "wheel" {
            most := _max(0, self.options.length() - self._rows())
            self._top = _clamp(self._top - e.dy, 0, most)
            return true
        }
        return e.kind == "mouse_up"
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        rh := self._row_h()
        rows := self._rows()
        self._pw = self.width
        self._ph = rows * rh + 4
        self._px = self.x
        self._py = self.y + self.height + 2
        // No room below: open upwards.
        if self._py + self._ph > win.height() and self.y - self._ph - 2 >= 0 { self._py = self.y - self._ph - 2 }
        self._top = _clamp(self._top, 0, _max(0, self.options.length() - rows))
        win.rect(self._px + 3, self._py + 3, self._pw, self._ph, mix(t.background, window.black(), 45))   // shadow
        win.rect(self._px, self._py, self._pw, self._ph, t.surface)
        win.rect(self._px, self._py, self._pw, self._ph, t.border, fill=false)
        fit := _max(1, (self._pw - 16) / t.char_w())
        i := self._top
        while i < self.options.length() and i < self._top + rows {
            ry := self._py + 2 + (i - self._top) * rh
            ink := t.text
            if i == self._hover {
                win.rect(self._px + 2, ry, self._pw - 4, rh, t.accent)
                ink = t.accent_text
            } elif i == self.selected {
                win.rect(self._px + 2, ry, self._pw - 4, rh, mix(t.accent, t.surface, 75))
            }
            label := self.options[i].str()
            if label.length() > fit { label = label.substring(0, fit) }
            win.text(label, self._px + 8, ry + (rh - t.line()) / 2, ink, scale=t.scale)
            i = i + 1
        }
        if self.options.length() > rows {
            track := self._ph - 4
            bar := _max(8, track * rows / self.options.length())
            most := _max(1, self.options.length() - rows)
            by := self._py + 2 + (track - bar) * self._top / most
            win.rect(self._px + self._pw - 5, by, 3, bar, t.muted)
        }
    }
}

// ===== Tabs =====

---
Pages under a row of tabs: `ui.Tabs(["General", "Advanced"], [page1, page2])`.
Click a tab, or Left / Right when the tab row has the focus. `selected`
is the page shown; `on_change(index, title)` runs when it changes;
`add(title, page)` adds one.
---
struct Tabs : Widget {
    titles: List
    pages: List
    selected: Int
    on_change: Callable
    _tab_h: Int
    _xs: List

    define __init(self, titles: List, pages: List, selected: Int = 0, on_change: Callable = null, expand: Bool = false) -> void {
        super().__init()
        self.titles = titles
        self.pages = pages
        self.selected = _clamp(selected, 0, _max(0, pages.length() - 1))
        self.on_change = on_change
        self.expand = expand
        self._tab_h = 28
        self._xs = []
        self.focusable = true
    }

    --- Add a page with its tab title. ---
    define add(self, title: String, page: Widget) -> void {
        self.titles.append(title)
        self.pages.append(page)
    }

    --- Show page `i` (clamped); runs `on_change` if it changed. ---
    define select(self, i: Int) -> void {
        if self.pages.length() == 0 { return }
        ni := _clamp(i, 0, self.pages.length() - 1)
        if ni != self.selected {
            self.selected = ni
            if self.on_change != null { self.on_change(ni, self.titles[ni]) }
        }
    }

    --- The page being shown (null when there are none). ---
    define page(self) -> Widget {
        if self.selected < 0 or self.selected >= self.pages.length() { return null }
        return self.pages[self.selected]
    }

    define children(self) -> List {
        p := self.page()
        if p == null { return [] }
        return [p]
    }

    define measure(self, t: Theme) -> void {
        self._tab_h = t.line() + 12
        tw := 0
        for title in self.titles { tw = tw + window.text_width(title.str(), t.scale) + 3 * t.char_w() }
        pw := 0
        ph := 0
        for pg in self.pages {
            w: Widget = pg
            w.measure(t)
            pw = _max(pw, w.min_w)
            ph = _max(ph, w.min_h)
        }
        self.min_w = _max(tw, pw + 16)
        self.min_h = self._tab_h + ph + 16
    }

    define place(self, x: Int, y: Int, width: Int, height: Int) -> void {
        self.x = x
        self.y = y
        self.width = width
        self.height = height
        p := self.page()
        if p != null { p.place(x + 8, y + self._tab_h + 8, width - 16, height - self._tab_h - 16) }
    }

    // The tab under x, or -1.
    define _tab_at(self, px: Int) -> Int {
        i := 0
        while i + 1 < self._xs.length() {
            a: Int = self._xs[i]
            b: Int = self._xs[i + 1]
            if px >= a and px < b { return i }
            i = i + 1
        }
        return -1
    }

    define handle(self, e: window.Event) -> Bool {
        if not self.enabled { return false }
        if e.kind == "mouse_down" and e.button == 1 {
            if e.y < self.y + self._tab_h {
                i := self._tab_at(e.x)
                if i >= 0 { self.select(i) }
            }
            return true
        }
        if e.kind == "mouse_up" { return true }
        if e.kind == "key_down" {
            if e.key == "right" or (e.key == "tab" and e.ctrl and not e.shift) {
                self.select((self.selected + 1) % _max(1, self.pages.length()))
                return true
            }
            if e.key == "left" or (e.key == "tab" and e.ctrl and e.shift) {
                self.select((self.selected + self.pages.length() - 1) % _max(1, self.pages.length()))
                return true
            }
        }
        return false
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        th := self._tab_h
        win.rect(self.x, self.y + th, self.width, self.height - th, t.surface)
        win.rect(self.x, self.y + th, self.width, self.height - th, t.border, fill=false)
        xs := [self.x]
        tx := self.x
        i := 0
        while i < self.titles.length() {
            title := self.titles[i].str()
            w := window.text_width(title, t.scale) + 3 * t.char_w()
            bg := t.background
            ink := t.muted
            if i == self.selected {
                bg = t.surface
                ink = t.text
            } elif self.hovered {
                ink = mix(t.muted, t.text, 40)
            }
            win.rect(tx, self.y, w, th + 1, bg)
            win.rect(tx, self.y, w, th + 1, t.border, fill=false)
            if i == self.selected {
                win.rect(tx + 1, self.y + th, w - 2, 1, t.surface)                 // open into the page
                win.rect(tx, self.y, w, 2, _ink(self, t.accent, t))
            }
            win.text(title, tx + (w - window.text_width(title, t.scale)) / 2, self.y + (th - t.line()) / 2,
                     _ink(self, ink, t), scale=t.scale)
            tx = tx + w
            xs.append(tx)
            i = i + 1
        }
        self._xs = xs
        if self.focused {
            win.rect(self.x - 2, self.y - 2, tx - self.x + 4, th + 4, t.focus, fill=false)
        }
        p := self.page()
        if p != null and p.visible { p.draw(win, t) }
    }
}

// ===== Menus =====

---
One entry of a `ui.Menu`: `text`, `on_click` (no arguments), an optional
`shortcut` label shown on the right (just text — bind the keys yourself
with `app.on_key`), and `enabled`. `ui.MenuItem("-")` is a separator.
---
struct MenuItem {
    text: String
    on_click: Callable
    shortcut: String
    enabled: Bool

    define __init(self, text: String, on_click: Callable = null, shortcut: String = "", enabled: Bool = true) -> void {
        self.text = text
        self.on_click = on_click
        self.shortcut = shortcut
        self.enabled = enabled
    }

    --- True for a separator line. ---
    define is_separator(self) -> Bool {
        return self.text == "-"
    }

    --- True when key event `e` is this item's `shortcut` ("Ctrl+S", "Ctrl+Shift+N", "F5", "Delete"; Ctrl also matches Cmd). ---
    define matches(self, e: window.Event) -> Bool {
        if self.shortcut.length() == 0 or e.kind != "key_down" { return false }
        parts := self.shortcut.split("+")
        ctrl := false
        shift := false
        alt := false
        key := ""
        for p in parts {
            word: String = p
            w := word.trim().lower()
            if w == "ctrl" or w == "cmd" or w == "control" { ctrl = true }
            elif w == "shift" { shift = true }
            elif w == "alt" or w == "option" { alt = true }
            elif w == "del" { key = "delete" }
            elif w == "esc" { key = "escape" }
            elif w == "enter" { key = "return" }
            elif w == "pgup" { key = "pageup" }
            elif w == "pgdn" { key = "pagedown" }
            elif w == "ins" { key = "insert" }
            else { key = w }
        }
        if key.length() == 0 { return false }
        return e.key == key and (e.ctrl or e.meta) == ctrl and e.shift == shift and e.alt == alt
    }
}

---
A list of `ui.MenuItem`s that pops up: under a `ui.MenuBar` title, or
where the user right-clicks a widget whose `context_menu` it is
(`menu.open_at(x, y)` from code). Click an item, or Up / Down and Enter;
Escape closes it.
---
struct Menu : Widget {
    items: List
    is_open: Bool
    bar: MenuBar
    _hover: Int
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int

    define __init(self, items: List) -> void {
        super().__init()
        self.items = items
        self.is_open = false
        self.bar = null
        self._hover = -1
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
    }

    define _item(self, i: Int) -> MenuItem {
        return self.items[i]
    }

    define _usable(self, i: Int) -> Bool {
        if i < 0 or i >= self.items.length() { return false }
        it := self._item(i)
        return it.enabled and not it.is_separator()
    }

    define open_at(self, px: Int, py: Int) -> void {
        if self.is_open { self.close() }
        self._px = px
        self._py = py
        self._hover = -1
        self.is_open = true
        _popups.append(self)
    }

    --- Hide it. ---
    define close(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
        if self.bar != null { self.bar.close_popup() }
    }

    define close_popup(self) -> void {
        self.close()
    }

    // Run item i: close every popup first (its action may open another).
    define activate(self, i: Int) -> void {
        if not self._usable(i) { return }
        it := self._item(i)
        _close_popups()
        if it.on_click != null { it.on_click() }
    }

    define _row_h(self, i: Int) -> Int {
        if self._item(i).is_separator() { return 9 }
        return 24
    }

    define _row_at(self, py: Int) -> Int {
        y := self._py + 2
        i := 0
        while i < self.items.length() {
            h := self._row_h(i)
            if py >= y and py < y + h { return i }
            y = y + h
            i = i + 1
        }
        return -1
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        if px >= self._px and py >= self._py and px < self._px + self._pw and py < self._py + self._ph { return true }
        // A menu bar's title row belongs to its open menu (hover to switch).
        return self.bar != null and self.bar.contains(px, py)
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if self.bar != null and self.bar.contains(e.x, e.y) {
            return self.bar._while_open(e)
        }
        if e.kind == "mouse_move" {
            r := self._row_at(e.y)
            if self._usable(r) { self._hover = r } else { self._hover = -1 }
            return true
        }
        if (e.kind == "mouse_up" or e.kind == "mouse_down") and e.button == 1 {
            r := self._row_at(e.y)
            if e.kind == "mouse_up" and self._usable(r) { self.activate(r) }
            return true
        }
        return true
    }

    define _step(self, by: Int) -> void {
        n := self.items.length()
        if n == 0 { return }
        i := self._hover
        tries := 0
        while tries < n {
            i = (i + by + n) % n
            if self._usable(i) {
                self._hover = i
                return
            }
            tries = tries + 1
        }
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind != "key_down" { return e.kind == "key_up" or e.kind == "text" }
        k := e.key
        if k == "down" {
            self._step(1)
        } elif k == "up" {
            if self._hover < 0 { self._hover = 0 }
            self._step(-1)
        } elif k == "return" or k == "keypad_enter" or k == "space" {
            if self._usable(self._hover) { self.activate(self._hover) } else { self.close() }
        } elif k == "escape" {
            self.close()
        } elif (k == "left" or k == "right") and self.bar != null {
            self.bar._switch(k == "right")
        } else {
            return true          // an open menu takes the keyboard
        }
        return true
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        cw := t.char_w()
        widest := 0
        hint := 0
        h := 4
        i := 0
        while i < self.items.length() {
            it := self._item(i)
            widest = _max(widest, window.text_width(it.text, t.scale))
            hint = _max(hint, window.text_width(it.shortcut, t.scale))
            h = h + self._row_h(i)
            i = i + 1
        }
        self._pw = widest + 4 * cw + 16
        if hint > 0 { self._pw = self._pw + hint + 3 * cw }
        self._ph = h
        // Keep it on screen.
        if self._px + self._pw > win.width() { self._px = _max(0, win.width() - self._pw) }
        if self._py + self._ph > win.height() { self._py = _max(0, self._py - self._ph) }
        win.rect(self._px + 3, self._py + 3, self._pw, self._ph, mix(t.background, window.black(), 45))
        win.rect(self._px, self._py, self._pw, self._ph, t.surface)
        win.rect(self._px, self._py, self._pw, self._ph, t.border, fill=false)
        y := self._py + 2
        i = 0
        while i < self.items.length() {
            it := self._item(i)
            rh := self._row_h(i)
            if it.is_separator() {
                win.rect(self._px + 6, y + rh / 2, self._pw - 12, 1, t.border)
            } else {
                ink := t.text
                if not it.enabled { ink = mix(t.text, t.surface, 55) }
                if i == self._hover {
                    win.rect(self._px + 2, y, self._pw - 4, rh, t.accent)
                    ink = t.accent_text
                }
                ty := y + (rh - t.line()) / 2
                win.text(it.text, self._px + 2 * cw, ty, ink, scale=t.scale)
                if it.shortcut.length() > 0 {
                    sw := window.text_width(it.shortcut, t.scale)
                    sink := t.muted
                    if i == self._hover { sink = t.accent_text }
                    win.text(it.shortcut, self._px + self._pw - 2 * cw - sw, ty, sink, scale=t.scale)
                }
            }
            y = y + rh
            i = i + 1
        }
    }
}

---
A row of menu titles, usually at the top of the window:
`ui.MenuBar(["File", "Edit"], [file_menu, edit_menu])`. Click a title to
open its menu; while one is open, moving over another title (or Left /
Right) switches to it.
---
struct MenuBar : Widget {
    titles: List
    menus: List
    _open: Int
    _xs: List

    define __init(self, titles: List, menus: List) -> void {
        super().__init()
        self.titles = titles
        self.menus = menus
        self._open = -1
        self._xs = []
        self.takes_clicks = true
        for m in menus {
            mm: Menu = m
            mm.bar = self
        }
    }

    define is_menu_bar(self) -> Bool {
        return true
    }

    define measure(self, t: Theme) -> void {
        w := 0
        for title in self.titles { w = w + window.text_width(title.str(), t.scale) + 2 * t.char_w() }
        self.min_w = w
        self.min_h = t.line() + 10
    }

    define _title_at(self, px: Int) -> Int {
        i := 0
        while i + 1 < self._xs.length() {
            a: Int = self._xs[i]
            b: Int = self._xs[i + 1]
            if px >= a and px < b { return i }
            i = i + 1
        }
        return -1
    }

    --- Open menu `i` under its title (-1: close). ---
    define open_menu(self, i: Int) -> void {
        if self._open >= 0 and self._open < self.menus.length() {
            was: Menu = self.menus[self._open]
            self._open = -1
            was.close()
        }
        if i < 0 or i >= self.menus.length() or i + 1 >= self._xs.length() { return }
        m: Menu = self.menus[i]
        x: Int = self._xs[i]
        m.open_at(x, self.y + self.height)
        self._open = i
    }

    define close_popup(self) -> void {
        self._open = -1
    }

    define _switch(self, forward: Bool) -> void {
        n := self.menus.length()
        if n == 0 or self._open < 0 { return }
        nxt := (self._open + n - 1) % n
        if forward { nxt = (self._open + 1) % n }
        self.open_menu(nxt)
    }

    // Mouse over the bar while one of its menus is open.
    define _while_open(self, e: window.Event) -> Bool {
        i := self._title_at(e.x)
        if e.kind == "mouse_move" {
            if i >= 0 and i != self._open { self.open_menu(i) }
        } elif e.kind == "mouse_down" and e.button == 1 {
            if i == self._open or i < 0 { self.open_menu(-1) } else { self.open_menu(i) }
        }
        return true
    }

    define handle(self, e: window.Event) -> Bool {
        if e.kind == "mouse_down" and e.button == 1 {
            i := self._title_at(e.x)
            if i >= 0 { self.open_menu(i) }
            return true
        }
        return e.kind == "mouse_up"
    }

    define draw(self, win: window.Window, t: Theme) -> void {
        win.rect(self.x, self.y, self.width, self.height, t.surface)
        win.rect(self.x, self.y + self.height - 1, self.width, 1, t.border)
        xs := [self.x]
        tx := self.x
        i := 0
        while i < self.titles.length() {
            title := self.titles[i].str()
            w := window.text_width(title, t.scale) + 2 * t.char_w()
            ink := t.text
            if i == self._open {
                win.rect(tx, self.y, w, self.height - 1, t.accent)
                ink = t.accent_text
            }
            win.text(title, tx + t.char_w(), self.y + (self.height - t.line()) / 2, ink, scale=t.scale)
            tx = tx + w
            xs.append(tx)
            i = i + 1
        }
        self._xs = xs
    }
}

// ===== FileDialog =====

---
A window-sized dialog to pick a file (`mode="open"`), a name to save as
(`mode="save"`) or a folder (`mode="folder"`), starting in `dir`.
`filter` (e.g. "*.qk") limits the files shown. `show()` opens it;
`on_pick(path)` runs with the full path chosen, `on_cancel()` (optional)
when it's dismissed. Double-click or Enter opens a folder or picks a
file; Backspace goes up a folder; Tab moves between the list and the
name field; Escape cancels. While it's open it takes all input.
---
struct FileDialog : Widget {
    mode: String
    dir: String
    filter: String
    title: String
    show_hidden: Bool
    on_pick: Callable
    on_cancel: Callable
    is_open: Bool
    _names: List
    _dirs: List
    _list: ListView
    _name: TextInput
    _ok: Button
    _cancel: Button
    _in_name: Bool
    _px: Int
    _py: Int
    _pw: Int
    _ph: Int

    define __init(self, mode: String = "open", dir: String = ".", on_pick: Callable = null, filter: String = "", title: String = "", on_cancel: Callable = null) -> void {
        super().__init()
        self.mode = mode
        self.dir = fs.absolute(dir)
        self.filter = filter
        self.title = title
        if title == "" {
            if mode == "save" { self.title = "Save as" }
            elif mode == "folder" { self.title = "Choose a folder" }
            else { self.title = "Open" }
        }
        self.show_hidden = false
        self.on_pick = on_pick
        self.on_cancel = on_cancel
        self.is_open = false
        self._names = []
        self._dirs = []
        self._list = ListView([], rows=8)
        self._name = TextInput("", columns=30)
        label := "Open"
        if mode == "save" { label = "Save" }
        if mode == "folder" { label = "Choose" }
        self._ok = Button(label)
        self._cancel = Button("Cancel")
        self._in_name = mode == "save"
        self._px = 0
        self._py = 0
        self._pw = 0
        self._ph = 0
    }

    --- Open the dialog (reading `dir`). ---
    define show(self) -> void {
        _close_popups()
        self.go(self.dir)
        self.is_open = true
        _popups.append(self)
    }

    --- Show folder `path`. ---
    define go(self, path: String) -> void {
        if not fs.is_dir(path) { return }
        self.dir = fs.absolute(path)
        dirs := []
        files := []
        for e in fs.list_dir(self.dir) {
            name: String = e
            if not self.show_hidden and name.startswith(".") { continue }
            if fs.is_dir(fs.join(self.dir, name)) {
                dirs.append(name)
            } elif self.mode != "folder" and (self.filter == "" or fs.matches(self.filter, name)) {
                files.append(name)
            }
        }
        dirs = _sorted_names(dirs)
        files = _sorted_names(files)
        names := []
        kinds := []
        if fs.dirname(self.dir) != self.dir {
            names.append("..")
            kinds.append(true)
        }
        for d in dirs {
            names.append(d)
            kinds.append(true)
        }
        for f in files {
            names.append(f)
            kinds.append(false)
        }
        self._names = names
        self._dirs = kinds
        shown := []
        i := 0
        while i < names.length() {
            n: String = names[i]
            isd: Bool = kinds[i]
            if isd and n != ".." { shown.append(n + "/") } else { shown.append(n) }
            i = i + 1
        }
        self._list.items = shown
        self._list.selected = -1
        self._list._top = 0
        if shown.length() > 0 { self._list.select(0) }
    }

    --- Dismiss the dialog without a choice. ---
    define cancel(self) -> void {
        self.close_popup()
        if self.on_cancel != null { self.on_cancel() }
    }

    define close_popup(self) -> void {
        if not self.is_open { return }
        self.is_open = false
        keep := []
        for o in _popups {
            w: Widget = o
            if w != self { keep.append(w) }
        }
        _popups.clear()
        for w in keep { _popups.append(w) }
    }

    define _pick(self, path: String) -> void {
        self.close_popup()
        if self.on_pick != null { self.on_pick(path) }
    }

    // Enter / double-click on list row i.
    define _open_row(self, i: Int) -> void {
        if i < 0 or i >= self._names.length() { return }
        name: String = self._names[i]
        isd: Bool = self._dirs[i]
        if name == ".." {
            self.go(fs.dirname(self.dir))
        } elif isd {
            self.go(fs.join(self.dir, name))
        } elif self.mode == "save" {
            self._name.text = name
            self._name.select_all()
            self._confirm()
        } else {
            self._pick(fs.join(self.dir, name))
        }
    }

    // The Open / Save / Choose button.
    define _confirm(self) -> void {
        if self.mode == "save" {
            name := self._name.text.trim()
            if name.length() > 0 { self._pick(fs.join(self.dir, name)) }
        } elif self.mode == "folder" {
            i := self._list.selected
            if i >= 0 and i < self._names.length() {
                n: String = self._names[i]
                if n != ".." {
                    self._pick(fs.join(self.dir, n))
                    return
                }
            }
            self._pick(self.dir)
        } else {
            self._open_row(self._list.selected)
        }
    }

    define popup_contains(self, px: Int, py: Int) -> Bool {
        return true                               // modal: every click is ours
    }

    define popup_handle(self, e: window.Event) -> Bool {
        if self._list.contains(e.x, e.y) or (e.kind == "wheel") {
            if e.kind == "mouse_down" {
                self._in_name = false
                self._list.focused = true
                self._name.focused = false
            }
            self._list.handle(e)
            if e.kind == "mouse_down" and e.button == 1 and e.clicks >= 2 { self._open_row(self._list.selected) }
            elif e.kind == "mouse_down" and self.mode == "save" {
                i := self._list.selected
                if i >= 0 {
                    isd: Bool = self._dirs[i]
                    if not isd { self._name.text = self._names[i] }
                }
            }
            return true
        }
        if self.mode == "save" and (self._name.contains(e.x, e.y) or self._name._dragging) {
            if e.kind == "mouse_down" {
                self._in_name = true
                self._name.focused = true
                self._list.focused = false
            }
            self._name.handle(e)
            return true
        }
        for b in [self._ok, self._cancel] {
            btn: Button = b
            if e.kind == "mouse_down" and e.button == 1 { btn.pressed = btn.contains(e.x, e.y) }
            if e.kind == "mouse_up" and e.button == 1 {
                was := btn.pressed
                btn.pressed = false
                if was and btn.contains(e.x, e.y) {
                    if btn == self._ok { self._confirm() } else { self.cancel() }
                    return true
                }
            }
        }
        return true
    }

    define popup_key(self, e: window.Event) -> Bool {
        if e.kind == "key_down" {
            k := e.key
            if k == "escape" {
                self.cancel()
                return true
            }
            if k == "tab" and self.mode == "save" {
                self._in_name = not self._in_name
                return true
            }
            if k == "return" or k == "keypad_enter" {
                if self._in_name { self._confirm() } else { self._open_row(self._list.selected) }
                return true
            }
            if k == "backspace" and not self._in_name {
                self.go(fs.dirname(self.dir))
                return true
            }
        }
        if self._in_name { self._name.handle(e) } else { self._list.handle(e) }
        return true
    }

    define draw_popup(self, win: window.Window, t: Theme) -> void {
        // Dim what's behind, then a centred panel.
        win.rect(0, 0, win.width(), win.height(), window.rgba(0, 0, 0, 110))
        self._pw = _min(win.width() - 24, 520)
        self._ph = _min(win.height() - 24, 380)
        self._px = (win.width() - self._pw) / 2
        self._py = (win.height() - self._ph) / 2
        x := self._px
        y := self._py
        w := self._pw
        h := self._ph
        win.rect(x + 4, y + 4, w, h, mix(t.background, window.black(), 50))
        win.rect(x, y, w, h, t.surface)
        win.rect(x, y, w, h, t.border, fill=false)
        lh := t.line()
        win.text(self.title, x + 12, y + 10, t.text, scale=t.scale)
        shown_dir := self.dir
        fit := _max(4, (w - 24) / t.char_w())
        if shown_dir.length() > fit { shown_dir = "..." + shown_dir.substring(shown_dir.length() - fit + 3, shown_dir.length()) }
        win.text(shown_dir, x + 12, y + 10 + lh + 4, t.muted, scale=t.scale)
        top := y + 10 + 2 * lh + 14
        bottom := y + h - 12 - (lh + 12)          // the buttons row
        if self.mode == "save" { bottom = bottom - (lh + 12) - 8 }
        self._list.focused = not self._in_name
        self._name.focused = self._in_name
        self._list.measure(t)
        self._list.place(x + 12, top, w - 24, _max(30, bottom - top - 8))
        self._list.draw(win, t)
        if self.mode == "save" {
            self._name.measure(t)
            self._name.place(x + 12, bottom, w - 24, lh + 12)
            self._name.draw(win, t)
        }
        by := y + h - 12 - (lh + 12)
        for b in [self._cancel, self._ok] {
            btn: Button = b
            btn.measure(t)
        }
        okw := self._ok.min_w
        cw := self._cancel.min_w
        self._ok.place(x + w - 12 - okw, by, okw, lh + 12)
        self._cancel.place(x + w - 12 - okw - 8 - cw, by, cw, lh + 12)
        self._cancel.draw(win, t)
        self._ok.draw(win, t)
    }
}

// Every visible MenuBar in the tree.
define _all_menu_bars(w: Widget) -> List {
    out := []
    _collect_bars(w, out)
    return out
}

define _collect_bars(w: Widget, out: List) -> void {
    if not w.visible { return }
    if w.is_menu_bar() { out.append(w) }
    for c in w.children() {
        cw: Widget = c
        _collect_bars(cw, out)
    }
}

// Names sorted, ignoring case (insertion sort; folders are small).
define _sorted_names(names: List) -> List {
    out := []
    for n in names { out.append(n) }
    i := 1
    while i < out.length() {
        cur: String = out[i]
        j := i - 1
        while j >= 0 {
            prev: String = out[j]
            if prev.lower() <= cur.lower() { break }
            out[j + 1] = prev
            j = j - 1
        }
        out[j + 1] = cur
        i = i + 1
    }
    return out
}

// ===== App =====

// Visible, enabled, focusable widgets in tree order (Tab order).
define _focus_chain(w: Widget, out: List) -> void {
    if not w.visible { return }
    if w.focusable and w.enabled { out.append(w) }
    for c in w.children() { _focus_chain(c, out) }
}

// The deepest visible widget at (px, py) that takes clicks (focusable,
// or `takes_clicks`), or null.
define _hit(w: Widget, px: Int, py: Int) -> Widget {
    if not w.visible or not w.contains(px, py) { return null }
    kids := w.children()
    i := kids.length() - 1
    while i >= 0 {
        found := _hit(kids[i], px, py)
        if found != null { return found }
        i = i - 1
    }
    if w.focusable or w.takes_clicks { return w }
    return null
}

// Every visible widget containing (px, py), outermost first.
define _path(w: Widget, px: Int, py: Int, out: List) -> void {
    if not w.visible or not w.contains(px, py) { return }
    out.append(w)
    kids := w.children()
    i := kids.length() - 1
    while i >= 0 {
        before := out.length()
        _path(kids[i], px, py, out)
        if out.length() > before { return }
        i = i - 1
    }
}

// The deepest widget at (px, py) with a tooltip, or null.
define _tip_at(w: Widget, px: Int, py: Int) -> Widget {
    path := []
    _path(w, px, py, path)
    i := path.length() - 1
    while i >= 0 {
        c: Widget = path[i]
        if c.tooltip.length() > 0 { return c }
        i = i - 1
    }
    return null
}

define _close_popups() -> void {
    while _popups.length() > 0 {
        o: Widget = _popups[_popups.length() - 1]
        o.close_popup()
        if _popups.length() > 0 {
            top: Widget = _popups[_popups.length() - 1]
            if top == o { _popups.pop() }
        }
    }
}

define _clear_hover(w: Widget) -> void {
    w.hovered = false
    for c in w.children() { _clear_hover(c) }
}

---
A window showing a widget tree. Set `root`, then `run()`.
  `theme`     — colours (`ui.dark()` by default)
  `on_frame`  — optional `fn()` called once per frame before drawing
  `focus`     — the widget with the keyboard focus (or null)
  `tooltip_delay` — ms the mouse rests on a widget before its tooltip shows
  `on_key`    — optional `fn(e)` called for every key press, before the
                focused widget sees it (shortcuts: `if e.ctrl and e.key == "s"`)
`step()` runs one frame yourself (custom loops, tests).
---
struct App {
    win: window.Window
    root: Widget
    theme: Theme
    focus: Widget
    on_frame: Callable
    on_key: Callable
    tooltip_delay: Int
    _capture: Widget
    _tip: Widget
    _tip_since: Int
    _mx: Int
    _my: Int
    _drag_src: Widget
    _drag_from_x: Int
    _drag_from_y: Int
    _drag_data: Any
    _dragging: Bool

    define __init(self, title: String, width: Int, height: Int, theme: Theme = null, resizable: Bool = true, headless: Bool = false) -> void {
        self.win = window.open(title, width, height, resizable=resizable, headless=headless)
        self.root = Column([])
        if theme == null {
            self.theme = dark()
        } else {
            self.theme = theme
        }
        self.focus = null
        self.on_frame = null
        self.on_key = null
        self.tooltip_delay = 500
        self._capture = null
        self._tip = null
        self._tip_since = 0
        self._mx = -1
        self._my = -1
        self._drag_src = null
        self._drag_from_x = 0
        self._drag_from_y = 0
        self._drag_data = null
        self._dragging = false
        _close_popups()
    }

    --- True while something is being dragged (see `Widget.on_drag`). ---
    define dragging(self) -> Bool {
        return self._dragging
    }

    // Menus whose shortcuts apply now.
    define _shortcut_menus(self, w: Widget, out: List) -> void {
        if not w.visible or not w.enabled { return }
        if w.context_menu != null and _focused_in(w) != null { out.append(w.context_menu) }
        for c in w.children() {
            cw: Widget = c
            self._shortcut_menus(cw, out)
        }
    }

    // Run the enabled menu item whose shortcut is `e`; true if one did.
    define _run_shortcut(self, e: window.Event) -> Bool {
        menus := []
        self._shortcut_menus(self.root, menus)
        for b in _all_menu_bars(self.root) {
            bar: MenuBar = b
            for m in bar.menus { menus.append(m) }
        }
        for mm in menus {
            menu: Menu = mm
            for it in menu.items {
                item: MenuItem = it
                if item.enabled and not item.is_separator() and item.matches(e) {
                    if item.on_click != null { item.on_click() }
                    return true
                }
            }
        }
        return false
    }

    // The innermost widget at (px, py) that something can be dropped on.
    define _drop_target(self, px: Int, py: Int) -> Widget {
        path := []
        _path(self.root, px, py, path)
        i := path.length() - 1
        while i >= 0 {
            w: Widget = path[i]
            if w.on_drop != null and w.enabled { return w }
            i = i - 1
        }
        return null
    }

    --- True until the window is closed. ---
    define is_open(self) -> Bool {
        return self.win.is_open()
    }

    --- Close the window (ends `run`). ---
    define close(self) -> void {
        self.win.close()
    }

    --- Give `w` the keyboard focus (null: nobody). ---
    define focus_on(self, w: Widget) -> void {
        if w != self.focus { _close_popups() }
        if self.focus != null { self.focus.focused = false }
        self.focus = w
        if w != null { w.focused = true }
    }

    define _cycle_focus(self, backwards: Bool) -> void {
        chain := []
        _focus_chain(self.root, chain)
        if chain.length() == 0 { return }
        idx := -1
        i := 0
        for c in chain {
            if c.focused { idx = i }
            i = i + 1
        }
        next := 0
        if backwards {
            next = chain.length() - 1
            if idx > 0 { next = idx - 1 }
        } elif idx >= 0 {
            next = (idx + 1) % chain.length()
        }
        self.focus_on(chain[next])
    }

    --- Measure and place the tree to fill the window. ---
    define layout(self) -> void {
        self.root.measure(self.theme)
        self.root.place(0, 0, self.win.width(), self.win.height())
    }

    --- Route one event to the widget it's for (also usable from tests). ---
    define dispatch(self, e: window.Event) -> void {
        k := e.kind
        if k == "mouse_move" or k == "mouse_down" or k == "mouse_up" or k == "wheel" or k == "key_down" or k == "blur" {
            if k == "mouse_move" {
                self._mx = e.x
                self._my = e.y
                tip := _tip_at(self.root, e.x, e.y)
                if tip != self._tip {
                    self._tip = tip
                    self._tip_since = window.ticks()
                }
            } else {
                self._tip_since = -1      // hidden until the mouse moves to another widget
            }
        }
        // An open popup gets the mouse first; a click anywhere else closes it.
        if _popups.length() > 0 and (k == "mouse_move" or k == "mouse_down" or k == "mouse_up" or k == "wheel") {
            top: Widget = _popups[_popups.length() - 1]
            px := e.x
            py := e.y
            if k == "wheel" {
                px = self.win.mouse().0
                py = self.win.mouse().1
            }
            if top.popup_contains(px, py) {
                _clear_hover(self.root)
                top.popup_handle(e)
                return
            }
            if k == "mouse_down" {
                owner := _hit(self.root, e.x, e.y)
                _close_popups()
                // A click on the popup's own field just closes it.
                if owner == top {
                    self._capture = owner
                    return
                }
            }
        }
        // Drag and drop: past 4 px of movement with the button held, the
        // pressed widget's `on_drag` data travels to an `on_drop` target.
        if k == "mouse_move" and self._drag_src != null and e.left and not self._dragging {
            dx := e.x - self._drag_from_x
            dy := e.y - self._drag_from_y
            if dx * dx + dy * dy > 16 {
                self._drag_data = self._drag_src.on_drag()
                if self._drag_data != null {
                    self._dragging = true
                    if self._capture != null { self._capture.pressed = false }
                } else {
                    self._drag_src = null
                }
            }
        }
        if k == "mouse_up" and self._dragging {
            target := self._drop_target(e.x, e.y)
            data := self._drag_data
            self._dragging = false
            self._drag_src = null
            self._drag_data = null
            if self._capture != null {
                cap := self._capture
                self._capture = null
                cap.pressed = false
                // Released somewhere else: no click.
                ev := window.Event("mouse_up")
                ev.x = -100000
                ev.y = -100000
                ev.button = e.button
                cap.handle(ev)
            }
            if target != null { target.on_drop(data) }
            return
        }
        if k == "mouse_up" { self._drag_src = null }
        if k == "mouse_move" {
            _clear_hover(self.root)
            over := _hit(self.root, e.x, e.y)
            if over != null { over.hovered = true }
            if self._capture != null { self._capture.handle(e) }
            return
        }
        // Right-click: the context menu of the innermost widget that has one.
        if k == "mouse_down" and e.button == 3 {
            path := []
            _path(self.root, e.x, e.y, path)
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.context_menu != null and w.enabled {
                    _close_popups()
                    w.context_menu.open_at(e.x, e.y)
                    return
                }
                i = i - 1
            }
            return
        }
        if k == "mouse_down" and e.button == 1 {
            path := []
            _path(self.root, e.x, e.y, path)
            self._drag_src = null
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.on_drag != null and w.enabled {
                    self._drag_src = w
                    self._drag_from_x = e.x
                    self._drag_from_y = e.y
                    break
                }
                i = i - 1
            }
        }
        if k == "mouse_down" {
            target := _hit(self.root, e.x, e.y)
            if target != null and target.enabled {
                if target.focusable { self.focus_on(target) }
                self._capture = target
                target.handle(e)
            } else {
                self.focus_on(null)
            }
            return
        }
        if k == "mouse_up" {
            if self._capture != null {
                cap := self._capture
                self._capture = null
                cap.handle(e)
            }
            return
        }
        if k == "wheel" {
            // Innermost widget under the mouse that uses it (a list inside a
            // scroll view scrolls itself; elsewhere the scroll view scrolls).
            path := []
            mx := self.win.mouse().0
            my := self.win.mouse().1
            if self._mx >= 0 {
                mx = self._mx
                my = self._my
            }
            _path(self.root, mx, my, path)
            i := path.length() - 1
            while i >= 0 {
                w: Widget = path[i]
                if w.enabled and w.handle(e) { return }
                i = i - 1
            }
            return
        }
        if k == "key_down" and self.on_key != null { self.on_key(e) }
        // Menu shortcuts: from any menu bar, and the right-click menus of the
        // focused widget and those around it. Not while a popup is open.
        if k == "key_down" and _popups.length() == 0 and self._run_shortcut(e) { return }
        // An open popup that takes keys (a menu) gets them first.
        if (k == "key_down" or k == "key_up" or k == "text") and _popups.length() > 0 {
            top: Widget = _popups[_popups.length() - 1]
            if top.popup_key(e) { return }
        }
        if k == "key_down" and e.key == "tab" and not e.ctrl {
            self._cycle_focus(e.shift)
            return
        }
        if k == "key_down" or k == "key_up" or k == "text" {
            if self.focus != null and self.focus.visible and self.focus.enabled { self.focus.handle(e) }
            return
        }
        if k == "blur" {
            _clear_hover(self.root)
        }
    }

    --- One frame: handle events, lay out, draw, present. False once the window is closed. ---
    define step(self) -> Bool {
        for e in self.win.events() {
            if not self.win.is_open() { return false }
            self.dispatch(e)
        }
        if not self.win.is_open() { return false }
        if self.on_frame != null { self.on_frame() }
        if not self.win.is_open() { return false }
        self.layout()
        self.draw()
        self.win.present()
        return true
    }

    --- Draw the tree, open popups and the tooltip (what `step` shows). ---
    define draw(self) -> void {
        t := self.theme
        _clips.clear()
        self.win.unclip()
        self.win.clear(t.background)
        self.root.draw(self.win, t)
        if self._dragging {
            over := self._drop_target(self._mx, self._my)
            if over != null { self.win.rect(over.x - 2, over.y - 2, over.width + 4, over.height + 4, t.accent, fill=false) }
            label := "?"
            if self._drag_data != null { label = self._drag_data.str() }
            if label.length() > 30 { label = label.substring(0, 30) + "..." }
            lw := window.text_width(label, t.scale) + 12
            self.win.rect(self._mx + 12, self._my + 8, lw, t.line() + 6, mix(t.surface, t.accent, 25))
            self.win.rect(self._mx + 12, self._my + 8, lw, t.line() + 6, t.accent, fill=false)
            self.win.text(label, self._mx + 18, self._my + 11, t.text, scale=t.scale)
        }
        for o in _popups {
            p: Widget = o
            p.draw_popup(self.win, t)
        }
        tip := self._tip
        if tip != null {
            if tip.visible and self._tip_since >= 0 and window.ticks() - self._tip_since >= self.tooltip_delay {
                self._draw_tip(tip.tooltip)
            }
        }
    }

    define _draw_tip(self, text: String) -> void {
        t := self.theme
        tw := window.text_width(text, t.scale) + 12
        th := text.split("\n").length() * t.line() + 8
        tx := _clamp(self._mx + 12, 0, _max(0, self.win.width() - tw))
        ty := self._my + 20
        if ty + th > self.win.height() { ty = _max(0, self._my - th - 4) }
        self.win.rect(tx, ty, tw, th, mix(t.surface, t.text, 12))
        self.win.rect(tx, ty, tw, th, t.border, fill=false)
        self.win.text(text, tx + 6, ty + 4, t.text, scale=t.scale)
    }

    --- Run until the window closes, about `fps` frames a second. ---
    define run(self, fps: Int = 60) -> void {
        budget := 1000 / fps
        while self.is_open() {
            start := window.ticks()
            if not self.step() { break }
            left := budget - (window.ticks() - start)
            if left > 0 { window.sleep(left) }
        }
    }
}
